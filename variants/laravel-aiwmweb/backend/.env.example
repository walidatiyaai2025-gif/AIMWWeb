APP_NAME="Laravel AIWMWeb"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=debug
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_aiwmweb
DB_USERNAME=laravel_aiwmweb
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_CONNECTION=default

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=150
CACHE_STORE=redis
CACHE_PREFIX=aimwweb_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=aimwweb:

SCHEDULER_HEALTH_MAX_AGE=180
TRUSTED_PROXIES=127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

AI_OPENAI_API_KEY=
AI_GEMINI_API_KEY=
AI_ANTHROPIC_API_KEY=

WORDPRESS_BASE_URL=
WORDPRESS_ADMIN_USER=
WORDPRESS_APPLICATION_PASSWORD=
AIMW_CONNECTOR_PROTOCOL_VERSION=1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL="${APP_URL}"
