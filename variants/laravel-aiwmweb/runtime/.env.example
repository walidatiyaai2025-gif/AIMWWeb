COMPOSE_PROJECT_NAME=laravel-aiwmweb
APP_ENV=production
APP_KEY=
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
APP_PORT=8080
LOG_LEVEL=info

DB_DATABASE=laravel_aiwmweb
DB_USERNAME=laravel_aiwmweb
DB_PASSWORD=
DB_ROOT_PASSWORD=

REDIS_PREFIX=aimwweb:
CACHE_PREFIX=aimwweb_cache_
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=150
SCHEDULER_HEALTH_MAX_AGE=180
TRUSTED_PROXIES=*
CORS_ALLOWED_ORIGINS=http://localhost:8080

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS=noreply@example.invalid
MAIL_FROM_NAME=Laravel AIWMWeb

AI_OPENAI_API_KEY=
AI_GEMINI_API_KEY=
AI_ANTHROPIC_API_KEY=

WORDPRESS_PORT=8081
WORDPRESS_URL=http://localhost:8081
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=
WORDPRESS_DB_ROOT_PASSWORD=
WORDPRESS_ADMIN_USER=ci-admin
WORDPRESS_ADMIN_PASSWORD=
WORDPRESS_ADMIN_EMAIL=ci@example.invalid
AIMW_PLATFORM_URL=http://web
AIMW_PAIRING_TOKEN=
AIMW_REQUIRE_CONNECTOR=0
AIMW_CONNECTOR_PROTOCOL_VERSION=1
