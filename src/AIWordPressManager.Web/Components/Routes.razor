<TrackedErrorBoundary @ref="_errorBoundary">
    <ChildContent>
        <Router AppAssembly="typeof(Program).Assembly" OnNavigateAsync="HandleNavigationAsync">
            <Found Context="routeData">
                <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            </Found>
            <NotFound>
                <LayoutView Layout="typeof(MainLayout)">
                    <div class="empty-state"><h1>الصفحة غير موجودة</h1><p>تحقق من الرابط أو ارجع إلى لوحة التحكم.</p></div>
                </LayoutView>
            </NotFound>
        </Router>
    </ChildContent>
    <ErrorContent Context="exception">
        <LayoutView Layout="typeof(MainLayout)">
            <div class="settings-page">
                <section class="panel settings-hero">
                    <div>
                        <span class="workspace-kicker">ERROR CENTER</span>
                        <h1>حدث خطأ غير متوقع</h1>
                        <p>تم تسجيل الخطأ تلقائيًا. انسخ رقم الخطأ ثم افتح شاشة السجلات للوصول إلى التفاصيل.</p>
                    </div>
                    <span class="settings-badge danger">ERROR</span>
                </section>
                <section class="panel settings-section">
                    <div class="database-info-grid">
                        <div><small>رقم الخطأ</small><strong>@(_errorBoundary?.ErrorId ?? "N/A")</strong></div>
                        <div><small>رقم الارتباط</small><strong>@(_errorBoundary?.CorrelationId ?? "N/A")</strong></div>
                        <div><small>الوقت</small><strong>@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</strong></div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap" style="margin-top:1rem">
                        <button class="btn primary" @onclick="Recover">إعادة تحميل الشاشة</button>
                        <a class="btn" href="/logs">فتح السجلات</a>
                        <a class="btn" href="/">العودة للرئيسية</a>
                    </div>
                </section>
            </div>
        </LayoutView>
    </ErrorContent>
</TrackedErrorBoundary>

@code {
    private TrackedErrorBoundary? _errorBoundary;

    private Task HandleNavigationAsync(NavigationContext context)
    {
        _errorBoundary?.Recover();
        return Task.CompletedTask;
    }

    private void Recover() => _errorBoundary?.Recover();
}
