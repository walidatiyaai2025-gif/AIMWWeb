@using AIWordPressManager.Web.Diagnostics
@inject AppLanguageService L
@inject NavigationManager Navigation

<TrackedErrorBoundary @ref="_errorBoundary">
    <ChildContent>
        <Router AppAssembly="typeof(Program).Assembly" OnNavigateAsync="HandleNavigationAsync">
            <Found Context="routeData">
                <PermissionRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                    <Authorizing>
                        <div class="settings-page">
                            <section class="panel settings-section" role="status">
                                <h1>@(L.IsArabic ? "جارٍ التحقق من الصلاحيات" : "Checking access")</h1>
                                <p>@(L.IsArabic ? "يتم التحقق من جلسة الدخول والصلاحيات المطلوبة لهذه الصفحة." : "Your sign-in session and the permissions required for this page are being verified.")</p>
                            </section>
                        </div>
                    </Authorizing>
                    <NotAuthorized>
                        <div class="settings-page">
                            <section class="panel settings-hero">
                                <div>
                                    <span class="workspace-kicker">ACCESS CONTROL</span>
                                    <h1>@(L.IsArabic ? "غير مصرح بالوصول" : "Access denied")</h1>
                                    <p>@(L.IsArabic ? "حسابك مسجل الدخول، لكنه لا يملك الصلاحية المطلوبة لفتح هذه الصفحة." : "Your account is signed in but doesn't have the permission required to open this page.")</p>
                                </div>
                                <span class="settings-badge danger">403</span>
                            </section>
                            <section class="panel settings-section" role="alert">
                                <p>@(L.IsArabic ? "إذا تغير دورك أو صلاحياتك مؤخرًا، سجّل الدخول من جديد بعد أن يراجع مسؤول النظام التعيين." : "If your role or permissions changed recently, sign in again after an administrator reviews the assignment.")</p>
                                <div class="d-flex gap-2 flex-wrap" style="margin-top:1rem">
                                    <a class="btn primary" href="/">@(L.IsArabic ? "العودة للرئيسية" : "Back to dashboard")</a>
                                    <a class="btn" href="/account/profile">@(L.IsArabic ? "فتح حسابي" : "Open my account")</a>
                                </div>
                            </section>
                        </div>
                    </NotAuthorized>
                </PermissionRouteView>
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            </Found>
            <NotFound>
                <LayoutView Layout="typeof(MainLayout)">
                    <div class="empty-state">
                        <h1>@(L.IsArabic ? "الصفحة غير موجودة" : "Page not found")</h1>
                        <p>@(L.IsArabic ? "تحقق من الرابط أو ارجع إلى لوحة التحكم." : "Check the address or return to the dashboard.")</p>
                    </div>
                </LayoutView>
            </NotFound>
        </Router>
    </ChildContent>
    <ErrorContent Context="exception">
        @* Do not render MainLayout here. A layout-level failure (for example the account/site
           widget) would otherwise recursively throw while trying to display the error. *@
        <div class="settings-page" style="min-height:100vh;padding:2rem;background:#0b0f17;color:#f9fafb" role="alert">
            <section class="panel settings-hero">
                <div>
                    <span class="workspace-kicker">RUNTIME ERROR — DIAGNOSTIC MODE</span>
                    <h1>@(L.IsArabic ? "حدث خطأ أثناء تشغيل الشاشة" : "A runtime error interrupted this screen")</h1>
                    <p>@(L.IsArabic ? "الخطأ غير مخفي. التفاصيل الأساسية ظاهرة أدناه وتم تسجيل الـStack Trace كاملًا في ملف السجل." : "The failure is not hidden. Core details are shown below and the full stack trace was written to the log file.")</p>
                </div>
                <span class="settings-badge danger">ERROR</span>
            </section>

            <section class="panel settings-section" style="margin-top:1rem">
                <div class="database-info-grid">
                    <div><small>@(L.IsArabic ? "رقم الخطأ" : "Error ID")</small><strong>@(_errorBoundary?.ErrorId ?? "N/A")</strong></div>
                    <div><small>@(L.IsArabic ? "رقم الارتباط" : "Correlation ID")</small><strong>@(_errorBoundary?.CorrelationId ?? "N/A")</strong></div>
                    <div><small>@(L.IsArabic ? "نوع الخطأ" : "Exception type")</small><strong>@exception.GetType().FullName</strong></div>
                    <div><small>@(L.IsArabic ? "الوقت" : "Time")</small><strong>@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</strong></div>
                </div>

                <div style="margin-top:1rem;padding:1rem;border:1px solid #ef444466;border-radius:10px;background:#7f1d1d33;white-space:pre-wrap;word-break:break-word">
                    <strong>@(L.IsArabic ? "رسالة الخطأ" : "Exception message")</strong>
                    <div style="margin-top:.5rem">@RuntimeLogRedactor.Redact(exception.Message)</div>
                </div>

                @if (exception.InnerException is not null)
                {
                    <div style="margin-top:.75rem;padding:1rem;border:1px solid #f59e0b55;border-radius:10px;white-space:pre-wrap;word-break:break-word">
                        <strong>@(L.IsArabic ? "الخطأ الداخلي" : "Inner exception")</strong>
                        <div style="margin-top:.5rem">@exception.InnerException.GetType().FullName: @RuntimeLogRedactor.Redact(exception.InnerException.Message)</div>
                    </div>
                }

                <p style="margin-top:1rem;opacity:.8">
                    @(L.IsArabic
                        ? "للتشخيص أرسل Error ID مع ملف aiwm/errors الخاص بنفس الوقت. الأسرار الحساسة يتم إخفاؤها تلقائيًا."
                        : "For diagnosis, send the Error ID together with the aiwm/errors log from the same time. Sensitive secrets are automatically redacted.")
                </p>

                <div class="d-flex gap-2 flex-wrap" style="margin-top:1rem">
                    <button class="btn primary" @onclick="Recover">@(L.IsArabic ? "محاولة استعادة الشاشة" : "Try to recover")</button>
                    <a class="btn" href="@Navigation.Uri" data-enhance-nav="false">@(L.IsArabic ? "إعادة تحميل كاملة" : "Hard reload")</a>
                    <a class="btn" href="/logs">@(L.IsArabic ? "فتح السجلات" : "Open logs")</a>
                    <a class="btn" href="/">@(L.IsArabic ? "العودة للرئيسية" : "Back to dashboard")</a>
                </div>
            </section>
        </div>
    </ErrorContent>
</TrackedErrorBoundary>

@code {
    private TrackedErrorBoundary? _errorBoundary;

    private Task HandleNavigationAsync(NavigationContext context)
    {
        _errorBoundary?.Recover();
        return Task.CompletedTask;
    }

    private void Recover() => _errorBoundary?.Recover();
}
