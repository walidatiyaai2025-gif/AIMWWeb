<article class="app-stat-card @Tone @Class">
    <span class="app-stat-card__icon" aria-hidden="true">@Icon</span>
    <div class="app-stat-card__content">
        <small>@Label</small>
        <strong class="@ValueClass">@Value</strong>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <span>@Description</span>
        }
    </div>
</article>

@code {
    [Parameter] public string Icon { get; set; } = "•";
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string Tone { get; set; } = "accent";
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string ValueClass { get; set; } = string.Empty;
}
