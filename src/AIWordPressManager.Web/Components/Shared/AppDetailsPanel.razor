<aside class="app-details-panel @ToneClass @Class" aria-label="@AriaLabel">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <span class="app-details-panel__icon" aria-hidden="true">@Icon</span>
    }
    <div class="app-details-panel__content">
        @if (!string.IsNullOrWhiteSpace(Eyebrow))
        {
            <span class="app-details-panel__eyebrow">@Eyebrow</span>
        }
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <h3>@Title</h3>
        }
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p>@Description</p>
        }
        @ChildContent
        @if (Actions is not null)
        {
            <div class="app-details-panel__actions">@Actions</div>
        }
    </div>
</aside>

@code {
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string Tone { get; set; } = "accent";
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    private string ToneClass => $"app-details-panel--{Tone}";
}
