<span class="app-badge app-badge--@Tone @Class" title="@Title" data-bidi-mode="@EffectiveBidiMode">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <span class="app-badge__icon" aria-hidden="true">@Icon</span>
    }
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else if (!string.IsNullOrWhiteSpace(BidiMode))
    {
        <AppBidiText Mode="@BidiMode" Text="@Text" />
    }
    else
    {
        @Text
    }
</span>

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string Tone { get; set; } = "neutral";
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? BidiMode { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string EffectiveBidiMode => string.IsNullOrWhiteSpace(BidiMode) ? "inherit" : BidiMode.Trim().ToLowerInvariant();
}
