<section class="app-card app-card--@NormalizedTone app-card--@NormalizedDensity @Class"
         aria-label="@ExplicitAriaLabel"
         aria-labelledby="@LabelledById"
         aria-describedby="@DescribedById"
         data-heading-level="@NormalizedHeadingLevel"
         data-card-tone="@NormalizedTone"
         data-card-density="@NormalizedDensity">
    @if (!string.IsNullOrWhiteSpace(Title) || Header is not null)
    {
        <header class="app-card__header">
            <div class="app-card__heading">
                @if (!string.IsNullOrWhiteSpace(Eyebrow))
                {
                    <span class="app-card__eyebrow">@Eyebrow</span>
                }
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    @if (NormalizedHeadingLevel <= 2)
                    {
                        <h2 id="@TitleId">@Title</h2>
                    }
                    else if (NormalizedHeadingLevel == 4)
                    {
                        <h4 id="@TitleId">@Title</h4>
                    }
                    else
                    {
                        <h3 id="@TitleId">@Title</h3>
                    }
                }
                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <p id="@SubtitleId">@Subtitle</p>
                }
            </div>
            @if (Header is not null)
            {
                <div class="app-card__header-content">@Header</div>
            }
        </header>
    }

    <div class="app-card__body @BodyClass">
        @ChildContent
    </div>

    @if (Footer is not null)
    {
        <footer class="app-card__footer">@Footer</footer>
    }
</section>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string Tone { get; set; } = "neutral";
    [Parameter] public string Density { get; set; } = "comfortable";
    [Parameter] public int HeadingLevel { get; set; } = 3;
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string BodyClass { get; set; } = string.Empty;
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    private readonly string _instanceId = Guid.NewGuid().ToString("N");
    private string TitleId => $"app-card-{_instanceId}-title";
    private string SubtitleId => $"app-card-{_instanceId}-description";
    private int NormalizedHeadingLevel => Math.Clamp(HeadingLevel, 2, 4);
    private string NormalizedTone => Tone.Trim().ToLowerInvariant() switch
    {
        "accent" => "accent",
        "success" => "success",
        "warning" => "warning",
        "danger" => "danger",
        "info" => "info",
        _ => "neutral"
    };
    private string NormalizedDensity => Density.Trim().ToLowerInvariant() switch
    {
        "compact" => "compact",
        "spacious" => "spacious",
        _ => "comfortable"
    };
    private string? ExplicitAriaLabel => string.IsNullOrWhiteSpace(Title) ? AriaLabel : null;
    private string? LabelledById => string.IsNullOrWhiteSpace(Title) ? null : TitleId;
    private string? DescribedById => string.IsNullOrWhiteSpace(Subtitle) ? null : SubtitleId;
}
