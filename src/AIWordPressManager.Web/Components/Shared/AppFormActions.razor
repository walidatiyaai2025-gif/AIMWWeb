<div class="app-form-actions @Class" aria-busy="@Busy">
    <div class="app-form-actions__state">
        @if (Dirty)
        {
            <span class="app-form-actions__dirty" role="status">@DirtyText</span>
        }
        @if (!string.IsNullOrWhiteSpace(Hint))
        {
            <small>@Hint</small>
        }
    </div>
    <div class="app-form-actions__buttons">
        @if (ShowCancel)
        {
            <AppButton Text="@CancelText"
                       Disabled="@(Busy || CancelDisabled)"
                       AriaLabel="@CancelAriaLabel"
                       OnClick="CancelClickedAsync" />
        }
        <AppButton Variant="@SaveVariant"
                   Icon="@SaveIcon"
                   Text="@(Busy ? SavingText : SaveText)"
                   Busy="@Busy"
                   Disabled="@(Busy || Disabled)"
                   AriaLabel="@SaveAriaLabel"
                   OnClick="SaveClickedAsync" />
    </div>
</div>

@code {
    [Parameter] public string SaveText { get; set; } = "Save";
    [Parameter] public string SavingText { get; set; } = "Saving";
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public string? SaveAriaLabel { get; set; }
    [Parameter] public string? CancelAriaLabel { get; set; }
    [Parameter] public string SaveVariant { get; set; } = "primary";
    [Parameter] public string SaveIcon { get; set; } = "✓";
    [Parameter] public string DirtyText { get; set; } = "Unsaved changes";
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool CancelDisabled { get; set; }
    [Parameter] public bool ShowCancel { get; set; } = true;
    [Parameter] public bool Dirty { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnSave { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnCancel { get; set; }

    private Task SaveClickedAsync(MouseEventArgs args) => Busy || Disabled ? Task.CompletedTask : OnSave.InvokeAsync(args);
    private Task CancelClickedAsync(MouseEventArgs args) => Busy || CancelDisabled ? Task.CompletedTask : OnCancel.InvokeAsync(args);
}
