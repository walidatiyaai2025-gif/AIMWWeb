<div class="app-form-field @(Invalid ? "is-invalid" : string.Empty) @(Disabled ? "is-disabled" : string.Empty) @Class"
     data-form-field
     data-invalid="@Invalid.ToString().ToLowerInvariant()">
    <label class="app-form-field__label" for="@InputId">
        <span>@Label</span>
        @if (Required)
        {
            <strong class="app-form-field__required" aria-hidden="true">*</strong>
            <span class="sr-only">@RequiredText</span>
        }
        else if (!string.IsNullOrWhiteSpace(OptionalText))
        {
            <small class="app-form-field__optional">@OptionalText</small>
        }
    </label>

    @if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <div id="@HelperId" class="app-form-field__helper">@HelperText</div>
    }

    <div class="app-form-field__control">@ChildContent</div>

    @if (!string.IsNullOrWhiteSpace(CharacterHint))
    {
        <div id="@HintId" class="app-form-field__hint">@CharacterHint</div>
    }

    @if (Invalid && !string.IsNullOrWhiteSpace(ErrorText))
    {
        <div id="@ErrorId" class="app-form-field__error" role="alert" aria-live="polite">@ErrorText</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string InputId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public string? CharacterHint { get; set; }
    [Parameter] public string RequiredText { get; set; } = "Required";
    [Parameter] public string? OptionalText { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Invalid { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    public string HelperId => $"{InputId}-help";
    public string HintId => $"{InputId}-hint";
    public string ErrorId => $"{InputId}-error";
    public string DescriptionIds => string.Join(" ", new[]
    {
        string.IsNullOrWhiteSpace(HelperText) ? null : HelperId,
        string.IsNullOrWhiteSpace(CharacterHint) ? null : HintId,
        Invalid && !string.IsNullOrWhiteSpace(ErrorText) ? ErrorId : null
    }.Where(x => !string.IsNullOrWhiteSpace(x)));
}
