<aside class="app-state-banner app-state-banner--@NormalizedKind @Class"
       role="@EffectiveRole"
       aria-live="@EffectiveLive"
       aria-atomic="true"
       aria-busy="@Busy.ToString().ToLowerInvariant()"
       data-state="@NormalizedKind"
       data-retains-content="true">
    <span class="app-state-banner__icon" aria-hidden="true">@EffectiveIcon</span>
    <div class="app-state-banner__content">
        <strong>@Title</strong>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <span>@Description</span>
        }
        @if (!string.IsNullOrWhiteSpace(FreshnessText))
        {
            <small>@FreshnessText</small>
        }
    </div>
    @if (RetryRequested.HasDelegate || Actions is not null)
    {
        <div class="app-state-banner__actions">
            @if (RetryRequested.HasDelegate)
            {
                <AppButton Icon="↻"
                           Size="small"
                           Text="@(Busy ? RetryingText : RetryText)"
                           AriaLabel="@RetryAriaLabel"
                           Disabled="@Busy"
                           Busy="@Busy"
                           OnClick="RetryAsync" />
            }
            @Actions
        </div>
    }
</aside>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Kind { get; set; } = "info";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? FreshnessText { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Assertive { get; set; }
    [Parameter] public string RetryText { get; set; } = "Retry";
    [Parameter] public string RetryingText { get; set; } = "Retrying...";
    [Parameter] public string? RetryAriaLabel { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public EventCallback RetryRequested { get; set; }

    private string NormalizedKind => Kind.Trim().ToLowerInvariant() switch
    {
        "success" => "success",
        "warning" => "warning",
        "error" or "danger" => "error",
        "offline" => "offline",
        "cached" or "stale" => "cached",
        "partial" => "partial",
        _ => "info"
    };

    private string EffectiveRole => Assertive || NormalizedKind == "error" ? "alert" : "status";
    private string EffectiveLive => Assertive || NormalizedKind == "error" ? "assertive" : "polite";
    private string EffectiveIcon => Icon ?? NormalizedKind switch
    {
        "success" => "✓",
        "warning" => "!",
        "error" => "×",
        "offline" => "⌁",
        "cached" => "◷",
        "partial" => "◐",
        _ => "i"
    };

    private Task RetryAsync(MouseEventArgs _) => Busy ? Task.CompletedTask : RetryRequested.InvokeAsync();
}
