@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

@if (!string.IsNullOrWhiteSpace(Href))
{
    <a class="app-button @VariantClass @SizeClass @Class"
       href="@EffectiveHref"
       target="@Target"
       tabindex="@DisabledTabIndex"
       aria-disabled="@EffectiveDisabled"
       aria-busy="@Busy"
       aria-label="@EffectiveAriaLabel"
       aria-pressed="@AriaPressed"
       title="@Title">
        @ButtonContent
    </a>
}
else
{
    <button class="app-button @VariantClass @SizeClass @Class"
            type="@Type"
            disabled="@EffectiveDisabled"
            aria-busy="@Busy"
            aria-label="@EffectiveAriaLabel"
            aria-pressed="@AriaPressed"
            title="@Title"
            @onclick="OnClick">
        @ButtonContent
    </button>
}

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string IconIntent { get; set; } = "neutral";
    [Parameter] public bool? MirrorIconInRtl { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Target { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string Variant { get; set; } = "default";
    [Parameter] public string Size { get; set; } = "medium";
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool? AriaPressed { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _permissionDisabled;
    private bool EffectiveDisabled => Disabled || _permissionDisabled;
    private string VariantClass => $"app-button--{Variant}";
    private string SizeClass => $"app-button--{Size}";
    private string? EffectiveHref => EffectiveDisabled ? null : Href;
    private string? DisabledTabIndex => EffectiveDisabled ? "-1" : null;
    private string? EffectiveAriaLabel => string.IsNullOrWhiteSpace(AriaLabel) ? Text : AriaLabel;
    private string NormalizedIconIntent => IconIntent.Trim().ToLowerInvariant() switch
    {
        "back" or "previous" => "back",
        "forward" or "next" => "forward",
        "enter" => "enter",
        "external" => "external",
        _ => "neutral"
    };
    private bool ShouldMirrorIcon => MirrorIconInRtl ?? NormalizedIconIntent is "back" or "forward" or "enter";
    private string IconClass => $"app-button__icon app-directional-icon{(ShouldMirrorIcon ? " app-directional-icon--mirror-rtl" : string.Empty)}";

    protected override async Task OnParametersSetAsync()
    {
        _permissionDisabled = false;
        if (!OnClick.HasDelegate || !ApplicationContentMutationUiPolicy.RequiresContentEdit(new Uri(Navigation.Uri).AbsolutePath))
            return;

        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _permissionDisabled = !ApplicationPermissionCatalog.PrincipalHasPermission(
            authenticationState.User,
            ApplicationPermissionCatalog.ContentEdit);
    }

    private RenderFragment ButtonContent => builder =>
    {
        var sequence = 0;
        if (Busy)
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "app-button__spinner");
            builder.AddAttribute(sequence++, "aria-hidden", "true");
            builder.CloseElement();
        }
        else if (!string.IsNullOrWhiteSpace(Icon))
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", IconClass);
            builder.AddAttribute(sequence++, "data-directional-icon", NormalizedIconIntent);
            builder.AddAttribute(sequence++, "aria-hidden", "true");
            builder.AddContent(sequence++, Icon);
            builder.CloseElement();
        }

        if (ChildContent is not null)
        {
            builder.AddContent(sequence++, ChildContent);
        }
        else if (!string.IsNullOrWhiteSpace(Text))
        {
            builder.AddContent(sequence++, Text);
        }
    };
}
