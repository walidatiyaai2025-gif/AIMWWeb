<section class="app-toolbar @Class" aria-label="@AriaLabel">
    <div class="app-toolbar__main">
        @if (!string.IsNullOrWhiteSpace(Eyebrow))
        {
            <span class="app-toolbar__eyebrow">@Eyebrow</span>
        }
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <h1>@Title</h1>
        }
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p>@Subtitle</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="app-toolbar__actions">@Actions</div>
    }
</section>

@code {
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Actions { get; set; }
}
