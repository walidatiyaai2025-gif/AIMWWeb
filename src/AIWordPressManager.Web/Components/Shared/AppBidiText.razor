<bdi class="app-bidi-text app-bidi-text--@NormalizedMode @Class"
     dir="@EffectiveDirection"
     data-bidi-mode="@NormalizedMode"
     lang="@Lang">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @Text
    }
</bdi>

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Mode { get; set; } = "auto";
    [Parameter] public string? Lang { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;

    private string NormalizedMode => Mode.Trim().ToLowerInvariant() switch
    {
        "technical" or "code" or "path" or "url" or "email" => "technical",
        "number" or "numeric" or "date" or "time" or "version" => "numeric",
        "rtl" => "rtl",
        "ltr" => "ltr",
        _ => "auto"
    };

    private string EffectiveDirection => NormalizedMode switch
    {
        "technical" or "numeric" or "ltr" => "ltr",
        "rtl" => "rtl",
        _ => "auto"
    };
}
