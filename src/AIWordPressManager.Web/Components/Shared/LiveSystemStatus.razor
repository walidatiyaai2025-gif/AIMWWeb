@implements IAsyncDisposable
@inject AppLanguageService L
@inject DashboardLiveService DashboardService

<AppCard Title="@(L.IsArabic ? "حالة النظام" : "System Status")" Class="live-system-status">
    @if (_dashboard is null && string.IsNullOrEmpty(_errorMessage))
    {
        <div class="status-grid">
            <AppBadge Tone="warning" Icon="◌">
                @(L.IsArabic ? "جاري التحميل" : "Loading")
            </AppBadge>
        </div>
    }
    else
    {
        <div class="status-grid">
            <AppBadge Tone="@(_hasError ? "danger" : "success")" Icon="●">
                @(_hasError ? (L.IsArabic ? "خطأ في الاتصال" : "Connection Error") : (L.IsArabic ? "النظام يعمل" : "System Online"))
            </AppBadge>

            @if (_dashboard is not null)
            {
                <div class="status-item">
                    <span>@(L.IsArabic ? "آخر مزامنة" : "Last Sync")</span>
                    <strong>@(_dashboard.LastSynchronizationAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</strong>
                </div>
                <div class="status-item">
                    <span>@(L.IsArabic ? "صحة النظام" : "Health")</span>
                    <strong>@_dashboard.HealthScore%</strong>
                </div>
                <div class="status-item">
                    <span>@(L.IsArabic ? "المهام النشطة" : "Active Jobs")</span>
                    <strong>@_dashboard.ActiveJobs</strong>
                </div>
                <div class="status-item">
                    <span>@(L.IsArabic ? "المهام الفاشلة" : "Failed Jobs")</span>
                    <strong>@_dashboard.FailedJobs</strong>
                </div>
            }
        </div>
    }
</AppCard>

@code {
    private DashboardLiveView? _dashboard;
    private PeriodicTimer? _refreshTimer;
    private readonly CancellationTokenSource _refreshCts = new();
    private string? _errorMessage;
    private bool _hasError;
    private bool _refreshing;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _ = RunRefreshLoopAsync();
    }

    private async Task RefreshAsync()
    {
        if (_refreshing) return;

        try
        {
            _refreshing = true;
            _hasError = false;
            _errorMessage = null;
            _dashboard = await DashboardService.GetAsync();
        }
        catch (Exception ex)
        {
            _hasError = true;
            _errorMessage = ex.Message;
        }
        finally
        {
            _refreshing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RunRefreshLoopAsync()
    {
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));

        while (await _refreshTimer.WaitForNextTickAsync(_refreshCts.Token))
        {
            await RefreshAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _refreshCts.Cancel();
        _refreshTimer?.Dispose();
        _refreshCts.Dispose();
        await Task.CompletedTask;
    }
}

<style>
.status-grid{display:flex;gap:14px;align-items:center;flex-wrap:wrap}.status-item{display:flex;flex-direction:column;gap:4px;font-size:13px}.status-item span{opacity:.7}.status-item strong{font-size:14px}
</style>
