@if (Open)
{
    <div class="app-dialog-backdrop" role="presentation" @onclick="HandleBackdropAsync">
        <section id="@DialogId"
                 class="app-dialog app-dialog--@Size @Class"
                 role="dialog"
                 aria-modal="true"
                 aria-label="@ExplicitAriaLabel"
                 aria-labelledby="@LabelledById"
                 aria-describedby="@DescribedById"
                 dir="@NormalizedDirection"
                 data-bidi-scope="dialog"
                 tabindex="-1"
                 @onclick:stopPropagation="true">
            <header class="app-dialog__header">
                <div>
                    @if (!string.IsNullOrWhiteSpace(Eyebrow))
                    {
                        <span class="app-dialog__eyebrow">@Eyebrow</span>
                    }
                    <h2 id="@TitleId">@Title</h2>
                    @if (!string.IsNullOrWhiteSpace(Subtitle))
                    {
                        <p id="@SubtitleId">@Subtitle</p>
                    }
                </div>
                @if (ShowCloseButton)
                {
                    <button type="button"
                            class="app-dialog__close"
                            data-a11y-close
                            @onclick="CloseAsync"
                            aria-label="@CloseAriaLabel">×</button>
                }
            </header>
            <div class="app-dialog__body">@ChildContent</div>
            @if (Footer is not null)
            {
                <footer class="app-dialog__footer">@Footer</footer>
            }
        </section>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string CloseAriaLabel { get; set; } = "Close dialog";
    [Parameter] public string Size { get; set; } = "medium";
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string? Direction { get; set; }
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;
    [Parameter] public bool ShowCloseButton { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    private readonly string _instanceId = Guid.NewGuid().ToString("N");
    private string DialogId => $"app-dialog-{_instanceId}";
    private string TitleId => $"{DialogId}-title";
    private string SubtitleId => $"{DialogId}-description";
    private string? ExplicitAriaLabel => string.IsNullOrWhiteSpace(AriaLabel) ? null : AriaLabel;
    private string? LabelledById => string.IsNullOrWhiteSpace(AriaLabel) ? TitleId : null;
    private string? DescribedById => string.IsNullOrWhiteSpace(Subtitle) ? null : SubtitleId;
    private string? NormalizedDirection => Direction?.Trim().ToLowerInvariant() switch
    {
        "rtl" => "rtl",
        "ltr" => "ltr",
        "auto" => "auto",
        _ => null
    };

    private Task CloseAsync() => OpenChanged.InvokeAsync(false);
    private Task HandleBackdropAsync() => CloseOnBackdrop ? CloseAsync() : Task.CompletedTask;
}
