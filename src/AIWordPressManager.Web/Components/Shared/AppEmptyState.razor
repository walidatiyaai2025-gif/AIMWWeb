@if (Actions is null)
{
    <AppStatePanel Kind="empty"
                   Title="@Title"
                   Description="@Description"
                   RecoveryText="@RecoveryText"
                   RecoveryLabel="@RecoveryLabel"
                   Icon="@Icon"
                   Blocking="@Blocking"
                   Class="@StateClass" />
}
else
{
    <AppStatePanel Kind="empty"
                   Title="@Title"
                   Description="@Description"
                   RecoveryText="@RecoveryText"
                   RecoveryLabel="@RecoveryLabel"
                   Icon="@Icon"
                   Blocking="@Blocking"
                   Class="@StateClass">
        <Actions>@Actions</Actions>
    </AppStatePanel>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? RecoveryText { get; set; }
    [Parameter] public string RecoveryLabel { get; set; } = "Next:";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public bool Blocking { get; set; } = true;
    [Parameter] public RenderFragment? Actions { get; set; }

    private string StateClass => string.IsNullOrWhiteSpace(Class) ? "app-empty-state" : $"app-empty-state {Class}";
}
