@implements IDisposable
@inject AppNotificationService Notifications

<div class="global-notifications" aria-live="polite" aria-atomic="false">
    @foreach (var item in Notifications.Items)
    {
        <article class="global-notification @CssClass(item.Type)" role="@(item.Type == NotificationType.Error ? "alert" : "status")">
            <div class="global-notification-icon">@Icon(item.Type)</div>
            <div class="global-notification-body">
                <strong>@(item.Title ?? DefaultTitle(item.Type))</strong>
                <p>@item.Message</p>
                @if (!string.IsNullOrWhiteSpace(item.Details))
                {
                    <details><summary>Details</summary><pre>@item.Details</pre></details>
                }
            </div>
            <button type="button" class="global-notification-close" @onclick="() => Notifications.Dismiss(item.Id)" aria-label="Close">×</button>
        </article>
    }
</div>

<style>
.global-notifications{position:fixed;top:22px;right:22px;z-index:5000;display:flex;flex-direction:column;gap:12px;width:min(430px,calc(100vw - 32px));pointer-events:none}.global-notification{pointer-events:auto;display:grid;grid-template-columns:40px 1fr 30px;gap:12px;align-items:start;padding:16px;border:1px solid rgba(255,255,255,.14);border-radius:16px;background:#17191f;color:#fff;box-shadow:0 18px 45px rgba(0,0,0,.35);animation:notification-in .2s ease-out}.global-notification.success{border-left:4px solid #35c878}.global-notification.error{border-left:4px solid #ef5b5b}.global-notification.warning{border-left:4px solid #e9b949}.global-notification.info{border-left:4px solid #61a8ff}.global-notification-icon{width:36px;height:36px;display:grid;place-items:center;border-radius:12px;background:rgba(255,255,255,.08);font-size:18px}.global-notification-body strong{display:block;margin-bottom:4px;font-size:14px}.global-notification-body p{margin:0;color:#d7dae2;line-height:1.55;font-size:13px}.global-notification-body details{margin-top:8px}.global-notification-body pre{white-space:pre-wrap;max-height:180px;overflow:auto;font-size:11px}.global-notification-close{border:0;background:transparent;color:#aeb4c0;font-size:22px;cursor:pointer}.global-notification-close:hover{color:#fff}[dir="rtl"] .global-notifications{right:auto;left:22px}[dir="rtl"] .global-notification.success,[dir="rtl"] .global-notification.error,[dir="rtl"] .global-notification.warning,[dir="rtl"] .global-notification.info{border-left:1px solid rgba(255,255,255,.14);border-right-width:4px}@keyframes notification-in{from{opacity:0;transform:translateY(-8px) scale(.98)}to{opacity:1;transform:none}}@@media(max-width:600px){.global-notifications{top:12px;right:12px;left:12px;width:auto}[dir="rtl"] .global-notifications{right:12px;left:12px}}
</style>

@code {
    protected override void OnInitialized() => Notifications.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    private static string CssClass(NotificationType type) => type.ToString().ToLowerInvariant();
    private static string Icon(NotificationType type) => type switch { NotificationType.Success => "✓", NotificationType.Error => "!", NotificationType.Warning => "⚠", _ => "i" };
    private static string DefaultTitle(NotificationType type) => type switch { NotificationType.Success => "Success", NotificationType.Error => "Error", NotificationType.Warning => "Warning", _ => "Information" };
    public void Dispose() => Notifications.Changed -= OnChanged;
}
