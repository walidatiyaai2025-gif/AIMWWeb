@implements IDisposable
@inject AppNotificationService Notifications

<div class="global-notifications" aria-live="polite" aria-atomic="false">
    @foreach (var item in Notifications.Items)
    {
        <article class="global-notification @CssClass(item.Type)" role="@(item.Type == NotificationType.Error ? "alert" : "status")">
            <div class="global-notification-icon">@Icon(item.Type)</div>
            <div class="global-notification-body">
                <strong>@(item.Title ?? DefaultTitle(item.Type))</strong>
                <p>@item.Message</p>
                @if (item.Type == NotificationType.Error && !string.IsNullOrWhiteSpace(item.Details))
                {
                    <a class="notification-log-link" href="/logs">@(L.IsArabic ? "عرض التفاصيل في السجلات" : "View details in logs")</a>
                }
            </div>
            <button type="button" class="global-notification-close" @onclick="() => Notifications.Dismiss(item.Id)" aria-label="Close">×</button>
        </article>
    }
</div>

<style>
.global-notifications{position:fixed;top:18px;right:18px;z-index:5000;display:flex;flex-direction:column;gap:10px;width:min(390px,calc(100vw - 32px));pointer-events:none}.global-notification{pointer-events:auto;display:grid;grid-template-columns:36px 1fr 28px;gap:10px;align-items:start;padding:14px;border:1px solid rgba(255,255,255,.12);border-radius:14px;background:rgba(23,25,31,.96);backdrop-filter:blur(18px);color:#fff;box-shadow:0 16px 38px rgba(0,0,0,.28);animation:notification-in .18s ease-out}.global-notification.success{border-inline-start:4px solid #35c878}.global-notification.error{border-inline-start:4px solid #ef5b5b}.global-notification.warning{border-inline-start:4px solid #e9b949}.global-notification.info{border-inline-start:4px solid #61a8ff}.global-notification-icon{width:34px;height:34px;display:grid;place-items:center;border-radius:10px;background:rgba(255,255,255,.08);font-size:17px}.global-notification-body strong{display:block;margin-bottom:3px;font-size:14px}.global-notification-body p{margin:0;color:#d7dae2;line-height:1.5;font-size:13px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.notification-log-link{display:inline-flex;margin-top:8px;font-size:12px;font-weight:800;color:#93c5fd}.global-notification-close{border:0;background:transparent;color:#aeb4c0;font-size:21px;cursor:pointer}.global-notification-close:hover{color:#fff}[dir="rtl"] .global-notifications{right:auto;left:18px}@@keyframes notification-in{from{opacity:0;transform:translateY(-6px) scale(.985)}to{opacity:1;transform:none}}@@media(max-width:600px){.global-notifications{top:10px;right:10px;left:10px;width:auto}[dir="rtl"] .global-notifications{right:10px;left:10px}}@@media(prefers-reduced-motion:reduce){.global-notification{animation:none}}
</style>

@code {
    [Inject] private AppLanguageService L { get; set; } = default!;
    protected override void OnInitialized() => Notifications.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    private static string CssClass(NotificationType type) => type.ToString().ToLowerInvariant();
    private static string Icon(NotificationType type) => type switch { NotificationType.Success => "✓", NotificationType.Error => "!", NotificationType.Warning => "⚠", _ => "i" };
    private static string DefaultTitle(NotificationType type) => type switch { NotificationType.Success => "Success", NotificationType.Error => "Error", NotificationType.Warning => "Warning", _ => "Information" };
    public void Dispose() => Notifications.Changed -= OnChanged;
}
