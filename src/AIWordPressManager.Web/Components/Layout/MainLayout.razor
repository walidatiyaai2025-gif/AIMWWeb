@inherits LayoutComponentBase
@inject AppLanguageService L
@inject BuildInformationService BuildInfo
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject NavigationManager Navigation

<GlobalNotifications />

<a class="skip-link" href="#main-content">@(L.IsArabic ? "انتقل إلى المحتوى الرئيسي" : "Skip to main content")</a>

<div class="app-shell design-system-shell @(_sidebarCollapsed ? "sidebar-collapsed" : string.Empty)" dir="@L.Direction">
    <aside class="sidebar" aria-label="@(L.IsArabic ? "التنقل الرئيسي" : "Primary navigation")">
        <button type="button"
                class="responsive-sidebar-close"
                @onclick="ToggleSidebarAsync"
                aria-label="@(L.IsArabic ? "إغلاق قائمة التنقل" : "Close navigation")">
            <span aria-hidden="true">×</span>
        </button>

        <a class="brand" href="/" aria-label="@(L.IsArabic ? "العودة إلى لوحة التحكم" : "Go to dashboard")">
            <span class="brand-mark" aria-hidden="true">AI</span>
            <div><strong>@L["AppName"]</strong><small>@L["BlazorServer"]</small></div>
        </a>

        <nav id="primary-navigation" class="main-nav" aria-label="@(L.IsArabic ? "مساحات عمل التطبيق" : "Application workspaces")">
            @foreach (var group in VisibleGroups)
            {
                <details class="nav-section" open="@(ActiveGroup == group.Key)">
                    <summary class="nav-section-toggle" title="@(L.IsArabic ? group.ArabicDescription : group.EnglishDescription)">
                        <span>@(L.IsArabic ? group.ArabicName : group.EnglishName)</span>
                        <span class="nav-chevron" aria-hidden="true">⌄</span>
                    </summary>
                    <div class="nav-section-links">
                        @foreach (var item in group.Items.Where(IsVisibleSidebarItem))
                        {
                            <NavLink href="@item.Path"
                                     Match="@(item.Path == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                                     title="@(L.IsArabic ? item.ArabicDescription : item.EnglishDescription)">
                                <span aria-hidden="true">@item.Icon</span>
                                <span>@(L.IsArabic ? item.ArabicName : item.EnglishName)</span>
                            </NavLink>
                        }
                    </div>
                </details>
            }
        </nav>

        <div class="sidebar-footer">
            <div><span class="status-dot" aria-hidden="true"></span> @L["LocalSystemRunning"]</div>
            <a href="/about-build" class="app-version" aria-label="@(L.IsArabic ? $"الإصدار {Build.Version}" : $"Version {Build.Version}")">
                <strong>VERSION @(Build.Version)</strong>
                <small>@Build.Branch · @Build.Commit</small>
            </a>
        </div>
    </aside>

    <button type="button"
            class="responsive-nav-backdrop"
            @onclick="ToggleSidebarAsync"
            aria-label="@(L.IsArabic ? "إغلاق قائمة التنقل" : "Close navigation")"
            tabindex="-1"></button>

    <main class="main-area">
        <header class="topbar">
            <div class="topbar-title">
                <button type="button"
                        class="sidebar-toggle"
                        @onclick="ToggleSidebarAsync"
                        aria-label="@(L.IsArabic ? "إظهار أو إخفاء القائمة الجانبية" : "Toggle sidebar")"
                        aria-expanded="@(!_sidebarCollapsed)"
                        aria-controls="primary-navigation">
                    <span aria-hidden="true">☰</span>
                </button>
                <div class="topbar-heading-block">
                    <div class="app-breadcrumb" aria-label="@(L.IsArabic ? "مسار الصفحة" : "Breadcrumb")">
                        <span>@SectionTitle</span><b aria-hidden="true">›</b><strong>@PageTitle</strong>
                    </div>
                    <h2>@PageTitle</h2>
                    <small class="topbar-context">@PageDescription</small>
                </div>
            </div>
            <div class="topbar-actions">
                <button type="button"
                        class="recent-access-trigger"
                        @onclick="OpenRecentPagesAsync"
                        aria-label="@(L.IsArabic ? "فتح المفضلة والصفحات الأخيرة" : "Open favorites and recent pages")"
                        title="@(L.IsArabic ? "المفضلة والصفحات الأخيرة — Ctrl+Shift+P" : "Favorites and recent pages — Ctrl+Shift+P")">
                    <span aria-hidden="true">★</span>
                </button>
                <button id="command-palette-trigger"
                        type="button"
                        class="command-trigger"
                        @onclick="OpenCommandPalette"
                        aria-label="@(L.IsArabic ? "فتح البحث السريع" : "Open quick search")">
                    <span aria-hidden="true">⌕</span><em>@(L.IsArabic ? "بحث سريع" : "Quick search")</em><kbd>Ctrl K</kbd>
                </button>
                <a class="topbar-version" href="/about-build" aria-label="@(L.IsArabic ? $"معلومات الإصدار {Build.Version}" : $"Build information {Build.Version}")">v@(Build.Version) <span>• @Build.Branch</span></a>
                <button type="button" class="appearance-toggle" @onclick="ToggleAppearanceAsync" aria-label="@(L.IsArabic ? "تبديل الوضع الفاتح والداكن" : "Toggle light and dark mode")"><span aria-hidden="true">@(_appearanceMode == "light" ? "☀" : "☾")</span></button>
                <div class="theme-picker">
                    <button type="button" class="theme-trigger" @onclick="ToggleThemePicker" aria-expanded="@_themePickerOpen" aria-haspopup="true" aria-label="@(L.IsArabic ? "تغيير ألوان النظام" : "Change application colors")"><span aria-hidden="true">◈</span></button>
                    @if (_themePickerOpen)
                    {
                        <div class="theme-popover" role="group" aria-label="@(L.IsArabic ? "ألوان النظام" : "Application colors")">
                            <div class="theme-popover-head">
                                <div><strong>@(L.IsArabic ? "ألوان النظام" : "Application colors")</strong><small>@(L.IsArabic ? "اختر لوحة الألوان المناسبة لك" : "Choose your preferred color palette")</small></div>
                                <button type="button" class="theme-popover-close" @onclick="CloseThemePicker" aria-label="@(L.IsArabic ? "إغلاق اختيار الألوان" : "Close color picker")">×</button>
                            </div>
                            <div class="theme-grid">
                                @foreach (var theme in Themes)
                                {
                                    <button type="button"
                                            class="theme-swatch @(_selectedTheme == theme.Key ? "active" : string.Empty)"
                                            style="--swatch:@theme.Color"
                                            @onclick="() => SelectThemeAsync(theme.Key)"
                                            aria-pressed="@(_selectedTheme == theme.Key)">
                                        <span class="theme-swatch-dot" aria-hidden="true"></span>
                                        <span>@(L.IsArabic ? theme.ArabicName : theme.EnglishName)</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
                <button type="button" class="language-switch" onclick="window.appLanguage.toggleAndReload(); return false;" aria-label="@(L.IsArabic ? "Switch to English" : "التبديل إلى العربية")"><span aria-hidden="true">🌐</span><span class="language-label">@L["SwitchLanguage"]</span></button>
                <CurrentUserChip />
            </div>
        </header>
        <section class="content" id="main-content" tabindex="-1">@Body</section>
    </main>
</div>

@if (_commandOpen)
{
    <div class="command-overlay" @onclick="CloseCommandPalette">
        <section class="command-dialog navigation-command-dialog" role="dialog" aria-modal="true" aria-label="@(L.IsArabic ? "البحث السريع" : "Quick search")" @onclick:stopPropagation="true">
            <header>
                <span aria-hidden="true">⌕</span>
                <input autofocus
                       @bind="_commandQuery"
                       @bind:event="oninput"
                       aria-label="@(L.IsArabic ? "ابحث عن صفحة أو وظيفة" : "Search pages and capabilities")"
                       placeholder="@(L.IsArabic ? "ابحث بالاسم أو الوظيفة أو المسار..." : "Search by name, capability, or route...")" />
                <button type="button" @onclick="CloseCommandPalette" aria-label="@(L.IsArabic ? "إغلاق البحث" : "Close search")">Esc</button>
            </header>
            <div class="command-results navigation-command-results">
                @if (!CommandGroupResults.Any())
                {
                    <div class="command-empty">
                        <strong>@(L.IsArabic ? "لا توجد نتيجة مطابقة" : "No matching destination")</strong>
                        <small>@(L.IsArabic ? "جرّب اسم الصفحة أو المهمة التي تريد تنفيذها." : "Try the page name or the task you want to perform.")</small>
                    </div>
                }
                else
                {
                    @foreach (var result in CommandGroupResults)
                    {
                        <section class="command-group" aria-label="@(L.IsArabic ? result.Group.ArabicName : result.Group.EnglishName)">
                            <header class="command-group-heading">
                                <div>
                                    <strong>@(L.IsArabic ? result.Group.ArabicName : result.Group.EnglishName)</strong>
                                    <small>@(L.IsArabic ? result.Group.ArabicDescription : result.Group.EnglishDescription)</small>
                                </div>
                                <span>@result.Items.Count</span>
                            </header>
                            @foreach (var item in result.Items)
                            {
                                <button type="button" class="command-item navigation-command-item" @onclick="() => RunCommand(item)">
                                    <span aria-hidden="true">@item.Icon</span>
                                    <div>
                                        <strong>@(L.IsArabic ? item.ArabicName : item.EnglishName)</strong>
                                        <small>@(L.IsArabic ? item.ArabicDescription : item.EnglishDescription)</small>
                                    </div>
                                    <code>@item.Path</code>
                                    <kbd>↵</kbd>
                                </button>
                            }
                        </section>
                    }
                }
            </div>
            <footer>
                <span>↑↓ @(L.IsArabic ? "للتصفح" : "navigate")</span>
                <span>Enter @(L.IsArabic ? "للفتح" : "open")</span>
                <span>Esc @(L.IsArabic ? "للإغلاق" : "close")</span>
                <button type="button" class="command-recent-link" @onclick="OpenRecentFromCommandAsync">★ @(L.IsArabic ? "المفضلة والأخيرة" : "Favorites & recent")</button>
            </footer>
        </section>
    </div>
}

@code {
    private BuildInformation Build => BuildInfo.Current;
    private string CurrentPath => new Uri(Navigation.Uri).AbsolutePath;
    private AppNavigationItem? CurrentItem => AppNavigationCatalog.FindItem(CurrentPath, _isAdministrator);
    private AppNavigationGroup? CurrentGroup => AppNavigationCatalog.FindGroup(CurrentPath, _isAdministrator);
    private string ActiveGroup => CurrentGroup?.Key ?? "system";
    private string SectionTitle => CurrentGroup is null
        ? (L.IsArabic ? "النظام" : "System")
        : (L.IsArabic ? CurrentGroup.ArabicName : CurrentGroup.EnglishName);
    private string PageTitle => CurrentItem is null
        ? (L.IsArabic ? "مساحة العمل" : "Workspace")
        : (L.IsArabic ? CurrentItem.ArabicName : CurrentItem.EnglishName);
    private string PageDescription => CurrentItem is null
        ? (L.IsArabic ? "مساحة عمل داخل AI WordPress Manager." : "AI WordPress Manager workspace.")
        : (L.IsArabic ? CurrentItem.ArabicDescription : CurrentItem.EnglishDescription);

    private IEnumerable<AppNavigationGroup> VisibleGroups =>
        AppNavigationCatalog.Groups.Where(group => group.Items.Any(IsVisibleSidebarItem));

    private IEnumerable<AppNavigationItem> CommandItems =>
        AppNavigationCatalog.VisibleItems(_isAdministrator)
            .Where(item => item.MatchesSearch(_commandQuery));

    private IEnumerable<CommandGroupResult> CommandGroupResults =>
        AppNavigationCatalog.Groups
            .Select(group => new CommandGroupResult(
                group,
                CommandItems.Where(item => item.GroupKey == group.Key).ToArray()))
            .Where(result => result.Items.Count > 0);

    private bool _themePickerOpen;
    private bool _sidebarCollapsed;
    private bool _commandOpen;
    private bool _isAdministrator;
    private string _commandQuery = string.Empty;
    private string _selectedTheme = "gold";
    private string _appearanceMode = "dark";

    private static readonly ThemeOption[] Themes =
    [
        new("gold", "Gold", "ذهبي", "#c5a45d"),
        new("ocean", "Ocean", "أزرق", "#3b82f6"),
        new("emerald", "Emerald", "زمردي", "#10b981"),
        new("violet", "Violet", "بنفسجي", "#8b5cf6"),
        new("rose", "Rose", "وردي", "#f43f5e"),
        new("amber", "Amber", "كهرماني", "#f59e0b"),
        new("cyan", "Cyan", "سماوي", "#06b6d4"),
        new("slate", "Slate", "رمادي", "#94a3b8")
    ];

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isAdministrator = authenticationState.User.IsInRole("Administrator");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var culture = await JS.InvokeAsync<string?>("appLanguage.get");
        L.SetCulture(culture == "ar" ? "ar" : "en");
        await JS.InvokeVoidAsync("appLanguage.apply", L.Culture, L.Direction);
        _selectedTheme = await JS.InvokeAsync<string>("appTheme.get");
        _appearanceMode = await JS.InvokeAsync<string>("appTheme.getMode");
        _sidebarCollapsed = await JS.InvokeAsync<bool>("appTheme.getSidebarCollapsed");
        await SyncRecentNavigationCatalogAsync();
        StateHasChanged();
    }

    private bool IsVisibleSidebarItem(AppNavigationItem item) =>
        item.ShowInSidebar && (!item.AdministratorOnly || _isAdministrator);

    private async Task SyncRecentNavigationCatalogAsync()
    {
        var items = AppNavigationCatalog.VisibleItems(_isAdministrator)
            .Select(item => new
            {
                path = item.Path,
                english = item.EnglishName,
                arabic = item.ArabicName,
                icon = item.Icon
            })
            .ToArray();

        await JS.InvokeVoidAsync("aiwmRecentPages.setCatalog", items);
    }

    private void ToggleThemePicker() => _themePickerOpen = !_themePickerOpen;
    private void CloseThemePicker() => _themePickerOpen = false;

    private async Task SelectThemeAsync(string theme)
    {
        _selectedTheme = await JS.InvokeAsync<string>("appTheme.set", theme);
        _themePickerOpen = false;
    }

    private async Task ToggleAppearanceAsync() =>
        _appearanceMode = await JS.InvokeAsync<string>("appTheme.toggleMode");

    private async Task ToggleSidebarAsync()
    {
        _sidebarCollapsed = !_sidebarCollapsed;
        await JS.InvokeVoidAsync("appTheme.setSidebarCollapsed", _sidebarCollapsed);
    }

    private async Task OpenRecentPagesAsync() =>
        await JS.InvokeVoidAsync("aiwmRecentPages.open");

    private void OpenCommandPalette()
    {
        _commandQuery = string.Empty;
        _commandOpen = true;
        _themePickerOpen = false;
    }

    private void CloseCommandPalette() => _commandOpen = false;

    private async Task OpenRecentFromCommandAsync()
    {
        _commandOpen = false;
        await OpenRecentPagesAsync();
    }

    private void RunCommand(AppNavigationItem item)
    {
        _commandOpen = false;
        Navigation.NavigateTo(item.Path);
    }

    private sealed record ThemeOption(string Key, string EnglishName, string ArabicName, string Color);
    private sealed record CommandGroupResult(AppNavigationGroup Group, IReadOnlyList<AppNavigationItem> Items);
}