@inherits LayoutComponentBase
@implements IDisposable
@inject AppLanguageService L
@inject BuildInformationService BuildInfo
@inject IJSRuntime JS

<GlobalNotifications />

<div class="app-shell" dir="@L.Direction">
    <aside class="sidebar">
        <div class="brand"><span class="brand-mark">AI</span><div><strong>@L["AppName"]</strong><small>@L["BlazorServer"]</small></div></div>
        <nav class="main-nav">
            <div class="nav-section">
                <span class="nav-section-title">@(L.IsArabic ? "الرئيسية" : "OVERVIEW")</span>
                <NavLink href="/" Match="NavLinkMatch.All"><span>⌂</span> @L["Dashboard"]</NavLink>
                <NavLink href="/sites"><span>◉</span> @L["Sites"]</NavLink>
                <NavLink href="/module/overview"><span>▦</span> @(L.IsArabic ? "مركز النظام" : "System Overview")</NavLink>
            </div>

            <div class="nav-section">
                <span class="nav-section-title">@(L.IsArabic ? "إدارة المحتوى" : "CONTENT")</span>
                <NavLink href="/module/posts"><span>▤</span> @L["Posts"]</NavLink>
                <NavLink href="/module/pages"><span>▧</span> @L["Pages"]</NavLink>
                <NavLink href="/module/media"><span>▣</span> @L["MediaManager"]</NavLink>
                <NavLink href="/module/taxonomy"><span>#</span> @L["CategoriesTags"]</NavLink>
                <NavLink href="/module/comments"><span>◌</span> @L["Comments"]</NavLink>
                <NavLink href="/module/users"><span>◎</span> @L["UsersManager"]</NavLink>
            </div>

            <div class="nav-section">
                <span class="nav-section-title">SEO</span>
                <NavLink href="/module/seo-audit"><span>◈</span> @L["SeoManager"]</NavLink>
                <NavLink href="/module/seo-suggestions"><span>✦</span> @(L.IsArabic ? "اقتراحات التحسين" : "Suggestions")</NavLink>
                <NavLink href="/module/approvals"><span>✓</span> @(L.IsArabic ? "قائمة الموافقات" : "Approval Queue")</NavLink>
            </div>

            <div class="nav-section">
                <span class="nav-section-title">@(L.IsArabic ? "الذكاء الاصطناعي" : "AI WORKSPACE")</span>
                <NavLink href="/module/ai-providers"><span>✦</span> @(L.IsArabic ? "مزودو الذكاء" : "AI Providers")</NavLink>
                <NavLink href="/module/prompts"><span>⌘</span> @(L.IsArabic ? "قوالب الأوامر" : "Prompt Templates")</NavLink>
            </div>

            <div class="nav-section">
                <span class="nav-section-title">@(L.IsArabic ? "التشغيل والأتمتة" : "OPERATIONS")</span>
                <NavLink href="/module/execution"><span>▶</span> @(L.IsArabic ? "مركز التنفيذ" : "Execution Center")</NavLink>
                <NavLink href="/module/sync"><span>↻</span> @L["ContentSync"]</NavLink>
                <NavLink href="/module/schedules"><span>◷</span> @(L.IsArabic ? "الجدولة" : "Schedules")</NavLink>
            </div>

            <div class="nav-section">
                <span class="nav-section-title">@(L.IsArabic ? "التقارير" : "REPORTS")</span>
                <NavLink href="/module/reports"><span>▥</span> @(L.IsArabic ? "التقارير والتصدير" : "Reports & Exports")</NavLink>
            </div>

            <div class="nav-section">
                <span class="nav-section-title">@(L.IsArabic ? "النظام" : "SYSTEM")</span>
                <NavLink href="/system-health"><span>♥</span> @(L.IsArabic ? "صحة النظام" : "System Health")</NavLink>
                <NavLink href="/module/logs"><span>≡</span> @(L.IsArabic ? "السجلات والأخطاء" : "Logs & Errors")</NavLink>
                <NavLink href="/module/backups"><span>⬡</span> @(L.IsArabic ? "النسخ الاحتياطي" : "Backup & Restore")</NavLink>
                <NavLink href="/settings"><span>⚙</span> @L["Settings"]</NavLink>
                <NavLink href="/about-build"><span>ⓘ</span> @(L.IsArabic ? "معلومات الإصدار" : "Build Information")</NavLink>
            </div>
        </nav>
        <div class="sidebar-footer">
            <div><span class="status-dot"></span> @L["LocalSystemRunning"]</div>
            <a href="/about-build" class="app-version"><strong>VERSION @Build.Version</strong><small>@Build.Branch · @Build.Commit</small></a>
        </div>
    </aside>
    <main class="main-area">
        <header class="topbar">
            <div><h2>@L["AppName"]</h2><p>@L["BrowserManagement"]</p></div>
            <div class="topbar-actions">
                <a class="topbar-version" href="/about-build">v@Build.Version</a>
                <button class="language-switch" @onclick="ToggleLanguage" title="@L["Language"]">🌐 @L["SwitchLanguage"]</button>
                <div class="user-chip"><span>WA</span><div><strong>@L["Administrator"]</strong><small>@L["LocalAccount"]</small></div></div>
            </div>
        </header>
        <section class="content">@Body</section>
    </main>
</div>

@code {
    private BuildInformation Build => BuildInfo.Current;
    protected override void OnInitialized() => L.Changed += OnLanguageChanged;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var culture = await JS.InvokeAsync<string>("appLanguage.get");
        L.SetCulture(culture);
        await JS.InvokeVoidAsync("appLanguage.apply", L.Culture, L.Direction);
    }
    private async Task ToggleLanguage()
    {
        L.SetCulture(L.IsArabic ? "en" : "ar");
        await JS.InvokeVoidAsync("appLanguage.set", L.Culture);
        await JS.InvokeVoidAsync("appLanguage.apply", L.Culture, L.Direction);
    }
    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= OnLanguageChanged;
}
