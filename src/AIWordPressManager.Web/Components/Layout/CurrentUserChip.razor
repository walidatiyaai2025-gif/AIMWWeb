@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using AIWordPressManager.Domain.Entities
@using AIWordPressManager.Web.Diagnostics
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AppLanguageService L
@inject BuildInformationService BuildInfo
@inject SiteWebService SitesService
@inject CurrentUserContext CurrentUser
@inject ILogger<CurrentUserChip> Logger
@inject IJSRuntime JS
@inject NavigationManager Navigation

<QuickActions />
<NotificationCenter />

<details class="account-menu">
    <summary class="account-trigger" title="@(L.IsArabic ? "قائمة الحساب" : "Account menu")">
        <span class="user-avatar">@Initials</span>
        <span class="user-details">
            <strong>@UserName</strong>
            <small>@Role</small>
        </span>
        @if (!string.IsNullOrWhiteSpace(_siteLoadError))
        {
            <span class="account-chevron" style="color:#ef4444;font-weight:800" title="@_siteLoadError">!</span>
        }
        else
        {
            <span class="account-chevron">⌄</span>
        }
    </summary>

    <section class="account-popover">
        <header class="account-profile">
            <span class="account-avatar-large">@Initials</span>
            <div>
                <strong>@UserName</strong>
                <small>@Role</small>
                <em>@(_isAuthenticated
                    ? (L.IsArabic ? "جلسة تطبيق مصادق عليها" : "Authenticated application session")
                    : (L.IsArabic ? "جلسة تطبيق غير مصادق عليها" : "Unauthenticated application session"))</em>
            </div>
        </header>

        <div class="workspace-switcher">
            <label for="active-workspace">@(L.IsArabic ? "مساحة عمل الموقع" : "Site workspace")</label>
            @if (_loadingSites)
            {
                <div class="workspace-loading">@(L.IsArabic ? "جارٍ تحميل المواقع..." : "Loading sites...")</div>
            }
            else if (!string.IsNullOrWhiteSpace(_siteLoadError))
            {
                <div role="alert" style="padding:.65rem;border:1px solid #ef444466;border-radius:8px;background:#7f1d1d33;color:#fecaca;font-size:.78rem;word-break:break-word">
                    <strong>@(L.IsArabic ? "خطأ Runtime:" : "Runtime error:")</strong>
                    <div>@_siteLoadError</div>
                    <a href="/logs" style="color:inherit;text-decoration:underline">@(L.IsArabic ? "فتح السجلات" : "Open logs")</a>
                </div>
            }
            else if (_sites.Count == 0)
            {
                <a class="workspace-empty" href="/sites/connect">＋ @(L.IsArabic ? "أضف موقعك الأول" : "Connect your first site")</a>
            }
            else
            {
                <select id="active-workspace" value="@SelectedSiteValue" @onchange="ChangeWorkspaceAsync">
                    <option value="">@(L.IsArabic ? "كل المواقع" : "All sites")</option>
                    @foreach (var site in _sites)
                    {
                        <option value="@site.Id">@site.Name</option>
                    }
                </select>
                @if (_activeSite is not null)
                {
                    <div class="workspace-current">
                        <span>●</span>
                        <strong>@_activeSite.Name</strong>
                    </div>
                    <div class="workspace-actions">
                        <a href="/sites/@_activeSite.Id">@(L.IsArabic ? "لوحة الموقع" : "Site dashboard")</a>
                        <a href="/sites/@_activeSite.Id/explorer">@(L.IsArabic ? "المحتوى" : "Content")</a>
                        <a href="/sites/@_activeSite.Id/settings">@(L.IsArabic ? "الإعدادات" : "Settings")</a>
                    </div>
                }
            }
        </div>

        <div class="account-meta">
            <div><span>◉</span><div><small>@(L.IsArabic ? "الجلسة" : "Session")</small><strong>@(_isAuthenticated ? (L.IsArabic ? "تم تسجيل الدخول" : "Signed in") : (L.IsArabic ? "غير مصادق" : "Not authenticated"))</strong></div></div>
            <div><span>ⓘ</span><div><small>@(L.IsArabic ? "الإصدار" : "Version")</small><strong>@BuildInfo.Current.Version</strong></div></div>
        </div>

        <nav class="account-links">
            <a href="/account/profile"><span>◎</span><div><strong>@(L.IsArabic ? "حسابي" : "My account")</strong><small>@(L.IsArabic ? "الملف الشخصي وكلمة المرور" : "Profile and password")</small></div><b>›</b></a>
            <a href="/settings"><span>⚙</span><div><strong>@(L.IsArabic ? "الإعدادات" : "Settings")</strong><small>@(L.IsArabic ? "اللغة والمظهر والتفضيلات" : "Language, appearance and preferences")</small></div><b>›</b></a>
            <a href="/about-build"><span>ⓘ</span><div><strong>@(L.IsArabic ? "معلومات الإصدار" : "Build information")</strong><small>@(L.IsArabic ? "الفرع والنسخة وتفاصيل البناء" : "Branch, version and build details")</small></div><b>›</b></a>
            <a href="/system-health"><span>♥</span><div><strong>@(L.IsArabic ? "صحة النظام" : "System health")</strong><small>@(L.IsArabic ? "فحص الخدمات وقاعدة البيانات" : "Services and database status")</small></div><b>›</b></a>
        </nav>

        <form method="post" action="/logout" class="account-logout-form">
            <button type="submit" class="account-logout"><span>↪</span><div><strong>@(L.IsArabic ? "تسجيل الخروج" : "Sign out")</strong><small>@(L.IsArabic ? "إنهاء الجلسة الحالية بأمان" : "End the current session securely")</small></div></button>
        </form>
    </section>
</details>

@code {
    private readonly List<Site> _sites = [];
    private Site? _activeSite;
    private bool _loadingSites = true;
    private bool _workspaceRestored;
    private bool _isAuthenticated;
    private string? _siteLoadError;
    private string UserName { get; set; } = "User";
    private string Role { get; set; } = "User";
    private string Initials => string.Concat(UserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
    private string SelectedSiteValue => _activeSite?.Id.ToString() ?? string.Empty;
    private string StorageKey => $"aiwm.workspace.{UserName.ToLowerInvariant()}";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var principal = state.User;
        CurrentUser.SetCircuitPrincipal(principal);
        _isAuthenticated = principal.Identity?.IsAuthenticated == true;
        UserName = principal.Identity?.Name ?? "User";
        Role = principal.FindFirstValue(ClaimTypes.Role) ?? "User";

        try
        {
            _sites.AddRange(await SitesService.GetSitesAsync());
        }
        catch (Exception ex)
        {
            _siteLoadError = $"{ex.GetType().Name}: {RuntimeLogRedactor.Redact(ex.Message)}";
            Logger.LogError(ex, "Current user site workspace failed to load. The account widget remains available in diagnostic mode.");
        }
        finally
        {
            _loadingSites = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _workspaceRestored || _sites.Count == 0)
            return;

        _workspaceRestored = true;
        var savedValue = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
        if (Guid.TryParse(savedValue, out var savedSiteId))
            _activeSite = _sites.FirstOrDefault(x => x.Id == savedSiteId);

        StateHasChanged();
    }

    private async Task ChangeWorkspaceAsync(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        if (!Guid.TryParse(value, out var siteId))
        {
            _activeSite = null;
            await JS.InvokeVoidAsync("localStorage.removeItem", StorageKey);
            Navigation.NavigateTo(RemoveSiteQuery(CurrentRelativePath()));
            return;
        }

        _activeSite = _sites.FirstOrDefault(x => x.Id == siteId);
        if (_activeSite is null)
            return;

        await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, _activeSite.Id.ToString());
        Navigation.NavigateTo(BuildWorkspaceDestination(_activeSite.Id));
    }

    private string BuildWorkspaceDestination(Guid siteId)
    {
        var path = CurrentRelativePath();

        if (path.StartsWith("/sites/", StringComparison.OrdinalIgnoreCase))
        {
            var segments = path.Split('?', 2)[0].Split('/', StringSplitOptions.RemoveEmptyEntries);
            if (segments.Length >= 2 && Guid.TryParse(segments[1], out _))
            {
                var suffix = segments.Length > 2 ? "/" + string.Join('/', segments.Skip(2)) : string.Empty;
                return $"/sites/{siteId}{suffix}";
            }
        }

        if (path.StartsWith("/module/", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("/content", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("/operations", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("/site-operations", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("/site-reliability", StringComparison.OrdinalIgnoreCase))
        {
            return AddOrReplaceSiteQuery(path, siteId);
        }

        return $"/sites/{siteId}";
    }

    private string CurrentRelativePath()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        return "/" + relative.TrimStart('/');
    }

    private static string AddOrReplaceSiteQuery(string relativePath, Guid siteId)
    {
        var split = relativePath.Split('?', 2);
        var basePath = split[0];
        var query = split.Length > 1
            ? Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(split[1])
                .Where(x => !string.Equals(x.Key, "siteId", StringComparison.OrdinalIgnoreCase))
                .SelectMany(x => x.Value.Select(value => new KeyValuePair<string, string?>(x.Key, value)))
                .ToDictionary(x => x.Key, x => x.Value)
            : new Dictionary<string, string?>();

        query["siteId"] = siteId.ToString();
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(basePath, query);
    }

    private static string RemoveSiteQuery(string relativePath)
    {
        var split = relativePath.Split('?', 2);
        if (split.Length == 1)
            return relativePath.StartsWith("/sites/", StringComparison.OrdinalIgnoreCase) ? "/sites" : relativePath;

        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(split[1])
            .Where(x => !string.Equals(x.Key, "siteId", StringComparison.OrdinalIgnoreCase))
            .SelectMany(x => x.Value.Select(value => new KeyValuePair<string, string?>(x.Key, value)))
            .ToDictionary(x => x.Key, x => x.Value);

        return query.Count == 0 ? split[0] : Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(split[0], query);
    }
}
