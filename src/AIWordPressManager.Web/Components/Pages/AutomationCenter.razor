@page "/automation-center"
@page "/module/schedules"
@rendermode InteractiveServer
@implements IDisposable
@inject AutomationCenterService Automation
@inject SiteWebService Sites
@inject AppLanguageService L

<PageTitle>@(L.IsArabic ? "مركز الأتمتة" : "Automation Center")</PageTitle>

<div class="automation-page">
    <section class="automation-hero panel">
        <div>
            <span class="workspace-kicker">@(L.IsArabic ? "التشغيل التلقائي" : "AUTOMATION")</span>
            <h1>◷ @(L.IsArabic ? "مركز الأتمتة" : "Automation Center")</h1>
            <p>@(L.IsArabic ? "أنشئ مهام دورية للمزامنة وSEO والنسخ الاحتياطي واربطها بمركز التنفيذ." : "Schedule synchronization, SEO, backup, and maintenance jobs through the execution center.")</p>
        </div>
        <button class="btn btn-primary" @onclick="NewJob">＋ @(L.IsArabic ? "مهمة جديدة" : "New automation")</button>
    </section>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="automation-message @(_isError ? "error" : "success")">@_message</div>
    }

    <section class="automation-stats">
        <article class="panel"><small>@(L.IsArabic ? "إجمالي المهام" : "Total jobs")</small><strong>@_jobs.Count</strong></article>
        <article class="panel"><small>@(L.IsArabic ? "نشطة" : "Enabled")</small><strong>@_jobs.Count(x => x.Enabled)</strong></article>
        <article class="panel"><small>@(L.IsArabic ? "فاشلة" : "Failed")</small><strong>@_jobs.Count(x => x.LastStatus == "Failed")</strong></article>
        <article class="panel"><small>@(L.IsArabic ? "التشغيل القادم" : "Next run")</small><strong class="small-value">@FormatNextRun()</strong></article>
    </section>

    <section class="automation-grid">
        <article class="panel automation-form">
            <header><h2>@(_model.Id == Guid.Empty ? (L.IsArabic ? "إضافة مهمة" : "Add automation") : (L.IsArabic ? "تعديل المهمة" : "Edit automation"))</h2></header>
            <label>@(L.IsArabic ? "اسم المهمة" : "Job name")<input @bind="_model.Name" placeholder="@(L.IsArabic ? "مزامنة الموقع اليومية" : "Daily site synchronization")" /></label>
            <label>@(L.IsArabic ? "الموقع" : "Site")
                <select @bind="_selectedSiteId" @onchange="SiteChanged">
                    <option value="">@(L.IsArabic ? "اختر موقعًا" : "Select a site")</option>
                    @foreach (var site in _sites)
                    {
                        <option value="@site.Id">@site.Name</option>
                    }
                </select>
            </label>
            <label>@(L.IsArabic ? "نوع المهمة" : "Job type")
                <select @bind="_model.Type">
                    <option value="Synchronization">@(L.IsArabic ? "مزامنة الموقع" : "Site synchronization")</option>
                    <option value="SEO Audit">@(L.IsArabic ? "تدقيق SEO" : "SEO audit")</option>
                    <option value="Backup">@(L.IsArabic ? "نسخ احتياطي" : "Backup")</option>
                    <option value="Media Cleanup">@(L.IsArabic ? "تنظيف الوسائط" : "Media cleanup")</option>
                    <option value="Plugin Updates">@(L.IsArabic ? "تحديث الإضافات" : "Plugin updates")</option>
                </select>
            </label>
            <div class="automation-row">
                <label>@(L.IsArabic ? "التكرار" : "Frequency")
                    <select @bind="_model.Frequency">
                        <option value="hourly">@(L.IsArabic ? "كل عدد ساعات" : "Every N hours")</option>
                        <option value="daily">@(L.IsArabic ? "يومي" : "Daily")</option>
                        <option value="weekly">@(L.IsArabic ? "أسبوعي" : "Weekly")</option>
                        <option value="monthly">@(L.IsArabic ? "شهري" : "Monthly")</option>
                    </select>
                </label>
                <label>@(L.IsArabic ? "كل" : "Interval")<input type="number" min="1" max="365" @bind="_model.IntervalValue" /></label>
            </div>
            <div class="automation-row">
                <label>@(L.IsArabic ? "وقت التشغيل UTC" : "Run time UTC")<input type="time" @bind="_model.TimeOfDay" /></label>
                <label>@(L.IsArabic ? "المحاولات" : "Retries")<input type="number" min="0" max="10" @bind="_model.RetryCount" /></label>
            </div>
            <label class="automation-check"><input type="checkbox" @bind="_model.Enabled" /> @(L.IsArabic ? "المهمة مفعلة" : "Automation enabled")</label>
            <div class="automation-actions">
                <button class="btn btn-primary" @onclick="SaveAsync">@(L.IsArabic ? "حفظ المهمة" : "Save automation")</button>
                <button class="btn" @onclick="NewJob">@(L.IsArabic ? "إلغاء" : "Cancel")</button>
            </div>
        </article>

        <article class="panel automation-list-card">
            <header><div><h2>@(L.IsArabic ? "المهام المجدولة" : "Scheduled jobs")</h2><small>@(L.IsArabic ? "يتم الفحص تلقائيًا كل دقيقة" : "Scheduler checks every minute")</small></div><button class="btn" @onclick="Reload">↻</button></header>
            @if (_jobs.Count == 0)
            {
                <div class="automation-empty">@(L.IsArabic ? "لا توجد مهام مجدولة بعد." : "No scheduled automations yet.")</div>
            }
            else
            {
                <div class="automation-jobs">
                    @foreach (var job in _jobs)
                    {
                        <div class="automation-job">
                            <div class="automation-job-main"><span class="automation-state @(job.Enabled ? "on" : "off")"></span><div><strong>@job.Name</strong><small>@job.SiteName · @job.Type</small></div></div>
                            <div><small>@(L.IsArabic ? "التشغيل القادم" : "Next run")</small><strong>@FormatDate(job.NextRunUtc)</strong></div>
                            <span class="badge @(job.LastStatus == "Failed" ? "danger" : "success")">@job.LastStatus</span>
                            <div class="automation-job-actions">
                                <button class="icon-button" title="Edit" @onclick="() => Edit(job)">✎</button>
                                <button class="icon-button" title="Toggle" @onclick="() => Toggle(job)">@(job.Enabled ? "Ⅱ" : "▶")</button>
                                <button class="icon-button danger" title="Delete" @onclick="() => Delete(job.Id)">×</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </article>
    </section>

    <section class="panel automation-history">
        <header><h2>@(L.IsArabic ? "سجل التشغيل" : "Run history")</h2><a href="/execution-center">@(L.IsArabic ? "فتح مركز التنفيذ" : "Open execution center")</a></header>
        @if (_history.Count == 0)
        {
            <div class="automation-empty">@(L.IsArabic ? "لم تُشغّل أي مهمة بعد." : "No automation runs yet.")</div>
        }
        else
        {
            @foreach (var item in _history.Take(20))
            {
                <div class="history-row"><span class="job-state @(item.Status == "Failed" ? "failed" : "success")">@(item.Status == "Failed" ? "!" : "✓")</span><div><strong>@item.JobName</strong><small>@item.Message</small></div><time>@FormatDate(item.StartedAtUtc)</time><span class="badge">@item.Status</span></div>
            }
        }
    </section>
</div>

<style>
.automation-page{display:grid;gap:18px}.automation-hero{display:flex;justify-content:space-between;align-items:center;padding:24px}.automation-hero h1{margin:5px 0}.automation-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.automation-stats article{padding:18px;display:grid;gap:6px}.automation-stats strong{font-size:28px}.automation-stats .small-value{font-size:15px}.automation-grid{display:grid;grid-template-columns:minmax(300px,380px) 1fr;gap:18px}.automation-form,.automation-list-card,.automation-history{padding:20px}.automation-form{display:grid;gap:14px}.automation-form label{display:grid;gap:6px;font-weight:600}.automation-form input,.automation-form select{width:100%;padding:11px 12px;border:1px solid var(--border-color,#d7dce5);border-radius:10px;background:var(--surface,#fff);font-family:Cairo,sans-serif}.automation-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.automation-check{display:flex!important;align-items:center;gap:8px}.automation-check input{width:auto}.automation-actions{display:flex;gap:8px}.automation-list-card header,.automation-history header{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}.automation-jobs{display:grid;gap:10px}.automation-job{display:grid;grid-template-columns:minmax(220px,1fr) 170px 90px 110px;gap:12px;align-items:center;padding:13px;border:1px solid var(--border-color,#e1e5ec);border-radius:12px}.automation-job-main{display:flex;align-items:center;gap:10px}.automation-job-main div,.automation-job>div{display:grid}.automation-job small,.history-row small{opacity:.68}.automation-state{width:9px;height:9px;border-radius:50%}.automation-state.on{background:#21a366}.automation-state.off{background:#9ca3af}.automation-job-actions{display:flex!important;gap:5px}.automation-empty{padding:30px;text-align:center;opacity:.65}.history-row{display:grid;grid-template-columns:34px 1fr 180px 90px;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid var(--border-color,#e6e9ef)}.history-row>div{display:grid}.automation-message{padding:12px 16px;border-radius:10px}.automation-message.success{background:#e9f8ef;color:#167344}.automation-message.error{background:#fdecec;color:#a72828}@media(max-width:1050px){.automation-stats{grid-template-columns:repeat(2,1fr)}.automation-grid{grid-template-columns:1fr}.automation-job{grid-template-columns:1fr 160px 90px}}@media(max-width:700px){.automation-hero{align-items:flex-start;gap:14px;flex-direction:column}.automation-stats{grid-template-columns:1fr}.automation-row{grid-template-columns:1fr}.automation-job{grid-template-columns:1fr}.history-row{grid-template-columns:34px 1fr}.history-row time,.history-row>.badge{grid-column:2}}
</style>

@code {
    private List<AIWordPressManager.Domain.Entities.Site> _sites = [];
    private List<AutomationJob> _jobs = [];
    private List<AutomationHistoryItem> _history = [];
    private AutomationJobEditModel _model = new();
    private string _selectedSiteId = string.Empty;
    private string _message = string.Empty;
    private bool _isError;

    protected override void OnInitialized() => L.Changed += LanguageChanged;
    protected override async Task OnInitializedAsync()
    {
        _sites = await Sites.GetSitesAsync();
        Reload();
    }

    private void Reload()
    {
        _jobs = Automation.GetJobs().ToList();
        _history = Automation.GetHistory().ToList();
    }

    private void SiteChanged(ChangeEventArgs args)
    {
        _selectedSiteId = args.Value?.ToString() ?? string.Empty;
        if (Guid.TryParse(_selectedSiteId, out var id))
        {
            var site = _sites.FirstOrDefault(x => x.Id == id);
            _model.SiteId = id;
            _model.SiteName = site?.Name ?? string.Empty;
        }
    }

    private Task SaveAsync()
    {
        try
        {
            if (Guid.TryParse(_selectedSiteId, out var siteId))
            {
                _model.SiteId = siteId;
                _model.SiteName = _sites.FirstOrDefault(x => x.Id == siteId)?.Name ?? string.Empty;
            }
            Automation.Save(_model);
            _message = L.IsArabic ? "تم حفظ المهمة المجدولة بنجاح." : "Automation saved successfully.";
            _isError = false;
            NewJob(false);
            Reload();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
        return Task.CompletedTask;
    }

    private void Edit(AutomationJob job)
    {
        _model = new AutomationJobEditModel { Id = job.Id, Name = job.Name, SiteId = job.SiteId, SiteName = job.SiteName, Type = job.Type, Frequency = job.Frequency, IntervalValue = job.IntervalValue, TimeOfDay = job.TimeOfDay, Enabled = job.Enabled, RetryCount = job.RetryCount };
        _selectedSiteId = job.SiteId.ToString();
    }

    private void Toggle(AutomationJob job) { Automation.SetEnabled(job.Id, !job.Enabled); Reload(); }
    private void Delete(Guid id) { Automation.Delete(id); if (_model.Id == id) NewJob(); Reload(); }
    private void NewJob(bool clearMessage = true) { _model = new(); _selectedSiteId = string.Empty; if (clearMessage) _message = string.Empty; }
    private string FormatNextRun() => _jobs.Where(x => x.Enabled).OrderBy(x => x.NextRunUtc).Select(x => FormatDate(x.NextRunUtc)).FirstOrDefault() ?? L["Never"];
    private string FormatDate(DateTime value) => value.ToLocalTime().ToString(L.IsArabic ? "yyyy-MM-dd HH:mm" : "MMM d, yyyy HH:mm");
    private void LanguageChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= LanguageChanged;
}
