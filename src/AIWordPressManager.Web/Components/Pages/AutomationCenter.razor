@page "/automation-center"
@rendermode InteractiveServer
@implements IDisposable
@using AIWordPressManager.Domain.Entities
@inject AutomationCenterService Automation
@inject SiteWebService SiteService
@inject AppLanguageService L
@inject AppNotificationService Notifications

<PageTitle>@(L.IsArabic ? "مركز الأتمتة" : "Automation Center")</PageTitle>

<div class="automation-page">
    <section class="panel automation-hero">
        <div>
            <span class="workspace-kicker">AUTOMATION</span>
            <h1>@(L.IsArabic ? "مركز الأتمتة" : "Automation Center")</h1>
            <p>@(L.IsArabic ? "إدارة مهام المزامنة وتدقيق SEO وتشغيلها ومتابعة سجل التنفيذ." : "Manage synchronization and SEO audit jobs and review execution history.")</p>
        </div>
        <div class="automation-hero-actions">
            <button class="btn" @onclick="Refresh" disabled="@_saving">@(L.IsArabic ? "تحديث" : "Refresh")</button>
            <button class="btn primary" @onclick="NewJob" disabled="@_saving">@(L.IsArabic ? "مهمة جديدة" : "New job")</button>
        </div>
    </section>

    <section class="automation-kpis">
        <article class="panel"><small>@(L.IsArabic ? "إجمالي المهام" : "Total jobs")</small><strong>@_jobs.Count</strong></article>
        <article class="panel"><small>@(L.IsArabic ? "المهام المفعلة" : "Enabled jobs")</small><strong>@_jobs.Count(x => x.Enabled)</strong></article>
        <article class="panel"><small>@(L.IsArabic ? "التشغيلات الفاشلة" : "Failed runs")</small><strong>@_history.Count(x => x.Status == "Failed")</strong></article>
    </section>

    <section class="automation-layout">
        <main class="panel automation-list-panel">
            <header>
                <h2>@(L.IsArabic ? "المهام المجدولة" : "Scheduled jobs")</h2>
                <div class="automation-filters">
                    <input @bind="_search" @bind:event="oninput" placeholder="@(L.IsArabic ? "بحث..." : "Search...")" />
                    <select @bind="_statusFilter">
                        <option value="">@(L.IsArabic ? "كل الحالات" : "All states")</option>
                        <option value="enabled">@(L.IsArabic ? "مفعلة" : "Enabled")</option>
                        <option value="disabled">@(L.IsArabic ? "معطلة" : "Disabled")</option>
                    </select>
                </div>
            </header>

            <div class="automation-job-list">
                @foreach (var job in FilteredJobs)
                {
                    <article class="automation-job-card @(job.Enabled ? "enabled" : "disabled")">
                        <div class="automation-job-main">
                            <div>
                                <strong>@job.Name</strong>
                                <p>@job.SiteName · @job.Type</p>
                                <small>@ScheduleText(job)</small>
                            </div>
                        </div>
                        <div class="automation-job-actions">
                            <button class="btn compact" disabled="@_saving" @onclick="() => Edit(job)">@(L.IsArabic ? "تعديل" : "Edit")</button>
                            <button class="btn compact" disabled="@_saving" @onclick="() => RunNow(job)">@(L.IsArabic ? "تشغيل" : "Run")</button>
                            <button class="btn compact" disabled="@_saving" @onclick="() => Toggle(job)">@(job.Enabled ? (L.IsArabic ? "إيقاف" : "Disable") : (L.IsArabic ? "تفعيل" : "Enable"))</button>
                            <button class="btn danger compact" disabled="@_saving" @onclick="() => Delete(job)">@(L.IsArabic ? "حذف" : "Delete")</button>
                        </div>
                    </article>
                }
            </div>
        </main>

        <aside class="panel automation-editor">
            <header><h2>@(_model.Id == Guid.Empty ? (L.IsArabic ? "مهمة جديدة" : "New job") : (L.IsArabic ? "تعديل المهمة" : "Edit job"))</h2></header>
            <div class="automation-form">
                <label><span>@(L.IsArabic ? "اسم المهمة" : "Job name")</span><input @bind="_model.Name" /></label>
                <label>
                    <span>@(L.IsArabic ? "الموقع" : "Site")</span>
                    <select value="@_siteIdText" @onchange="SiteChanged">
                        <option value="">@(L.IsArabic ? "اختر الموقع" : "Select site")</option>
                        @foreach (var site in _sites)
                        {
                            <option value="@site.Id">@site.Name</option>
                        }
                    </select>
                </label>
                <label><span>@(L.IsArabic ? "نوع المهمة" : "Job type")</span><select @bind="_model.Type"><option>Synchronization</option><option>SEO Audit</option><option>Content Operation</option></select></label>
                <label><span>@(L.IsArabic ? "التكرار" : "Frequency")</span><select @bind="_model.Frequency"><option value="hourly">Hourly</option><option value="daily">Daily</option><option value="weekly">Weekly</option><option value="monthly">Monthly</option></select></label>
                <label><span>@(L.IsArabic ? "كل" : "Every")</span><input type="number" min="1" max="365" @bind="_model.IntervalValue" /></label>
                <label><span>@(L.IsArabic ? "وقت التشغيل UTC" : "Run time UTC")</span><input type="time" value="@TimeText" @onchange="TimeChanged" /></label>
                <label><span>@(L.IsArabic ? "عدد الإعادات" : "Retries")</span><input type="number" min="0" max="10" @bind="_model.RetryCount" /></label>
                <label><input type="checkbox" @bind="_model.Enabled" /> @(L.IsArabic ? "مفعلة" : "Enabled")</label>
                <button class="btn primary full" disabled="@_saving" @onclick="Save">@(_saving ? (L.IsArabic ? "جارٍ الحفظ..." : "Saving...") : (L.IsArabic ? "حفظ" : "Save"))</button>
            </div>
        </aside>
    </section>

    <section class="panel automation-history-panel">
        <header><h2>@(L.IsArabic ? "سجل التشغيل" : "Execution history")</h2></header>
        <div class="automation-history-list">
            @foreach (var row in _history.Take(30))
            {
                <article><strong>@row.JobName</strong><p>@row.Message</p><small>@row.StartedAtUtc · @row.Status</small></article>
            }
        </div>
    </section>
</div>

@code {
    private List<AutomationJob> _jobs = new();
    private List<AutomationHistoryItem> _history = new();
    private List<Site> _sites = new();
    private AutomationJobEditModel _model = new();
    private string _siteIdText = string.Empty;
    private string _search = string.Empty;
    private string _statusFilter = string.Empty;
    private bool _saving;
    private bool _disposed;

    private string TimeText => Convert.ToString(_model.TimeOfDay) ?? string.Empty;

    private IEnumerable<AutomationJob> FilteredJobs => _jobs.Where(x =>
        (string.IsNullOrWhiteSpace(_search) || x.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.SiteName.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_statusFilter) || (_statusFilter == "enabled" && x.Enabled) || (_statusFilter == "disabled" && !x.Enabled)));

    protected override void OnInitialized() => L.Changed += Changed;

    protected override async Task OnInitializedAsync()
    {
        var sites = await SiteService.GetSitesAsync();
        if (_disposed) return;
        _sites = sites.ToList();
        Refresh();
    }

    private void Refresh()
    {
        if (_disposed) return;
        var allowedSiteIds = _sites.Select(x => x.Id).ToHashSet();
        _jobs = Automation.GetJobs().Where(x => allowedSiteIds.Contains(x.SiteId)).ToList();
        var allowedJobNames = _jobs.Select(x => x.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
        _history = Automation.GetHistory(100).Where(x => allowedJobNames.Contains(x.JobName)).ToList();
    }

    private void NewJob()
    {
        if (_disposed || _saving) return;
        _model = new AutomationJobEditModel();
        _siteIdText = string.Empty;
    }

    private void Edit(AutomationJob job)
    {
        if (_disposed || _saving) return;
        EnsureOwned(job);
        _model = new AutomationJobEditModel
        {
            Id = job.Id,
            Name = job.Name,
            SiteId = job.SiteId,
            SiteName = job.SiteName,
            Type = job.Type,
            Frequency = job.Frequency,
            IntervalValue = job.IntervalValue,
            TimeOfDay = Convert.ToString(job.TimeOfDay) ?? string.Empty,
            Enabled = job.Enabled,
            RetryCount = job.RetryCount
        };
        _siteIdText = job.SiteId.ToString();
    }

    private void SiteChanged(ChangeEventArgs e)
    {
        if (_disposed || _saving) return;
        _siteIdText = e.Value?.ToString() ?? string.Empty;
        if (Guid.TryParse(_siteIdText, out var id))
        {
            _model.SiteId = id;
            _model.SiteName = _sites.FirstOrDefault(x => x.Id == id)?.Name ?? string.Empty;
        }
        else
        {
            _model.SiteId = Guid.Empty;
            _model.SiteName = string.Empty;
        }
    }

    private void TimeChanged(ChangeEventArgs e)
    {
        if (_disposed || _saving) return;
        _model.TimeOfDay = e.Value?.ToString() ?? string.Empty;
    }

    private void Save()
    {
        if (_disposed || _saving) return;
        try
        {
            _saving = true;
            var site = _sites.FirstOrDefault(x => x.Id == _model.SiteId)
                ?? throw new UnauthorizedAccessException("The selected site does not belong to the signed-in user.");
            _model.SiteName = site.Name;
            Automation.Save(_model);
            if (_disposed) return;
            Notifications.Success(L.IsArabic ? "تم حفظ المهمة." : "Job saved.");
            NewJob();
            Refresh();
        }
        catch (Exception ex)
        {
            if (!_disposed) Notifications.Error(L.TranslateMessage(ex.Message));
        }
        finally
        {
            if (!_disposed) _saving = false;
        }
    }

    private void Toggle(AutomationJob job) => RunOwned(job, () => Automation.SetEnabled(job.Id, !job.Enabled));
    private void RunNow(AutomationJob job) => RunOwned(job, () => Automation.QueueNow(job.Id));
    private void Delete(AutomationJob job) => RunOwned(job, () => Automation.Delete(job.Id));

    private void RunOwned(AutomationJob job, Action action)
    {
        if (_disposed || _saving) return;
        try
        {
            EnsureOwned(job);
            action();
            Refresh();
        }
        catch (Exception ex)
        {
            if (!_disposed) Notifications.Error(L.TranslateMessage(ex.Message));
        }
    }

    private void EnsureOwned(AutomationJob job)
    {
        if (!_sites.Any(x => x.Id == job.SiteId))
            throw new UnauthorizedAccessException("This automation does not belong to the signed-in user.");
    }

    private static string ScheduleText(AutomationJob job) =>
        job.Frequency + " · " + Convert.ToString(job.TimeOfDay) + " UTC";

    private void Changed()
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            if (!_disposed) StateHasChanged();
        });
    }

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        L.Changed -= Changed;
    }
}