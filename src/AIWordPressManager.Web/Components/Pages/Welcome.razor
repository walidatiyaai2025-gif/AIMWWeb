@page "/welcome"
@layout LandingLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using System.Globalization
@using AIWordPressManager.Application.Abstractions.Billing
@using AIWordPressManager.Domain.Entities
@inject AppLanguageService L
@inject BuildInformationService BuildInfo
@inject ISubscriptionPlanCatalog Plans
@inject IPlanEntitlementCatalog Entitlements
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationState
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS

<PageTitle>@(L.IsArabic ? "AI WordPress Manager | منصة تشغيل WordPress بالذكاء الاصطناعي" : "AI WordPress Manager | AI WordPress Operations Platform")</PageTitle>

<div class="landing-v2" dir="@L.Direction">
    <header class="public-header">
        <a class="public-brand" href="/welcome" aria-label="AI WordPress Manager">
            <span class="brand-symbol">AI</span>
            <span><strong>AI WordPress Manager</strong><small>@(L.IsArabic ? "WordPress Operations OS" : "WordPress Operations OS")</small></span>
        </a>
        <nav aria-label="@(L.IsArabic ? "التنقل العام" : "Public navigation")">
            <a href="#product">@(L.IsArabic ? "المنتج" : "Product")</a>
            <a href="#workflow">@(L.IsArabic ? "طريقة العمل" : "Workflow")</a>
            <a href="#pricing">@(L.IsArabic ? "الخطط" : "Pricing")</a>
            <a href="#security">@(L.IsArabic ? "الأمان" : "Security")</a>
        </nav>
        <div class="header-actions">
            <button type="button" class="language-button" onclick="window.appLanguage.toggleAndReload(); return false;" aria-label="Switch language">@(L.IsArabic ? "EN" : "AR")</button>
            <a class="sign-in" href="@(_isAuthenticated ? "/" : "/login")">@(_isAuthenticated ? (L.IsArabic ? "لوحة التحكم" : "Dashboard") : (L.IsArabic ? "تسجيل الدخول" : "Sign in"))</a>
            <a class="primary-link" href="@PrimaryCtaHref">@PrimaryCtaText</a>
        </div>
    </header>

    <main>
        <section class="hero-v2" id="product">
            <div class="hero-copy-v2">
                <div class="hero-label"><span></span>@(L.IsArabic ? "من موقع واحد إلى محفظة WordPress كاملة" : "FROM ONE SITE TO A WORDPRESS PORTFOLIO")</div>
                <h1>@(L.IsArabic ? "شغّل WordPress كمنظومة واحدة، لا كعشرين لوحة تحكم." : "Operate WordPress as one system, not twenty dashboards.")</h1>
                <p>@(L.IsArabic ? "إدارة مواقع ومحتوى وSEO وأتمتة وذكاء اصطناعي من مساحة تشغيل موحدة، مع صلاحيات واضحة وسجل تنفيذ وتشخيص للأخطاء." : "Manage sites, content, SEO, automation and AI from one operating workspace—with clear permissions, auditable execution and actionable diagnostics.")</p>
                <div class="hero-actions-v2">
                    <a class="hero-primary" href="@PrimaryCtaHref">@PrimaryCtaText <span>→</span></a>
                    <a class="hero-secondary" href="#workspace-preview">@(L.IsArabic ? "شاهد مساحة العمل" : "Explore the workspace")</a>
                </div>
                <div class="hero-proof">
                    <span><b>14</b><small>@(L.IsArabic ? "يوم تجربة مجانية" : "day free trial")</small></span>
                    <span><b>0</b><small>@(L.IsArabic ? "بطاقة مطلوبة" : "card required")</small></span>
                    <span><b>1</b><small>@(L.IsArabic ? "سجل تشغيل موحد" : "operating record")</small></span>
                </div>
            </div>

            <div class="workspace-stage" id="workspace-preview" aria-label="AI WordPress Manager interface preview">
                <div class="stage-glow"></div>
                <div class="app-window-v2">
                    <div class="app-window-top">
                        <div class="window-controls"><i></i><i></i><i></i></div>
                        <div class="window-breadcrumb">portfolio / operations / overview</div>
                        <div class="window-live"><i></i>@(L.IsArabic ? "مباشر" : "LIVE")</div>
                    </div>
                    <div class="app-window-body">
                        <aside class="mini-sidebar">
                            <div class="mini-logo">AI</div>
                            <span class="active">⌂</span><span>◎</span><span>▤</span><span>⌕</span><span>✦</span><span>⚡</span><span class="bottom">⚙</span>
                        </aside>
                        <div class="mini-workspace">
                            <div class="mini-heading"><div><small>OPERATIONS OVERVIEW</small><strong>@(L.IsArabic ? "مساحة التحكم" : "Command workspace")</strong></div><button>+ @(L.IsArabic ? "إجراء" : "Action")</button></div>
                            <div class="metric-row">
                                <article><span>◎</span><div><small>@(L.IsArabic ? "المواقع" : "Sites")</small><strong>12</strong></div><em>+2</em></article>
                                <article><span>▤</span><div><small>@(L.IsArabic ? "المحتوى" : "Content")</small><strong>1,284</strong></div><em>99.8%</em></article>
                                <article><span>⌕</span><div><small>SEO</small><strong>93</strong></div><em>↑ 8</em></article>
                                <article><span>⚡</span><div><small>@(L.IsArabic ? "العمليات" : "Jobs")</small><strong>7</strong></div><em>@(L.IsArabic ? "نشطة" : "active")</em></article>
                            </div>
                            <div class="workspace-columns">
                                <article class="ops-panel">
                                    <header><div><small>@(L.IsArabic ? "المحفظة" : "PORTFOLIO")</small><strong>@(L.IsArabic ? "صحة المواقع" : "Site health")</strong></div><span>@(L.IsArabic ? "الآن" : "Now")</span></header>
                                    <div class="site-line"><i class="good"></i><div><strong>Storefront</strong><small>Connected · 48ms</small></div><b>98</b></div>
                                    <div class="site-line"><i class="good"></i><div><strong>Editorial Hub</strong><small>Synced · 2m ago</small></div><b>95</b></div>
                                    <div class="site-line"><i class="warn"></i><div><strong>Campaign</strong><small>SEO review required</small></div><b>82</b></div>
                                </article>
                                <article class="ai-insight-panel">
                                    <span class="spark">✦ AI INSIGHT</span>
                                    <h3>@(L.IsArabic ? "3 إجراءات تستحق المراجعة" : "3 actions worth reviewing")</h3>
                                    <p>@(L.IsArabic ? "مشاكل SEO ومحتوى قديم ومهمة مزامنة متأخرة — مرتبة حسب التأثير قبل التنفيذ." : "SEO findings, stale content and a delayed sync—prioritized by impact before execution.")</p>
                                    <div class="insight-action"><span>@(L.IsArabic ? "مراجعة المقترحات" : "Review proposals")</span><b>→</b></div>
                                </article>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="credibility-strip" aria-label="Core platform capabilities">
            <span>WORDPRESS REST</span><span>MULTI-SITE</span><span>AI PROVIDERS</span><span>SEO OPERATIONS</span><span>AUTOMATION</span><span>AUDIT TRAIL</span>
        </section>

        <section class="product-section">
            <div class="section-heading-v2"><span>@(L.IsArabic ? "مساحة تشغيل واحدة" : "ONE OPERATING LAYER")</span><h2>@(L.IsArabic ? "كل شيء مهم أمامك. كل تغيير يمكن تتبعه." : "Everything important in view. Every change traceable.")</h2><p>@(L.IsArabic ? "صممنا المساحات حول العمل الحقيقي: اكتشف المشكلة، افهم أثرها، راجع الإجراء، ثم نفّذ وراقب النتيجة." : "Workspaces are organized around the real job: surface the issue, understand impact, review the action, execute and verify the result.")</p></div>
            <div class="bento-grid">
                @foreach (var feature in Features)
                {
                    <article class="bento-card @feature.ClassName"><span class="bento-icon">@feature.Icon</span><div><small>@(L.IsArabic ? feature.ArKicker : feature.EnKicker)</small><h3>@(L.IsArabic ? feature.ArTitle : feature.EnTitle)</h3><p>@(L.IsArabic ? feature.ArDescription : feature.EnDescription)</p></div><div class="bento-visual" aria-hidden="true"><i></i><i></i><i></i></div></article>
                }
            </div>
        </section>

        <section class="workflow-section" id="workflow">
            <div class="section-heading-v2 compact"><span>@(L.IsArabic ? "من الإشارة إلى التنفيذ" : "SIGNAL → DECISION → EXECUTION")</span><h2>@(L.IsArabic ? "سرعة بدون فقدان السيطرة." : "Move faster without losing control.")</h2></div>
            <div class="workflow-line">
                <article><b>01</b><span>◎</span><h3>@(L.IsArabic ? "راقب" : "Observe")</h3><p>@(L.IsArabic ? "زامن حالة المواقع والمحتوى والصحة التشغيلية." : "Synchronize site, content and operational state.")</p></article>
                <i>→</i>
                <article><b>02</b><span>✦</span><h3>@(L.IsArabic ? "افهم" : "Understand")</h3><p>@(L.IsArabic ? "رتب إشارات SEO والذكاء الاصطناعي حسب التأثير." : "Prioritize SEO and AI signals by impact.")</p></article>
                <i>→</i>
                <article><b>03</b><span>✓</span><h3>@(L.IsArabic ? "راجع" : "Review")</h3><p>@(L.IsArabic ? "اعرف ماذا سيتغير قبل اعتماد الإجراء." : "Know exactly what changes before approval.")</p></article>
                <i>→</i>
                <article><b>04</b><span>⚡</span><h3>@(L.IsArabic ? "نفّذ" : "Execute")</h3><p>@(L.IsArabic ? "شغّل المهمة مع حالة وسجل وتشخيص واضح." : "Run with status, history and clear diagnostics.")</p></article>
            </div>
        </section>

        <section class="pricing-section" id="pricing">
            <div class="section-heading-v2 centered"><span>@(L.IsArabic ? "خطط من نفس كتالوج المنتج" : "PRICING FROM THE LIVE PRODUCT CATALOG")</span><h2>@(L.IsArabic ? "ابدأ مجانًا. وسّع الحدود عندما تحتاج." : "Start free. Expand capacity when you need it.")</h2><p>@(L.IsArabic ? "الأسعار والحدود أدناه تأتي من نفس كتالوج الاشتراكات المستخدم داخل الحساب، لذلك لا توجد صفحة أسعار منفصلة عن حقيقة المنتج." : "Plans and limits below come from the same catalog used inside account billing, so public pricing cannot drift away from product reality.")</p></div>

            @if (_plansLoading)
            {
                <div class="pricing-loading">@(L.IsArabic ? "جارٍ تحميل الخطط..." : "Loading plans...")</div>
            }
            else if (_plans.Count == 0)
            {
                <div class="pricing-loading">@(L.IsArabic ? "كتالوج الخطط غير متاح مؤقتًا." : "The plan catalog is temporarily unavailable.")</div>
            }
            else
            {
                <div class="pricing-grid @(_plans.Count == 1 ? "single" : string.Empty)">
                    @foreach (var plan in _plans)
                    {
                        var isFreeTrial = IsFreeTrial(plan);
                        <article class="price-card @(isFreeTrial ? "featured" : string.Empty)">
                            <div class="price-card-head">
                                <div><span>@(isFreeTrial ? (L.IsArabic ? "ابدأ هنا" : "START HERE") : plan.Code.ToUpperInvariant())</span><h3>@(L.IsArabic ? plan.NameAr : plan.NameEn)</h3></div>
                                @if (isFreeTrial)<b>@(L.IsArabic ? "بدون بطاقة" : "NO CARD")</b>
                            </div>
                            <p>@(L.IsArabic ? plan.DescriptionAr : plan.DescriptionEn)</p>
                            <div class="price-value">
                                @if (plan.Price == 0m)
                                {
                                    <strong>@(L.IsArabic ? "مجاني" : "Free")</strong><small>@(plan.TrialDays > 0 ? $"{plan.TrialDays} {(L.IsArabic ? "يومًا" : "days")}" : string.Empty)</small>
                                }
                                else
                                {
                                    <strong>@FormatMoney(plan)</strong><small>/ @(plan.BillingInterval == SubscriptionPlan.YearlyInterval ? (L.IsArabic ? "سنة" : "year") : (L.IsArabic ? "شهر" : "month"))</small>
                                }
                            </div>
                            <ul>
                                @foreach (var benefit in BenefitsFor(plan))
                                {
                                    <li><span>✓</span>@benefit</li>
                                }
                            </ul>
                            <a href="@PlanCtaHref(plan)" class="price-cta">@(isFreeTrial ? (L.IsArabic ? "ابدأ التجربة المجانية" : "Start free trial") : (L.IsArabic ? "اختر الخطة" : "Choose plan")) <span>→</span></a>
                            @if (plan.Price > 0m && string.IsNullOrWhiteSpace(plan.GatewayPlanId))
                            {
                                <small class="gateway-note">@(L.IsArabic ? "الدفع لهذه الخطة لم يتم ربطه ببوابة الدفع بعد." : "Payment gateway binding is not configured for this plan yet.")</small>
                            }
                        </article>
                    }
                </div>
            }
        </section>

        <section class="security-section" id="security">
            <div class="security-copy"><span>@(L.IsArabic ? "التحكم والأمان" : "CONTROL & SECURITY")</span><h2>@(L.IsArabic ? "الأتمتة مفيدة فقط عندما يمكن تفسيرها وإيقافها ومراجعتها." : "Automation is useful only when it can be explained, stopped and audited.")</h2><p>@(L.IsArabic ? "صلاحيات على الخادم، أسرار محمية، سجل أمني، تشخيص Runtime، وعمليات يمكن تتبعها من الطلب إلى النتيجة." : "Server-side permissions, protected secrets, security audit, runtime diagnostics and operations that remain traceable from request to outcome.")</p></div>
            <div class="security-grid">
                <article><span>◈</span><strong>@(L.IsArabic ? "صلاحيات دقيقة" : "Permission aware")</strong><small>@(L.IsArabic ? "القدرات الحساسة محمية بسياسات الخادم." : "Sensitive capabilities are protected by server policies.")</small></article>
                <article><span>⌁</span><strong>@(L.IsArabic ? "أسرار معزولة" : "Protected secrets")</strong><small>@(L.IsArabic ? "بيانات الاعتماد لا تتحول إلى نصوص معروضة." : "Credentials do not become display data.")</small></article>
                <article><span>◎</span><strong>@(L.IsArabic ? "تشخيص قابل للإرسال" : "Actionable diagnostics")</strong><small>@(L.IsArabic ? "Correlation IDs وRuntime logs لتحديد الخطأ." : "Correlation IDs and runtime logs localize failures.")</small></article>
                <article><span>✓</span><strong>@(L.IsArabic ? "تنفيذ مدقق" : "Auditable execution")</strong><small>@(L.IsArabic ? "سجل يوضح ماذا حدث ومتى وبأي نتيجة." : "History records what happened, when and with what outcome.")</small></article>
            </div>
        </section>

        <section class="faq-section">
            <div class="section-heading-v2 compact"><span>FAQ</span><h2>@(L.IsArabic ? "أسئلة قبل أن تبدأ." : "Questions before you start.")</h2></div>
            <div class="faq-grid">
                @foreach (var faq in Faqs)
                {
                    <details><summary>@(L.IsArabic ? faq.ArQuestion : faq.EnQuestion)<span>+</span></summary><p>@(L.IsArabic ? faq.ArAnswer : faq.EnAnswer)</p></details>
                }
            </div>
        </section>

        <section class="final-cta-v2">
            <div><span>@(L.IsArabic ? "ابدأ صغيرًا. حافظ على نفس طريقة التشغيل عند التوسع." : "START SMALL. KEEP THE SAME OPERATING MODEL AS YOU SCALE.")</span><h2>@(L.IsArabic ? "أول موقع WordPress على بعد دقائق." : "Your first WordPress site is minutes away.")</h2><p>@(L.IsArabic ? "جرّب الأساسيات لمدة 14 يومًا بدون بطاقة، ثم وسّع الخطة فقط عندما تحتاج مواقع أو AI أو أتمتة أكثر." : "Explore the core platform for 14 days with no card, then upgrade only when you need more sites, AI or automation.")</p></div>
            <a href="@PrimaryCtaHref">@PrimaryCtaText <b>→</b></a>
        </section>
    </main>

    <footer class="public-footer">
        <a class="public-brand" href="/welcome"><span class="brand-symbol small">AI</span><span><strong>AI WordPress Manager</strong><small>Operations OS</small></span></a>
        <div><span>v@Build.Version</span><span>@Build.Branch</span></div>
        <nav><a href="#product">Product</a><a href="#pricing">Pricing</a><a href="/login">Sign in</a></nav>
    </footer>
</div>

@code {
    private BuildInformation Build => BuildInfo.Current;
    private readonly List<SubscriptionPlanItem> _plans = new();
    private readonly Dictionary<Guid, Dictionary<string, string>> _planEntitlements = new();
    private bool _plansLoading = true;
    private bool _isAuthenticated;

    private string PrimaryCtaHref => _isAuthenticated ? "/" : "/register";
    private string PrimaryCtaText => _isAuthenticated
        ? (L.IsArabic ? "فتح مساحة العمل" : "Open workspace")
        : (L.IsArabic ? "ابدأ مجانًا" : "Start free trial");

    private static readonly LandingFeature[] Features =
    [
        new("◎", "PORTFOLIO", "المحفظة", "Multi-site operations", "تشغيل عدة مواقع", "Independent WordPress profiles with connection state, synchronization history and a single portfolio view.", "ملفات WordPress مستقلة مع حالة الاتصال وسجل المزامنة ونظرة موحدة على المحفظة.", "feature-wide"),
        new("▤", "CONTENT", "المحتوى", "Content command center", "مركز قيادة المحتوى", "Work across posts, pages, media and taxonomies without jumping between WordPress dashboards.", "اعمل على المقالات والصفحات والوسائط والتصنيفات بدون التنقل بين لوحات WordPress.", ""),
        new("⌕", "SEO", "SEO", "Prioritized SEO work", "SEO مرتب بالأولوية", "Turn technical and content findings into reviewable work instead of another disconnected report.", "حوّل المشاكل التقنية ومشاكل المحتوى إلى أعمال قابلة للمراجعة بدل تقرير منفصل جديد.", ""),
        new("✦", "AI", "الذكاء الاصطناعي", "AI with a control layer", "AI داخل طبقة تحكم", "Generate proposals and assistance while keeping approval and execution as explicit product steps.", "أنشئ المقترحات والمساعدة مع إبقاء الاعتماد والتنفيذ خطوات واضحة داخل المنتج.", "feature-accent"),
        new("⚡", "AUTOMATION", "الأتمتة", "Jobs you can trace", "مهام يمكنك تتبعها", "Schedule operations with progress, retry behavior, history and diagnostics when something fails.", "جدول العمليات مع تقدم وإعادة محاولة وسجل وتشخيص واضح عندما يفشل شيء.", "feature-wide")
    ];

    private static readonly LandingFaq[] Faqs =
    [
        new("Do I need a card for the free trial?", "هل أحتاج بطاقة للتجربة المجانية؟", "No. The built-in Free Trial is provisioned without a payment method and has deliberately limited product entitlements.", "لا. يتم إنشاء التجربة المجانية بدون وسيلة دفع وبحدود استخدام واضحة داخل المنتج."),
        new("Are plan limits only visual?", "هل حدود الخطط مجرد عرض في الواجهة؟", "No. Entitlements are resolved and enforced by server-side application services where the capability is protected.", "لا. يتم حل الاستحقاقات وتطبيقها في خدمات الخادم للقدرات المحمية بالحدود."),
        new("Does returning from PayPal activate a paid plan?", "هل الرجوع من PayPal يفعّل الخطة المدفوعة؟", "No. Browser navigation is never treated as payment evidence. Provider reconciliation remains authoritative for paid subscription state.", "لا. تنقل المتصفح لا يعتبر دليل دفع. تظل مصالحة بيانات مزود الدفع هي المرجع لحالة الاشتراك المدفوع."),
        new("Can I manage more than one WordPress site?", "هل يمكنني إدارة أكثر من موقع WordPress؟", "Yes. Multi-site operation is a core platform capability; the number of sites available to an account is controlled by its plan entitlement.", "نعم. تشغيل عدة مواقع قدرة أساسية في المنصة، وعدد المواقع المتاح للحساب تحدده حدود خطته.")
    ];

    protected override async Task OnInitializedAsync()
    {
        var preferredLanguage = HttpContextAccessor.HttpContext?.Request.Cookies["aiwp-language"];
        L.SetCulture(preferredLanguage == "ar" ? "ar" : "en");

        try
        {
            var auth = await AuthenticationState.GetAuthenticationStateAsync();
            _isAuthenticated = auth.User.Identity?.IsAuthenticated == true;
        }
        catch { _isAuthenticated = false; }

        try
        {
            _plans.AddRange(await Plans.ListAsync(includeDisabled: false));
            foreach (var plan in _plans)
            {
                var values = (await Entitlements.ListAsync(plan.Id))
                    .ToDictionary(x => x.Key, x => x.CanonicalValue, StringComparer.OrdinalIgnoreCase);
                _planEntitlements[plan.Id] = values;
            }
        }
        catch
        {
            _plans.Clear();
            _planEntitlements.Clear();
        }
        finally
        {
            _plansLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var culture = await JS.InvokeAsync<string?>("appLanguage.get");
            L.SetCulture(culture == "ar" ? "ar" : "en");
            await JS.InvokeVoidAsync("appLanguage.apply", L.Culture, L.Direction);
            StateHasChanged();
        }
        catch (InvalidOperationException) { }
    }

    private bool IsFreeTrial(SubscriptionPlanItem plan) =>
        string.Equals(plan.Code, "free-trial", StringComparison.OrdinalIgnoreCase) || plan.Price == 0m;

    private string PlanCtaHref(SubscriptionPlanItem plan)
    {
        if (!_isAuthenticated) return "/register";
        return IsFreeTrial(plan) ? "/" : "/account/billing";
    }

    private string FormatMoney(SubscriptionPlanItem plan) =>
        $"{plan.Price.ToString("0.##", CultureInfo.InvariantCulture)} {plan.Currency}";

    private IReadOnlyList<string> BenefitsFor(SubscriptionPlanItem plan)
    {
        if (!_planEntitlements.TryGetValue(plan.Id, out var values)) return Array.Empty<string>();
        var benefits = new List<string>();

        if (TryInteger(values, EntitlementDefinitionCatalog.SitesMax, out var sites))
            benefits.Add(L.IsArabic ? $"حتى {sites} موقع WordPress" : $"Up to {sites} WordPress site{(sites == 1 ? string.Empty : "s")}");
        if (TryBoolean(values, EntitlementDefinitionCatalog.AiEnabled, out var aiEnabled))
        {
            if (aiEnabled && TryInteger(values, EntitlementDefinitionCatalog.AiMonthlyRequestsMax, out var aiMax))
                benefits.Add(L.IsArabic ? $"{aiMax} طلب AI شهريًا" : $"{aiMax} AI requests / month");
            else if (!aiEnabled)
                benefits.Add(L.IsArabic ? "بدون AI" : "AI not included");
        }
        if (TryInteger(values, EntitlementDefinitionCatalog.AutomationSchedulesMax, out var automations))
            benefits.Add(L.IsArabic ? $"{automations} جدول أتمتة" : $"{automations} automation schedule{(automations == 1 ? string.Empty : "s")}");
        if (TryInteger(values, EntitlementDefinitionCatalog.BackupRetentionDays, out var backupDays))
            benefits.Add(L.IsArabic ? $"احتفاظ بالنسخ {backupDays} يوم" : $"{backupDays}-day backup retention");
        if (TryBoolean(values, EntitlementDefinitionCatalog.PremiumSeo, out var premiumSeo))
            benefits.Add(premiumSeo ? (L.IsArabic ? "SEO متقدم" : "Premium SEO") : (L.IsArabic ? "SEO الأساسي" : "Core SEO workspace"));

        return benefits.Take(5).ToArray();
    }

    private static bool TryInteger(IReadOnlyDictionary<string, string> values, string key, out long value) =>
        values.TryGetValue(key, out var raw) && long.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out value);

    private static bool TryBoolean(IReadOnlyDictionary<string, string> values, string key, out bool value) =>
        values.TryGetValue(key, out var raw) && bool.TryParse(raw, out value);

    private sealed record LandingFeature(string Icon, string EnKicker, string ArKicker, string EnTitle, string ArTitle, string EnDescription, string ArDescription, string ClassName);
    private sealed record LandingFaq(string EnQuestion, string ArQuestion, string EnAnswer, string ArAnswer);
}