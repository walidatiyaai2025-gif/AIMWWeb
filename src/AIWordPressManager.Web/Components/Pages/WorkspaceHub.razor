@page "/content-workspace"
@page "/seo-workspace"
@page "/ai-workspace"
@page "/operations-workspace"
@inject NavigationManager Navigation
@inject AppLanguageService L

<PageTitle>@Title</PageTitle>

<div class="page-heading workspace-heading" data-testid="workspace-hub">
    <div>
        <span class="workspace-kicker">@Kicker</span>
        <h1>@Title</h1>
        <p>@Description</p>
    </div>
    <NavLink class="btn primary" href="/sites">@(L.IsArabic ? "اختيار موقع" : "Select Site")</NavLink>
</div>

<section class="panel" style="padding:16px 18px;margin-bottom:16px" data-testid="workspace-real-data-notice">
    <strong>@(L.IsArabic ? "مساحات تشغيل حقيقية فقط" : "Real workspaces only")</strong>
    <p style="margin:6px 0 0;opacity:.74">
        @(L.IsArabic
            ? "كل بطاقة أدناه تفتح وظيفة فعلية موجودة في النظام. تمت إزالة مؤشرات الجاهزية والبطاقات الوصفية غير القابلة للتنفيذ."
            : "Every card below opens an implemented workspace. Static readiness badges and non-actionable prototype cards have been removed.")
    </p>
</section>

<div class="workspace-grid">
    @foreach (var item in Items)
    {
        <a class="card workspace-card"
           style="text-decoration:none;color:inherit"
           href="@item.Href"
           data-testid="workspace-link"
           data-workspace-key="@item.Key">
            <div class="workspace-card-icon">@item.Icon</div>
            <div>
                <h3>@(L.IsArabic ? item.Arabic : item.English)</h3>
                <p>@(L.IsArabic ? item.ArabicDescription : item.EnglishDescription)</p>
            </div>
            <span class="badge success">@(L.IsArabic ? "فتح" : "Open") →</span>
        </a>
    }
</div>

@code {
    private string Route => new Uri(Navigation.Uri).AbsolutePath.Trim('/').ToLowerInvariant();

    private string Title => Route switch
    {
        "content-workspace" => L.IsArabic ? "إدارة محتوى WordPress" : "WordPress Content Management",
        "seo-workspace" => L.IsArabic ? "مساحة عمل SEO" : "SEO Workspace",
        "ai-workspace" => L.IsArabic ? "مساحة عمل الذكاء الاصطناعي" : "AI Workspace",
        _ => L.IsArabic ? "مركز التشغيل والأتمتة" : "Operations & Automation"
    };

    private string Kicker => Route switch
    {
        "content-workspace" => L.IsArabic ? "المحتوى" : "CONTENT",
        "seo-workspace" => "SEO",
        "ai-workspace" => "AI",
        _ => L.IsArabic ? "التشغيل" : "OPERATIONS"
    };

    private string Description => Route switch
    {
        "content-workspace" => L.IsArabic ? "افتح مساحات المقالات والصفحات والوسائط والتصنيفات والتعليقات والمستخدمين المتصلة بالخدمات الفعلية." : "Open the real posts, pages, media, taxonomy, comments, and users workspaces.",
        "seo-workspace" => L.IsArabic ? "انتقل إلى التدقيق والاقتراحات والموافقات دون عرض نتائج SEO تجريبية." : "Open real audit, recommendation, and approval flows without prototype SEO results.",
        "ai-workspace" => L.IsArabic ? "إدارة مركز الذكاء الاصطناعي والمزودين والقوالب من مساحات التشغيل الفعلية." : "Manage the AI center, providers, and prompt templates in their real workspaces.",
        _ => L.IsArabic ? "افتح مركز التنفيذ والمزامنة والجدولة والسجلات والنسخ الاحتياطي والتقارير الفعلية." : "Open the real execution, synchronization, scheduling, logs, backup, and reporting workspaces."
    };

    private IReadOnlyList<WorkspaceItem> Items => Route switch
    {
        "content-workspace" =>
        [
            W("posts", "▣", "المقالات", "Posts", "إدارة ونشر مقالات WordPress الفعلية.", "Manage and publish real WordPress posts.", "/module/posts"),
            W("pages", "▧", "الصفحات", "Pages", "إدارة صفحات WordPress الفعلية.", "Manage real WordPress pages.", "/module/pages"),
            W("media", "◫", "مكتبة الوسائط", "Media Library", "إدارة الوسائط المتزامنة وعمليات الرفع الحقيقية.", "Manage synchronized media and real upload operations.", "/module/media"),
            W("taxonomy", "⌘", "التصنيفات والوسوم", "Categories & Tags", "إدارة التصنيفات عبر WordPress REST والمزامنة.", "Manage taxonomy through WordPress REST and synchronization.", "/module/taxonomy"),
            W("comments", "◌", "التعليقات", "Comments", "مراجعة واعتماد والرد على التعليقات الحقيقية.", "Moderate and reply to real WordPress comments.", "/module/comments"),
            W("users", "♟", "المستخدمون والأدوار", "Users & Roles", "إدارة مستخدمي WordPress والصلاحيات من مساحة المستخدمين.", "Manage WordPress users and roles in the users workspace.", "/module/users")
        ],
        "seo-workspace" =>
        [
            W("seo-audit", "◎", "تدقيق SEO", "SEO Audit", "اختر موقعًا وشغّل التحليل والتدقيق المحفوظ الفعلي.", "Choose a site and run real persisted SEO analysis and audits.", "/module/seo-audit"),
            W("seo-suggestions", "★", "اقتراحات SEO", "SEO Suggestions", "انتقل إلى نتائج المواقع الفعلية بدل اقتراحات ثابتة.", "Use real site results instead of static recommendations.", "/module/seo-suggestions"),
            W("approvals", "✓", "قائمة الموافقات", "Approval Queue", "مراجعة التغييرات الحقيقية قبل التنفيذ.", "Review real changes before execution.", "/approvals")
        ],
        "ai-workspace" =>
        [
            W("ai-center", "✦", "مركز الذكاء الاصطناعي", "AI Center", "افتح مساحة الذكاء الاصطناعي التشغيلية.", "Open the operational AI workspace.", "/ai-center"),
            W("ai-providers", "◈", "مزودو الذكاء الاصطناعي", "AI Providers", "إدارة اتصالات المزودين والمفاتيح والنماذج.", "Manage provider connections, keys, and models.", "/settings/ai-providers"),
            W("ai-prompts", "▤", "قوالب الأوامر", "Prompt Templates", "إدارة القوالب المحفوظة عبر مخزن القوالب الفعلي.", "Manage persisted templates through the real prompt store.", "/settings/ai-prompts"),
            W("approvals", "✓", "الموافقات", "Approvals", "مراجعة طلبات التنفيذ التي تتطلب موافقة.", "Review execution requests that require approval.", "/approvals")
        ],
        _ =>
        [
            W("execution", "▶", "مركز التنفيذ", "Execution Center", "متابعة المهام والتقدم والنتائج الفعلية.", "Track real jobs, progress, and results.", "/module/execution"),
            W("sync", "⟳", "المزامنة", "Synchronization", "تشغيل ومراجعة مزامنة WordPress مع SQLite.", "Run and inspect WordPress-to-SQLite synchronization.", "/module/sync"),
            W("schedules", "◷", "الجدولة", "Scheduling", "إدارة جداول التشغيل المحفوظة.", "Manage persisted execution schedules.", "/module/schedules"),
            W("logs", "!", "السجلات والأخطاء", "Logs & Errors", "عرض السجلات والأخطاء ومعرفات التتبع الفعلية.", "Inspect real logs, failures, and correlation IDs.", "/module/logs"),
            W("backups", "⬡", "النسخ الاحتياطي", "Backup & Restore", "إنشاء واستعادة النسخ من مساحة النسخ الفعلية.", "Create and restore backups in the real backup workspace.", "/module/backups"),
            W("reports", "▥", "التقارير والتصدير", "Reports & Exports", "فتح التقارير وعمليات التصدير الفعلية.", "Open real reports and export operations.", "/module/reports")
        ]
    };

    private static WorkspaceItem W(
        string key,
        string icon,
        string arabic,
        string english,
        string arabicDescription,
        string englishDescription,
        string href) =>
        new(key, icon, arabic, english, arabicDescription, englishDescription, href);

    private sealed record WorkspaceItem(
        string Key,
        string Icon,
        string Arabic,
        string English,
        string ArabicDescription,
        string EnglishDescription,
        string Href);
}
