@page "/account/profile"
@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@inject AppLanguageService L
@inject AppNotificationService Notifications

<PageTitle>@(L.IsArabic ? "حسابي" : "My Account")</PageTitle>

<div class="settings-page">
    <AppToolbar
        Eyebrow="@(L.IsArabic ? "إعدادات الحساب" : "ACCOUNT SETTINGS")"
        Title="@(L.IsArabic ? "حسابي" : "My Account")"
        Subtitle="@(L.IsArabic ? "راجع بيانات حسابك وحدّث كلمة المرور بأمان." : "Review your account details and update your password securely.")">
        <Actions>
            <AppButton Href="/account/email-settings" Icon="✉" Text="@(L.IsArabic ? "إعدادات بريد الداشبورد" : "Dashboard email settings")" />
        </Actions>
    </AppToolbar>

    @if (_loading)
    {
        <AppLoading Title="@(L.IsArabic ? "جارٍ تحميل الحساب" : "Loading account")" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <AppCard>
            <AppEmptyState Icon="!" Title="@(L.IsArabic ? "تعذر تحميل الحساب" : "Account could not be loaded")" Description="@_error" />
        </AppCard>
    }
    else if (_profile is not null)
    {
        <section class="app-stat-grid">
            <AppStatCard Icon="◎" Label="@(L.IsArabic ? "اسم المستخدم" : "Username")" Value="@_profile.UserName" Description="@_profile.UserId.ToString()" Tone="accent" />
            <AppStatCard Icon="◆" Label="@(L.IsArabic ? "الدور" : "Role")" Value="@_profile.Role" Description="@(_profile.IsActive ? (L.IsArabic ? "الحساب نشط" : "Account active") : (L.IsArabic ? "الحساب موقوف" : "Account inactive"))" Tone="info" />
            <AppStatCard Icon="◉" Label="@(L.IsArabic ? "المواقع" : "Sites")" Value="@_profile.SiteCount.ToString()" Description="@(L.IsArabic ? "مواقع WordPress المملوكة للحساب" : "WordPress sites owned by this account")" Tone="success" />
            <AppStatCard Icon="◷" Label="@(L.IsArabic ? "آخر دخول" : "Last login")" Value="@FormatDate(_profile.LastLoginAtUtc)" Description="@($"{(L.IsArabic ? "تاريخ إنشاء الحساب" : "Account created")}: {FormatDate(_profile.CreatedAtUtc)}")" Tone="neutral" />
        </section>

        <AppCard Eyebrow="@(L.IsArabic ? "الأمان" : "SECURITY")"
                 Title="@(L.IsArabic ? "تغيير كلمة المرور" : "Change password")"
                 Subtitle="@(L.IsArabic ? "أدخل كلمة المرور الحالية ثم اختر كلمة مرور جديدة قوية." : "Enter your current password, then choose a strong new password.")">
            <div data-form-ux aria-busy="@_working">
                <AppFormStatus Tone="@(_isError ? "error" : "success")"
                               Title="@(_isError ? (L.IsArabic ? "تعذر تغيير كلمة المرور" : "Password change failed") : (L.IsArabic ? "تم الحفظ" : "Saved"))"
                               Message="@_message"
                               RecoveryText="@(_isError ? (L.IsArabic ? "راجع الحقول أدناه وحاول مرة أخرى." : "Review the fields below and try again.") : null)" />

                <AppValidationSummary Messages="@_validationMessages"
                                      Title="@(L.IsArabic ? "راجع بيانات كلمة المرور" : "Review the password fields")"
                                      Description="@(L.IsArabic ? "صحح الحقول المحددة قبل إعادة المحاولة." : "Correct the highlighted fields before trying again.")" />

                <div class="form-ux-grid">
                    <AppFormField InputId="current-password"
                                  Label="@(L.IsArabic ? "كلمة المرور الحالية" : "Current password")"
                                  Required="true"
                                  RequiredText="@(L.IsArabic ? "مطلوب" : "Required")"
                                  HelperText="@(L.IsArabic ? "أدخل كلمة المرور المستخدمة حاليًا لهذا الحساب." : "Enter the password currently used for this account.")"
                                  Invalid="@HasValidationError(CurrentPasswordRequiredMessage)"
                                  ErrorText="@(HasValidationError(CurrentPasswordRequiredMessage) ? CurrentPasswordRequiredMessage : null)">
                        <InputText id="current-password"
                                   @bind-Value="_currentPassword"
                                   type="password"
                                   autocomplete="current-password"
                                   disabled="@_working"
                                   aria-invalid="@HasValidationError(CurrentPasswordRequiredMessage)"
                                   aria-describedby="current-password-help current-password-error" />
                    </AppFormField>

                    <AppFormField InputId="new-password"
                                  Label="@(L.IsArabic ? "كلمة المرور الجديدة" : "New password")"
                                  Required="true"
                                  RequiredText="@(L.IsArabic ? "مطلوب" : "Required")"
                                  HelperText="@(L.IsArabic ? "8 أحرف على الأقل مع حرف كبير وصغير ورقم." : "At least 8 characters with uppercase, lowercase, and a number.")"
                                  Invalid="@NewPasswordInvalid"
                                  ErrorText="@NewPasswordError">
                        <InputText id="new-password"
                                   @bind-Value="_newPassword"
                                   type="password"
                                   autocomplete="new-password"
                                   disabled="@_working"
                                   aria-invalid="@NewPasswordInvalid"
                                   aria-describedby="new-password-help new-password-error" />
                    </AppFormField>

                    <AppFormField InputId="confirm-password"
                                  Label="@(L.IsArabic ? "تأكيد كلمة المرور الجديدة" : "Confirm new password")"
                                  Required="true"
                                  RequiredText="@(L.IsArabic ? "مطلوب" : "Required")"
                                  HelperText="@(L.IsArabic ? "أعد كتابة كلمة المرور الجديدة بالضبط." : "Re-enter the new password exactly.")"
                                  Invalid="@ConfirmPasswordInvalid"
                                  ErrorText="@(ConfirmPasswordInvalid ? ConfirmationMessage : null)"
                                  Class="form-ux-full">
                        <InputText id="confirm-password"
                                   @bind-Value="_confirmPassword"
                                   type="password"
                                   autocomplete="new-password"
                                   disabled="@_working"
                                   aria-invalid="@ConfirmPasswordInvalid"
                                   aria-describedby="confirm-password-help confirm-password-error" />
                    </AppFormField>
                </div>

                <AppFormActions SaveText="@(L.IsArabic ? "تغيير كلمة المرور" : "Change password")"
                                SavingText="@(L.IsArabic ? "جارٍ التغيير" : "Changing")"
                                SaveAriaLabel="@(L.IsArabic ? "حفظ كلمة المرور الجديدة" : "Save new password")"
                                SaveIcon="🔒"
                                Busy="@_working"
                                Disabled="@(!PasswordFormHasValues)"
                                ShowCancel="false"
                                Hint="@(L.IsArabic ? "لن يتم حفظ كلمة المرور إلا بعد اجتياز جميع قواعد الأمان." : "The password is saved only after all security rules pass.")"
                                OnSave="ChangePasswordAsync" />
            </div>
        </AppCard>
    }
</div>

@code {
    private AccountProfileService AccountService => ActivatorUtilities.CreateInstance<AccountProfileService>(Services);
    private AccountProfileView? _profile;
    private bool _loading = true;
    private bool _working;
    private bool _isError;
    private bool _disposed;
    private string? _error;
    private string _message = string.Empty;
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private readonly List<string> _validationMessages = new();

    private string CurrentPasswordRequiredMessage => L.IsArabic ? "كلمة المرور الحالية مطلوبة." : "Current password is required.";
    private string NewPasswordLengthMessage => L.IsArabic ? "يجب ألا تقل كلمة المرور الجديدة عن 8 أحرف." : "The new password must contain at least 8 characters.";
    private string NewPasswordComplexityMessage => L.IsArabic ? "يجب أن تحتوي كلمة المرور الجديدة على حرف كبير وحرف صغير ورقم." : "The new password must contain uppercase, lowercase, and numeric characters.";
    private string NewPasswordDifferentMessage => L.IsArabic ? "يجب أن تختلف كلمة المرور الجديدة عن الحالية." : "The new password must be different from the current password.";
    private string ConfirmationMessage => L.IsArabic ? "تأكيد كلمة المرور غير مطابق." : "Password confirmation does not match.";
    private bool PasswordFormHasValues => !string.IsNullOrWhiteSpace(_currentPassword) || !string.IsNullOrWhiteSpace(_newPassword) || !string.IsNullOrWhiteSpace(_confirmPassword);
    private bool NewPasswordInvalid => HasValidationError(NewPasswordLengthMessage) || HasValidationError(NewPasswordComplexityMessage) || HasValidationError(NewPasswordDifferentMessage);
    private string? NewPasswordError => _validationMessages.FirstOrDefault(x => x == NewPasswordLengthMessage || x == NewPasswordComplexityMessage || x == NewPasswordDifferentMessage);
    private bool ConfirmPasswordInvalid => HasValidationError(ConfirmationMessage);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profile = await AccountService.GetAsync();
            if (_disposed) return;
            _profile = profile;
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed)
                _loading = false;
        }
    }

    private bool HasValidationError(string message) => _validationMessages.Contains(message, StringComparer.Ordinal);

    private bool ValidatePasswordForm()
    {
        _validationMessages.Clear();
        if (string.IsNullOrWhiteSpace(_currentPassword)) _validationMessages.Add(CurrentPasswordRequiredMessage);
        if (_newPassword.Length < 8) _validationMessages.Add(NewPasswordLengthMessage);
        if (!_newPassword.Any(char.IsUpper) || !_newPassword.Any(char.IsLower) || !_newPassword.Any(char.IsDigit)) _validationMessages.Add(NewPasswordComplexityMessage);
        if (!string.IsNullOrEmpty(_currentPassword) && string.Equals(_currentPassword, _newPassword, StringComparison.Ordinal)) _validationMessages.Add(NewPasswordDifferentMessage);
        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal)) _validationMessages.Add(ConfirmationMessage);
        return _validationMessages.Count == 0;
    }

    private async Task ChangePasswordAsync(MouseEventArgs _)
    {
        if (_disposed || _working) return;
        _message = string.Empty;
        _isError = false;
        if (!ValidatePasswordForm())
        {
            _isError = true;
            return;
        }

        try
        {
            _working = true;
            var result = await AccountService.ChangePasswordAsync(_currentPassword, _newPassword, _confirmPassword);
            if (_disposed) return;

            _isError = !result.IsSuccess;
            _message = L.IsArabic ? Translate(result.Message) : result.Message;

            if (result.IsSuccess)
            {
                _currentPassword = string.Empty;
                _newPassword = string.Empty;
                _confirmPassword = string.Empty;
                _validationMessages.Clear();
                Notifications.Success(_message);
            }
            else
            {
                Notifications.Error(_message);
            }
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _isError = true;
            _message = ex.Message;
            Notifications.Error(_message);
        }
        finally
        {
            if (!_disposed)
                _working = false;
        }
    }

    private string FormatDate(DateTime? value) => value is null
        ? (L.IsArabic ? "غير متاح" : "Not available")
        : value.Value.ToLocalTime().ToString(L.IsArabic ? "yyyy-MM-dd HH:mm" : "MMM d, yyyy HH:mm");

    private static string Translate(string message) => message switch
    {
        "The current password is incorrect." => "كلمة المرور الحالية غير صحيحة.",
        "The new password must contain at least 8 characters." => "يجب ألا تقل كلمة المرور الجديدة عن 8 أحرف.",
        "The new password must contain uppercase, lowercase, and numeric characters." => "يجب أن تحتوي كلمة المرور الجديدة على حرف كبير وحرف صغير ورقم.",
        "Password confirmation does not match." => "تأكيد كلمة المرور غير مطابق.",
        "The new password must be different from the current password." => "يجب أن تختلف كلمة المرور الجديدة عن الحالية.",
        "Password changed successfully." => "تم تغيير كلمة المرور بنجاح.",
        _ => message
    };

    public void Dispose()
    {
        _disposed = true;
    }
}
