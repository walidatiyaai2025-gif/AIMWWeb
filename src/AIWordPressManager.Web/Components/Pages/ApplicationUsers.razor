@page "/admin/application-users"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator")]
@implements IDisposable
@inject IServiceProvider Services
@inject AppLanguageService L

<PageTitle>@(L.IsArabic ? "إدارة مستخدمي التطبيق" : "Application Users")</PageTitle>

@if (_loading)
{
    <AppLoading Title="@(L.IsArabic ? "تحميل المستخدمين" : "Loading users")"
                Message="@(L.IsArabic ? "يتم تحميل حسابات التطبيق وحالة الأمان." : "Loading application accounts and security state.")" />
}
else
{
    <div class="application-users-page" dir="@(L.IsArabic ? "rtl" : "ltr")">
        <AppToolbar Eyebrow="@(L.IsArabic ? "الأمان والإدارة" : "SECURITY & ADMINISTRATION")"
                    Title="@(L.IsArabic ? "مستخدمو التطبيق" : "Application users")"
                    Subtitle="@(L.IsArabic ? "إنشاء الحسابات وإدارتها وفك القفل وإعادة تعيين كلمات المرور ومراجعة محاولات الدخول." : "Create accounts, manage access, unlock users, reset passwords, and review sign-in history.")">
            <Actions>
                <AppButton Icon="↻" Text="@(L.IsArabic ? "تحديث" : "Refresh")" Busy="@_working" Disabled="@_working" OnClick="RefreshClickedAsync" />
                <a class="app-button" href="/admin/roles-permissions">@(L.IsArabic ? "الأدوار والصلاحيات" : "Roles & permissions")</a>
                <AppButton Variant="primary" Icon="＋" Text="@(L.IsArabic ? "مستخدم جديد" : "New user")" Disabled="@_working" OnClick="StartCreateClicked" />
            </Actions>
        </AppToolbar>

        <AppFormStatus Tone="@(_isError ? "error" : "success")"
                       Title="@(_isError ? (L.IsArabic ? "تعذر تنفيذ العملية" : "Action failed") : (L.IsArabic ? "تم التنفيذ" : "Action completed"))"
                       Message="@_message"
                       RecoveryText="@(_isError ? (L.IsArabic ? "راجع البيانات أو حالة الحساب ثم أعد المحاولة." : "Review the form or account state and try again.") : null)" />

        <section class="app-stat-grid">
            <AppStatCard Icon="◎" Label="@(L.IsArabic ? "إجمالي المستخدمين" : "Total users")" Value="@_users.Count.ToString()" />
            <AppStatCard Icon="✓" Label="@(L.IsArabic ? "نشط" : "Active")" Value="@_users.Count(x => x.IsActive).ToString()" Tone="success" />
            <AppStatCard Icon="⌁" Label="@(L.IsArabic ? "مقفل الآن" : "Locked now")" Value="@_users.Count(x => x.LockedUntilUtc > DateTime.UtcNow).ToString()" Tone="warning" />
            <AppStatCard Icon="◆" Label="@(L.IsArabic ? "مديرون" : "Administrators")" Value="@_users.Count(x => x.Role == ApplicationRoles.Administrator && x.IsActive).ToString()" Tone="info" />
        </section>

        <AppCard>
            <div class="admin-users-filter">
                <input @bind="_search" @bind:event="oninput" placeholder="@(L.IsArabic ? "بحث باسم المستخدم..." : "Search username...")" aria-label="@(L.IsArabic ? "بحث باسم المستخدم" : "Search by username")" />
                <AppButton Variant="primary" Text="@(L.IsArabic ? "بحث" : "Search")" Disabled="@_working" OnClick="SearchClickedAsync" />
                @if (!string.IsNullOrWhiteSpace(_search))
                {
                    <AppButton Text="@(L.IsArabic ? "مسح" : "Clear")" Disabled="@_working" OnClick="ClearSearchClickedAsync" />
                }
            </div>
        </AppCard>

        <div class="admin-users-layout">
            <section>
                <AppCard>
                    <div class="admin-users-table-wrap">
                        <table class="admin-users-table">
                            <thead><tr>
                                <th>@(L.IsArabic ? "المستخدم" : "User")</th><th>@(L.IsArabic ? "الدور" : "Role")</th>
                                <th>@(L.IsArabic ? "الحالة" : "Status")</th><th>@(L.IsArabic ? "محاولات فاشلة" : "Failed attempts")</th>
                                <th>@(L.IsArabic ? "آخر دخول" : "Last login")</th><th>@(L.IsArabic ? "إجراءات" : "Actions")</th>
                            </tr></thead>
                            <tbody>
                            @if (_users.Count == 0)
                            {
                                <tr><td colspan="6" class="empty-cell">@(L.IsArabic ? "لا توجد حسابات مطابقة." : "No matching accounts.")</td></tr>
                            }
                            @foreach (var user in _users)
                            {
                                <tr class="@(_selectedId == user.Id ? "selected" : null)">
                                    <td><strong>@user.UserName</strong></td><td>@RoleText(user.Role)</td>
                                    <td>
                                        <AppBadge Tone="@(user.IsActive ? "success" : "danger")" Text="@(user.IsActive ? (L.IsArabic ? "نشط" : "Active") : (L.IsArabic ? "معطل" : "Disabled"))" />
                                        @if (user.LockedUntilUtc > DateTime.UtcNow) { <AppBadge Tone="warning" Text="@(L.IsArabic ? "مقفل" : "Locked")" /> }
                                    </td>
                                    <td>@user.FailedAccessCount</td><td>@FormatDate(user.LastLoginAtUtc)</td>
                                    <td><div class="row-actions">
                                        <AppButton Size="small" Text="@(L.IsArabic ? "تعديل" : "Edit")" Disabled="@_working" OnClick="_ => SelectUserAsync(user)" />
                                        @if (user.LockedUntilUtc > DateTime.UtcNow || user.FailedAccessCount > 0)
                                        { <AppButton Size="small" Text="@(L.IsArabic ? "فك القفل" : "Unlock")" Disabled="@_working" OnClick="_ => UnlockAsync(user)" /> }
                                        <AppButton Size="small" Variant="@(user.IsActive ? "danger" : "primary")"
                                                   Text="@(user.IsActive ? (L.IsArabic ? "تعطيل" : "Disable") : (L.IsArabic ? "تفعيل" : "Enable"))"
                                                   Disabled="@_working" OnClick="_ => RequestSetActiveAsync(user, !user.IsActive)" />
                                    </div></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </AppCard>
            </section>

            <aside>
                <AppSection Title="@(_selectedId.HasValue ? (L.IsArabic ? "تعديل الحساب" : "Edit account") : (L.IsArabic ? "إنشاء حساب" : "Create account"))"
                            Subtitle="@(L.IsArabic ? "عيّن أقل دور يحقق احتياج المستخدم. يمكن مراجعة المصفوفة الكاملة من صفحة الأدوار والصلاحيات." : "Assign the least-privileged role that fits the user. Review the full matrix in Roles & permissions.")">
                    <ChildContent>
                        <div class="admin-user-form" data-form-ux aria-busy="@_working">
                            <AppValidationSummary Messages="@_editorValidation"
                                                  Title="@(L.IsArabic ? "راجع بيانات الحساب" : "Review account details")" />
                            <AppFormField InputId="admin-user-name"
                                          Label="@(L.IsArabic ? "اسم المستخدم" : "Username")"
                                          Required="true"
                                          RequiredText="@(L.IsArabic ? "مطلوب" : "Required")"
                                          HelperText="@(L.IsArabic ? "استخدم اسمًا واضحًا وفريدًا للحساب." : "Use a clear, unique username for the account.")"
                                          Invalid="@HasEditorError(UserNameRequiredMessage)"
                                          ErrorText="@(HasEditorError(UserNameRequiredMessage) ? UserNameRequiredMessage : null)">
                                <input id="admin-user-name" @bind="_userName" disabled="@_working" aria-invalid="@HasEditorError(UserNameRequiredMessage)" aria-describedby="admin-user-name-help admin-user-name-error" />
                            </AppFormField>
                            <AppFormField InputId="admin-user-role"
                                          Label="@(L.IsArabic ? "الدور" : "Role")"
                                          HelperText="@(L.IsArabic ? "اختر Administrator فقط لإدارة الحسابات والأمان. الأدوار الأخرى تتبع مبدأ أقل صلاحية." : "Choose Administrator only for account and security administration. Other roles follow least privilege.")">
                                <select id="admin-user-role" @bind="_role" disabled="@_working" aria-describedby="admin-user-role-help">
                                    @foreach (var role in ApplicationRoles.All.Where(x => !x.IsLegacy))
                                    {
                                        <option value="@role.Name">@(L.IsArabic ? role.ArabicName : role.EnglishName)</option>
                                    }
                                    @if (string.Equals(_role, ApplicationRoles.LegacyUser, StringComparison.Ordinal))
                                    {
                                        <option value="@ApplicationRoles.LegacyUser">@(L.IsArabic ? "مستخدم قديم (توافق)" : "Legacy user (compatibility)")</option>
                                    }
                                </select>
                            </AppFormField>
                            @if (!_selectedId.HasValue)
                            {
                                <AppFormField InputId="admin-user-password"
                                              Label="@(L.IsArabic ? "كلمة المرور" : "Password")"
                                              Required="true"
                                              RequiredText="@(L.IsArabic ? "مطلوب" : "Required")"
                                              HelperText="@(L.IsArabic ? "مطلوبة عند إنشاء حساب جديد." : "Required when creating a new account.")"
                                              Invalid="@HasEditorError(CreatePasswordRequiredMessage)"
                                              ErrorText="@(HasEditorError(CreatePasswordRequiredMessage) ? CreatePasswordRequiredMessage : null)">
                                    <input id="admin-user-password" type="password" @bind="_password" autocomplete="new-password" disabled="@_working" aria-invalid="@HasEditorError(CreatePasswordRequiredMessage)" aria-describedby="admin-user-password-help admin-user-password-error" />
                                </AppFormField>
                                <AppFormField InputId="admin-user-confirm-password"
                                              Label="@(L.IsArabic ? "تأكيد كلمة المرور" : "Confirm password")"
                                              Required="true"
                                              RequiredText="@(L.IsArabic ? "مطلوب" : "Required")"
                                              HelperText="@(L.IsArabic ? "أعد كتابة كلمة المرور نفسها." : "Re-enter the same password.")"
                                              Invalid="@HasEditorError(CreatePasswordMismatchMessage)"
                                              ErrorText="@(HasEditorError(CreatePasswordMismatchMessage) ? CreatePasswordMismatchMessage : null)">
                                    <input id="admin-user-confirm-password" type="password" @bind="_confirmPassword" autocomplete="new-password" disabled="@_working" aria-invalid="@HasEditorError(CreatePasswordMismatchMessage)" aria-describedby="admin-user-confirm-password-help admin-user-confirm-password-error" />
                                </AppFormField>
                            }
                            <AppFormActions SaveText="@(_selectedId.HasValue ? (L.IsArabic ? "حفظ" : "Save") : (L.IsArabic ? "إنشاء" : "Create"))"
                                            SavingText="@(L.IsArabic ? "جارٍ الحفظ" : "Saving")"
                                            CancelText="@(L.IsArabic ? "إلغاء" : "Cancel")"
                                            Busy="@_working"
                                            OnSave="SaveClickedAsync"
                                            OnCancel="CancelClicked" />
                        </div>
                    </ChildContent>
                </AppSection>

                @if (_selectedId.HasValue)
                {
                    <AppSection Title="@(L.IsArabic ? "إعادة تعيين كلمة المرور" : "Reset password")"><ChildContent>
                        <div class="admin-user-form" data-form-ux aria-busy="@_working">
                            <AppValidationSummary Messages="@_resetValidation"
                                                  Title="@(L.IsArabic ? "راجع كلمة المرور الجديدة" : "Review the new password")" />
                            <AppFormField InputId="admin-reset-password"
                                          Label="@(L.IsArabic ? "كلمة المرور الجديدة" : "New password")"
                                          Required="true"
                                          RequiredText="@(L.IsArabic ? "مطلوب" : "Required")"
                                          Invalid="@HasResetError(ResetPasswordRequiredMessage)"
                                          ErrorText="@(HasResetError(ResetPasswordRequiredMessage) ? ResetPasswordRequiredMessage : null)">
                                <input id="admin-reset-password" type="password" @bind="_resetPassword" autocomplete="new-password" disabled="@_working" aria-invalid="@HasResetError(ResetPasswordRequiredMessage)" aria-describedby="admin-reset-password-error" />
                            </AppFormField>
                            <AppFormField InputId="admin-reset-confirm-password"
                                          Label="@(L.IsArabic ? "التأكيد" : "Confirmation")"
                                          Required="true"
                                          RequiredText="@(L.IsArabic ? "مطلوب" : "Required")"
                                          Invalid="@HasResetError(ResetPasswordMismatchMessage)"
                                          ErrorText="@(HasResetError(ResetPasswordMismatchMessage) ? ResetPasswordMismatchMessage : null)">
                                <input id="admin-reset-confirm-password" type="password" @bind="_resetConfirmPassword" autocomplete="new-password" disabled="@_working" aria-invalid="@HasResetError(ResetPasswordMismatchMessage)" aria-describedby="admin-reset-confirm-password-error" />
                            </AppFormField>
                            <AppButton Variant="primary" Text="@(L.IsArabic ? "مراجعة وإعادة تعيين" : "Review reset")" Disabled="@_working" OnClick="RequestResetPasswordAsync" />
                        </div>
                    </ChildContent></AppSection>
                    <AppSection Title="@(L.IsArabic ? "آخر محاولات الدخول" : "Recent sign-in audit")"><ChildContent>
                        @if (_audits.Count == 0) { <p class="muted">@(L.IsArabic ? "لا توجد محاولات مسجلة لهذا المستخدم." : "No recorded sign-in attempts for this user.")</p> }
                        else { <div class="audit-list">@foreach (var audit in _audits.Take(10)) { <div class="audit-item"><strong>@(audit.Succeeded ? (L.IsArabic ? "نجاح" : "Success") : (L.IsArabic ? "فشل" : "Failed"))</strong><span>@audit.Reason</span><small>@FormatDate(audit.AttemptedAtUtc) · @audit.IpAddress</small></div> }</div> }
                    </ChildContent></AppSection>
                }
            </aside>
        </div>
    </div>
}

<AppConfirmDialog Open="@_disableConfirmationOpen"
                  OpenChanged="DisableConfirmationOpenChangedAsync"
                  Title="@(L.IsArabic ? "تأكيد تعطيل الحساب" : "Confirm account disable")"
                  Eyebrow="@(L.IsArabic ? "تغيير وصول" : "ACCESS CHANGE")"
                  Message="@(L.IsArabic ? $"سيتم منع {PendingDisableUserName} من تسجيل الدخول حتى تتم إعادة تفعيل الحساب." : $"{PendingDisableUserName} will be prevented from signing in until the account is enabled again.")"
                  ImpactLabel="@(L.IsArabic ? "التأثير" : "Impact")"
                  ImpactText="@(L.IsArabic ? "الجلسات الجديدة ستُمنع، لكن بيانات الحساب وسجل التدقيق لن تُحذف." : "New sign-ins will be blocked, but the account data and audit history are not deleted.")"
                  RecoveryLabel="@(L.IsArabic ? "الاستعادة" : "Recovery")"
                  RecoveryText="@(L.IsArabic ? "يمكن للمسؤول إعادة تفعيل الحساب لاحقًا من نفس الشاشة." : "An administrator can enable the account again from this screen.")"
                  ConfirmText="@(L.IsArabic ? "تعطيل الحساب" : "Disable account")"
                  CancelText="@(L.IsArabic ? "إلغاء" : "Cancel")"
                  Busy="@_working"
                  OnConfirm="ConfirmDisableAsync" />

<AppConfirmDialog Open="@_resetConfirmationOpen"
                  OpenChanged="ResetConfirmationOpenChangedAsync"
                  Title="@(L.IsArabic ? "تأكيد إعادة تعيين كلمة المرور" : "Confirm password reset")"
                  Eyebrow="@(L.IsArabic ? "إجراء أمني" : "SECURITY ACTION")"
                  Message="@(L.IsArabic ? $"سيتم استبدال كلمة مرور {SelectedUserName}." : $"The password for {SelectedUserName} will be replaced.")"
                  ImpactLabel="@(L.IsArabic ? "التأثير" : "Impact")"
                  ImpactText="@(L.IsArabic ? "كلمة المرور القديمة لن تعمل بعد نجاح العملية، وسيتم مسح حالة القفل حسب منطق الخدمة الحالي." : "The old password will stop working after success, and lockout state is cleared by the existing service behavior.")"
                  RecoveryLabel="@(L.IsArabic ? "الاستعادة" : "Recovery")"
                  RecoveryText="@(L.IsArabic ? "إذا لزم الأمر يمكن للمسؤول تعيين كلمة مرور جديدة مرة أخرى." : "An administrator can perform another reset later if needed.")"
                  RequiredConfirmationText="@SelectedUserName"
                  ConfirmationLabel="@(L.IsArabic ? "اكتب اسم المستخدم للتأكيد" : "Type the username to confirm")"
                  ConfirmationHelper="@(L.IsArabic ? "اكتب اسم المستخدم كما هو ظاهر قبل تنفيذ إعادة التعيين." : "Type the displayed username before the reset can run.")"
                  ConfirmationErrorText="@(L.IsArabic ? "اسم المستخدم غير مطابق." : "The username does not match.")"
                  ConfirmText="@(L.IsArabic ? "إعادة تعيين كلمة المرور" : "Reset password")"
                  CancelText="@(L.IsArabic ? "إلغاء" : "Cancel")"
                  Busy="@_working"
                  OnConfirm="ConfirmResetPasswordAsync" />

@code {
    private ApplicationUserAdministrationService _service = default!;
    private IReadOnlyList<ApplicationUserSummary> _users = [];
    private IReadOnlyList<LoginAuditDto> _audits = [];
    private readonly List<string> _editorValidation = new();
    private readonly List<string> _resetValidation = new();
    private Guid? _selectedId;
    private ApplicationUserSummary? _pendingDisableUser;
    private string _search = string.Empty, _userName = string.Empty, _role = ApplicationRoles.Operator, _password = string.Empty, _confirmPassword = string.Empty, _resetPassword = string.Empty, _resetConfirmPassword = string.Empty;
    private string? _message;
    private bool _loading = true, _working, _isError, _disableConfirmationOpen, _resetConfirmationOpen;

    private string UserNameRequiredMessage => L.IsArabic ? "اسم المستخدم مطلوب." : "Username is required.";
    private string CreatePasswordRequiredMessage => L.IsArabic ? "كلمة المرور مطلوبة عند إنشاء مستخدم." : "Password is required when creating a user.";
    private string CreatePasswordMismatchMessage => L.IsArabic ? "تأكيد كلمة المرور غير مطابق." : "Password confirmation does not match.";
    private string ResetPasswordRequiredMessage => L.IsArabic ? "كلمة المرور الجديدة مطلوبة." : "A new password is required.";
    private string ResetPasswordMismatchMessage => L.IsArabic ? "تأكيد كلمة المرور الجديدة غير مطابق." : "New password confirmation does not match.";
    private string PendingDisableUserName => _pendingDisableUser?.UserName ?? (L.IsArabic ? "هذا المستخدم" : "this user");
    private string SelectedUserName => _selectedId.HasValue ? (_users.FirstOrDefault(x => x.Id == _selectedId.Value)?.UserName ?? _userName) : _userName;

    protected override void OnInitialized()
    {
        L.Changed += LanguageChanged;
        _service = Microsoft.Extensions.DependencyInjection.ActivatorUtilities.CreateInstance<ApplicationUserAdministrationService>(Services);
    }

    protected override async Task OnInitializedAsync() { await LoadAsync(); _loading = false; }

    private async Task LoadAsync()
    {
        try { _working = true; _users = await _service.ListAsync(_search); _isError = false; }
        catch (Exception ex) { _isError = true; _message = ex.Message; }
        finally { _working = false; }
    }

    private Task RefreshClickedAsync(MouseEventArgs _) => LoadAsync();
    private Task SearchClickedAsync(MouseEventArgs _) => LoadAsync();
    private async Task ClearSearchClickedAsync(MouseEventArgs _) { _search = string.Empty; await LoadAsync(); }
    private Task StartCreateClicked(MouseEventArgs _) { ClearEditor(); return Task.CompletedTask; }
    private Task CancelClicked(MouseEventArgs _) { ClearEditor(); return Task.CompletedTask; }

    private async Task SelectUserAsync(ApplicationUserSummary user)
    {
        _selectedId = user.Id; _userName = user.UserName; _role = ApplicationRoles.Normalize(user.Role);
        if (_role.Length == 0) _role = ApplicationRoles.LegacyUser;
        _password = _confirmPassword = _resetPassword = _resetConfirmPassword = string.Empty;
        _editorValidation.Clear(); _resetValidation.Clear();
        _audits = await _service.GetLoginAuditAsync(user.Id); _message = null;
    }

    private bool HasEditorError(string message) => _editorValidation.Contains(message, StringComparer.Ordinal);
    private bool HasResetError(string message) => _resetValidation.Contains(message, StringComparer.Ordinal);

    private bool ValidateEditor()
    {
        _editorValidation.Clear();
        if (string.IsNullOrWhiteSpace(_userName)) _editorValidation.Add(UserNameRequiredMessage);
        if (!_selectedId.HasValue)
        {
            if (string.IsNullOrWhiteSpace(_password)) _editorValidation.Add(CreatePasswordRequiredMessage);
            if (!string.Equals(_password, _confirmPassword, StringComparison.Ordinal)) _editorValidation.Add(CreatePasswordMismatchMessage);
        }
        return _editorValidation.Count == 0;
    }

    private bool ValidateReset()
    {
        _resetValidation.Clear();
        if (string.IsNullOrWhiteSpace(_resetPassword)) _resetValidation.Add(ResetPasswordRequiredMessage);
        if (!string.Equals(_resetPassword, _resetConfirmPassword, StringComparison.Ordinal)) _resetValidation.Add(ResetPasswordMismatchMessage);
        return _resetValidation.Count == 0;
    }

    private async Task SaveClickedAsync(MouseEventArgs _)
    {
        _message = null; _isError = false;
        if (!ValidateEditor()) { _isError = true; return; }
        var creating = !_selectedId.HasValue;
        await ExecuteAsync(async () => _selectedId.HasValue
            ? await _service.UpdateAsync(_selectedId.Value, _userName.Trim(), _role)
            : await _service.CreateAsync(_userName.Trim(), _password, _confirmPassword, _role),
            L.IsArabic ? "تم حفظ حساب المستخدم." : "Application user saved.", creating);
    }

    private async Task RequestSetActiveAsync(ApplicationUserSummary user, bool active)
    {
        if (_working) return;
        if (active)
        {
            await SetActiveCoreAsync(user, true);
            return;
        }
        _pendingDisableUser = user;
        _disableConfirmationOpen = true;
    }

    private Task DisableConfirmationOpenChangedAsync(bool value)
    {
        if (!_working) _disableConfirmationOpen = value;
        if (!value && !_working) _pendingDisableUser = null;
        return Task.CompletedTask;
    }

    private async Task ConfirmDisableAsync()
    {
        var user = _pendingDisableUser;
        if (user is null || _working) return;
        await SetActiveCoreAsync(user, false);
        if (!_isError) _disableConfirmationOpen = false;
        _pendingDisableUser = null;
    }

    private Task SetActiveCoreAsync(ApplicationUserSummary user, bool active) => ExecuteAsync(
        () => _service.SetActiveAsync(user.Id, active),
        active ? (L.IsArabic ? "تم تفعيل الحساب." : "Account enabled.") : (L.IsArabic ? "تم تعطيل الحساب." : "Account disabled."));

    private Task UnlockAsync(ApplicationUserSummary user) => ExecuteAsync(() => _service.UnlockAsync(user.Id), L.IsArabic ? "تم فك قفل الحساب." : "Account unlocked.");

    private Task ResetConfirmationOpenChangedAsync(bool value)
    {
        if (!_working) _resetConfirmationOpen = value;
        return Task.CompletedTask;
    }

    private Task RequestResetPasswordAsync(MouseEventArgs _)
    {
        _message = null; _isError = false;
        if (!_selectedId.HasValue) return Task.CompletedTask;
        if (!ValidateReset()) { _isError = true; return Task.CompletedTask; }
        _resetConfirmationOpen = true;
        return Task.CompletedTask;
    }

    private async Task ConfirmResetPasswordAsync()
    {
        if (!_selectedId.HasValue || _working) return;
        await ExecuteAsync(() => _service.ResetPasswordAsync(_selectedId.Value, _resetPassword, _resetConfirmPassword), L.IsArabic ? "تم تغيير كلمة المرور وفك القفل." : "Password reset and lockout cleared.");
        if (!_isError)
        {
            _resetPassword = _resetConfirmPassword = string.Empty;
            _resetValidation.Clear();
            _resetConfirmationOpen = false;
        }
    }

    private async Task ExecuteAsync(Func<Task<UserAdministrationResult>> action, string successMessage, bool clearEditorOnSuccess = false)
    {
        try
        {
            _working = true;
            var result = await action(); _isError = !result.IsSuccess; _message = result.IsSuccess ? successMessage : result.Message;
            if (result.IsSuccess)
            {
                await LoadAsync();
                if (clearEditorOnSuccess) ClearEditor(keepMessage: true);
                else if (_selectedId.HasValue) _audits = await _service.GetLoginAuditAsync(_selectedId.Value);
            }
        }
        catch (Exception ex) { _isError = true; _message = ex.Message; }
        finally { _working = false; }
    }

    private void ClearEditor(bool keepMessage = false)
    {
        _selectedId = null; _pendingDisableUser = null; _userName = _password = _confirmPassword = _resetPassword = _resetConfirmPassword = string.Empty; _role = ApplicationRoles.Operator; _audits = [];
        _editorValidation.Clear(); _resetValidation.Clear(); _disableConfirmationOpen = false; _resetConfirmationOpen = false;
        if (!keepMessage) { _message = null; _isError = false; }
    }

    private string RoleText(string role)
    {
        var definition = ApplicationRoles.Find(role);
        if (definition is null) return role;
        return L.IsArabic ? definition.ArabicName : definition.EnglishName;
    }

    private string FormatDate(DateTime? value) => value is null ? "—" : value.Value.ToLocalTime().ToString(L.IsArabic ? "yyyy-MM-dd HH:mm" : "MMM d, yyyy HH:mm");
    private void LanguageChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= LanguageChanged;
}