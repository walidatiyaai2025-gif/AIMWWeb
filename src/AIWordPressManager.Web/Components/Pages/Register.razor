@page "/register"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using AIWordPressManager.Application.Abstractions.Billing
@using AIWordPressManager.Domain.Entities
@inject LocalAuthenticationService Authentication
@inject ISubscriptionPlanCatalog Plans
@inject IAccountSubscriptionService Subscriptions
@inject NavigationManager Navigation

<PageTitle>Create account - AI WordPress Manager</PageTitle>

<div class="auth-page">
    <section class="auth-card">
        <div class="auth-brand">AI WordPress Manager</div>
        <div class="trial-chip">14-DAY FREE TRIAL · NO CARD REQUIRED</div>
        <h1>Create your account</h1>
        <p class="auth-subtitle">Start with one WordPress site, limited AI usage and core automation. Upgrade only when you need more capacity.</p>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="auth-alert @(_isError ? "error" : "success")">@_message</div>
        }

        <EditForm Model="_model" OnValidSubmit="RegisterAsync" FormName="register-account">
            <DataAnnotationsValidator />

            <label for="register-user">Username</label>
            <InputText id="register-user" @bind-Value="_model.UserName" autocomplete="username" disabled="@_working" />

            <label for="register-password">Password</label>
            <InputText id="register-password" type="password" @bind-Value="_model.Password" autocomplete="new-password" disabled="@_working" />
            <small>At least 8 characters with uppercase, lowercase, and a number.</small>

            <label for="register-confirm">Confirm password</label>
            <InputText id="register-confirm" type="password" @bind-Value="_model.ConfirmPassword" autocomplete="new-password" disabled="@_working" />

            <button class="auth-submit" type="submit" disabled="@_working">
                @(_working ? "Creating your workspace..." : "Start free trial")
            </button>
        </EditForm>

        <div class="trial-limits" aria-label="Free trial limits">
            <span>✓ 1 WordPress site</span>
            <span>✓ 50 AI requests / month</span>
            <span>✓ 1 automation schedule</span>
            <span>✓ 3-day backup retention</span>
        </div>

        <div class="auth-footer">
            Already registered? <a href="/login">Sign in</a>
        </div>
    </section>
</div>

@code {
    private const string FreeTrialPlanCode = "free-trial";
    private readonly RegisterModel _model = new();
    private bool _working;
    private bool _isError;
    private string? _message;

    private async Task RegisterAsync()
    {
        try
        {
            _working = true;
            _message = null;
            var result = await Authentication.RegisterAsync(_model.UserName, _model.Password, _model.ConfirmPassword);
            _isError = !result.IsSuccess;

            if (!result.IsSuccess)
            {
                _message = result.Message;
                return;
            }

            if (!result.UserId.HasValue)
                throw new InvalidOperationException("The account was created without a usable identity.");

            var freeTrial = await Plans.GetByCodeAsync(FreeTrialPlanCode);
            if (freeTrial is null || !freeTrial.IsEnabled)
                throw new InvalidOperationException("The free trial plan is currently unavailable. The account was created; contact an administrator to assign a subscription.");

            if (await Subscriptions.GetCurrentAsync(result.UserId.Value) is null)
            {
                var now = DateTime.UtcNow;
                var trialDays = Math.Max(1, freeTrial.TrialDays);
                await Subscriptions.CreateAsync(new AccountSubscriptionCreateRequest(
                    result.UserId.Value,
                    freeTrial.Id,
                    AccountSubscriptionStatus.Trialing,
                    now,
                    now.AddDays(trialDays)));
            }

            _message = $"Account created. Your {Math.Max(1, freeTrial.TrialDays)}-day free trial is ready. Redirecting to sign in...";
            await Task.Delay(700);
            Navigation.NavigateTo("/login?registered=true", forceLoad: true);
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _working = false;
        }
    }

    private sealed class RegisterModel
    {
        public string UserName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}