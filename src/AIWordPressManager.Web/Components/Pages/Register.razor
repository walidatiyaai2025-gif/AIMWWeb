@page "/register"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject LocalAuthenticationService Authentication
@inject NavigationManager Navigation

<PageTitle>Create account - AI WordPress Manager</PageTitle>

<div class="auth-page">
    <section class="auth-card">
        <div class="auth-brand">AI WordPress Manager</div>
        <h1>Create your account</h1>
        <p class="auth-subtitle">Register first, then connect and manage your own WordPress sites.</p>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="auth-alert @(_isError ? "error" : "success")">@_message</div>
        }

        <EditForm Model="_model" OnValidSubmit="RegisterAsync" FormName="register-account">
            <DataAnnotationsValidator />

            <label for="register-user">Username</label>
            <InputText id="register-user" @bind-Value="_model.UserName" autocomplete="username" disabled="@_working" />

            <label for="register-password">Password</label>
            <InputText id="register-password" type="password" @bind-Value="_model.Password" autocomplete="new-password" disabled="@_working" />
            <small>At least 8 characters with uppercase, lowercase, and a number.</small>

            <label for="register-confirm">Confirm password</label>
            <InputText id="register-confirm" type="password" @bind-Value="_model.ConfirmPassword" autocomplete="new-password" disabled="@_working" />

            <button class="auth-submit" type="submit" disabled="@_working">
                @(_working ? "Creating account..." : "Create account")
            </button>
        </EditForm>

        <div class="auth-footer">
            Already registered? <a href="/login">Sign in</a>
        </div>
    </section>
</div>

@code {
    private readonly RegisterModel _model = new();
    private bool _working;
    private bool _isError;
    private string? _message;

    private async Task RegisterAsync()
    {
        try
        {
            _working = true;
            _message = null;
            var result = await Authentication.RegisterAsync(_model.UserName, _model.Password, _model.ConfirmPassword);
            _isError = !result.IsSuccess;

            if (!result.IsSuccess)
            {
                _message = result.Message;
                return;
            }

            _message = "Account created successfully. Redirecting to sign in...";
            await Task.Delay(700);
            Navigation.NavigateTo("/login?registered=true", forceLoad: true);
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _working = false;
        }
    }

    private sealed class RegisterModel
    {
        public string UserName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}

<style>
.auth-page{min-height:100vh;display:grid;place-items:center;padding:24px;background:#111827;color:#f9fafb;font-family:Segoe UI,Arial,sans-serif}.auth-card{width:min(440px,100%);background:#1f2937;padding:34px;border:1px solid #374151;border-radius:18px;box-shadow:0 24px 70px rgba(0,0,0,.42)}.auth-brand{color:#d4af37;font-weight:800;letter-spacing:.04em;margin-bottom:18px}.auth-card h1{margin:0 0 8px;font-size:1.9rem}.auth-subtitle{margin:0 0 22px;color:#9ca3af;line-height:1.55}.auth-card label{display:block;margin:15px 0 7px;font-weight:700}.auth-card input{width:100%;box-sizing:border-box;padding:12px 13px;border-radius:9px;border:1px solid #4b5563;background:#111827;color:#fff;outline:none}.auth-card input:focus{border-color:#d4af37;box-shadow:0 0 0 3px rgba(212,175,55,.15)}.auth-card small{display:block;margin-top:6px;color:#9ca3af}.auth-submit{width:100%;margin-top:22px;padding:13px;border:0;border-radius:9px;background:#d4af37;color:#111827;font-weight:800;cursor:pointer}.auth-submit:disabled{opacity:.65;cursor:wait}.auth-footer{text-align:center;margin-top:20px;color:#9ca3af}.auth-footer a{color:#d4af37;font-weight:700}.auth-alert{padding:11px 13px;border-radius:8px;margin:14px 0}.auth-alert.error{background:rgba(220,38,38,.16);border:1px solid rgba(248,113,113,.4)}.auth-alert.success{background:rgba(22,163,74,.16);border:1px solid rgba(74,222,128,.4)}
</style>
