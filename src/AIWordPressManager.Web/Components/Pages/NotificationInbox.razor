@page "/notifications"
@rendermode InteractiveServer
@implements IDisposable
@inject NotificationInboxService Inbox
@inject CurrentUserContext CurrentUser
@inject AppLanguageService L
@inject AppNotificationService Toasts

<PageTitle>@(L.IsArabic ? "صندوق الإشعارات" : "Notification Inbox")</PageTitle>

<div class="notification-inbox-page">
    <section class="panel notification-inbox-hero">
        <div>
            <span class="workspace-kicker">NOTIFICATION INBOX</span>
            <h1>@(L.IsArabic ? "صندوق الإشعارات" : "Notification Inbox")</h1>
            <p>@(L.IsArabic ? "راجع إشعارات التخطيط والتنفيذ والعمليات الفعلية المسجلة لحسابك." : "Review planner, execution, and operational notifications recorded for your account.")</p>
        </div>
        <div class="notification-inbox-actions">
            <button class="btn" @onclick="Reload">↻ @(L.IsArabic ? "تحديث" : "Refresh")</button>
            <button class="btn primary" disabled="@(!_items.Any(x => !x.IsRead))" @onclick="MarkAllRead">✓ @(L.IsArabic ? "تعليم الكل كمقروء" : "Mark all read")</button>
        </div>
    </section>

    <section class="notification-inbox-stats">
        <article class="panel"><small>@(L.IsArabic ? "الإجمالي" : "Total")</small><strong>@_items.Count</strong></article>
        <article class="panel"><small>@(L.IsArabic ? "غير مقروء" : "Unread")</small><strong>@_items.Count(x => !x.IsRead)</strong></article>
        <article class="panel"><small>@(L.IsArabic ? "أخطاء وتحذيرات" : "Errors & warnings")</small><strong>@_items.Count(x => x.Severity is NotificationSeverity.Error or NotificationSeverity.Warning)</strong></article>
        <article class="panel"><small>@(L.IsArabic ? "آخر إشعار" : "Latest")</small><strong class="small-value">@LatestText</strong></article>
    </section>

    <section class="panel notification-inbox-toolbar">
        <input class="search-input" @bind="_search" @bind:event="oninput" placeholder="@(L.IsArabic ? "ابحث في العنوان أو الرسالة..." : "Search title or message...")" />
        <select @bind="_severity">
            <option value="">@(L.IsArabic ? "كل الأنواع" : "All severities")</option>
            @foreach (var severity in Enum.GetValues<NotificationSeverity>())
            {
                <option value="@severity">@SeverityText(severity)</option>
            }
        </select>
        <label class="notification-unread-toggle"><input type="checkbox" @bind="_unreadOnly" /> @(L.IsArabic ? "غير المقروء فقط" : "Unread only")</label>
    </section>

    <section class="panel notification-inbox-list">
        @if (!Filtered.Any())
        {
            <div class="empty-state"><h3>@(L.IsArabic ? "لا توجد إشعارات مطابقة" : "No matching notifications")</h3><p>@(L.IsArabic ? "ستظهر هنا إشعارات العمليات التي تخص حسابك." : "Operational notifications for your account will appear here.")</p></div>
        }
        else
        {
            @foreach (var item in Filtered)
            {
                <article class="notification-inbox-item @(!item.IsRead ? "unread" : string.Empty)">
                    <div class="notification-severity @SeverityClass(item.Severity)">@SeverityIcon(item.Severity)</div>
                    <div class="notification-inbox-main">
                        <div class="notification-inbox-title"><strong>@item.Title</strong>@if (!item.IsRead){<span class="badge warning">@(L.IsArabic ? "جديد" : "New")</span>}</div>
                        <p>@item.Message</p>
                        <small>@FormatDate(item.CreatedAtUtc) · @SeverityText(item.Severity)</small>
                    </div>
                    <div class="notification-inbox-item-actions">
                        @if (RelatedUrl(item) is { } url)
                        {
                            <a class="btn compact" href="@url">@(L.IsArabic ? "فتح" : "Open") ↗</a>
                        }
                        @if (!item.IsRead)
                        {
                            <button class="btn compact" @onclick="() => MarkRead(item)">✓ @(L.IsArabic ? "مقروء" : "Read")</button>
                        }
                        <button class="btn compact" @onclick="() => Dismiss(item)">× @(L.IsArabic ? "إخفاء" : "Dismiss")</button>
                    </div>
                </article>
            }
        }
    </section>
</div>

@code {
    private List<NotificationItem> _items = [];
    private string _search = string.Empty;
    private string _severity = string.Empty;
    private bool _unreadOnly;
    private IEnumerable<NotificationItem> Filtered => _items.Where(x =>
        (!_unreadOnly || !x.IsRead) &&
        (string.IsNullOrWhiteSpace(_severity) || x.Severity.ToString() == _severity) &&
        (string.IsNullOrWhiteSpace(_search) || x.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Message.Contains(_search, StringComparison.OrdinalIgnoreCase)));
    private string LatestText => _items.OrderByDescending(x => x.CreatedAtUtc).Select(x => FormatDate(x.CreatedAtUtc)).FirstOrDefault() ?? "—";

    protected override void OnInitialized(){L.Changed += Changed; Reload();}

    private void Reload() => TryReload();

    private bool TryReload(bool notifyFailure = true)
    {
        try
        {
            _items = Inbox.Get(CurrentUser.UserId, false, 300).ToList();
            return true;
        }
        catch (Exception)
        {
            if (notifyFailure)
            {
                Toasts.Error(
                    L.IsArabic ? "تعذر تحديث صندوق الإشعارات. حاول مرة أخرى." : "The notification inbox could not be refreshed. Try again.",
                    L.IsArabic ? "فشل تحميل الإشعارات" : "Failed to load notifications");
            }

            return false;
        }
    }

    private void MarkRead(NotificationItem item)
    {
        try
        {
            if (!Inbox.MarkRead(CurrentUser.UserId, item.Id))
            {
                Toasts.Warning(
                    L.IsArabic ? "لم يتم تغيير الإشعار. حدّث الصندوق للحصول على أحدث حالة." : "The notification was not changed. Refresh the inbox for the latest state.",
                    L.IsArabic ? "لم يتم إجراء تغيير" : "No change was made");
                return;
            }

            if (!TryReload(notifyFailure: false))
            {
                ShowMutationNeedsRefresh(
                    L.IsArabic ? "تم تعليم الإشعار كمقروء، لكن تعذر تحديث الصندوق." : "The notification was marked as read, but the inbox could not be refreshed.");
            }
        }
        catch (Exception)
        {
            Toasts.Error(
                L.IsArabic ? "تعذر تعليم الإشعار كمقروء. لم يتم تأكيد أي تغيير." : "The notification could not be marked as read. No change was confirmed.",
                L.IsArabic ? "فشل تحديث الإشعار" : "Notification update failed");
        }
    }

    private void MarkAllRead()
    {
        try
        {
            var changed = Inbox.MarkAllRead(CurrentUser.UserId);
            if (changed == 0)
            {
                Toasts.Warning(
                    L.IsArabic ? "لم يتم تغيير أي إشعار. حدّث الصندوق للحصول على أحدث حالة." : "No notifications were changed. Refresh the inbox for the latest state.",
                    L.IsArabic ? "لم يتم إجراء تغيير" : "No change was made");
                return;
            }

            if (TryReload(notifyFailure: false))
            {
                Toasts.Success(L.IsArabic ? "تم تعليم كل الإشعارات كمقروءة." : "All notifications marked as read.");
            }
            else
            {
                ShowMutationNeedsRefresh(
                    L.IsArabic ? "تم تعليم الإشعارات كمقروءة، لكن تعذر تحديث الصندوق." : "Notifications were marked as read, but the inbox could not be refreshed.");
            }
        }
        catch (Exception)
        {
            Toasts.Error(
                L.IsArabic ? "تعذر تعليم الإشعارات كمقروءة. لم يتم تأكيد أي تغيير." : "Notifications could not be marked as read. No change was confirmed.",
                L.IsArabic ? "فشل تحديث الإشعارات" : "Notification update failed");
        }
    }

    private void Dismiss(NotificationItem item)
    {
        try
        {
            if (!Inbox.Dismiss(CurrentUser.UserId, item.Id))
            {
                Toasts.Warning(
                    L.IsArabic ? "لم يتم إخفاء الإشعار. حدّث الصندوق للحصول على أحدث حالة." : "The notification was not dismissed. Refresh the inbox for the latest state.",
                    L.IsArabic ? "لم يتم إجراء تغيير" : "No change was made");
                return;
            }

            if (!TryReload(notifyFailure: false))
            {
                ShowMutationNeedsRefresh(
                    L.IsArabic ? "تم إخفاء الإشعار، لكن تعذر تحديث الصندوق." : "The notification was dismissed, but the inbox could not be refreshed.");
            }
        }
        catch (Exception)
        {
            Toasts.Error(
                L.IsArabic ? "تعذر إخفاء الإشعار. لم يتم تأكيد أي تغيير." : "The notification could not be dismissed. No change was confirmed.",
                L.IsArabic ? "فشل تحديث الإشعار" : "Notification update failed");
        }
    }

    private void ShowMutationNeedsRefresh(string message) =>
        Toasts.Warning(
            $"{message} {(L.IsArabic ? "استخدم تحديث لمطابقة الحالة المحفوظة." : "Use Refresh to reconcile the saved state.")}",
            L.IsArabic ? "تم الحفظ؛ يلزم التحديث" : "Saved; refresh required");

    private string? RelatedUrl(NotificationItem item) => item.ExecutionJobId.HasValue ? "/module/execution" : item.Title.Contains("planner",StringComparison.OrdinalIgnoreCase) || item.Title.Contains("content",StringComparison.OrdinalIgnoreCase) ? "/content-planner" : item.Title.Contains("execution",StringComparison.OrdinalIgnoreCase) ? "/module/execution" : item.RelatedId.HasValue ? "/content-planner" : null;
    private string SeverityClass(NotificationSeverity value)=>value.ToString().ToLowerInvariant();
    private string SeverityIcon(NotificationSeverity value)=>value switch{NotificationSeverity.Success=>"✓",NotificationSeverity.Warning=>"!",NotificationSeverity.Error=>"×",_=>"i"};
    private string SeverityText(NotificationSeverity value)=>L.IsArabic?value switch{NotificationSeverity.Information=>"معلومة",NotificationSeverity.Success=>"نجاح",NotificationSeverity.Warning=>"تحذير",NotificationSeverity.Error=>"خطأ",_=>value.ToString()}:value.ToString();
    private string FormatDate(DateTime value)=>value.ToLocalTime().ToString(L.IsArabic?"yyyy-MM-dd HH:mm":"MMM d, yyyy HH:mm");
    private void Changed()=>InvokeAsync(StateHasChanged);
    public void Dispose()=>L.Changed-=Changed;
}
