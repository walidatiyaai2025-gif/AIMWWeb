@page "/about-build"
@page "/release-notes"
@rendermode InteractiveServer
@inject BuildInformationService BuildInfo
@inject AppLanguageService L
@inject IWebHostEnvironment Environment
@inject IJSRuntime JS

<PageTitle>@(L.IsArabic ? "الإصدار وسجل التغييرات" : "Build & Release Notes")</PageTitle>

<div class="build-info-page">
    <AppCard Class="build-info-hero"
             Eyebrow="@(L.IsArabic ? "بيانات النسخة الحالية" : "CURRENT BUILD")"
             Title="@(L.IsArabic ? "الإصدار وسجل التغييرات" : "Version & Release Notes")"
             Subtitle="@(L.IsArabic ? "بيانات البناء الفعلية مع تاريخ الإصدارات من مصدر واحد داخل المشروع." : "Live build metadata with version history from a single source in the project.")">
        <Header>
            <strong class="build-version-badge">v@(Build.Version)</strong>
        </Header>
        <ChildContent>
            <div class="d-flex gap-2 flex-wrap">
                <AppButton Href="/api/build" Target="_blank" Variant="primary" Icon="↗" Text="@(L.IsArabic ? "فتح بيانات API" : "Open build API")" />
                <button class="btn" @onclick="CopyBuildReportAsync">@(L.IsArabic ? "نسخ تقرير البناء" : "Copy build report")</button>
            </div>
        </ChildContent>
    </AppCard>

    <section class="build-info-grid">
        <AppCard Class="build-info-card"><small>@(L.IsArabic ? "رقم الإصدار" : "Version")</small><strong>@Build.Version</strong></AppCard>
        <AppCard Class="build-info-card"><small>@(L.IsArabic ? "الفرع" : "Branch")</small><strong>@Build.Branch</strong></AppCard>
        <AppCard Class="build-info-card"><small>@(L.IsArabic ? "الالتزام" : "Commit")</small><strong>@Build.Commit</strong></AppCard>
        <AppCard Class="build-info-card"><small>@(L.IsArabic ? "وقت البناء" : "Build time")</small><strong>@Build.BuildTimeUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</strong></AppCard>
    </section>

    @if (CurrentRelease is not null)
    {
        <AppCard Class="build-info-details" Title="@(L.IsArabic ? "ما الجديد في هذه النسخة" : "What is new in this release")">
            <div class="d-flex justify-content-between gap-3 flex-wrap">
                <div><strong>@CurrentRelease.Title</strong><small style="display:block">@(CurrentRelease.Date?.ToString("yyyy-MM-dd") ?? "—")</small></div>
                <span class="settings-badge success">v@(CurrentRelease.Version)</span>
            </div>
            <ul style="margin:1rem 0 0;display:grid;gap:.55rem">
                @foreach (var change in CurrentRelease.Changes)
                {
                    <li>@change</li>
                }
            </ul>
        </AppCard>
    }

    <AppCard Class="build-info-details" Title="@(L.IsArabic ? "سجل الإصدارات" : "Release history")">
        @if (Releases.Count == 0)
        {
            <div class="empty-state"><p>@(L.IsArabic ? "لا يوجد سجل إصدارات متاح." : "No release history is available.")</p></div>
        }
        else
        {
            <div style="display:grid;gap:1rem">
                @foreach (var release in Releases)
                {
                    <details open="@(release.Version == Build.Version)">
                        <summary style="cursor:pointer;font-weight:700">v@(release.Version) · @release.Title · @(release.Date?.ToString("yyyy-MM-dd") ?? "—")</summary>
                        <ul style="margin:.8rem 0 0;display:grid;gap:.45rem">
                            @foreach (var change in release.Changes)
                            {
                                <li>@change</li>
                            }
                        </ul>
                    </details>
                }
            </div>
        }
    </AppCard>

    <AppCard Class="build-info-details" Title="@(L.IsArabic ? "التفاصيل التقنية" : "Technical details")">
        <div><span>@(L.IsArabic ? "اسم التجميعة" : "Assembly")</span><code>@Build.AssemblyName</code></div>
        <div><span>@(L.IsArabic ? "الإصدار التفصيلي" : "Informational version")</span><code>@Build.InformationalVersion</code></div>
        <div><span>API</span><code>/api/build</code></div>
        <div><span>@(L.IsArabic ? "مصدر سجل الإصدارات" : "Release notes source")</span><code>RELEASE_NOTES.md</code></div>
    </AppCard>
</div>

@code {
    private BuildInformation Build => BuildInfo.Current;
    private IReadOnlyList<ReleaseNote> Releases { get; set; } = Array.Empty<ReleaseNote>();
    private ReleaseNote? CurrentRelease => Releases.FirstOrDefault(x => x.Version == Build.Version);

    protected override void OnInitialized()
    {
        Releases = new ReleaseNotesService(Environment).GetAll();
    }

    private async Task CopyBuildReportAsync()
    {
        var lines = new List<string>
        {
            "AI WordPress Manager - Build Report",
            $"Version: {Build.Version}",
            $"Informational version: {Build.InformationalVersion}",
            $"Branch: {Build.Branch}",
            $"Commit: {Build.Commit}",
            $"Build time UTC: {Build.BuildTimeUtc:O}",
            $"Assembly: {Build.AssemblyName}"
        };
        if (CurrentRelease is not null)
        {
            lines.Add(string.Empty);
            lines.Add(CurrentRelease.Title);
            lines.AddRange(CurrentRelease.Changes.Select(x => $"- {x}"));
        }
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", string.Join(System.Environment.NewLine, lines));
    }
}
