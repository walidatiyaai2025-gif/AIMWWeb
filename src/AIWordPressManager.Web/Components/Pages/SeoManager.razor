@page "/sites/{Id:guid}/seo"
@rendermode InteractiveServer
@implements IDisposable
@using AIWordPressManager.Application.SeoAudit
@inject SeoAnalysisWebService SeoService
@inject SeoAuditExecutionService AuditService
@inject SeoRemediationWebService RemediationService
@inject AppNotificationService Notifications
@inject AppLanguageService L

<PageTitle>@L["SeoManager"]</PageTitle>

@if (_loading)
{
    <div class="seo-loading" data-testid="seo-loading" aria-busy="true">
        <div class="seo-skeleton hero"></div>
        <div class="seo-skeleton-grid">
            @for (var i = 0; i < 4; i++)
            {
                <div class="seo-skeleton"></div>
            }
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_loadErrorMessage))
{
    <section class="panel empty-state" role="alert" data-testid="seo-load-error">
        <h1>@(L.IsArabic ? "تعذر فتح مساحة SEO" : "SEO workspace unavailable")</h1>
        <p>@_loadErrorMessage</p>
        <div class="seo-hero-actions">
            <a class="btn primary" href="/account/billing">@(L.IsArabic ? "مراجعة الاشتراك" : "Review subscription")</a>
            <a class="btn" href="/sites">@L["BackToSites"]</a>
        </div>
    </section>
}
else if (_view is null)
{
    <section class="panel empty-state" data-testid="seo-site-unavailable">
        <h1>@L["SiteNotFound"]</h1>
        <a class="btn" href="/sites">@L["BackToSites"]</a>
    </section>
}
else
{
    <div class="seo-page" data-testid="seo-workspace">
        <section class="panel seo-hero">
            <div>
                <span class="workspace-kicker">@(L.IsArabic ? "تحسين الظهور" : "SEARCH OPTIMIZATION")</span>
                <h1>@L["SeoManager"]</h1>
                <p><strong>@_view.SiteName</strong> · @L["SeoIntro"]</p>
            </div>
            <div class="seo-hero-actions">
                <button class="btn primary" data-testid="seo-run-full-audit" @onclick="RunFullAuditAsync" disabled="@_runningAudit" aria-busy="@_runningAudit">
                    @(_runningAudit ? (L.IsArabic ? "جارٍ التدقيق..." : "Running audit...") : (L.IsArabic ? "تشغيل تدقيق كامل" : "Run full audit"))
                </button>
                <a class="btn" data-testid="seo-execution-center" href="/module/execution">@(L.IsArabic ? "مركز التنفيذ" : "Execution center")</a>
                <a class="btn" href="@($"/sites/{Id}/explorer")">@L["BackToExplorer"]</a>
            </div>
            @if (!string.IsNullOrWhiteSpace(_auditFeedbackMessage))
            {
                <div class="seo-audit-feedback @(_auditFeedbackIsError ? "error" : "success")"
                     data-testid="seo-audit-feedback"
                     role="@(_auditFeedbackIsError ? "alert" : "status")"
                     aria-live="polite">
                    @_auditFeedbackMessage
                </div>
            }
        </section>

        <section class="seo-summary-grid">
            <article class="panel seo-score-card">
                <div class="seo-score-ring @ScoreClass(_view.Summary.AverageScore)">
                    <strong>@_view.Summary.AverageScore</strong><small>/100</small>
                </div>
                <div><span>@L["AverageSeoScore"]</span><p>@ScoreDescription(_view.Summary.AverageScore)</p></div>
            </article>
            <article class="panel seo-summary-card good"><small>@L["GoodContent"]</small><strong>@_view.Summary.Good</strong><span>@L["Score80Plus"]</span></article>
            <article class="panel seo-summary-card warning"><small>@L["NeedsImprovement"]</small><strong>@_view.Summary.NeedsImprovement</strong><span>@L["Score50To79"]</span></article>
            <article class="panel seo-summary-card poor"><small>@L["SeoIssues"]</small><strong>@_view.Summary.TotalIssues</strong><span>@_view.Summary.Poor @L["PoorItems"]</span></article>
        </section>

        <section class="panel seo-priority-panel" data-testid="seo-audit-history">
            <header>
                <div>
                    <span class="workspace-kicker">@(L.IsArabic ? "الاتجاه" : "AUDIT TREND")</span>
                    <h2>@(L.IsArabic ? "سجل التدقيق" : "Audit history")</h2>
                </div>
                <span>@(L.IsArabic ? "آخر 12 عملية تدقيق محفوظة" : "Last 12 saved audits")</span>
            </header>
            @if (_history.Count == 0)
            {
                <div class="seo-clean-state">@(L.IsArabic ? "لا يوجد سجل محفوظ بعد. شغّل تدقيقًا كاملًا لإنشاء أول نقطة." : "No saved audit history yet. Run a full audit to create the first point.")</div>
            }
            else
            {
                <div class="seo-priority-grid">
                    @foreach (var point in _history)
                    {
                        <article class="seo-priority-item @HistorySeverity(point)" data-testid="seo-audit-history-point">
                            <span>@point.CapturedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            <strong>@point.Score<small>/100</small></strong>
                            <small>@(L.IsArabic ? $"{point.AuditedItems} عنصر · عالية {point.HighIssues} · متوسطة {point.MediumIssues} · منخفضة {point.LowIssues}" : $"{point.AuditedItems} items · High {point.HighIssues} · Medium {point.MediumIssues} · Low {point.LowIssues}")</small>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="panel seo-priority-panel">
            <header>
                <div><span class="workspace-kicker">@(L.IsArabic ? "الأولويات" : "TOP PRIORITIES")</span><h2>@(L.IsArabic ? "المشكلات الأكثر تكرارًا" : "Most frequent issues")</h2></div>
                <span>@FilteredItems.Count() @(L.IsArabic ? "عنصر" : "items")</span>
            </header>
            <div class="seo-priority-grid">
                @foreach (var issue in TopIssues)
                {
                    <button class="seo-priority-item @issue.Severity.ToLowerInvariant()" @onclick="() => FilterByIssue(issue.Code)">
                        <span>@IssueLabel(issue.Code)</span><strong>@issue.Count</strong><small>@SeverityText(issue.Severity)</small>
                    </button>
                }
                @if (!TopIssues.Any())
                {
                    <div class="seo-clean-state">✓ @(L.IsArabic ? "لا توجد مشكلات في النتائج الحالية" : "No issues in the current results")</div>
                }
            </div>
        </section>

        <section class="panel seo-remediation" data-testid="seo-remediation-workspace" aria-busy="@_remediationBusy">
            <header>
                <div>
                    <span class="workspace-kicker">@(L.IsArabic ? "المعالجة بالذكاء الاصطناعي" : "AI REMEDIATION")</span>
                    <h2>@(L.IsArabic ? "اقتراحات قابلة للمراجعة والتنفيذ" : "Reviewable, actionable suggestions")</h2>
                    <p>@(L.IsArabic ? "راجع القيمة الحالية والاقتراح قبل أي تعديل. لا يظهر النجاح إلا بعد حفظ القيمة وإعادة قراءتها من ووردبريس." : "Compare the persisted value with the suggestion before applying. Success appears only after WordPress persistence and re-read verification.")</p>
                </div>
                <button class="btn primary" data-testid="seo-generate-all" @onclick="GenerateSuggestionsAsync" disabled="@(_remediationBusy || _providerReadiness?.State != SeoAiProviderState.Ready)">
                    @(_generating ? (L.IsArabic ? "جارٍ إنشاء الاقتراحات..." : "Generating suggestions...") : (L.IsArabic ? "إنشاء اقتراحات AI" : "Generate AI suggestions"))
                </button>
            </header>

            <div class="seo-remediation-toolbar" data-testid="seo-provider-readiness">
                <span><strong>AI Provider:</strong> @(_providerReadiness?.Provider ?? "Not configured")</span>
                <span><strong>Status:</strong> @ProviderStatus</span>
                @if (_providerReadiness?.State != SeoAiProviderState.Ready)
                {
                    <a class="btn" data-testid="seo-configure-ai-provider" href="/settings/ai-providers">@(L.IsArabic ? "إعداد مزود الذكاء الاصطناعي" : "Configure AI Provider")</a>
                }
            </div>

            <div class="seo-remediation-toolbar">
                <button class="btn primary" data-testid="seo-apply-selected" @onclick="ApplySelectedAsync" disabled="@(_remediationBusy || _selectedProposals.Count == 0)">@(L.IsArabic ? "تطبيق المحدد" : "Apply selected")</button>
                <button class="btn" data-testid="seo-apply-all-safe" @onclick="ApplyAllSafeAsync" disabled="@(_remediationBusy || !Proposals.Any(IsSafeEligible))">@(L.IsArabic ? "تطبيق كل الاقتراحات الآمنة" : "Apply all safe")</button>
                <button class="btn" data-testid="seo-retry-failed" @onclick="RetryFailedAsync" disabled="@(_remediationBusy || !Proposals.Any(IsFailed))">@(L.IsArabic ? "إعادة محاولة الفاشل" : "Retry failed")</button>
            </div>

            @if (_lastBulkResult is not null)
            {
                <div class="seo-remediation-summary" data-testid="seo-remediation-summary" role="status">
                    <span>@(L.IsArabic ? "المحدد" : "Selected"): @_lastBulkResult.Selected</span>
                    <span>@(L.IsArabic ? "نجح" : "Succeeded"): @_lastBulkResult.Succeeded</span>
                    <span>@(L.IsArabic ? "فشل" : "Failed"): @_lastBulkResult.Failed</span>
                    <span>@(L.IsArabic ? "تعارض" : "Conflicted"): @_lastBulkResult.Conflicted</span>
                    <span>@(L.IsArabic ? "يتطلب مراجعة" : "Review required"): @_lastBulkResult.ReviewRequired</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_remediationFeedback))
            {
                <div class="seo-remediation-feedback @(_remediationFeedbackIsError ? "error" : null)" data-testid="seo-remediation-feedback" role="@(_remediationFeedbackIsError ? "alert" : "status")" aria-live="polite">@_remediationFeedback</div>
            }

            @if (!Proposals.Any())
            {
                <div class="seo-proposal-empty">@(L.IsArabic ? "لم تُنشأ اقتراحات بعد. استخدم زر إنشاء اقتراحات AI للبدء." : "No suggestions have been generated. Use Generate AI suggestions to begin.")</div>
            }
            else
            {
                <div class="seo-proposal-list">
                    @foreach (var proposal in Proposals)
                    {
                        var proposalId = (Guid)proposal.ProposalId;
                        <article class="seo-proposal @(_selectedProposals.Contains(proposalId) ? "selected" : null)" data-testid="proposal-row-@proposalId">
                            <div class="seo-proposal-head">
                                <label class="seo-proposal-identity">
                                    <input type="checkbox" data-testid="proposal-select-@proposalId" checked="@_selectedProposals.Contains(proposalId)" @onchange="e => SetSelected(proposalId, e.Value as bool? == true)" disabled="@(_remediationBusy || !IsSelectable(proposal))" />
                                    <span><strong>@FieldLabel(proposal.Field.ToString())</strong><small>@proposal.ContentType #@proposal.ContentId</small></span>
                                </label>
                                <div class="seo-proposal-badges">
                                    <span class="@SafetyCss(proposal.SafetyClass.ToString())">@SafetyLabel(proposal.SafetyClass.ToString())</span>
                                    <span class="@StateCss(proposal.State.ToString())" data-testid="proposal-status-@proposalId">@StateLabel(proposal.State.ToString())</span>
                                    <span>@Math.Round((decimal)proposal.Confidence * 100)%</span>
                                </div>
                            </div>
                            <div class="seo-proposal-diff">
                                <div class="seo-proposal-value" data-testid="proposal-current-@proposalId"><small>@(L.IsArabic ? "القيمة الحالية" : "Current")</small><p>@proposal.CurrentValue</p></div>
                                <div class="seo-proposal-value suggested" data-testid="proposal-suggested-@proposalId"><small>@(L.IsArabic ? "اقتراح AI" : "AI suggested")</small><p>@proposal.SuggestedValue</p></div>
                            </div>
                            <p class="seo-proposal-reason"><strong>@(L.IsArabic ? "السبب:" : "Reason:")</strong> @proposal.Reason</p>
                            @if (!string.IsNullOrWhiteSpace((string?)proposal.Error))
                            {
                                <p class="seo-remediation-feedback error" role="alert">@proposal.Error</p>
                            }
                            <div class="seo-proposal-actions">
                                <button class="btn compact primary" data-testid="proposal-apply-@proposalId" @onclick="() => ApplyOneAsync(proposalId)" disabled="@(_remediationBusy || !IsApplyEligible(proposal))">@(L.IsArabic ? "تطبيق هذا الحقل" : "Apply this field")</button>
                                @if (_undoAudits.TryGetValue(proposalId, out var auditId))
                                {
                                    <button class="btn compact" data-testid="proposal-undo-@proposalId" @onclick="() => UndoAsync(proposalId, auditId)" disabled="@_remediationBusy">@(L.IsArabic ? "تراجع" : "Undo")</button>
                                }
                                else if (proposal.State.ToString() == "Verified")
                                {
                                    <span class="badge">@(L.IsArabic ? "التراجع غير متاح دون سجل تحقق" : "Undo unavailable without verified audit evidence")</span>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
            @if (_remediationHistory.Count > 0)
            {
                <div class="seo-remediation-history" data-testid="seo-remediation-history">
                    <h3>@(L.IsArabic ? "سجل المعالجة" : "Remediation history")</h3>
                    @foreach (var entry in _remediationHistory.Take(12))
                    {
                        <div class="seo-remediation-history-row" data-testid="seo-remediation-history-entry">
                            <span><strong>@FieldLabel(entry.Field.ToString())</strong><small>@entry.ContentType #@entry.ContentId · @entry.OccurredAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></span>
                            <span class="badge @StateCss(entry.Result.ToString())">@StateLabel(entry.Result.ToString())</span>
                            @if (!string.IsNullOrWhiteSpace(entry.FailureReason))
                            {
                                <span class="seo-history-failure">@entry.FailureReason</span>
                            }
                            @if (entry.Result == SeoRemediationProposalState.Verified && !entry.Action.Equals("Undo", StringComparison.OrdinalIgnoreCase))
                            {
                                <button class="btn compact" data-testid="history-undo-@entry.AuditId" @onclick="() => UndoAsync(entry.ProposalId, entry.AuditId)" disabled="@_remediationBusy">@(L.IsArabic ? "تراجع آمن" : "Safe undo")</button>
                            }
                        </div>
                    }
                </div>
            }
        </section>

        <section class="panel seo-toolbar">
            <div class="seo-search">
                <span>⌕</span>
                <InputText @bind-Value="_query" @bind-Value:event="oninput" placeholder="@L["SearchPlaceholder"]" />
            </div>
            <select @bind="_type">
                <option value="all">@L["All"]</option>
                <option value="post">@L["Posts"]</option>
                <option value="page">@L["Pages"]</option>
            </select>
            <select @bind="_quality">
                <option value="all">@(L.IsArabic ? "كل الدرجات" : "All scores")</option>
                <option value="good">@(L.IsArabic ? "جيد 80+" : "Good 80+")</option>
                <option value="warning">@(L.IsArabic ? "يحتاج تحسين" : "Needs improvement")</option>
                <option value="poor">@(L.IsArabic ? "ضعيف" : "Poor")</option>
            </select>
            <select @bind="_issue">
                <option value="all">@(L.IsArabic ? "كل المشكلات" : "All issues")</option>
                @foreach (var issueCode in IssueCodes)
                {
                    <option value="@issueCode">@IssueLabel(issueCode)</option>
                }
            </select>
            <select @bind="_pageSize">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
            <button class="btn primary" @onclick="ApplyFiltersAsync">@L["Analyze"]</button>
            <button class="btn" @onclick="ResetFiltersAsync">@(L.IsArabic ? "إعادة ضبط" : "Reset")</button>
        </section>

        @if (!FilteredItems.Any())
        {
            <section class="panel empty-state">
                <h3>@L["NoContentToAnalyze"]</h3>
                <p>@L["SyncBeforeSeo"]</p>
                <a class="btn primary" href="@($"/sites/{Id}/explorer")">@(L.IsArabic ? "الانتقال للمزامنة" : "Go to synchronization")</a>
            </section>
        }
        else
        {
            <section class="panel seo-results" data-testid="seo-results">
                <header>
                    <div><h2>@(L.IsArabic ? "نتائج التحليل" : "Analysis results")</h2><p>@(L.IsArabic ? $"عرض {PagedItems.Count()} من {FilteredItems.Count()}" : $"Showing {PagedItems.Count()} of {FilteredItems.Count()}")</p></div>
                </header>
                <div class="seo-table-wrap">
                    <table class="seo-table">
                        <thead><tr><th>@L["Score"]</th><th>@L["Content"]</th><th>@L["SeoMetrics"]</th><th>@L["DetectedIssues"]</th><th>@L["Actions"]</th></tr></thead>
                        <tbody>
                        @foreach (var item in PagedItems)
                        {
                            <tr class="@ScoreClass(item.Score)">
                                <td><span class="score-pill @ScoreClass(item.Score)">@item.Score</span></td>
                                <td><strong>@(string.IsNullOrWhiteSpace(item.Title) ? L["Untitled"] : item.Title)</strong><small>@(item.ContentType == "post" ? L["Post"] : L["Page"]) · /@item.Slug</small></td>
                                <td><div class="metric-list"><span>@L["Words"] <b>@item.WordCount</b></span><span>@L["Headings"] <b>@item.HeadingCount</b></span><span>@L["InternalLinks"] <b>@item.InternalLinks</b></span><span>@L["Images"] <b>@item.ImageCount</b></span></div></td>
                                <td>
                                    @if (item.Issues.Count == 0)
                                    {
                                        <span class="badge success">@L["NoSeoIssues"]</span>
                                    }
                                    else
                                    {
                                        <div class="issue-list">
                                            @foreach (var issue in item.Issues)
                                            {
                                                <button class="issue-chip @issue.Severity.ToLowerInvariant()" @onclick="() => FilterByIssue(issue.Code)">@IssueText(issue)</button>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <button class="btn compact" @onclick="() => ToggleDetails(item)">@(ReferenceEquals(_expanded, item) ? (L.IsArabic ? "إخفاء" : "Hide") : (L.IsArabic ? "تفاصيل" : "Details"))</button>
                                        <a class="btn compact primary" href="@($"/sites/{Id}/content/{item.ContentType}/{item.WordPressId}/edit")">@L["Fix"]</a>
                                        @if (!string.IsNullOrWhiteSpace(item.Link))
                                        {
                                            <a class="btn compact" href="@item.Link" target="_blank">↗</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                            @if (ReferenceEquals(_expanded, item))
                            {
                                <tr class="seo-detail-row">
                                    <td colspan="5">
                                        <div class="seo-detail-grid">
                                            <div>
                                                <h3>@(L.IsArabic ? "خطة الإصلاح" : "Fix plan")</h3>
                                                <ol>
                                                    @foreach (var issue in item.Issues)
                                                    {
                                                        <li><strong>@IssueLabel(issue.Code)</strong><span>@IssueRecommendation(issue.Code)</span></li>
                                                    }
                                                </ol>
                                            </div>
                                            <div class="seo-detail-score"><span>@(L.IsArabic ? "الدرجة الحالية" : "Current score")</span><strong>@item.Score</strong><a class="btn primary" href="@($"/sites/{Id}/content/{item.ContentType}/{item.WordPressId}/edit")">@(L.IsArabic ? "فتح المحرر وتنفيذ الإصلاح" : "Open editor and apply fixes")</a></div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
                <footer class="seo-pagination">
                    <span>@(L.IsArabic ? $"صفحة {_page} من {TotalPages}" : $"Page {_page} of {TotalPages}")</span>
                    <div><button class="btn compact" disabled="@(_page <= 1)" @onclick="PreviousPage">@(L.IsArabic ? "السابق" : "Previous")</button><button class="btn compact" disabled="@(_page >= TotalPages)" @onclick="NextPage">@(L.IsArabic ? "التالي" : "Next")</button></div>
                </footer>
            </section>
        }
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private SeoAnalysisView? _view;
    private SeoAnalysisItem? _expanded;
    private IReadOnlyList<SeoAuditHistoryPoint> _history = Array.Empty<SeoAuditHistoryPoint>();
    private IReadOnlyList<SeoRemediationAuditEntry> _remediationHistory = Array.Empty<SeoRemediationAuditEntry>();
    private bool _loading = true, _runningAudit, _auditFeedbackIsError;
    private bool _remediationBusy, _generating, _remediationFeedbackIsError;
    private string? _loadErrorMessage, _auditFeedbackMessage;
    private string? _remediationFeedback;
    private SeoRemediationBulkResult? _lastBulkResult;
    private SeoAiProviderReadiness? _providerReadiness;
    private readonly HashSet<Guid> _selectedProposals = new();
    private readonly Dictionary<Guid, Guid> _undoAudits = new();
    private string _query = string.Empty, _type = "all", _quality = "all", _issue = "all";
    private int _page = 1, _pageSize = 10;
    private IReadOnlyList<SeoRemediationProposal> Proposals => RemediationService.GetProposals(Id);
    private string ProviderStatus => _providerReadiness?.State switch
    {
        SeoAiProviderState.Ready => L.IsArabic ? "جاهز" : "Ready",
        SeoAiProviderState.Unavailable => L.IsArabic ? "غير متاح" : "Unavailable",
        _ => L.IsArabic ? "الإعداد مطلوب" : "Configuration required"
    };

    private IEnumerable<SeoAnalysisItem> FilteredItems => (_view?.Items ?? Array.Empty<SeoAnalysisItem>()).Where(x =>
        (_quality == "all" || (_quality == "good" && x.Score >= 80) || (_quality == "warning" && x.Score is >= 50 and < 80) || (_quality == "poor" && x.Score < 50)) &&
        (_issue == "all" || x.Issues.Any(i => i.Code == _issue)));
    private IEnumerable<SeoAnalysisItem> PagedItems => FilteredItems.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredItems.Count() / (double)_pageSize));
    private IEnumerable<string> IssueCodes => (_view?.Items ?? Array.Empty<SeoAnalysisItem>()).SelectMany(x => x.Issues).Select(x => x.Code).Distinct().OrderBy(IssueLabel);
    private IEnumerable<IssueAggregate> TopIssues => (_view?.Items ?? Array.Empty<SeoAnalysisItem>()).SelectMany(x => x.Issues).GroupBy(x => new { x.Code, x.Severity }).Select(g => new IssueAggregate(g.Key.Code, g.Key.Severity, g.Sum(x => x.Count))).OrderByDescending(x => x.Count).Take(5);

    protected override void OnInitialized() => L.Changed += Changed;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _loadErrorMessage = null;
        try { await LoadAsync(); }
        catch (Exception ex)
        {
            _view = null;
            _history = Array.Empty<SeoAuditHistoryPoint>();
            _loadErrorMessage = L.IsArabic
                ? "تعذر تحميل مساحة SEO. تحقق من صلاحية الوصول واشتراك Premium SEO ثم حاول مرة أخرى."
                : "The SEO workspace could not be loaded. Check site access and the Premium SEO subscription, then try again.";
            Notifications.Error(L.IsArabic ? "تعذر تحميل تحليل SEO." : "SEO analysis could not be loaded.", L.IsArabic ? "خطأ تحليل SEO" : "SEO analysis error", ex.ToString());
        }
        finally { _loading = false; }
    }

    private async Task LoadAsync()
    {
        _view = await SeoService.AnalyzeAsync(Id, _query, _type);
        _history = _view is null ? Array.Empty<SeoAuditHistoryPoint>() : await AuditService.LoadHistoryAsync(Id, 12);
        _remediationHistory = _view is null ? Array.Empty<SeoRemediationAuditEntry>() : await RemediationService.GetHistoryAsync(Id);
        _providerReadiness = _view is null ? null : await RemediationService.GetProviderReadinessAsync();
        _page = 1;
        _expanded = null;
    }

    private async Task ApplyFiltersAsync() { await LoadAsync(); Notifications.Info(L.IsArabic ? "تم تحديث نتائج التحليل." : "SEO results refreshed.", "SEO"); }
    private async Task ResetFiltersAsync() { _query = ""; _type = _quality = _issue = "all"; _pageSize = 10; await LoadAsync(); }
    private void FilterByIssue(string issueCode) { _issue = issueCode; _page = 1; }
    private void ToggleDetails(SeoAnalysisItem item) => _expanded = ReferenceEquals(_expanded, item) ? null : item;
    private void PreviousPage() { if (_page > 1) _page--; _expanded = null; }
    private void NextPage() { if (_page < TotalPages) _page++; _expanded = null; }

    private async Task RunFullAuditAsync()
    {
        if (_runningAudit) return;
        _runningAudit = true;
        _auditFeedbackIsError = false;
        _auditFeedbackMessage = L.IsArabic ? "جارٍ تنفيذ تدقيق SEO الكامل..." : "Running the full SEO audit...";
        try
        {
            await AuditService.RunAsync(Id);
            await LoadAsync();
            _auditFeedbackMessage = L.IsArabic ? "اكتمل تدقيق SEO وتم تحديث النتائج والسجل." : "SEO audit completed; results and history were refreshed.";
            Notifications.Success(_auditFeedbackMessage, "SEO");
        }
        catch (Exception ex)
        {
            _auditFeedbackIsError = true;
            _auditFeedbackMessage = L.IsArabic ? "فشل تدقيق SEO. راجع صلاحية الوصول والاشتراك ثم أعد المحاولة." : "SEO audit failed. Check access and subscription status, then try again.";
            Notifications.Error(_auditFeedbackMessage, "SEO", ex.ToString());
        }
        finally { _runningAudit = false; }
    }

    private async Task GenerateSuggestionsAsync()
    {
        if (_remediationBusy) return;
        _providerReadiness = await RemediationService.GetProviderReadinessAsync();
        if (_providerReadiness.State != SeoAiProviderState.Ready)
        {
            _remediationFeedbackIsError = true;
            _remediationFeedback = L.IsArabic ? "مزود الذكاء الاصطناعي غير مُعد. افتح إعدادات المزود للمتابعة." : "AI Provider not configured. Configure an AI provider to continue.";
            return;
        }
        _remediationBusy = _generating = true;
        _remediationFeedbackIsError = false;
        _remediationFeedback = L.IsArabic ? "جارٍ إنشاء اقتراحات من المحتوى المحفوظ..." : "Generating suggestions from persisted content...";
        try
        {
            var result = await RemediationService.GenerateAsync(Id);
            _providerReadiness = result.Readiness;
            var generated = result.Proposals;
            _selectedProposals.RemoveWhere(id => Proposals.All(x => x.ProposalId != id));
            var usable = generated.Count(x => x.State == SeoRemediationProposalState.AiSuggested);
            _remediationFeedbackIsError = usable == 0;
            _remediationFeedback = usable == 0
                ? (L.IsArabic ? "لم يُنشئ مزود AI اقتراحًا صالحًا. راجع أخطاء الحقول وإعداد المزود." : "The AI provider produced no usable suggestion. Review the field errors and provider configuration.")
                : (L.IsArabic ? $"تم إنشاء {usable} اقتراح قابل للمراجعة." : $"Generated {usable} reviewable suggestions.");
        }
        catch (Exception ex)
        {
            _remediationFeedbackIsError = true;
            _remediationFeedback = L.IsArabic ? "تعذر إنشاء اقتراحات AI. تحقق من إعداد مزود الذكاء الاصطناعي ثم حاول مجددًا." : "AI suggestions could not be generated. Check the configured AI provider and try again.";
            Notifications.Error(_remediationFeedback, "SEO", ex.ToString());
        }
        finally { _generating = _remediationBusy = false; }
    }

    private async Task ApplyOneAsync(Guid proposalId)
    {
        if (_remediationBusy) return;
        _remediationBusy = true;
        _remediationFeedbackIsError = false;
        try
        {
            var result = await RemediationService.ApplyAsync(Id, proposalId);
            RememberAudit(result);
            await RefreshRemediationHistoryAsync();
            _remediationFeedbackIsError = result.State is SeoRemediationProposalState.Failed or SeoRemediationProposalState.Conflict or SeoRemediationProposalState.NeedsReview;
            _remediationFeedback = result.Message;
        }
        catch (Exception ex) { SetRemediationFailure(ex); }
        finally { _remediationBusy = false; }
    }

    private async Task ApplySelectedAsync()
    {
        if (_remediationBusy || _selectedProposals.Count == 0) return;
        await RunBulkAsync(() => RemediationService.ApplySelectedAsync(Id, _selectedProposals.ToArray()));
    }

    private async Task ApplyAllSafeAsync()
    {
        if (_remediationBusy) return;
        await RunBulkAsync(() => RemediationService.ApplyAllSafeAsync(Id));
    }

    private async Task RetryFailedAsync()
    {
        if (_remediationBusy) return;
        await RunBulkAsync(() => RemediationService.RetryFailedAsync(Id));
    }

    private async Task RunBulkAsync(Func<Task<SeoRemediationBulkResult>> action)
    {
        _remediationBusy = true;
        _remediationFeedbackIsError = false;
        try
        {
            _lastBulkResult = await action();
            foreach (var result in _lastBulkResult.Items) RememberAudit(result);
            await RefreshRemediationHistoryAsync();
            _remediationFeedbackIsError = _lastBulkResult.Failed > 0 || _lastBulkResult.Conflicted > 0;
            _remediationFeedback = L.IsArabic
                ? $"اكتمل التنفيذ: نجح {_lastBulkResult.Succeeded}، فشل {_lastBulkResult.Failed}، تعارض {_lastBulkResult.Conflicted}."
                : $"Execution complete: {_lastBulkResult.Succeeded} succeeded, {_lastBulkResult.Failed} failed, {_lastBulkResult.Conflicted} conflicted.";
        }
        catch (Exception ex) { SetRemediationFailure(ex); }
        finally { _remediationBusy = false; }
    }

    private async Task UndoAsync(Guid proposalId, Guid auditId)
    {
        if (_remediationBusy) return;
        _remediationBusy = true;
        _remediationFeedbackIsError = false;
        try
        {
            var result = await RemediationService.UndoAsync(Id, auditId);
            _remediationFeedbackIsError = result.State is SeoRemediationProposalState.Failed or SeoRemediationProposalState.Conflict or SeoRemediationProposalState.NeedsReview;
            _remediationFeedback = result.Message;
            if (!_remediationFeedbackIsError) _undoAudits.Remove(proposalId);
            await RefreshRemediationHistoryAsync();
        }
        catch (Exception ex) { SetRemediationFailure(ex); }
        finally { _remediationBusy = false; }
    }

    private void RememberAudit(SeoRemediationApplyResult result)
    {
        if (result.AuditId is Guid auditId && result.State == SeoRemediationProposalState.Verified)
            _undoAudits[result.ProposalId] = auditId;
    }

    private async Task RefreshRemediationHistoryAsync() => _remediationHistory = await RemediationService.GetHistoryAsync(Id);

    private void SetRemediationFailure(Exception ex)
    {
        _remediationFeedbackIsError = true;
        _remediationFeedback = L.IsArabic ? "تعذر إكمال المعالجة. لم يتم اعتبار التغيير ناجحًا." : "Remediation could not be completed. The change was not reported as successful.";
        Notifications.Error(_remediationFeedback, "SEO", ex.ToString());
    }

    private void SetSelected(Guid proposalId, bool selected)
    {
        if (selected) _selectedProposals.Add(proposalId); else _selectedProposals.Remove(proposalId);
    }

    private static bool IsSelectable(SeoRemediationProposal proposal) => proposal.State == SeoRemediationProposalState.AiSuggested && proposal.SafetyClass != SeoRemediationSafetyClass.Unsupported;
    private static bool IsApplyEligible(SeoRemediationProposal proposal) => proposal.State == SeoRemediationProposalState.AiSuggested && proposal.SafetyClass == SeoRemediationSafetyClass.SafeAutomatic;
    private static bool IsSafeEligible(SeoRemediationProposal proposal) => IsApplyEligible(proposal);
    private static bool IsFailed(SeoRemediationProposal proposal) => proposal.State == SeoRemediationProposalState.Failed;
    private string FieldLabel(string field) => L.IsArabic ? field switch { "Title" => "العنوان", "MetaDescription" => "وصف الميتا", _ => field } : field switch { "MetaDescription" => "Meta description", _ => field };
    private string SafetyLabel(string safety) => L.IsArabic ? safety switch { "SafeAutomatic" => "آمن تلقائيًا", "ReviewRequired" => "يتطلب مراجعة", _ => "غير مدعوم" } : safety switch { "SafeAutomatic" => "Safe automatic", "ReviewRequired" => "Review required", _ => "Unsupported" };
    private static string SafetyCss(string safety) => safety == "SafeAutomatic" ? "safe" : safety == "ReviewRequired" ? "review" : "failed";
    private string StateLabel(string state) => L.IsArabic ? state switch { "AiSuggested" => "مقترح", "Applying" => "جارٍ التطبيق", "Verified" => "تم التحقق", "Failed" => "فشل", "Conflict" => "تعارض", "NeedsReview" => "يتطلب مراجعة", _ => state } : state switch { "AiSuggested" => "AI suggested", "NeedsReview" => "Needs review", _ => state };
    private static string StateCss(string state) => state == "Verified" ? "safe" : state == "Failed" ? "failed" : state is "Conflict" or "NeedsReview" ? "review" : string.Empty;

    private static string ScoreClass(int score) => score >= 80 ? "good" : score >= 50 ? "warning" : "poor";
    private static string HistorySeverity(SeoAuditHistoryPoint point) => point.HighIssues > 0 || point.Score < 50 ? "high" : point.MediumIssues > 0 || point.Score < 80 ? "medium" : "low";
    private string ScoreDescription(int score) => score >= 80 ? (L.IsArabic ? "المحتوى في حالة جيدة." : "Content is in good condition.") : score >= 50 ? (L.IsArabic ? "توجد فرص تحسين واضحة." : "There are clear improvement opportunities.") : (L.IsArabic ? "يحتاج المحتوى إلى معالجة ذات أولوية." : "Content requires priority remediation.");
    private string IssueText(SeoIssue issue) => $"{IssueLabel(issue.Code)}{(issue.Count > 1 ? $" ({issue.Count})" : string.Empty)}";
    private string IssueLabel(string issueCode) => L[issueCode];
    private string SeverityText(string severity) => L.IsArabic ? severity switch { "High" => "عالية", "Medium" => "متوسطة", _ => "منخفضة" } : severity;
    private string IssueRecommendation(string issueCode) => L.IsArabic ? issueCode switch { "MissingTitle" => "أضف عنوانًا واضحًا وفريدًا.", "ShortTitle" => "وسّع العنوان ليصف نية البحث بدقة.", "LongTitle" => "اختصر العنوان إلى نحو 60 حرفًا.", "MissingDescription" => "أضف وصفًا موجزًا وجذابًا.", "LongDescription" => "اختصر الوصف إلى نحو 160 حرفًا.", "ThinContent" => "وسّع المحتوى بمعلومات أصلية ومفيدة.", "MissingHeadings" => "قسّم المحتوى بعناوين H2 وH3 منطقية.", "MissingInternalLinks" => "أضف روابط داخلية مرتبطة بالموضوع.", "ImagesMissingAlt" => "أضف ALT وصفيًا للصور.", "MissingSlug" => "أنشئ Slug قصيرًا وواضحًا.", _ => "راجع العنصر داخل المحرر." } : issueCode switch { "MissingTitle" => "Add a clear, unique title.", "ShortTitle" => "Expand the title to describe search intent.", "LongTitle" => "Shorten the title to about 60 characters.", "MissingDescription" => "Add a concise, compelling description.", "LongDescription" => "Shorten the description to about 160 characters.", "ThinContent" => "Expand the content with original, useful information.", "MissingHeadings" => "Structure the content with logical H2 and H3 headings.", "MissingInternalLinks" => "Add relevant internal links.", "ImagesMissingAlt" => "Add descriptive ALT text to images.", "MissingSlug" => "Create a short, readable slug.", _ => "Review the item in the editor." };
    private void Changed() => InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= Changed;
    private sealed record IssueAggregate(string Code, string Severity, int Count);
}
