@page "/approvals"
@rendermode InteractiveServer
@implements IDisposable
@inject ApprovalWorkflowService ApprovalService
@inject ExecutionCenterService ExecutionCenter
@inject IWordPressPostEditorService EditorService
@inject CurrentUserContext CurrentUser
@inject AppLanguageService L
@inject AppNotificationService Notifications

<PageTitle>@(L.IsArabic ? "قائمة الموافقات" : "Approval Queue")</PageTitle>

<div class="approval-page">
    <section class="panel approval-hero">
        <div>
            <span class="workspace-kicker">@(L.IsArabic ? "سير العمل الآمن" : "CONTROLLED WORKFLOW")</span>
            <h1>@(L.IsArabic ? "قائمة الموافقات" : "Approval Queue")</h1>
            <p>@(L.IsArabic ? "راجع التغييرات المقترحة قبل اعتمادها. التنفيذ والرجوع كلاهما يمران بفحص الملكية ونسخة WordPress الحالية." : "Review proposed changes before approval. Execution and rollback both recheck ownership and the current WordPress version.")</p>
        </div>
        <div class="approval-hero-actions">
            <button class="btn" @onclick="LoadAsync" disabled="@_working">↻ @(L.IsArabic ? "تحديث" : "Refresh")</button>
            <a class="btn" href="/module/execution">▶ @(L.IsArabic ? "مركز التنفيذ" : "Execution center")</a>
        </div>
    </section>

    <section class="approval-kpis">
        <article class="panel"><small>@(L.IsArabic ? "الكل" : "Total")</small><strong>@_allItems.Count</strong></article>
        <article class="panel pending"><small>@(L.IsArabic ? "في الانتظار" : "Pending")</small><strong>@Count(ApprovalStatus.Pending)</strong></article>
        <article class="panel approved"><small>@(L.IsArabic ? "معتمدة" : "Approved")</small><strong>@Count(ApprovalStatus.Approved)</strong></article>
        <article class="panel rejected"><small>@(L.IsArabic ? "مرفوضة" : "Rejected")</small><strong>@Count(ApprovalStatus.Rejected)</strong></article>
        <article class="panel executed"><small>@(L.IsArabic ? "نُفذت فعليًا" : "Executed")</small><strong>@Count(ApprovalStatus.Executed)</strong></article>
    </section>

    <section class="panel approval-toolbar">
        <div class="approval-filters">
            <input class="search-input" placeholder="@(L.IsArabic ? "ابحث بالعنوان أو الموقع أو نوع العملية..." : "Search title, site, or operation...")" @bind="_search" @bind:event="oninput" />
            <select @bind="_statusFilter"><option value="all">@(L.IsArabic ? "كل الحالات" : "All statuses")</option>@foreach (var status in Enum.GetValues<ApprovalStatus>()) { <option value="@status.ToString()">@StatusText(status)</option> }</select>
            <select @bind="_riskFilter"><option value="all">@(L.IsArabic ? "كل المخاطر" : "All risks")</option>@foreach (var risk in Enum.GetValues<ApprovalRiskLevel>()) { <option value="@risk.ToString()">@RiskText(risk)</option> }</select>
        </div>
        <div class="approval-reviewer"><label>@(L.IsArabic ? "المراجع الحالي" : "Current reviewer")</label><strong>@_reviewer</strong></div>
    </section>

    @if (_loading)
    {
        <div class="approval-skeleton-grid">@for (var i = 0; i < 4; i++) { <div class="panel"></div> }</div>
    }
    else if (!FilteredItems.Any())
    {
        <section class="panel empty-state approval-empty"><div class="approval-empty-icon">✓</div><h2>@(L.IsArabic ? "لا توجد عناصر مطابقة" : "No matching approval items")</h2><p>@(L.IsArabic ? "ستظهر هنا فقط الاقتراحات والعمليات الحساسة التابعة لمواقع حسابك." : "Only proposals and sensitive operations owned by your account appear here.")</p></section>
    }
    else
    {
        <section class="approval-list">
            @foreach (var item in FilteredItems)
            {
                <article class="panel approval-card @(item.Id == _expandedId ? "expanded" : string.Empty)">
                    <header class="approval-card-head">
                        <button class="approval-card-title" @onclick="() => ToggleDetails(item)"><span class="approval-risk @RiskClass(item.RiskLevel)">@RiskText(item.RiskLevel)</span><span><strong>@item.Title</strong><small>@item.SiteName · @item.OperationType</small></span></button>
                        <div class="approval-card-state"><span class="badge @StatusClass(item.Status)">@StatusText(item.Status)</span><small>@FormatDate(item.RequestedAtUtc)</small></div>
                    </header>

                    <div class="approval-meta">
                        <span><b>@(L.IsArabic ? "طلب بواسطة" : "Requested by"):</b> @item.RequestedBy</span>
                        <span><b>Correlation:</b> <code>@item.CorrelationId</code></span>
                        @if (item.ExecutionJobId.HasValue) { <span><b>@(L.IsArabic ? "مهمة التنفيذ" : "Execution job"):</b> <code>@item.ExecutionJobId</code> · @ExecutionStatus(item.ExecutionJobId.Value)</span> }
                    </div>

                    @if (item.Id == _expandedId)
                    {
                        var capability = ApprovedChangePolicy.Evaluate(item);
                        <div class="approval-details">
                            <div class="approval-diff-grid"><section><h3>@(L.IsArabic ? "قبل" : "Before")</h3><pre>@PrettyJson(item.BeforeJson)</pre></section><section><h3>@(L.IsArabic ? "بعد" : "After")</h3><pre>@PrettyJson(item.AfterJson)</pre></section></div>

                            @if (_audit.Count > 0)
                            {
                                <section class="approval-audit"><h3>@(L.IsArabic ? "سجل المراجعة" : "Audit trail")</h3>@foreach (var entry in _audit) { <div><span></span><div><strong>@entry.Action</strong><small>@entry.Actor · @FormatDate(entry.CreatedAtUtc)</small>@if (!string.IsNullOrWhiteSpace(entry.Notes)) { <p>@entry.Notes</p> }</div></div> }</section>
                            }

                            @if (item.Status == ApprovalStatus.Pending)
                            {
                                <div class="approval-decision-box">
                                    <textarea rows="3" @bind="_notes" placeholder="@(L.IsArabic ? "ملاحظات المراجع..." : "Reviewer notes...")"></textarea>
                                    @if (capability.CanExecute)
                                    {
                                        <label class="check-row"><input type="checkbox" @bind="_executeImmediately" /> <span>@(L.IsArabic ? "إضافة التغيير المعتمد إلى قائمة التنفيذ الحقيقي فور الموافقة" : "Queue the approved change for real execution immediately")</span></label>
                                        <small>@(L.IsArabic ? "سيظل الطلب معتمدًا حتى ينجح التغيير على WordPress فعليًا؛ عداد التقدم لا يستطيع إكماله." : "The request stays Approved until the WordPress mutation really succeeds; the progress simulator cannot complete it.")</small>
                                    }
                                    else
                                    {
                                        <div class="approval-reviewed-note"><strong>@(L.IsArabic ? "تنفيذ تلقائي غير متاح" : "Automatic execution unavailable")</strong><p>@capability.Message</p></div>
                                    }
                                    <div class="approval-actions"><button class="btn primary" disabled="@_working" @onclick="() => ApproveAsync(item)">✓ @(L.IsArabic ? "موافقة" : "Approve")</button><button class="btn danger" disabled="@_working" @onclick="() => RejectAsync(item)">✕ @(L.IsArabic ? "رفض" : "Reject")</button></div>
                                </div>
                            }
                            else if (item.Status == ApprovalStatus.Executed && string.Equals(item.OperationType, ApprovedChangePolicy.WordPressContentUpdateOperation, StringComparison.Ordinal))
                            {
                                <div class="approval-decision-box">
                                    <strong>@(L.IsArabic ? "رجوع محكوم" : "Controlled rollback")</strong>
                                    <p>@(L.IsArabic ? "إنشاء الرجوع لا يغير WordPress فورًا. سيتم قراءة النسخة الحالية وإنشاء طلب موافقة جديد يعيد حالة Before الأصلية." : "Creating a rollback does not change WordPress immediately. The current remote version is read and a new approval is created to restore the original Before state.")</p>
                                    <button class="btn" disabled="@_working" @onclick="() => CreateRollbackAsync(item)">↶ @(L.IsArabic ? "إنشاء طلب رجوع" : "Create rollback approval")</button>
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(item.ReviewerNotes))
                            {
                                <div class="approval-reviewed-note"><strong>@(L.IsArabic ? "ملاحظات المراجع" : "Reviewer notes")</strong><p>@item.ReviewerNotes</p></div>
                            }
                        </div>
                    }
                </article>
            }
        </section>
    }
</div>

@code {
    private IReadOnlyList<ApprovalItem> _allItems = Array.Empty<ApprovalItem>();
    private IReadOnlyList<ApprovalAuditEntry> _audit = Array.Empty<ApprovalAuditEntry>();
    private IReadOnlyList<ExecutionJob> _executionJobs = Array.Empty<ExecutionJob>();
    private string _search = string.Empty, _statusFilter = "all", _riskFilter = "all", _reviewer = string.Empty, _notes = string.Empty;
    private Guid _ownerUserId;
    private Guid? _expandedId;
    private bool _loading = true, _working, _executeImmediately;
    private bool _disposed;

    private IEnumerable<ApprovalItem> FilteredItems => _allItems.Where(item =>
        (_statusFilter == "all" || item.Status.ToString() == _statusFilter) &&
        (_riskFilter == "all" || item.RiskLevel.ToString() == _riskFilter) &&
        (string.IsNullOrWhiteSpace(_search) || item.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) || item.SiteName.Contains(_search, StringComparison.OrdinalIgnoreCase) || item.OperationType.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    protected override void OnInitialized()
    {
        L.Changed += Changed;
        _ownerUserId = CurrentUser.UserId;
        _reviewer = string.IsNullOrWhiteSpace(CurrentUser.UserName) ? _ownerUserId.ToString() : CurrentUser.UserName;
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task LoadAsync()
    {
        if (_disposed) return Task.CompletedTask;
        _loading = true;
        _allItems = ApprovalService.GetItems(_ownerUserId, null, 500);
        _executionJobs = ExecutionCenter.GetJobs(_ownerUserId);
        _loading = false;
        return Task.CompletedTask;
    }

    private void ToggleDetails(ApprovalItem item)
    {
        if (_disposed) return;
        if (_expandedId == item.Id) { _expandedId = null; _audit = Array.Empty<ApprovalAuditEntry>(); return; }
        _expandedId = item.Id;
        _notes = item.ReviewerNotes ?? string.Empty;
        _executeImmediately = item.Status == ApprovalStatus.Pending && ApprovedChangePolicy.Evaluate(item).CanExecute;
        _audit = ApprovalService.GetAudit(_ownerUserId, item.Id, 100);
    }

    private async Task ApproveAsync(ApprovalItem item)
    {
        if (_disposed || _working) return;
        try
        {
            _working = true;
            var canExecute = ApprovedChangePolicy.Evaluate(item).CanExecute;
            var result = ApprovalService.Approve(_ownerUserId, item.Id, _reviewer, _notes, _executeImmediately && canExecute);
            if (_disposed) return;
            Notifications.Success(L.IsArabic ? "تم اعتماد العنصر." : "Approval completed.", result.Status.ToString());
            await LoadAsync();
            if (!_disposed) _audit = ApprovalService.GetAudit(_ownerUserId, item.Id, 100);
        }
        catch (Exception ex) { if (!_disposed) Notifications.Error(L.IsArabic ? "تعذر اعتماد العنصر." : "Approval failed.", details: ex.Message); }
        finally { if (!_disposed) _working = false; }
    }

    private async Task RejectAsync(ApprovalItem item)
    {
        if (_disposed || _working) return;
        try
        {
            _working = true;
            ApprovalService.Reject(_ownerUserId, item.Id, _reviewer, _notes);
            if (_disposed) return;
            Notifications.Warning(L.IsArabic ? "تم رفض العنصر." : "Approval rejected.");
            await LoadAsync();
            if (!_disposed) _audit = ApprovalService.GetAudit(_ownerUserId, item.Id, 100);
        }
        catch (Exception ex) { if (!_disposed) Notifications.Error(L.IsArabic ? "تعذر رفض العنصر." : "Rejection failed.", details: ex.Message); }
        finally { if (!_disposed) _working = false; }
    }

    private async Task CreateRollbackAsync(ApprovalItem item)
    {
        if (_disposed || _working) return;
        try
        {
            _working = true;
            if (!item.SiteId.HasValue) throw new InvalidOperationException("Rollback requires a site-scoped approval.");
            if (!ApprovedChangePolicy.TryGetBeforeRequest(item, out var original, out var parseError)) throw new InvalidOperationException(parseError);

            var remoteResult = await EditorService.GetAsync(item.SiteId.Value, original.ContentType, original.Id);
            if (remoteResult.IsFailure) throw new InvalidOperationException(remoteResult.Error.Message);
            if (!ApprovedChangePolicy.TryBuildRollbackSubmission(item, remoteResult.Value, out var submission, out var rollbackError)) throw new InvalidOperationException(rollbackError);

            var rollback = ApprovalService.Submit(_ownerUserId, submission, _reviewer);
            await LoadAsync();
            if (_disposed) return;
            _expandedId = rollback.Id;
            _notes = string.Empty;
            _executeImmediately = ApprovedChangePolicy.Evaluate(rollback).CanExecute;
            _audit = ApprovalService.GetAudit(_ownerUserId, rollback.Id, 100);
            Notifications.Success(L.IsArabic ? "تم إنشاء طلب رجوع جديد للمراجعة." : "A new rollback approval was created for review.", rollback.Id.ToString()[..8]);
        }
        catch (Exception ex) { if (!_disposed) Notifications.Error(L.IsArabic ? "تعذر إنشاء طلب الرجوع." : "Rollback approval could not be created.", details: ex.Message); }
        finally { if (!_disposed) _working = false; }
    }

    private string ExecutionStatus(Guid jobId)
    {
        var status = _executionJobs.FirstOrDefault(x => x.Id == jobId)?.Status;
        return string.IsNullOrWhiteSpace(status) ? (L.IsArabic ? "غير متاحة" : "Unavailable") : status;
    }

    private int Count(ApprovalStatus status) => _allItems.Count(x => x.Status == status);
    private string StatusText(ApprovalStatus status) => L.IsArabic ? status switch { ApprovalStatus.Pending => "في الانتظار", ApprovalStatus.Approved => "معتمدة", ApprovalStatus.Rejected => "مرفوضة", ApprovalStatus.Executed => "تم تنفيذها", ApprovalStatus.Cancelled => "ملغاة", _ => status.ToString() } : status.ToString();
    private string RiskText(ApprovalRiskLevel risk) => L.IsArabic ? risk switch { ApprovalRiskLevel.Low => "منخفضة", ApprovalRiskLevel.Medium => "متوسطة", ApprovalRiskLevel.High => "مرتفعة", ApprovalRiskLevel.Critical => "حرجة", _ => risk.ToString() } : risk.ToString();
    private static string StatusClass(ApprovalStatus status) => status switch { ApprovalStatus.Approved or ApprovalStatus.Executed => "success", ApprovalStatus.Rejected or ApprovalStatus.Cancelled => "danger", _ => "warning" };
    private static string RiskClass(ApprovalRiskLevel risk) => risk.ToString().ToLowerInvariant();
    private string FormatDate(DateTime value) => value.ToLocalTime().ToString(L.IsArabic ? "yyyy-MM-dd HH:mm" : "MMM d, yyyy HH:mm");
    private static string PrettyJson(string value) { try { using var document = System.Text.Json.JsonDocument.Parse(value); return System.Text.Json.JsonSerializer.Serialize(document.RootElement, new System.Text.Json.JsonSerializerOptions { WriteIndented = true }); } catch { return value; } }

    private void Changed() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    public void Dispose() { if (_disposed) return; _disposed = true; L.Changed -= Changed; }
}
