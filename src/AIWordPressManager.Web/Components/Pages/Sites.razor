@page "/sites"
@rendermode InteractiveServer
@implements IDisposable
@inject SiteWebService SiteService
@inject AppLanguageService L
@inject AppNotificationService Notifications
<PageTitle>@L["Sites"]</PageTitle>

<div class="sites-page sites-workspace">
    <AppToolbar
        Eyebrow="@(L.IsArabic ? "إدارة البنية الرقمية" : "DIGITAL ESTATE")"
        Title="@L["Sites"]"
        Subtitle="@(L.IsArabic ? "راقب اتصالات WordPress وصحة المواقع وافتح أدوات المحتوى من مساحة عمل موحدة." : "Monitor WordPress connections, site health and content tools from one unified workspace.")">
        <Actions>
            <AppButton Href="/system-health" Icon="♥" Text="@(L.IsArabic ? "صحة النظام" : "System health")" />
            <AppButton Icon="↻" Text="@(_refreshing ? (L.IsArabic ? "جارٍ التحديث" : "Refreshing") : L["Refresh"])" Busy="@_refreshing" Disabled="@(_refreshing || _bulkWorking)" OnClick="ReloadClickedAsync" />
            <AppButton Variant="primary" Icon="＋" Text="@L["AddSite"]" Disabled="@(_saving || _bulkWorking)" OnClick="OpenAddFormClicked" />
        </Actions>
    </AppToolbar>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "error" : "success")">@_message</div>
    }

    <section class="app-stat-grid">
        <AppStatCard Icon="◉" Label="@L["TotalSites"]" Value="@(_sites.Count.ToString())" Description="@L["AllRegisteredSites"]" />
        <AppStatCard Icon="✓" Label="@L["Connected"]" Value="@(ConnectedCount.ToString())" Description="@L["HealthyConnection"]" Tone="success" />
        <AppStatCard Icon="!" Label="@L["NeedsReview"]" Value="@(ProblemCount.ToString())" Description="@L["ConnectionOrLoginFailed"]" Tone="warning" />
        <AppStatCard Icon="◷" Label="@L["LastCheck"]" Value="@LatestCheck" Description="@L["LocalDatabase"]" ValueClass="summary-date" />
    </section>

    @if (_showForm)
    {
        <AppCard
            Class="site-create-panel"
            Eyebrow="@(_editingId.HasValue ? (L.IsArabic ? "تعديل الاتصال" : "EDIT CONNECTION") : (L.IsArabic ? "اتصال جديد" : "NEW CONNECTION"))"
            Title="@(_editingId.HasValue ? (L.IsArabic ? "تعديل بيانات الموقع" : "Edit site profile") : L["AddNewSite"] )"
            Subtitle="@(L.IsArabic ? "راجع الاسم والرابط قبل الحفظ." : "Review the name and URL before saving.")">
            <Header>
                <button type="button" class="icon-button" @onclick="CloseForm" aria-label="Close">×</button>
            </Header>
            <ChildContent>
                <EditForm Model="_model" OnSubmit="SaveAsync">
                    <div class="site-create-grid">
                        <label><span>@L["SiteName"]</span><InputText @bind-Value="_model.Name" disabled="@_saving" /></label>
                        <label><span>@L["SiteUrl"]</span><InputText @bind-Value="_model.Url" placeholder="https://example.com" disabled="@_saving" /></label>
                    </div>
                    <div class="site-form-hint">🔒 @(L.IsArabic ? "يتم تطبيع الرابط ويمكن استخدامه في أكثر من ملف اتصال مستقل؛ لكل ملف هوية وإعدادات وبيانات اعتماد خاصة به." : "The URL is normalized and can be reused across independent site profiles; each profile keeps its own identity, settings, and credentials.")</div>
                    <div class="actions">
                        <AppButton Type="submit" Variant="primary" Text="@(_saving ? L["Saving"] : L["Save"])" Busy="@_saving" Disabled="@_saving" />
                        <AppButton Text="@L["Cancel"]" Disabled="@_saving" OnClick="CloseFormClicked" />
                    </div>
                </EditForm>
            </ChildContent>
        </AppCard>
    }

    <AppCard Class="sites-toolbar" BodyClass="sites-toolbar-body">
        <div class="sites-toolbar-layout">
            <AppSearchBox Value="@_searchInput" ValueChanged="SearchChangedAsync" Busy="@(_searchDebounce is not null && !_searchDebounce.IsCancellationRequested)" Placeholder="@(L.IsArabic ? "ابحث بالاسم أو الرابط..." : "Search by name or URL...")" AriaLabel="@(L.IsArabic ? "بحث المواقع" : "Search sites")" />
            <div class="sites-filter-group">
                <button class="site-filter @(_statusFilter == "all" ? "active" : string.Empty)" @onclick="ShowAllSites" disabled="@_bulkWorking">@(L.IsArabic ? "الكل" : "All") <b>@_sites.Count</b></button>
                <button class="site-filter @(_statusFilter == "connected" ? "active" : string.Empty)" @onclick="ShowConnectedSites" disabled="@_bulkWorking">@(L.IsArabic ? "متصل" : "Connected") <b>@ConnectedCount</b></button>
                <button class="site-filter @(_statusFilter == "review" ? "active" : string.Empty)" @onclick="ShowReviewSites" disabled="@_bulkWorking">@(L.IsArabic ? "يحتاج مراجعة" : "Needs review") <b>@ProblemCount</b></button>
            </div>
            <div class="site-selection-tools">
                <button type="button"
                        class="site-select-all @(AllVisibleSelected ? "active" : string.Empty)"
                        disabled="@(_bulkWorking || !_visibleSites.Any())"
                        @onclick="ToggleSelectAllVisibleAsync">
                    <span aria-hidden="true">@(AllVisibleSelected ? "✓" : "□")</span>
                    @(AllVisibleSelected
                        ? (L.IsArabic ? "إلغاء تحديد الظاهر" : "Clear visible")
                        : (L.IsArabic ? "تحديد الظاهر" : "Select visible"))
                </button>
                <AppBadge Tone="info" Text="@(L.IsArabic ? $"عرض {_visibleSites.Count} موقع" : $"Showing {_visibleSites.Count} sites")" />
            </div>
        </div>
    </AppCard>

    <AppBulkActionBar SelectedCount="@SelectedCount"
                      Busy="@_bulkWorking"
                      SelectedText="@(L.IsArabic ? "موقع محدد" : "sites selected")"
                      Description="@(L.IsArabic ? "الإجراءات تطبق فقط على ملفات المواقع المحددة في العرض الحالي." : "Actions apply only to selected site profiles in the current view.")"
                      ClearText="@(L.IsArabic ? "إلغاء التحديد" : "Clear selection")"
                      ClearRequested="ClearSelectionAsync">
        <Actions>
            <AppButton Icon="↻" Size="small" Text="@(L.IsArabic ? "إعادة اختبار" : "Retest")" Disabled="@_bulkWorking" OnClick="RetestSelectedAsync" />
            <AppButton Icon="✓" Size="small" Text="@(L.IsArabic ? "تفعيل" : "Enable")" Disabled="@_bulkWorking" OnClick="EnableSelectedAsync" />
            <AppButton Icon="⊘" Size="small" Text="@(L.IsArabic ? "تعطيل" : "Disable")" Disabled="@_bulkWorking" OnClick="DisableSelectedAsync" />
            <AppButton Icon="⌫" Size="small" Variant="danger" Text="@(L.IsArabic ? "حذف المحدد" : "Delete selected")" Disabled="@_bulkWorking" OnClick="RequestBulkDeleteAsync" />
        </Actions>
    </AppBulkActionBar>

    @if (_loading)
    {
        <AppLoading Title="@(L.IsArabic ? "جارٍ تحميل المواقع" : "Loading sites")" Message="@(L.IsArabic ? "يتم قراءة البيانات المحلية وحالة الاتصالات." : "Reading local data and connection status.")" />
    }
    else if (!_sites.Any())
    {
        <AppCard>
            <AppEmptyState Icon="◎" Title="@L["NoSites"]" Description="@L["AddFirstSite"]">
                <Actions>
                    <AppButton Variant="primary" Icon="＋" Text="@L["AddSite"]" OnClick="OpenAddFormClicked" />
                </Actions>
            </AppEmptyState>
        </AppCard>
    }
    else if (!_visibleSites.Any())
    {
        <AppCard>
            <AppEmptyState Icon="⌕" Title="@(L.IsArabic ? "لا توجد نتائج" : "No matching sites")" Description="@(L.IsArabic ? "غيّر البحث أو الفلتر لعرض مواقع أخرى." : "Change the search or status filter to see other sites.")" />
        </AppCard>
    }
    else
    {
        <section class="sites-card-grid">
            @foreach (var site in _visibleSites)
            {
                var busy = _busySiteId == site.Id;
                var health = HealthPercent(site.ConnectionStatus);
                var selected = _selectedSiteIds.Contains(site.Id);
                <div class="site-card-shell @(selected ? "is-selected" : string.Empty)" @key="site.Id">
                    <AppCard Class="@($"site-management-card {(busy ? "is-busy" : string.Empty)}")">
                        <div class="site-card-header">
                            <div class="site-identity">
                                <label class="site-select-box" title="@(L.IsArabic ? "تحديد الموقع" : "Select site")">
                                    <input type="checkbox"
                                           checked="@selected"
                                           disabled="@(_bulkWorking || busy)"
                                           @onchange="args => ToggleSiteSelection(site.Id, args)" />
                                    <span aria-hidden="true"></span>
                                </label>
                                <div class="site-avatar">@Initials(site.Name)</div>
                                <div><h3>@site.Name</h3><a href="@site.SiteUrl" target="_blank" rel="noopener">@site.SiteUrl</a></div>
                            </div>
                            <AppBadge Tone="@StatusTone(site.ConnectionStatus)" Text="@StatusText(site.ConnectionStatus)" Icon="●" />
                        </div>
                        <div class="site-overview-row">
                            <div class="site-health-ring" style="--health:@health"><div><strong>@health%</strong><small>@(L.IsArabic ? "الصحة" : "Health")</small></div></div>
                            <div class="site-card-metrics">
                                <div><small>@L["WordPressVersion"]</small><strong>@(string.IsNullOrWhiteSpace(site.WordPressVersion) ? "—" : site.WordPressVersion)</strong></div>
                                <div><small>@L["LastTest"]</small><strong>@FormatDate(site.LastConnectionTestAtUtc)</strong></div>
                                <div><small>@(L.IsArabic ? "لغة الموقع" : "Site language")</small><strong>@(string.IsNullOrWhiteSpace(site.LanguageCode) ? "—" : site.LanguageCode)</strong></div>
                                <div><small>REST API</small><strong>@StatusText(site.ConnectionStatus)</strong></div>
                                <div><small>@(L.IsArabic ? "معرّف الملف" : "Profile ID")</small><strong>@ProfileId(site.Id)</strong></div>
                                <div><small>@(L.IsArabic ? "نطاق بيانات الاعتماد" : "Credential scope")</small><strong>@(L.IsArabic ? "خاص بهذا الملف" : "Per profile")</strong></div>
                            </div>
                        </div>
                        <div class="site-quick-links"><a href="@($"/sites/{site.Id}")"><span>⌂</span>@(L.IsArabic ? "لوحة الموقع" : "Dashboard")</a><a href="@($"/sites/{site.Id}/explorer")"><span>▤</span>@(L.IsArabic ? "المحتوى" : "Content")</a><a href="@site.SiteUrl" target="_blank" rel="noopener"><span>↗</span>@(L.IsArabic ? "فتح الموقع" : "Visit site")</a></div>
                        <AppProgressBar Value="@health" Tone="@HealthTone(health)" Label="@(L.IsArabic ? "صحة الاتصال" : "Connection health")" />
                        <div class="site-card-actions">
                            <AppButton Href="@($"/sites/{site.Id}")" Variant="primary" Text="@L["Open"]" />
                            <AppButton Icon="↻" Disabled="@(_bulkWorking || busy)" Busy="@busy" OnClick="args => RetestAsync(site.Id)" />
                            <AppButton Icon="✎" Disabled="@(_bulkWorking || busy)" OnClick="args => OpenEditForm(site)" />
                            <AppButton Icon="⌫" Variant="danger" Disabled="@(_bulkWorking || busy)" OnClick="args => RequestDelete(site.Id, site.Name)" />
                        </div>
                    </AppCard>
                </div>
            }
        </section>
    }

    <AppConfirmDialog Open="@_deleteDialogOpen"
                      OpenChanged="@DeleteDialogOpenChangedAsync"
                      Eyebrow="@(L.IsArabic ? "تأكيد الحذف" : "DELETE CONFIRMATION")"
                      Title="@(L.IsArabic ? "حذف الموقع" : "Delete site")"
                      Message="@(L.IsArabic ? $"هل تريد حذف الموقع «{_deleteSiteName}»؟" : $"Delete site ‘{_deleteSiteName}’?")"
                      Details="@(L.IsArabic ? "سيتم حذف بيانات الاتصال المحلية لهذا الموقع. لا يمكن التراجع عن هذه العملية." : "The local connection profile for this site will be removed. This action cannot be undone.")"
                      ConfirmText="@(L.IsArabic ? "حذف الموقع" : "Delete site")"
                      CancelText="@L["Cancel"]"
                      ConfirmVariant="danger"
                      ConfirmIcon="⌫"
                      Busy="@_deleting"
                      OnConfirm="ConfirmDeleteAsync"
                      OnCancel="CancelDeleteAsync" />

    <AppConfirmDialog Open="@_bulkDeleteDialogOpen"
                      OpenChanged="@BulkDeleteDialogOpenChangedAsync"
                      Eyebrow="@(L.IsArabic ? "حذف جماعي" : "BULK DELETE")"
                      Title="@(L.IsArabic ? "حذف المواقع المحددة" : "Delete selected sites")"
                      Message="@(L.IsArabic ? $"سيتم حذف {SelectedCount} ملف موقع محدد." : $"You are about to delete {SelectedCount} selected site profiles.")"
                      Details="@BulkDeleteDetails"
                      ConfirmText="@(L.IsArabic ? "حذف المحدد" : "Delete selected")"
                      CancelText="@L["Cancel"]"
                      ConfirmVariant="danger"
                      ConfirmIcon="⌫"
                      Busy="@_bulkWorking"
                      OnConfirm="ConfirmBulkDeleteAsync"
                      OnCancel="CancelBulkDeleteAsync" />
</div>

@code {
    private bool _loading = true, _refreshing, _saving, _showForm, _isError;
    private Guid? _editingId, _busySiteId, _deleteSiteId;
    private bool _deleteDialogOpen, _deleting, _bulkWorking, _bulkDeleteDialogOpen;
    private string _deleteSiteName = string.Empty;
    private string? _message;
    private string _searchInput = string.Empty;
    private string _search = string.Empty;
    private string _statusFilter = "all";
    private int _loadVersion;
    private CancellationTokenSource? _searchDebounce;
    private readonly HashSet<Guid> _selectedSiteIds = [];
    private List<AIWordPressManager.Domain.Entities.Site> _sites = new();
    private List<AIWordPressManager.Domain.Entities.Site> _visibleSites = new();
    private SiteInput _model = new();

    private int ConnectedCount => _sites.Count(x => x.ConnectionStatus == AIWordPressManager.Domain.Enums.SiteConnectionStatus.Connected);
    private int ProblemCount => _sites.Count(x => x.ConnectionStatus is not AIWordPressManager.Domain.Enums.SiteConnectionStatus.Connected and not AIWordPressManager.Domain.Enums.SiteConnectionStatus.Unknown);
    private int SelectedCount => _selectedSiteIds.Count;
    private bool AllVisibleSelected => SiteBulkOperationPolicy.AreAllVisibleSelected(_visibleSites.Select(x => x.Id), _selectedSiteIds);
    private string LatestCheck => FormatDate(_sites.Where(x => x.LastConnectionTestAtUtc.HasValue).Select(x => x.LastConnectionTestAtUtc).OrderByDescending(x => x).FirstOrDefault());
    private string BulkDeleteDetails
    {
        get
        {
            var names = _visibleSites.Where(x => _selectedSiteIds.Contains(x.Id)).Select(x => x.Name).Take(6).ToArray();
            var extra = SelectedCount > names.Length
                ? (L.IsArabic ? $" و{SelectedCount - names.Length} أخرى" : $" and {SelectedCount - names.Length} more")
                : string.Empty;
            var joined = string.Join(L.IsArabic ? "، " : ", ", names);
            return L.IsArabic
                ? $"الملفات: {joined}{extra}. سيتم حذف ملفات الاتصال المحلية المحددة ولا يمكن التراجع عن العملية."
                : $"Profiles: {joined}{extra}. The selected local connection profiles will be deleted and this action cannot be undone.";
        }
    }

    protected override void OnInitialized() => L.Changed += Changed;
    protected override async Task OnInitializedAsync() => await ReloadAsync(true);

    private Task ReloadClickedAsync(MouseEventArgs _) => ReloadAsync(false);
    private Task ReloadAsync() => ReloadAsync(false);

    private async Task ReloadAsync(bool initial)
    {
        var version = ++_loadVersion;
        try
        {
            if (initial) _loading = true; else _refreshing = true;
            var sites = await SiteService.GetSitesAsync();
            if (version != _loadVersion) return;
            _sites = sites;
            ApplyFilters();
            _isError = false;
        }
        catch (Exception ex) { Fail(L.TranslateMessage(ex.Message), ex.ToString()); }
        finally { if (version == _loadVersion) { _loading = false; _refreshing = false; } }
    }

    private async Task SearchChangedAsync(string value)
    {
        _searchInput = value;
        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
        _searchDebounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(250, _searchDebounce.Token);
            _search = _searchInput.Trim();
            ApplyFilters();
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    private void SetFilter(string value) { _statusFilter = value; ApplyFilters(); }
    private void ShowAllSites() => SetFilter("all");
    private void ShowConnectedSites() => SetFilter("connected");
    private void ShowReviewSites() => SetFilter("review");
    private void ApplyFilters()
    {
        _visibleSites = _sites
            .Where(MatchesFilter)
            .Where(x => string.IsNullOrWhiteSpace(_search) || x.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.SiteUrl.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .ToList();
        _selectedSiteIds.IntersectWith(_visibleSites.Select(x => x.Id));
    }
    private bool MatchesFilter(AIWordPressManager.Domain.Entities.Site site) => _statusFilter switch { "connected" => site.ConnectionStatus == AIWordPressManager.Domain.Enums.SiteConnectionStatus.Connected, "review" => site.ConnectionStatus is not AIWordPressManager.Domain.Enums.SiteConnectionStatus.Connected and not AIWordPressManager.Domain.Enums.SiteConnectionStatus.Unknown, _ => true };

    private void ToggleSiteSelection(Guid siteId, ChangeEventArgs args)
    {
        var shouldSelect = args.Value is bool value && value;
        if (!shouldSelect)
        {
            _selectedSiteIds.Remove(siteId);
            return;
        }

        if (!_visibleSites.Any(x => x.Id == siteId)) return;
        if (_selectedSiteIds.Count >= SiteBulkOperationPolicy.MaxSitesPerOperation)
        {
            Notifications.Error(
                L.IsArabic ? $"الحد الأقصى للعملية الجماعية هو {SiteBulkOperationPolicy.MaxSitesPerOperation} موقع." : $"Bulk operations are limited to {SiteBulkOperationPolicy.MaxSitesPerOperation} sites.",
                L["Sites"]);
            return;
        }

        _selectedSiteIds.Add(siteId);
    }

    private Task ToggleSelectAllVisibleAsync(MouseEventArgs _)
    {
        var visibleIds = _visibleSites.Select(x => x.Id).ToArray();
        if (AllVisibleSelected)
        {
            foreach (var id in visibleIds) _selectedSiteIds.Remove(id);
            return Task.CompletedTask;
        }

        _selectedSiteIds.Clear();
        foreach (var id in visibleIds.Take(SiteBulkOperationPolicy.MaxSitesPerOperation))
            _selectedSiteIds.Add(id);

        if (visibleIds.Length > SiteBulkOperationPolicy.MaxSitesPerOperation)
        {
            Notifications.Info(
                L.IsArabic ? $"تم تحديد أول {SiteBulkOperationPolicy.MaxSitesPerOperation} موقع ظاهر؛ هذا هو الحد الأقصى للعملية الواحدة." : $"Selected the first {SiteBulkOperationPolicy.MaxSitesPerOperation} visible sites, the maximum for one bulk operation.",
                L["Sites"]);
        }

        return Task.CompletedTask;
    }

    private Task ClearSelectionAsync()
    {
        _selectedSiteIds.Clear();
        return Task.CompletedTask;
    }

    private Guid[] SelectedIdsSnapshot() => _visibleSites
        .Where(x => _selectedSiteIds.Contains(x.Id))
        .Select(x => x.Id)
        .Take(SiteBulkOperationPolicy.MaxSitesPerOperation)
        .ToArray();

    private void OpenAddForm() { _editingId = null; _model = new(); _showForm = true; _message = null; }
    private Task OpenAddFormClicked(MouseEventArgs _) { OpenAddForm(); return Task.CompletedTask; }
    private void OpenEditForm(AIWordPressManager.Domain.Entities.Site site) { _editingId = site.Id; _model = new() { Name = site.Name, Url = site.SiteUrl }; _showForm = true; _message = null; }
    private void CloseForm() { if (_saving) return; _showForm = false; _editingId = null; _model = new(); }
    private Task CloseFormClicked(MouseEventArgs _) { CloseForm(); return Task.CompletedTask; }

    private async Task SaveAsync()
    {
        try
        {
            _saving = true;
            if (string.IsNullOrWhiteSpace(_model.Name)) { Warn(L["RequiredSiteName"]); return; }
            if (string.IsNullOrWhiteSpace(_model.Url)) { Warn(L["RequiredUrl"]); return; }
            if (!Uri.TryCreate(_model.Url, UriKind.Absolute, out var uri) || uri.Scheme is not ("http" or "https")) { Warn(L["InvalidUrl"]); return; }
            if (_editingId is { } siteId) await SiteService.UpdateSiteAsync(siteId, _model.Name, _model.Url); else await SiteService.AddSiteAsync(_model.Name, _model.Url);
            Notifications.Success(L.IsArabic ? "تم حفظ الموقع." : "Site saved.", L["Sites"]);
            _showForm = false; _editingId = null; _model = new(); _isError = false;
            await ReloadAsync(false);
        }
        catch (Exception ex) { Fail(L.TranslateMessage(ex.Message), ex.ToString()); }
        finally { _saving = false; }
    }

    private async Task RetestAsync(Guid id)
    {
        try
        {
            _busySiteId = id;
            var result = await SiteService.RetestAsync(id);
            if (result.IsSuccess) Notifications.Success(L.TranslateMessage(result.Message)); else Notifications.Error(L.TranslateMessage(result.Message));
            await ReloadAsync(false);
        }
        catch (Exception ex) { Fail(L.TranslateMessage(ex.Message), ex.ToString()); }
        finally { _busySiteId = null; }
    }

    private async Task RetestSelectedAsync(MouseEventArgs _)
    {
        var ids = SelectedIdsSnapshot();
        if (ids.Length == 0) return;

        try
        {
            _bulkWorking = true;
            _message = null;
            var result = await SiteService.RetestSitesAsync(ids);
            _isError = result.Failed > 0;
            _message = L.IsArabic
                ? $"اكتمل اختبار {result.Requested} موقع: {result.Succeeded} ناجح، {result.Failed} يحتاج مراجعة."
                : $"Retested {result.Requested} sites: {result.Succeeded} succeeded, {result.Failed} need review.";

            if (result.Failed == 0)
            {
                Notifications.Success(_message, L["Sites"]);
            }
            else
            {
                var details = string.Join(Environment.NewLine, result.Items.Where(x => !x.IsSuccess).Select(x => $"{x.SiteName}: {x.Message}"));
                Notifications.Error(_message, L["Sites"], details);
            }

            await ReloadAsync(false);
        }
        catch (Exception ex) { Fail(L.TranslateMessage(ex.Message), ex.ToString()); }
        finally { _bulkWorking = false; }
    }

    private Task EnableSelectedAsync(MouseEventArgs _) => SetSelectedDisabledAsync(false);
    private Task DisableSelectedAsync(MouseEventArgs _) => SetSelectedDisabledAsync(true);

    private async Task SetSelectedDisabledAsync(bool disabled)
    {
        var ids = SelectedIdsSnapshot();
        if (ids.Length == 0) return;

        try
        {
            _bulkWorking = true;
            var changed = await SiteService.SetSitesDisabledAsync(ids, disabled);
            _selectedSiteIds.Clear();
            _isError = false;
            _message = disabled
                ? (L.IsArabic ? $"تم تعطيل {changed} موقع." : $"Disabled {changed} sites.")
                : (L.IsArabic ? $"تم تفعيل {changed} موقع وإعادته لحالة انتظار اختبار الاتصال." : $"Enabled {changed} sites and reset them for connection testing.");
            Notifications.Success(_message, L["Sites"]);
            await ReloadAsync(false);
        }
        catch (Exception ex) { Fail(L.TranslateMessage(ex.Message), ex.ToString()); }
        finally { _bulkWorking = false; }
    }

    private Task RequestBulkDeleteAsync(MouseEventArgs _)
    {
        if (SelectedCount > 0) _bulkDeleteDialogOpen = true;
        return Task.CompletedTask;
    }

    private Task BulkDeleteDialogOpenChangedAsync(bool open)
    {
        _bulkDeleteDialogOpen = open;
        return Task.CompletedTask;
    }

    private Task CancelBulkDeleteAsync()
    {
        _bulkDeleteDialogOpen = false;
        return Task.CompletedTask;
    }

    private async Task ConfirmBulkDeleteAsync()
    {
        var ids = SelectedIdsSnapshot();
        if (ids.Length == 0)
        {
            _bulkDeleteDialogOpen = false;
            return;
        }

        try
        {
            _bulkWorking = true;
            var deleted = await SiteService.DeleteSitesAsync(ids);
            _bulkDeleteDialogOpen = false;
            _selectedSiteIds.Clear();
            _isError = false;
            _message = L.IsArabic ? $"تم حذف {deleted} ملف موقع." : $"Deleted {deleted} site profiles.";
            Notifications.Success(_message, L["Sites"]);
            await ReloadAsync(false);
        }
        catch (Exception ex) { Fail(L.TranslateMessage(ex.Message), ex.ToString()); }
        finally { _bulkWorking = false; }
    }

    private void RequestDelete(Guid id, string name) { _deleteSiteId = id; _deleteSiteName = name; _deleteDialogOpen = true; }
    private Task DeleteDialogOpenChangedAsync(bool open) { _deleteDialogOpen = open; return Task.CompletedTask; }
    private Task CancelDeleteAsync() { _deleteDialogOpen = false; _deleteSiteId = null; return Task.CompletedTask; }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteSiteId is not { } id) return;
        try
        {
            _deleting = true;
            await SiteService.DeleteSiteAsync(id);
            _deleteDialogOpen = false;
            _deleteSiteId = null;
            _selectedSiteIds.Remove(id);
            Notifications.Success(L.IsArabic ? "تم حذف الموقع." : "Site deleted.", L["Sites"]);
            await ReloadAsync(false);
        }
        catch (Exception ex) { Fail(L.TranslateMessage(ex.Message), ex.ToString()); }
        finally { _deleting = false; }
    }

    private void Warn(string message) { _message = message; _isError = true; }
    private void Fail(string message, string? details = null) { _message = message; _isError = true; Notifications.Error(message, L["Sites"], details); }

    // AppLanguageService.Changed is Action?, not EventHandler.
    // Keep the handler parameterless so += / -= match the exact delegate type.
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { L.Changed -= Changed; _searchDebounce?.Dispose(); }

    private static string Initials(string value) => string.Join(string.Empty, value.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
    private static string ProfileId(Guid id) => id.ToString("N")[..8].ToUpperInvariant();
    private static string FormatDate(DateTime? value) => value?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—";
    private static int HealthPercent(AIWordPressManager.Domain.Enums.SiteConnectionStatus status) => status switch { AIWordPressManager.Domain.Enums.SiteConnectionStatus.Connected => 100, AIWordPressManager.Domain.Enums.SiteConnectionStatus.LimitedPermissions => 65, AIWordPressManager.Domain.Enums.SiteConnectionStatus.AuthenticationFailed => 35, AIWordPressManager.Domain.Enums.SiteConnectionStatus.Unreachable => 20, _ => 0 };
    private static string HealthTone(int health) => health >= 80 ? "success" : health >= 50 ? "warning" : "danger";
    private static string StatusTone(AIWordPressManager.Domain.Enums.SiteConnectionStatus status) => status switch { AIWordPressManager.Domain.Enums.SiteConnectionStatus.Connected => "success", AIWordPressManager.Domain.Enums.SiteConnectionStatus.Unknown => "info", _ => "warning" };
    private string StatusText(AIWordPressManager.Domain.Enums.SiteConnectionStatus status) => status switch { AIWordPressManager.Domain.Enums.SiteConnectionStatus.Connected => L.IsArabic ? "متصل" : "Connected", AIWordPressManager.Domain.Enums.SiteConnectionStatus.AuthenticationFailed => L.IsArabic ? "فشل المصادقة" : "Authentication failed", AIWordPressManager.Domain.Enums.SiteConnectionStatus.LimitedPermissions => L.IsArabic ? "صلاحيات محدودة" : "Limited permissions", AIWordPressManager.Domain.Enums.SiteConnectionStatus.Unreachable => L.IsArabic ? "غير متاح" : "Unreachable", AIWordPressManager.Domain.Enums.SiteConnectionStatus.Disabled => L.IsArabic ? "معطل" : "Disabled", _ => L.IsArabic ? "غير معروف" : "Unknown" };

    private sealed class SiteInput
    {
        public string Name { get; set; } = string.Empty;
        public string Url { get; set; } = string.Empty;
    }
