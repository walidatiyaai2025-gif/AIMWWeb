@page "/sites"
@rendermode InteractiveServer
@implements IDisposable
@inject SiteWebService SiteService
@inject AppLanguageService L
@inject AppNotificationService Notifications
@inject IJSRuntime JS
<PageTitle>@L["Sites"]</PageTitle>

<div class="sites-page sites-workspace">
    <AppToolbar
        Eyebrow="@(L.IsArabic ? "إدارة البنية الرقمية" : "DIGITAL ESTATE")"
        Title="@L["Sites"]"
        Subtitle="@(L.IsArabic ? "راقب اتصالات WordPress وصحة المواقع وافتح أدوات المحتوى من مساحة عمل موحدة." : "Monitor WordPress connections, site health and content tools from one unified workspace.")">
        <Actions>
            <AppButton Href="/system-health" Icon="♥" Text="@(L.IsArabic ? "صحة النظام" : "System health")" />
            <AppButton Icon="↻" Text="@(_refreshing ? (L.IsArabic ? "جارٍ التحديث" : "Refreshing") : L["Refresh"])" Busy="@_refreshing" Disabled="@_refreshing" OnClick="ReloadClickedAsync" />
            <AppButton Variant="primary" Icon="＋" Text="@L["AddSite"]" Disabled="@_saving" OnClick="OpenAddFormClicked" />
        </Actions>
    </AppToolbar>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "error" : "success")">@_message</div>
    }

    <section class="app-stat-grid">
        <AppStatCard Icon="◉" Label="@L["TotalSites"]" Value="@(_sites.Count.ToString())" Description="@L["AllRegisteredSites"]" />
        <AppStatCard Icon="✓" Label="@L["Connected"]" Value="@(ConnectedCount.ToString())" Description="@L["HealthyConnection"]" Tone="success" />
        <AppStatCard Icon="!" Label="@L["NeedsReview"]" Value="@(ProblemCount.ToString())" Description="@L["ConnectionOrLoginFailed"]" Tone="warning" />
        <AppStatCard Icon="◷" Label="@L["LastCheck"]" Value="@LatestCheck" Description="@L["LocalDatabase"]" ValueClass="summary-date" />
    </section>

    @if (_showForm)
    {
        <AppCard
            Class="site-create-panel"
            Eyebrow="@(_editingId.HasValue ? (L.IsArabic ? "تعديل الاتصال" : "EDIT CONNECTION") : (L.IsArabic ? "اتصال جديد" : "NEW CONNECTION"))"
            Title="@(_editingId.HasValue ? (L.IsArabic ? "تعديل بيانات الموقع" : "Edit site profile") : L["AddNewSite"])"
            Subtitle="@(L.IsArabic ? "راجع الاسم والرابط قبل الحفظ." : "Review the name and URL before saving.")">
            <Header>
                <button type="button" class="icon-button" @onclick="CloseForm" aria-label="Close">×</button>
            </Header>
            <ChildContent>
                <EditForm Model="_model" OnSubmit="SaveAsync">
                    <div class="site-create-grid">
                        <label><span>@L["SiteName"]</span><InputText @bind-Value="_model.Name" disabled="@_saving" /></label>
                        <label><span>@L["SiteUrl"]</span><InputText @bind-Value="_model.Url" placeholder="https://example.com" disabled="@_saving" /></label>
                    </div>
                    <div class="site-form-hint">🔒 @(L.IsArabic ? "يتم حفظ الرابط بعد تطبيعه ومنع التكرار تلقائيًا." : "The URL is normalized and duplicate sites are blocked automatically.")</div>
                    <div class="actions">
                        <AppButton Type="submit" Variant="primary" Text="@(_saving ? L["Saving"] : L["Save"])" Busy="@_saving" Disabled="@_saving" />
                        <AppButton Text="@L["Cancel"]" Disabled="@_saving" OnClick="CloseFormClicked" />
                    </div>
                </EditForm>
            </ChildContent>
        </AppCard>
    }

    <AppCard Class="sites-toolbar" BodyClass="sites-toolbar-body">
        <div class="sites-toolbar-layout">
            <AppSearchBox Value="@_searchInput" ValueChanged="SearchChangedAsync" Busy="@(_searchDebounce is not null && !_searchDebounce.IsCancellationRequested)" Placeholder="@(L.IsArabic ? "ابحث بالاسم أو الرابط..." : "Search by name or URL...")" AriaLabel="@(L.IsArabic ? "بحث المواقع" : "Search sites")" />
            <div class="sites-filter-group">
                <button class="site-filter @(_statusFilter == "all" ? "active" : string.Empty)" @onclick="ShowAllSites">@(L.IsArabic ? "الكل" : "All") <b>@_sites.Count</b></button>
                <button class="site-filter @(_statusFilter == "connected" ? "active" : string.Empty)" @onclick="ShowConnectedSites">@(L.IsArabic ? "متصل" : "Connected") <b>@ConnectedCount</b></button>
                <button class="site-filter @(_statusFilter == "review" ? "active" : string.Empty)" @onclick="ShowReviewSites">@(L.IsArabic ? "يحتاج مراجعة" : "Needs review") <b>@ProblemCount</b></button>
            </div>
            <AppBadge Tone="info" Text="@(L.IsArabic ? $"عرض {_visibleSites.Count} موقع" : $"Showing {_visibleSites.Count} sites")" />
        </div>
    </AppCard>

    @if (_loading)
    {
        <AppLoading Title="@(L.IsArabic ? "جارٍ تحميل المواقع" : "Loading sites")" Message="@(L.IsArabic ? "يتم قراءة البيانات المحلية وحالة الاتصالات." : "Reading local data and connection status.")" />
    }
    else if (!_sites.Any())
    {
        <AppCard>
            <AppEmptyState Icon="◎" Title="@L["NoSites"]" Description="@L["AddFirstSite"]">
                <Actions>
                    <AppButton Variant="primary" Icon="＋" Text="@L["AddSite"]" OnClick="OpenAddFormClicked" />
                </Actions>
            </AppEmptyState>
        </AppCard>
    }
    else if (!_visibleSites.Any())
    {
        <AppCard>
            <AppEmptyState Icon="⌕" Title="@(L.IsArabic ? "لا توجد نتائج" : "No matching sites")" Description="@(L.IsArabic ? "غيّر البحث أو الفلتر لعرض مواقع أخرى." : "Change the search or status filter to see other sites.")" />
        </AppCard>
    }
    else
    {
        <section class="sites-card-grid">
            @foreach (var site in _visibleSites)
            {
                var busy = _busySiteId == site.Id;
                var health = HealthPercent(site.ConnectionStatus);
                <AppCard Class="@($"site-management-card {(busy ? "is-busy" : string.Empty)}")" @key="site.Id">
                    <div class="site-card-header"><div class="site-identity"><div class="site-avatar">@Initials(site.Name)</div><div><h3>@site.Name</h3><a href="@site.SiteUrl" target="_blank" rel="noopener">@site.SiteUrl</a></div></div><AppBadge Tone="@StatusTone(site.ConnectionStatus)" Text="@StatusText(site.ConnectionStatus)" Icon="●" /></div>
                    <div class="site-overview-row">
                        <div class="site-health-ring" style="--health:@health"><div><strong>@health%</strong><small>@(L.IsArabic ? "الصحة" : "Health")</small></div></div>
                        <div class="site-card-metrics">
                            <div><small>@L["WordPressVersion"]</small><strong>@(string.IsNullOrWhiteSpace(site.WordPressVersion) ? "—" : site.WordPressVersion)</strong></div>
                            <div><small>@L["LastTest"]</small><strong>@FormatDate(site.LastConnectionTestAtUtc)</strong></div>
                            <div><small>@(L.IsArabic ? "لغة الموقع" : "Site language")</small><strong>@(string.IsNullOrWhiteSpace(site.LanguageCode) ? "—" : site.LanguageCode)</strong></div>
                            <div><small>REST API</small><strong>@StatusText(site.ConnectionStatus)</strong></div>
                        </div>
                    </div>
                    <div class="site-quick-links"><a href="@($"/sites/{site.Id}")"><span>⌂</span>@(L.IsArabic ? "لوحة الموقع" : "Dashboard")</a><a href="@($"/sites/{site.Id}/explorer")"><span>▤</span>@(L.IsArabic ? "المحتوى" : "Content")</a><a href="@site.SiteUrl" target="_blank" rel="noopener"><span>↗</span>@(L.IsArabic ? "فتح الموقع" : "Visit site")</a></div>
                    <AppProgressBar Value="@health" Tone="@HealthTone(health)" Label="@(L.IsArabic ? "صحة الاتصال" : "Connection health")" />
                    <div class="site-card-actions">
                        <AppButton Href="@($"/sites/{site.Id}")" Variant="primary" Text="@L["Open"]" />
                        <AppButton Icon="↻" Disabled="@busy" Busy="@busy" OnClick="args => RetestAsync(site.Id)" />
                        <AppButton Icon="✎" Disabled="@busy" OnClick="args => OpenEditForm(site)" />
                        <AppButton Icon="⌫" Variant="danger" Disabled="@busy" OnClick="args => DeleteAsync(site.Id, site.Name)" />
                    </div>
                </AppCard>
            }
        </section>
    }
</div>

@code {
    private bool _loading = true, _refreshing, _saving, _showForm, _isError;
    private Guid? _editingId, _busySiteId;
    private string? _message;
    private string _searchInput = string.Empty;
    private string _search = string.Empty;
    private string _statusFilter = "all";
    private int _loadVersion;
    private CancellationTokenSource? _searchDebounce;
    private List<AIWordPressManager.Domain.Entities.Site> _sites = new();
    private List<AIWordPressManager.Domain.Entities.Site> _visibleSites = new();
    private SiteInput _model = new();

    private int ConnectedCount => _sites.Count(x => x.ConnectionStatus == AIWordPressManager.Domain.Enums.SiteConnectionStatus.Connected);
    private int ProblemCount => _sites.Count(x => x.ConnectionStatus is not AIWordPressManager.Domain.Enums.SiteConnectionStatus.Connected and not AIWordPressManager.Domain.Enums.SiteConnectionStatus.Unknown);
    private string LatestCheck => FormatDate(_sites.Where(x => x.LastConnectionTestAtUtc.HasValue).Select(x => x.LastConnectionTestAtUtc).OrderByDescending(x => x).FirstOrDefault());

    protected override void OnInitialized() => L.Changed += Changed;
    protected override async Task OnInitializedAsync() => await ReloadAsync(true);

    private Task ReloadClickedAsync(MouseEventArgs _) => ReloadAsync(false);
    private Task ReloadAsync() => ReloadAsync(false);

    private async Task ReloadAsync(bool initial)
    {
        var version = ++_loadVersion;
        try
        {
            if (initial) _loading = true; else _refreshing = true;
            var sites = await SiteService.GetSitesAsync();
            if (version != _loadVersion) return;
            _sites = sites;
            ApplyFilters();
            _isError = false;
        }
        catch (Exception ex) { Fail(L.TranslateMessage(ex.Message), ex.ToString()); }
        finally { if (version == _loadVersion) { _loading = false; _refreshing = false; } }
    }

    private async Task SearchChangedAsync(string value)
    {
        _searchInput = value;
        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
        _searchDebounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(250, _searchDebounce.Token);
            _search = _searchInput.Trim();
            ApplyFilters();
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    private void SetFilter(string value) { _statusFilter = value; ApplyFilters(); }
    private void ShowAllSites() => SetFilter("all");
    private void ShowConnectedSites() => SetFilter("connected");
    private void ShowReviewSites() => SetFilter("review");
    private void ApplyFilters() => _visibleSites = _sites.Where(MatchesFilter).Where(x => string.IsNullOrWhiteSpace(_search) || x.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.SiteUrl.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();
    private bool MatchesFilter(AIWordPressManager.Domain.Entities.Site site) => _statusFilter switch { "connected" => site.ConnectionStatus == AIWordPressManager.Domain.Enums.SiteConnectionStatus.Connected, "review" => site.ConnectionStatus is not AIWordPressManager.Domain.Enums.SiteConnectionStatus.Connected and not AIWordPressManager.Domain.Enums.SiteConnectionStatus.Unknown, _ => true };

    private void OpenAddForm() { _editingId = null; _model = new(); _showForm = true; _message = null; }
    private Task OpenAddFormClicked(MouseEventArgs _) { OpenAddForm(); return Task.CompletedTask; }
    private void OpenEditForm(AIWordPressManager.Domain.Entities.Site site) { _editingId = site.Id; _model = new() { Name = site.Name, Url = site.SiteUrl }; _showForm = true; _message = null; }
    private void CloseForm() { if (_saving) return; _showForm = false; _editingId = null; _model = new(); }
    private Task CloseFormClicked(MouseEventArgs _) { CloseForm(); return Task.CompletedTask; }

    private async Task SaveAsync()
    {
        try
        {
            _saving = true;
            if (string.IsNullOrWhiteSpace(_model.Name)) { Warn(L["RequiredSiteName"]); return; }
            if (string.IsNullOrWhiteSpace(_model.Url)) { Warn(L["RequiredUrl"]); return; }
            if (!Uri.TryCreate(_model.Url, UriKind.Absolute, out var uri) || uri.Scheme is not ("http" or "https")) { Warn(L["InvalidUrl"]); return; }
            if (_editingId is { } siteId) await SiteService.UpdateSiteAsync(siteId, _model.Name, _model.Url); else await SiteService.AddSiteAsync(_model.Name, _model.Url);
            Notifications.Success(L.IsArabic ? "تم حفظ الموقع." : "Site saved.", L["Sites"]);
            _showForm = false; _editingId = null; _model = new(); _isError = false;
            await ReloadAsync(false);
        }
        catch (Exception ex) { Fail(L.TranslateMessage(ex.Message), ex.ToString()); }
        finally { _saving = false; }
    }

    private async Task RetestAsync(Guid id)
    {
        try
        {
            _busySiteId = id;
            var result = await SiteService.RetestAsync(id);
            if (result.IsSuccess) Notifications.Success(L.TranslateMessage(result.Message)); else Notifications.Error(L.TranslateMessage(result.Message));
            var refreshed = await SiteService.GetSiteAsync(id);
            if (refreshed is not null)
            {
                var index = _sites.FindIndex(x => x.Id == id);
                if (index >= 0) _sites[index] = refreshed;
                ApplyFilters();
            }
        }
        catch (Exception ex) { Fail(L.TranslateMessage(ex.Message), ex.ToString()); }
        finally { _busySiteId = null; }
    }

    private async Task DeleteAsync(Guid id, string name)
    {
        if (!await JS.InvokeAsync<bool>("confirm", L.IsArabic ? $"هل تريد حذف الموقع «{name}»؟" : $"Delete site ‘{name}’?")) return;
        try
        {
            _busySiteId = id;
            await SiteService.DeleteSiteAsync(id);
            _sites.RemoveAll(x => x.Id == id);
            ApplyFilters();
            Notifications.Success(L["DeletedSuccess"], L["Sites"]);
        }
        catch (Exception ex) { Fail(L.TranslateMessage(ex.Message), ex.ToString()); }
        finally { _busySiteId = null; }
    }

    private void Warn(string message) { _isError = true; _message = message; Notifications.Warning(message, L["Sites"]); }
    private void Fail(string message, string? details = null) { _isError = true; _message = message; Notifications.Error(message, L["Sites"], details); }
    private string StatusText(AIWordPressManager.Domain.Enums.SiteConnectionStatus status) => status switch { AIWordPressManager.Domain.Enums.SiteConnectionStatus.Connected => L["Connected"], AIWordPressManager.Domain.Enums.SiteConnectionStatus.Unreachable => L["Unreachable"], AIWordPressManager.Domain.Enums.SiteConnectionStatus.AuthenticationFailed => L["AuthFailed"], AIWordPressManager.Domain.Enums.SiteConnectionStatus.LimitedPermissions => L["NeedsReview"], _ => L["NotTested"] };
    private static string StatusTone(AIWordPressManager.Domain.Enums.SiteConnectionStatus status) => status switch { AIWordPressManager.Domain.Enums.SiteConnectionStatus.Connected => "success", AIWordPressManager.Domain.Enums.SiteConnectionStatus.Unknown => "neutral", AIWordPressManager.Domain.Enums.SiteConnectionStatus.LimitedPermissions => "warning", _ => "danger" };
    private static int HealthPercent(AIWordPressManager.Domain.Enums.SiteConnectionStatus status) => status == AIWordPressManager.Domain.Enums.SiteConnectionStatus.Connected ? 100 : status == AIWordPressManager.Domain.Enums.SiteConnectionStatus.Unknown ? 35 : status == AIWordPressManager.Domain.Enums.SiteConnectionStatus.LimitedPermissions ? 60 : 15;
    private static string HealthTone(int health) => health >= 80 ? "success" : health >= 45 ? "warning" : "danger";
    private string FormatDate(DateTime? value) => value is null ? "—" : value.Value.ToLocalTime().ToString(L.IsArabic ? "yyyy-MM-dd HH:mm" : "MMM d, yyyy HH:mm");
    private static string Initials(string name) { var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length == 0 ? "WP" : string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0]))); }
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { L.Changed -= Changed; _searchDebounce?.Cancel(); _searchDebounce?.Dispose(); }
    private sealed class SiteInput { public string Name { get; set; } = string.Empty; public string Url { get; set; } = string.Empty; }
}