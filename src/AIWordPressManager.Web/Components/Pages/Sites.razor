@page "/sites"
@rendermode InteractiveServer
@implements IDisposable
@inject SiteWebService SiteService
@inject AppLanguageService L
@inject AppNotificationService Notifications
@inject IJSRuntime JS
<PageTitle>@L["Sites"]</PageTitle>

<div class="sites-page sites-workspace">
    <section class="sites-hero panel">
        <div>
            <span class="workspace-kicker">@(L.IsArabic ? "إدارة البنية الرقمية" : "DIGITAL ESTATE")</span>
            <h1>@L["Sites"]</h1>
            <p>@(L.IsArabic ? "راقب اتصالات WordPress وصحة المواقع وافتح أدوات المحتوى من مساحة عمل موحدة." : "Monitor WordPress connections, site health and content tools from one unified workspace.")</p>
        </div>
        <div class="sites-hero-actions">
            <a class="btn" href="/system-health">♥ @(L.IsArabic ? "صحة النظام" : "System health")</a>
            <button class="btn" @onclick="ReloadAsync" disabled="@_loading">↻ @(_loading ? (L.IsArabic ? "جارٍ التحديث" : "Refreshing") : L["Refresh"])</button>
            <button class="btn primary" @onclick="OpenAddForm" disabled="@_saving">＋ @L["AddSite"]</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "error" : "success")">@_message</div>
    }

    <section class="sites-summary-grid">
        <article class="panel site-summary-card"><span class="site-summary-icon">◉</span><div><small>@L["TotalSites"]</small><strong>@_sites.Count</strong><p>@L["AllRegisteredSites"]</p></div></article>
        <article class="panel site-summary-card"><span class="site-summary-icon success">✓</span><div><small>@L["Connected"]</small><strong>@ConnectedCount</strong><p>@L["HealthyConnection"]</p></div></article>
        <article class="panel site-summary-card"><span class="site-summary-icon warning">!</span><div><small>@L["NeedsReview"]</small><strong>@ProblemCount</strong><p>@L["ConnectionOrLoginFailed"]</p></div></article>
        <article class="panel site-summary-card"><span class="site-summary-icon">◷</span><div><small>@L["LastCheck"]</small><strong class="summary-date">@LatestCheck</strong><p>@L["LocalDatabase"]</p></div></article>
    </section>

    @if (_showForm)
    {
        <section class="panel site-create-panel">
            <div class="site-create-head">
                <div><span class="workspace-kicker">@(_editingId.HasValue ? (L.IsArabic ? "تعديل الاتصال" : "EDIT CONNECTION") : (L.IsArabic ? "اتصال جديد" : "NEW CONNECTION"))</span><h2>@(_editingId.HasValue ? (L.IsArabic ? "تعديل بيانات الموقع" : "Edit site profile") : L["AddNewSite"])</h2><p>@(L.IsArabic ? "راجع الاسم والرابط قبل الحفظ." : "Review the name and URL before saving.")</p></div>
                <button type="button" class="icon-button" @onclick="CloseForm" aria-label="Close">×</button>
            </div>
            <EditForm Model="_model" OnSubmit="SaveAsync">
                <div class="site-create-grid">
                    <label><span>@L["SiteName"]</span><InputText @bind-Value="_model.Name" placeholder="@(L.IsArabic ? "مثال: موقع الشركة" : "Example: Corporate site")" disabled="@_saving" /></label>
                    <label><span>@L["SiteUrl"]</span><InputText @bind-Value="_model.Url" placeholder="https://example.com" disabled="@_saving" /></label>
                </div>
                <div class="site-form-hint">🔒 @(L.IsArabic ? "يتم حفظ الرابط بعد تطبيعه ومنع التكرار تلقائيًا." : "The URL is normalized and duplicate sites are blocked automatically.")</div>
                <div class="actions"><button type="submit" class="btn primary" disabled="@_saving">@(_saving ? L["Saving"] : L["Save"])</button><button type="button" class="btn" @onclick="CloseForm" disabled="@_saving">@L["Cancel"]</button></div>
            </EditForm>
        </section>
    }

    <section class="sites-toolbar panel">
        <div class="sites-search"><span>⌕</span><input @bind="_search" @bind:event="oninput" placeholder="@(L.IsArabic ? "ابحث بالاسم أو الرابط..." : "Search by name or URL...")" /></div>
        <div class="sites-filter-group">
            <button class="site-filter @(_statusFilter == "all" ? "active" : string.Empty)" @onclick="ShowAllSites">@(L.IsArabic ? "الكل" : "All") <b>@_sites.Count</b></button>
            <button class="site-filter @(_statusFilter == "connected" ? "active" : string.Empty)" @onclick="ShowConnectedSites">@(L.IsArabic ? "متصل" : "Connected") <b>@ConnectedCount</b></button>
            <button class="site-filter @(_statusFilter == "review" ? "active" : string.Empty)" @onclick="ShowReviewSites">@(L.IsArabic ? "يحتاج مراجعة" : "Needs review") <b>@ProblemCount</b></button>
        </div>
        <div class="sites-view-note">@(L.IsArabic ? $"عرض {FilteredSites.Count()} موقع" : $"Showing {FilteredSites.Count()} sites")</div>
    </section>

    @if (_loading)
    {
        <div class="sites-skeleton-grid">@for (var i = 0; i < 4; i++) { <div class="panel site-skeleton"></div> }</div>
    }
    else if (!_sites.Any())
    {
        <section class="panel sites-empty"><div class="sites-empty-icon">◎</div><h2>@L["NoSites"]</h2><p>@L["AddFirstSite"]</p><button class="btn primary" @onclick="OpenAddForm">＋ @L["AddSite"]</button></section>
    }
    else
    {
        <section class="sites-card-grid">
            @foreach (var site in FilteredSites)
            {
                var busy = _busySiteId == site.Id;
                var health = HealthPercent(site.ConnectionStatus);
                <article class="panel site-management-card @(busy ? "is-busy" : string.Empty)">
                    <header><div class="site-identity"><div class="site-avatar">@Initials(site.Name)</div><div><h3>@site.Name</h3><a href="@site.SiteUrl" target="_blank" rel="noopener">@site.SiteUrl</a></div></div><span class="site-state @StatusClass(site.ConnectionStatus)"><i></i>@StatusText(site.ConnectionStatus)</span></header>
                    <div class="site-overview-row">
                        <div class="site-health-ring" style="--health:@health"><div><strong>@health%</strong><small>@(L.IsArabic ? "الصحة" : "Health")</small></div></div>
                        <div class="site-card-metrics">
                            <div><small>@L["WordPressVersion"]</small><strong>@(string.IsNullOrWhiteSpace(site.WordPressVersion) ? "—" : site.WordPressVersion)</strong></div>
                            <div><small>@L["LastTest"]</small><strong>@FormatDate(site.LastConnectionTestAtUtc)</strong></div>
                            <div><small>@(L.IsArabic ? "لغة الموقع" : "Site language")</small><strong>@(string.IsNullOrWhiteSpace(site.LanguageCode) ? "—" : site.LanguageCode)</strong></div>
                            <div><small>REST API</small><strong>@StatusText(site.ConnectionStatus)</strong></div>
                        </div>
                    </div>
                    <div class="site-quick-links"><a href="@($"/sites/{site.Id}")"><span>⌂</span>@(L.IsArabic ? "لوحة الموقع" : "Dashboard")</a><a href="@($"/sites/{site.Id}/explorer")"><span>▤</span>@(L.IsArabic ? "المحتوى" : "Content")</a><a href="@site.SiteUrl" target="_blank" rel="noopener"><span>↗</span>@(L.IsArabic ? "فتح الموقع" : "Visit site")</a></div>
                    <div class="site-health-line"><span style="width:@health%"></span></div>
                    <footer class="site-card-actions"><a class="btn primary" href="@($"/sites/{site.Id}")">@L["Open"]</a><button class="btn" title="Test connection" disabled="@busy" @onclick="() => RetestAsync(site.Id)">@(busy ? "…" : "↻")</button><button class="btn" title="Edit" disabled="@busy" @onclick="() => OpenEditForm(site)">✎</button><button class="btn danger" title="@L["Delete"]" disabled="@busy" @onclick="() => DeleteAsync(site.Id, site.Name)">⌫</button></footer>
                    @if (busy) { <div class="site-card-overlay"><span class="site-spinner"></span><strong>@(L.IsArabic ? "جارٍ تنفيذ العملية..." : "Processing...")</strong></div> }
                </article>
            }
        </section>
    }
</div>

@code {
    private bool _loading = true, _saving, _showForm, _isError;
    private Guid? _editingId, _busySiteId;
    private string? _message;
    private string _search = string.Empty;
    private string _statusFilter = "all";
    private List<AIWordPressManager.Domain.Entities.Site> _sites = [];
    private SiteInput _model = new();

    private int ConnectedCount => _sites.Count(x => x.ConnectionStatus == AIWordPressManager.Domain.Enums.SiteConnectionStatus.Connected);
    private int ProblemCount => _sites.Count(x => x.ConnectionStatus is not AIWordPressManager.Domain.Enums.SiteConnectionStatus.Connected and not AIWordPressManager.Domain.Enums.SiteConnectionStatus.Unknown);
    private string LatestCheck => FormatDate(_sites.Where(x => x.LastConnectionTestAtUtc.HasValue).Select(x => x.LastConnectionTestAtUtc).OrderByDescending(x => x).FirstOrDefault());
    private IEnumerable<AIWordPressManager.Domain.Entities.Site> FilteredSites => _sites.Where(MatchesFilter).Where(x => string.IsNullOrWhiteSpace(_search) || x.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.SiteUrl.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized() => L.Changed += Changed;
    protected override async Task OnInitializedAsync() => await ReloadAsync();
    private bool MatchesFilter(AIWordPressManager.Domain.Entities.Site site) => _statusFilter switch { "connected" => site.ConnectionStatus == AIWordPressManager.Domain.Enums.SiteConnectionStatus.Connected, "review" => site.ConnectionStatus is not AIWordPressManager.Domain.Enums.SiteConnectionStatus.Connected and not AIWordPressManager.Domain.Enums.SiteConnectionStatus.Unknown, _ => true };
    private void ShowAllSites() => _statusFilter = "all";
    private void ShowConnectedSites() => _statusFilter = "connected";
    private void ShowReviewSites() => _statusFilter = "review";

    private async Task ReloadAsync() { try { _loading = true; _sites = await SiteService.GetSitesAsync(); _isError = false; } catch (Exception ex) { Fail(L.TranslateMessage(ex.Message), ex.ToString()); } finally { _loading = false; } }
    private void OpenAddForm() { _editingId = null; _model = new(); _showForm = true; _message = null; }
    private void OpenEditForm(AIWordPressManager.Domain.Entities.Site site) { _editingId = site.Id; _model = new() { Name = site.Name, Url = site.SiteUrl }; _showForm = true; _message = null; }
    private void CloseForm() { if (_saving) return; _showForm = false; _editingId = null; _model = new(); }

    private async Task SaveAsync()
    {
        try { _saving = true; if (string.IsNullOrWhiteSpace(_model.Name)) { Warn(L["RequiredSiteName"]); return; } if (string.IsNullOrWhiteSpace(_model.Url)) { Warn(L["RequiredUrl"]); return; } if (!Uri.TryCreate(_model.Url, UriKind.Absolute, out var uri) || uri.Scheme is not ("http" or "https")) { Warn(L["InvalidUrl"]); return; } if (_editingId is { } siteId) { await SiteService.UpdateSiteAsync(siteId, _model.Name, _model.Url); _message = L.IsArabic ? "تم تحديث بيانات الموقع." : "Site profile updated."; } else { await SiteService.AddSiteAsync(_model.Name, _model.Url); _message = L["AddedSuccess"]; } Notifications.Success(_message, L["Sites"]); _showForm = false; _editingId = null; _model = new(); _isError = false; await ReloadAsync(); }
        catch (Exception ex) { Fail(L.TranslateMessage(ex.Message), ex.ToString()); }
        finally { _saving = false; }
    }

    private async Task RetestAsync(Guid id) { try { _busySiteId = id; var result = await SiteService.RetestAsync(id); if (result.IsSuccess) Notifications.Success(L.TranslateMessage(result.Message), L.IsArabic ? "اختبار الاتصال" : "Connection test"); else Notifications.Error(L.TranslateMessage(result.Message), L.IsArabic ? "فشل اختبار الاتصال" : "Connection test failed", result.Diagnostics); await ReloadAsync(); } catch (Exception ex) { Fail(L.TranslateMessage(ex.Message), ex.ToString()); } finally { _busySiteId = null; } }
    private async Task DeleteAsync(Guid id, string name) { var confirmed = await JS.InvokeAsync<bool>("confirm", L.IsArabic ? $"هل تريد حذف الموقع «{name}»؟" : $"Delete site ‘{name}’?"); if (!confirmed) return; try { _busySiteId = id; await SiteService.DeleteSiteAsync(id); _message = L["DeletedSuccess"]; _isError = false; Notifications.Success(_message, L["Sites"]); await ReloadAsync(); } catch (Exception ex) { Fail(L.TranslateMessage(ex.Message), ex.ToString()); } finally { _busySiteId = null; } }

    private void Warn(string message) { _isError = true; _message = message; Notifications.Warning(message, L["Sites"]); }
    private void Fail(string message, string? details = null) { _isError = true; _message = message; Notifications.Error(message, L["Sites"], details); }
    private string StatusText(AIWordPressManager.Domain.Enums.SiteConnectionStatus status) => status switch { AIWordPressManager.Domain.Enums.SiteConnectionStatus.Connected => L["Connected"], AIWordPressManager.Domain.Enums.SiteConnectionStatus.Unreachable => L["Unreachable"], AIWordPressManager.Domain.Enums.SiteConnectionStatus.AuthenticationFailed => L["AuthFailed"], AIWordPressManager.Domain.Enums.SiteConnectionStatus.LimitedPermissions => L["NeedsReview"], _ => L["NotTested"] };
    private static string StatusClass(AIWordPressManager.Domain.Enums.SiteConnectionStatus status) => status == AIWordPressManager.Domain.Enums.SiteConnectionStatus.Connected ? "connected" : status == AIWordPressManager.Domain.Enums.SiteConnectionStatus.Unknown ? "neutral" : "problem";
    private static int HealthPercent(AIWordPressManager.Domain.Enums.SiteConnectionStatus status) => status == AIWordPressManager.Domain.Enums.SiteConnectionStatus.Connected ? 100 : status == AIWordPressManager.Domain.Enums.SiteConnectionStatus.Unknown ? 35 : status == AIWordPressManager.Domain.Enums.SiteConnectionStatus.LimitedPermissions ? 60 : 15;
    private string FormatDate(DateTime? value) => value is null ? "—" : value.Value.ToLocalTime().ToString(L.IsArabic ? "yyyy-MM-dd HH:mm" : "MMM d, yyyy HH:mm");
    private static string Initials(string name) { var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length == 0 ? "WP" : string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0]))); }
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= Changed;
    private sealed class SiteInput { public string Name { get; set; } = ""; public string Url { get; set; } = ""; }
}
