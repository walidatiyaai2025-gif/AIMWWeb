@page "/module/ai-usage"
@rendermode InteractiveServer
@implements IDisposable
@using AIWordPressManager.Application.Abstractions.AI
@inject AIUsageWebService UsageService
@inject AppLanguageService L

<PageTitle>@(L.IsArabic ? "استخدام وتكلفة الذكاء الاصطناعي" : "AI Usage & Cost")</PageTitle>

<section class="panel usage-hero">
    <div>
        <span class="workspace-kicker">AI OBSERVABILITY</span>
        <h2>@(L.IsArabic ? "استخدام وتكلفة الذكاء الاصطناعي" : "AI Usage & Cost")</h2>
        <p>@(L.IsArabic ? "سجل خاص بحسابك فقط لطلبات الذكاء الاصطناعي والرموز والتكلفة المقدرة وحالات النجاح والفشل." : "Account-scoped observability for AI calls, tokens, estimated cost, and success or failure outcomes.")</p>
    </div>
    <div class="usage-actions">
        <a class="btn" href="/ai-center">✦ @(L.IsArabic ? "مركز الذكاء الاصطناعي" : "AI Center")</a>
        <button class="btn" disabled="@_loading" @onclick="LoadAsync">↻ @(L.IsArabic ? "تحديث" : "Refresh")</button>
    </div>
</section>

<AppFilterBar AriaLabel="@(L.IsArabic ? "فلاتر استخدام الذكاء الاصطناعي" : "AI usage filters")"
              ActiveFilterCount="@SiteFilterCount"
              ActiveFiltersText="@(L.IsArabic ? "فلتر نشط" : "active filter")"
              NoFiltersText="@(L.IsArabic ? "عرض كل المواقع" : "Showing all sites")"
              AppliedFiltersAriaLabel="@(L.IsArabic ? "الفلاتر المطبقة" : "Applied filters")"
              ClearText="@(L.IsArabic ? "مسح الفلاتر" : "Clear filters")"
              ClearAriaLabel="@(L.IsArabic ? "مسح فلتر الموقع" : "Clear site filter")"
              Busy="@_loading"
              ClearRequested="ClearSiteFilterAsync">
    <ChildContent>
        <label>
            <span>@(L.IsArabic ? "تصفية حسب الموقع" : "Filter by site")</span>
            <select value="@_selectedSiteId" @onchange="OnSiteChangedAsync" disabled="@_loading" aria-label="@(L.IsArabic ? "اختيار موقع لفلترة سجل الاستخدام" : "Choose site to filter usage history")">
                <option value="">@(L.IsArabic ? "كل مواقعي" : "All my sites")</option>
                @if (_snapshot is not null)
                {
                    @foreach (var site in _snapshot.Sites)
                    {
                        <option value="@site.Id">@site.Name</option>
                    }
                }
            </select>
        </label>
        <small>@(L.IsArabic ? "الهوية مأخوذة من جلسة الدخول الحالية ولا يتم قبول UserId من العميل." : "Identity comes from the authenticated session; client-supplied UserId is not trusted.")</small>
    </ChildContent>
    <AppliedFilters>
        @if (SiteFilterCount > 0)
        {
            <AppFilterChip Label="@(L.IsArabic ? "الموقع" : "Site")"
                           Value="@SelectedSiteName"
                           RemoveAriaLabel="@(L.IsArabic ? "إزالة فلتر الموقع" : "Remove site filter")"
                           Disabled="@_loading"
                           RemoveRequested="ClearSiteFilterAsync" />
        }
    </AppliedFilters>
</AppFilterBar>

@if (_loading && _snapshot is null)
{
    <AppLoading Title="@(L.IsArabic ? "جارٍ تحميل سجل الاستخدام" : "Loading AI usage")"
                Message="@(L.IsArabic ? "يتم تحميل المقاييس وآخر الطلبات لحسابك." : "Loading account metrics and recent AI calls.")"
                ShowSkeleton="true"
                SkeletonLines="5"
                Class="usage-loading" />
}
else if (!string.IsNullOrWhiteSpace(_error) && _snapshot is null)
{
    <AppStatePanel Kind="error"
                   Title="@(L.IsArabic ? "تعذر تحميل سجل الاستخدام" : "Could not load AI usage")"
                   Description="@_error"
                   RecoveryLabel="@(L.IsArabic ? "الخطوة التالية:" : "Next:")"
                   RecoveryText="@(L.IsArabic ? "أعد المحاولة. إذا استمرت المشكلة، راجع حالة الخدمة والسجلات." : "Retry. If the problem continues, review service health and logs.")"
                   RetryText="@(L.IsArabic ? "إعادة المحاولة" : "Try again")"
                   RetryingText="@(L.IsArabic ? "جارٍ إعادة المحاولة..." : "Trying again...")"
                   RetryAriaLabel="@(L.IsArabic ? "إعادة تحميل استخدام الذكاء الاصطناعي" : "Retry loading AI usage")"
                   Busy="@_loading"
                   RetryRequested="LoadAsync" />
}
else if (_snapshot is null)
{
    <AppEmptyState Title="@(L.IsArabic ? "لا توجد بيانات استخدام متاحة" : "No usage data is available")"
                   Description="@(L.IsArabic ? "لم يتم إرجاع سجل استخدام لهذا النطاق بعد." : "No usage history was returned for this scope yet.")"
                   RecoveryLabel="@(L.IsArabic ? "يمكنك:" : "You can:")"
                   RecoveryText="@(L.IsArabic ? "نفّذ طلبًا من مركز الذكاء الاصطناعي ثم حدّث هذه الصفحة." : "Run an AI request from AI Center, then refresh this page.")"
                   Icon="○">
        <Actions><a class="btn" href="/ai-center">✦ @(L.IsArabic ? "فتح مركز الذكاء الاصطناعي" : "Open AI Center")</a></Actions>
    </AppEmptyState>
}
else
{
    @if (_loading)
    {
        <AppStateBanner Kind="info"
                        Title="@(L.IsArabic ? "جارٍ تحديث البيانات" : "Refreshing usage data")"
                        Description="@(L.IsArabic ? "تظل آخر بيانات ناجحة ظاهرة أثناء التحديث." : "The last successful snapshot remains visible while refresh runs.")"
                        Busy="true" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <AppStateBanner Kind="cached"
                        Title="@(L.IsArabic ? "تعذر التحديث — يتم عرض آخر بيانات ناجحة" : "Refresh failed — showing last successful data")"
                        Description="@_error"
                        FreshnessText="@LoadedSnapshotText"
                        RetryText="@(L.IsArabic ? "إعادة المحاولة" : "Retry refresh")"
                        RetryingText="@(L.IsArabic ? "جارٍ إعادة المحاولة..." : "Retrying...")"
                        RetryAriaLabel="@(L.IsArabic ? "إعادة تحديث بيانات الاستخدام" : "Retry refreshing usage data")"
                        Busy="@_loading"
                        RetryRequested="LoadAsync" />
    }

    @if (FailedCallCount > 0)
    {
        <AppStateBanner Kind="partial"
                        Title="@(L.IsArabic ? $"يوجد {FailedCallCount} طلب غير ناجح" : $"{FailedCallCount} AI calls were not successful")"
                        Description="@(L.IsArabic ? "البيانات الناجحة ما زالت صالحة للعرض؛ راجع الصفوف المميزة لمعرفة تفاصيل الفشل." : "Successful telemetry remains available; review the marked rows for failure details.")" />
    }

    <section class="usage-kpis">
        <article class="panel usage-kpi"><small>@(L.IsArabic ? "إجمالي الطلبات" : "Total calls")</small><strong>@_snapshot.TotalCalls</strong><span>@(L.IsArabic ? "ضمن آخر 10,000 سجل محفوظ" : "within the latest 10,000 retained records")</span></article>
        <article class="panel usage-kpi"><small>@(L.IsArabic ? "معدل النجاح" : "Success rate")</small><strong>@_snapshot.SuccessRate.ToString("P0")</strong><span>@_snapshot.SuccessfulCalls / @_snapshot.TotalCalls</span></article>
        <article class="panel usage-kpi"><small>@(L.IsArabic ? "رموز الإدخال" : "Input tokens")</small><strong>@FormatNumber(_snapshot.InputTokens)</strong><span>@(L.IsArabic ? "مسجلة أو مقدرة بواسطة المزود" : "provider reported or estimated")</span></article>
        <article class="panel usage-kpi"><small>@(L.IsArabic ? "رموز الإخراج" : "Output tokens")</small><strong>@FormatNumber(_snapshot.OutputTokens)</strong><span>@(L.IsArabic ? "مسجلة أو مقدرة بواسطة المزود" : "provider reported or estimated")</span></article>
        <article class="panel usage-kpi"><small>@(L.IsArabic ? "التكلفة المقدرة" : "Estimated cost")</small><strong>@_snapshot.EstimatedCost.ToString("C4", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</strong><span>@(L.IsArabic ? "تعرض القيمة التي يعيدها Adapter الحالي" : "uses the current adapter-reported estimate")</span></article>
    </section>

    <section class="usage-grid">
        <article class="panel usage-breakdown">
            <header><div><span class="workspace-kicker">PROVIDERS</span><h2>@(L.IsArabic ? "حسب المزود" : "By provider")</h2></div></header>
            @if (_snapshot.Providers.Count == 0)
            {
                <AppEmptyState Title="@(L.IsArabic ? "لا توجد طلبات حسب المزود" : "No provider activity yet")"
                               Description="@(L.IsArabic ? "ستظهر ملخصات المزودين بعد تسجيل أول طلب." : "Provider summaries appear after the first recorded AI call.")"
                               Blocking="false" />
            }
            else
            {
                @foreach (var item in _snapshot.Providers)
                {
                    <div class="usage-breakdown-row">
                        <div><strong>@item.Name</strong><small>@item.SuccessfulCalls/@item.Calls @(L.IsArabic ? "ناجح" : "successful")</small></div>
                        <div><span>@FormatNumber(item.InputTokens + item.OutputTokens) tokens</span><span>@item.EstimatedCost.ToString("C4", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span></div>
                    </div>
                }
            }
        </article>

        <article class="panel usage-breakdown">
            <header><div><span class="workspace-kicker">OPERATIONS</span><h2>@(L.IsArabic ? "حسب العملية" : "By operation")</h2></div></header>
            @if (_snapshot.Operations.Count == 0)
            {
                <AppEmptyState Title="@(L.IsArabic ? "لا توجد عمليات بعد" : "No operations yet")"
                               Description="@(L.IsArabic ? "ستظهر أنواع العمليات بعد تسجيل النشاط." : "Operation summaries appear after activity is recorded.")"
                               Blocking="false" />
            }
            else
            {
                @foreach (var item in _snapshot.Operations.Take(12))
                {
                    <div class="usage-breakdown-row">
                        <div><strong>@item.Name</strong><small>@item.Calls @(L.IsArabic ? "طلب" : "calls")</small></div>
                        <div><span>@FormatNumber(item.InputTokens + item.OutputTokens) tokens</span><span>@item.EstimatedCost.ToString("C4", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span></div>
                    </div>
                }
            }
        </article>
    </section>

    <section class="panel usage-recent">
        <header><div><span class="workspace-kicker">RECENT ACTIVITY</span><h2>@(L.IsArabic ? "آخر طلبات الذكاء الاصطناعي" : "Recent AI calls")</h2></div><small>@_snapshot.Recent.Count @(L.IsArabic ? "سجل محتفظ به" : "retained records")</small></header>

        <AppDataGrid TItem="AIUsageEntry"
                     Items="@RecentRows"
                     KeySelector="entry => UsageKey(entry)"
                     RowAriaLabelSelector="entry => UsageRowLabel(entry)"
                     RowStateSelector="entry => UsageRowState(entry)"
                     SearchKeySelector="entry => UsageSearchText(entry)"
                     CsvHeaders="@UsageCsvHeaders"
                     CsvRowSelector="entry => UsageCsvRow(entry)"
                     CsvFileName="ai-usage.csv"
                     PageSize="25"
                     PageSizeOptions="@(new[] { 10, 25, 50, 100 })"
                     Density="compact"
                     Striped="true"
                     FocusableRows="true"
                     TableLabel="@(L.IsArabic ? "جدول آخر طلبات الذكاء الاصطناعي" : "Recent AI usage calls")"
                     Caption="@(L.IsArabic ? "آخر طلبات الذكاء الاصطناعي مع المزود والعملية والموقع والرموز والتكلفة والحالة." : "Recent AI calls with provider, operation, site, tokens, cost, and state.")"
                     ViewportAriaLabel="@(L.IsArabic ? "جدول قابل للتمرير لطلبات الذكاء الاصطناعي" : "Scrollable recent AI calls table")"
                     EmptyTitle="@(L.IsArabic ? "لا توجد طلبات بعد" : "No AI calls yet")"
                     EmptyDescription="@(L.IsArabic ? "ستظهر طلبات الذكاء الاصطناعي هنا بعد تنفيذها." : "AI calls will appear here after they run.")"
                     NoResultsTitle="@(L.IsArabic ? "لا توجد نتائج مطابقة" : "No matching AI calls")"
                     NoResultsDescription="@(L.IsArabic ? "غيّر نص البحث أو امسحه لعرض سجلات أخرى." : "Change or clear the search text to see other records.")"
                     SearchPlaceholder="@(L.IsArabic ? "بحث في المزود أو العملية أو الموقع..." : "Search provider, operation, site...")"
                     SearchAriaLabel="@(L.IsArabic ? "بحث في طلبات الذكاء الاصطناعي" : "Search AI usage calls")"
                     ClearSearchText="@(L.IsArabic ? "مسح البحث" : "Clear search")"
                     ExportText="@(L.IsArabic ? "تصدير CSV" : "Export CSV")"
                     ShowingText="@(L.IsArabic ? "عرض" : "Showing")"
                     OfText="@(L.IsArabic ? "من" : "of")"
                     RowsPerPageText="@(L.IsArabic ? "صفوف" : "Rows")"
                     RowsPerPageAriaLabel="@(L.IsArabic ? "عدد الصفوف في الصفحة" : "Rows per page")"
                     PaginationText="@(L.IsArabic ? "صفحات سجل الاستخدام" : "Usage log pagination")"
                     PreviousPageText="@(L.IsArabic ? "الصفحة السابقة" : "Previous page")"
                     NextPageText="@(L.IsArabic ? "الصفحة التالية" : "Next page")"
                     PageText="@(L.IsArabic ? "صفحة" : "Page")">
            <Header>
                <th scope="col">@(L.IsArabic ? "الوقت" : "Time")</th>
                <th scope="col">@(L.IsArabic ? "المزود" : "Provider")</th>
                <th scope="col">@(L.IsArabic ? "العملية" : "Operation")</th>
                <th scope="col">@(L.IsArabic ? "الموقع" : "Site")</th>
                <th scope="col">Tokens</th>
                <th scope="col">@(L.IsArabic ? "التكلفة" : "Cost")</th>
                <th scope="col">@(L.IsArabic ? "الحالة" : "State")</th>
            </Header>
            <RowTemplate Context="entry">
                <td><time datetime="@UsageTimestamp(entry)">@entry.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</time></td>
                <td><strong>@entry.Provider</strong><small>@(entry.Model ?? "—")</small></td>
                <td>@(entry.Operation ?? "—")</td>
                <td>@SiteName(entry.SiteId)</td>
                <td>@FormatNumber((long)entry.InputTokens + entry.OutputTokens)</td>
                <td>@entry.EstimatedCost.ToString("C4", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td>
                <td><AppBadge Tone="@(entry.IsSuccess ? "success" : "danger")" Text="@(entry.IsSuccess ? (L.IsArabic ? "نجح" : "Success") : (L.IsArabic ? "فشل" : "Failed"))" />@if (!entry.IsSuccess && !string.IsNullOrWhiteSpace(entry.Error)){<small class="usage-error">@entry.Error</small>}</td>
            </RowTemplate>
            <MobileRowTemplate Context="entry">
                <div class="usage-mobile-row">
                    <div><strong>@entry.Provider</strong><small>@(entry.Model ?? "—")</small></div>
                    <AppBadge Tone="@(entry.IsSuccess ? "success" : "danger")" Text="@(entry.IsSuccess ? (L.IsArabic ? "نجح" : "Success") : (L.IsArabic ? "فشل" : "Failed"))" />
                    <dl>
                        <div><dt>@(L.IsArabic ? "الوقت" : "Time")</dt><dd>@entry.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd></div>
                        <div><dt>@(L.IsArabic ? "العملية" : "Operation")</dt><dd>@(entry.Operation ?? "—")</dd></div>
                        <div><dt>@(L.IsArabic ? "الموقع" : "Site")</dt><dd>@SiteName(entry.SiteId)</dd></div>
                        <div><dt>Tokens</dt><dd>@FormatNumber((long)entry.InputTokens + entry.OutputTokens)</dd></div>
                        <div><dt>@(L.IsArabic ? "التكلفة" : "Cost")</dt><dd>@entry.EstimatedCost.ToString("C4", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</dd></div>
                    </dl>
                    @if (!entry.IsSuccess && !string.IsNullOrWhiteSpace(entry.Error))
                    {
                        <small class="usage-error">@entry.Error</small>
                    }
                </div>
            </MobileRowTemplate>
        </AppDataGrid>
    </section>
}

@code {
    private AIUsageDashboardSnapshot? _snapshot;
    private string _selectedSiteId = string.Empty;
    private string _error = string.Empty;
    private bool _loading;
    private DateTime? _loadedAtUtc;

    private int SiteFilterCount => string.IsNullOrWhiteSpace(_selectedSiteId) ? 0 : 1;
    private int FailedCallCount => _snapshot is null ? 0 : Math.Max(0, _snapshot.TotalCalls - _snapshot.SuccessfulCalls);
    private string SelectedSiteName => Guid.TryParse(_selectedSiteId, out var id) ? SiteName(id) : (L.IsArabic ? "كل المواقع" : "All sites");
    private string LoadedSnapshotText => _loadedAtUtc.HasValue
        ? (L.IsArabic ? $"آخر تحديث ناجح: {_loadedAtUtc.Value.ToLocalTime():yyyy-MM-dd HH:mm}" : $"Last successful refresh: {_loadedAtUtc.Value.ToLocalTime():yyyy-MM-dd HH:mm}")
        : (L.IsArabic ? "يتم عرض آخر بيانات ناجحة." : "Showing the last successful snapshot.");
    private IReadOnlyList<AIUsageEntry> RecentRows => _snapshot?.Recent.Take(250).ToArray() ?? Array.Empty<AIUsageEntry>();
    private IReadOnlyList<string> UsageCsvHeaders => L.IsArabic
        ? new[] { "الوقت", "المزود", "النموذج", "العملية", "الموقع", "Input Tokens", "Output Tokens", "التكلفة", "الحالة", "الخطأ" }
        : new[] { "Time", "Provider", "Model", "Operation", "Site", "Input Tokens", "Output Tokens", "Cost", "State", "Error" };

    protected override void OnInitialized() => L.Changed += Changed;
    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = string.Empty;
        try
        {
            var siteId = Guid.TryParse(_selectedSiteId, out var parsed) ? parsed : (Guid?)null;
            _snapshot = await UsageService.GetAsync(siteId, 10_000);
            _loadedAtUtc = DateTime.UtcNow;
        }
        catch (Exception ex)
        {
            _error = L.TranslateMessage(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSiteChangedAsync(ChangeEventArgs args)
    {
        _selectedSiteId = args.Value?.ToString() ?? string.Empty;
        await LoadAsync();
    }

    private async Task ClearSiteFilterAsync()
    {
        if (_loading || string.IsNullOrWhiteSpace(_selectedSiteId)) return;
        _selectedSiteId = string.Empty;
        await LoadAsync();
    }

    private string UsageSearchText(AIUsageEntry entry) => string.Join(' ', new[]
    {
        entry.Provider,
        entry.Model,
        entry.Operation,
        SiteName(entry.SiteId),
        entry.IsSuccess ? "success" : "failed",
        entry.Error
    }.Where(x => !string.IsNullOrWhiteSpace(x)));

    private string UsageRowLabel(AIUsageEntry entry) => $"{entry.Provider}, {entry.Operation ?? "—"}, {SiteName(entry.SiteId)}, {(entry.IsSuccess ? (L.IsArabic ? "نجح" : "Success") : (L.IsArabic ? "فشل" : "Failed"))}";
    private static string UsageRowState(AIUsageEntry entry) => entry.IsSuccess ? "success" : "error";
    private static string UsageTimestamp(AIUsageEntry entry) => entry.CreatedAtUtc.ToString("O", System.Globalization.CultureInfo.InvariantCulture);
    private static string UsageKey(AIUsageEntry entry) => $"{entry.CreatedAtUtc.Ticks}:{entry.Provider}:{entry.Operation}:{entry.SiteId}:{entry.InputTokens}:{entry.OutputTokens}";

    private IReadOnlyList<string> UsageCsvRow(AIUsageEntry entry) => new[]
    {
        UsageTimestamp(entry),
        entry.Provider,
        entry.Model ?? string.Empty,
        entry.Operation ?? string.Empty,
        SiteName(entry.SiteId),
        entry.InputTokens.ToString(System.Globalization.CultureInfo.InvariantCulture),
        entry.OutputTokens.ToString(System.Globalization.CultureInfo.InvariantCulture),
        entry.EstimatedCost.ToString(System.Globalization.CultureInfo.InvariantCulture),
        entry.IsSuccess ? "Success" : "Failed",
        entry.Error ?? string.Empty
    };

    private string SiteName(Guid? siteId)
    {
        if (!siteId.HasValue) return L.IsArabic ? "بدون موقع" : "No site";
        return _snapshot?.Sites.FirstOrDefault(x => x.Id == siteId.Value)?.Name ?? siteId.Value.ToString("N")[..8];
    }

    private static string FormatNumber(long value) => value.ToString("N0", System.Globalization.CultureInfo.InvariantCulture);
    private void Changed() => InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= Changed;
}
