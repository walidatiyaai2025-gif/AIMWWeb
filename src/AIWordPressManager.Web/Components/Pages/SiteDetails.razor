@page "/sites/{Id:guid}"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Site</PageTitle>

<div class="site-details-page">
    <AppToolbar Eyebrow="SITE WORKSPACE" Title="Site Dashboard" Subtitle="Manage connection, synchronization, content, SEO, and configuration.">
        <Actions>
            <AppButton Href="@($"/sites/{Id}/connection")" Text="Connection center" />
            <AppButton Href="@($"/sites/{Id}/settings")" Text="Site settings" />
            <AppButton Href="@($"/sites/{Id}/explorer")" Text="Content explorer" />
            <AppButton Href="/sites" Text="Back to sites" />
        </Actions>
    </AppToolbar>

    <AppCard Title="Site workspace" Subtitle="Use the actions above to manage this WordPress site.">
        <div class="site-tools-grid">
            <a class="site-tool-card" href="@($"/sites/{Id}/connection")"><span>↻</span><div><strong>Connection & Sync</strong><small>Credentials, tests, synchronization, and history</small></div></a>
            <a class="site-tool-card" href="@($"/sites/{Id}/settings")"><span>⚙</span><div><strong>Site Settings</strong><small>Profile, credentials, state, and deletion</small></div></a>
            <a class="site-tool-card" href="@($"/sites/{Id}/explorer")"><span>▤</span><div><strong>Content Explorer</strong><small>Posts, pages, media, categories, and tags</small></div></a>
            <a class="site-tool-card" href="@($"/sites/{Id}/seo")"><span>◈</span><div><strong>SEO Workspace</strong><small>Audits, recommendations, and execution</small></div></a>
        </div>
    </AppCard>
</div>

@code {
    [Parameter] public Guid Id { get; set; }
}
