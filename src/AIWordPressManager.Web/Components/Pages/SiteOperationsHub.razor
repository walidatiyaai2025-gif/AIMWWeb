@page "/operations"
@page "/operations/hub"
@rendermode InteractiveServer
@inject SiteWebService SiteService
@inject SiteOperationHistoryService History
@inject CurrentUserContext CurrentUser
@inject AppLanguageService L
@inject ILogger<SiteOperationsHub> Logger

<PageTitle>@(L.IsArabic ? "مركز عمليات المواقع" : "Site Operations Hub")</PageTitle>

@if (_loading)
{
    <div class="panel" style="padding:24px">@(L.IsArabic ? "جارٍ تحميل مركز العمليات..." : "Loading operations hub...")</div>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <section class="panel" style="padding:28px">
        <h1>@(L.IsArabic ? "تعذر تحميل سجل العمليات" : "Operation history could not be loaded")</h1>
        <p>@_loadError</p>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
            <button type="button" class="btn primary" @onclick="ReloadAsync">@(L.IsArabic ? "إعادة المحاولة" : "Retry")</button>
            <a class="btn" href="/sites">@(L.IsArabic ? "إدارة المواقع" : "Manage sites")</a>
        </div>
    </section>
}
else
{
    <div class="operations-hub-page">
        <section class="panel" style="padding:24px;margin-bottom:18px">
            <small style="font-weight:700;letter-spacing:.08em">@(L.IsArabic ? "التشغيل والمراقبة" : "OPERATIONS & MONITORING")</small>
            <h1 style="margin:8px 0">@(L.IsArabic ? "مركز عمليات مواقع WordPress" : "WordPress Site Operations Hub")</h1>
            <p style="margin:0;opacity:.75">@(L.IsArabic ? "نقطة وصول موحدة لسجل العمليات المحتفَظ به، ومؤشر نجاح الاتصال والمزامنة، ومسارات التشغيل الفعلية." : "A single entry point for retained operation history, recorded connection/sync success signals, and real operating workflows.")</p>
        </section>

        <section style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-bottom:18px">
            @Stat(L.IsArabic ? "إجمالي المواقع" : "Total sites", _sites.Count.ToString())
            @Stat(L.IsArabic ? "عمليات مسجلة خلال 30 يومًا" : "Recorded 30-day operations", _summary.Total.ToString())
            @Stat(L.IsArabic ? "نسبة نجاح العمليات المسجلة" : "Recorded success rate", SuccessRate)
            @Stat(L.IsArabic ? "عمليات فاشلة مسجلة" : "Recorded failed operations", _summary.Failed.ToString())
            @Stat(L.IsArabic ? "متوسط المدة المسجلة" : "Recorded average duration", FormatDuration(_summary.AverageDuration))
        </section>

        @if (_historyMayBeTruncated)
        {
            <section class="panel" style="padding:14px 18px;margin-bottom:18px">
                <strong>@(L.IsArabic ? "تنبيه نطاق السجل:" : "History scope notice:")</strong>
                <span>
                    @(L.IsArabic
                        ? $" وصل سجل العمليات إلى حد الاحتفاظ ({RetainedHistoryLimit:N0} من أحدث السجلات). قد لا تتضمن مؤشرات آخر 30 يومًا عمليات أقدم تم استبعادها من التخزين."
                        : $" Operation history has reached its {RetainedHistoryLimit:N0}-record retention limit. The 30-day metrics may omit older operations that have already been evicted from retained history.")
                </span>
            </section>
        }

        <section style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;margin-bottom:18px">
            @HubCard("≡", L.IsArabic ? "سجل عمليات المواقع" : "Site operation history", L.IsArabic ? "ابحث وفلتر وصدّر سجل العمليات المحتفَظ به." : "Search, filter, and export retained site-operation history.", "/site-operations", L.IsArabic ? "فتح السجل" : "Open history")
            @HubCard("◈", L.IsArabic ? "مؤشر نجاح الاتصال والمزامنة" : "Connection & sync success signal", L.IsArabic ? "افتح عرض مؤشرات الاتصال والمزامنة." : "Open the connection and synchronization metrics view.", "/site-reliability", L.IsArabic ? "عرض المؤشر" : "View signal")
            @HubCard("⌫", L.IsArabic ? "صيانة سجل العمليات" : "Operation history maintenance", L.IsArabic ? "افتح مساحة صيانة سجل العمليات؛ الإجراءات المتاحة تخضع لصلاحيات التشغيل." : "Open operation-history maintenance; available actions remain permission-gated.", "/operations/maintenance", L.IsArabic ? "فتح الصيانة" : "Open maintenance")
            @HubCard("↻", L.IsArabic ? "مزامنة المحتوى" : "Content synchronization", L.IsArabic ? "افتح مساحة المزامنة لمراجعة وتشغيل مسارات المزامنة المتاحة." : "Open synchronization to review and run available synchronization workflows.", "/module/sync", L.IsArabic ? "فتح المزامنة" : "Open synchronization")
            @HubCard("◉", L.IsArabic ? "إدارة المواقع" : "Site management", L.IsArabic ? "أضف المواقع وعدّل الاتصال وبيانات الاعتماد." : "Add sites and manage connection profiles and credentials.", "/sites", L.IsArabic ? "إدارة المواقع" : "Manage sites")
        </section>

        <section class="panel" style="padding:20px">
            <div style="display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:14px">
                <div><strong>@(L.IsArabic ? "آخر العمليات المسجلة" : "Recent recorded operations")</strong><div style="opacity:.7;font-size:.9rem">@(L.IsArabic ? "أحدث نشاط موجود في سجل العمليات المحتفَظ به لمواقع حسابك." : "Latest activity present in retained operation history for sites owned by your account.")</div></div>
                <a class="btn" href="/site-operations">@(L.IsArabic ? "عرض الكل" : "View all")</a>
            </div>
            @if (_recent.Count == 0)
            {
                <div style="padding:24px;text-align:center;opacity:.7">@(L.IsArabic ? "لا توجد عمليات مسجلة بعد." : "No operations have been recorded yet.")</div>
            }
            else
            {
                <div style="display:grid;gap:10px">
                    @foreach (var item in _recent)
                    {
                        <article style="display:grid;grid-template-columns:minmax(160px,.7fr) minmax(180px,.7fr) minmax(220px,1.5fr) auto;gap:12px;align-items:center;padding:12px;border:1px solid rgba(128,128,128,.2);border-radius:10px">
                            <div><strong>@SiteName(item.SiteId)</strong><small style="display:block;opacity:.65">@FormatDate(item.StartedAtUtc)</small></div>
                            <div>@item.Operation</div>
                            <div style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@item.Message</div>
                            <span class="badge @(item.Succeeded ? "success" : "danger")">@(item.Succeeded ? (L.IsArabic ? "ناجحة" : "Success") : (L.IsArabic ? "فشلت" : "Failed"))</span>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    private const int RetainedHistoryLimit = 2000;
    private bool _loading = true;
    private bool _historyMayBeTruncated;
    private string? _loadError;
    private IReadOnlyList<AIWordPressManager.Domain.Entities.Site> _sites = [];
    private IReadOnlyList<SiteOperationHistoryItem> _recent = [];
    private SiteOperationHistorySummary _summary = new(0, 0, 0, TimeSpan.Zero, 0, null);

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var ownerUserId = CurrentUser.RequireUserId();
            _sites = await SiteService.GetSitesAsync();
            var ownedSiteIds = _sites.Select(x => x.Id).ToArray();
            var retained = History.GetAll(ownerUserId, ownedSiteIds, RetainedHistoryLimit);
            _historyMayBeTruncated = retained.Count >= RetainedHistoryLimit;
            _recent = retained.Take(8).ToList();
            _summary = BuildSummary(retained.Where(x => x.StartedAtUtc >= DateTime.UtcNow.AddDays(-30)));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the Site Operations hub.");
            _sites = [];
            _recent = [];
            _summary = new SiteOperationHistorySummary(0, 0, 0, TimeSpan.Zero, 0, null);
            _historyMayBeTruncated = false;
            _loadError = L.IsArabic
                ? "تعذر قراءة مصدر سجل العمليات. لم يتم عرض مقاييس أو نشاط قديم على أنه بيانات حالية. أعد المحاولة بعد التحقق من خدمة التخزين."
                : "The retained operation-history source could not be read. No metrics or stale activity are being shown as current data. Retry after the storage service is available.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static SiteOperationHistorySummary BuildSummary(IEnumerable<SiteOperationHistoryItem> source)
    {
        var items = source.ToList();
        var successful = items.Count(x => x.Succeeded);
        var failed = items.Count - successful;
        var averageMilliseconds = items.Count == 0 ? 0 : items.Average(x => Math.Max(0, x.Duration.TotalMilliseconds));
        return new SiteOperationHistorySummary(
            items.Count,
            successful,
            failed,
            TimeSpan.FromMilliseconds(averageMilliseconds),
            items.Select(x => x.SiteId).Distinct().Count(),
            items.OrderByDescending(x => x.StartedAtUtc).FirstOrDefault()?.StartedAtUtc);
    }

    private string SuccessRate => _summary.Total == 0 ? "—" : $"{(_summary.Successful * 100.0 / _summary.Total):0.#}%";
    private string SiteName(Guid siteId) => _sites.FirstOrDefault(x => x.Id == siteId)?.Name ?? siteId.ToString("N")[..8];
    private string FormatDate(DateTime value) => value.ToLocalTime().ToString(L.IsArabic ? "yyyy-MM-dd HH:mm" : "MMM d, yyyy HH:mm");
    private static string FormatDuration(TimeSpan value) => value.TotalSeconds < 1 ? $"{Math.Max(0, value.TotalMilliseconds):0} ms" : $"{value.TotalSeconds:0.0} s";

    private RenderFragment Stat(string label, string value) => builder =>
    {
        builder.OpenElement(0, "article");
        builder.AddAttribute(1, "class", "panel");
        builder.AddAttribute(2, "style", "padding:18px");
        builder.OpenElement(3, "small"); builder.AddContent(4, label); builder.CloseElement();
        builder.OpenElement(5, "strong"); builder.AddAttribute(6, "style", "display:block;font-size:1.65rem;margin-top:8px"); builder.AddContent(7, value); builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment HubCard(string icon, string title, string description, string href, string action) => builder =>
    {
        builder.OpenElement(0, "article"); builder.AddAttribute(1, "class", "panel"); builder.AddAttribute(2, "style", "padding:20px;display:flex;flex-direction:column;gap:12px");
        builder.OpenElement(3, "span"); builder.AddAttribute(4, "style", "font-size:1.8rem"); builder.AddContent(5, icon); builder.CloseElement();
        builder.OpenElement(6, "strong"); builder.AddAttribute(7, "style", "font-size:1.05rem"); builder.AddContent(8, title); builder.CloseElement();
        builder.OpenElement(9, "p"); builder.AddAttribute(10, "style", "margin:0;opacity:.72;line-height:1.55;flex:1"); builder.AddContent(11, description); builder.CloseElement();
        builder.OpenElement(12, "a"); builder.AddAttribute(13, "class", "btn primary"); builder.AddAttribute(14, "href", href); builder.AddContent(15, action); builder.CloseElement();
        builder.CloseElement();
    };
}
