@page "/reports"
@page "/module/reports"
@rendermode InteractiveServer
@using System.Text
@using AIWordPressManager.Domain.Entities
@inject SiteWebService SiteService
@inject ApprovalWorkflowService ApprovalService
@inject AutomationCenterService AutomationService
@inject ContentPlannerService PlannerService
@inject AppLanguageService L
@inject AppNotificationService Notifications
@inject IJSRuntime JS

<PageTitle>@(L.IsArabic ? "التقارير والتصدير" : "Reports & Exports")</PageTitle>

<div class="reports-page">
    <section class="panel reports-hero">
        <div>
            <span class="workspace-kicker">BUSINESS INTELLIGENCE</span>
            <h1>@(L.IsArabic ? "التقارير والتصدير" : "Reports & Exports")</h1>
            <p>@(L.IsArabic ? "تقارير مباشرة من بيانات النظام الفعلية." : "Live reports from real application data.")</p>
        </div>
        <button class="btn" disabled="@(!_interactive || _loading)" @onclick="LoadAsync">
            @(_loading ? (L.IsArabic ? "جارٍ التحميل..." : "Loading...") : (L.IsArabic ? "تحديث" : "Refresh"))
        </button>
    </section>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert error"><strong>@(L.IsArabic ? "فشل تحميل التقرير" : "Report loading failed")</strong><p>@_error</p></div>
    }

    <section class="reports-stats">
        <article class="panel"><small>@(L.IsArabic ? "المواقع" : "Sites")</small><strong>@_sites.Count</strong></article>
        <article class="panel"><small>@(L.IsArabic ? "الموافقات" : "Approvals")</small><strong>@_approvals.Count</strong></article>
        <article class="panel"><small>@(L.IsArabic ? "مهام الأتمتة" : "Automations")</small><strong>@_jobs.Count</strong></article>
        <article class="panel"><small>@(L.IsArabic ? "عناصر التخطيط" : "Planner items")</small><strong>@_planner.Count</strong></article>
    </section>

    <section class="reports-grid">
        <article class="panel report-card">
            <header>
                <h2>@(L.IsArabic ? "تقرير المواقع" : "Sites report")</h2>
                <button class="btn compact" disabled="@(!_interactive || _loading)" @onclick="ExportSitesAsync">CSV</button>
            </header>
            <div class="report-table-wrap">
                <table>
                    <thead><tr><th>@(L.IsArabic ? "الموقع" : "Site")</th><th>URL</th><th>@(L.IsArabic ? "الحالة" : "Status")</th></tr></thead>
                    <tbody>
                        @foreach (var site in _sites.Take(12))
                        {
                            <tr><td>@site.Name</td><td>@site.SiteUrl</td><td>@site.ConnectionStatus</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </article>

        <article class="panel report-card">
            <header>
                <h2>@(L.IsArabic ? "تقرير الموافقات" : "Approvals report")</h2>
                <button class="btn compact" disabled="@(!_interactive || _loading)" @onclick="ExportApprovalsAsync">CSV</button>
            </header>
            <div class="report-table-wrap">
                <table>
                    <thead><tr><th>@(L.IsArabic ? "العنوان" : "Title")</th><th>@(L.IsArabic ? "الموقع" : "Site")</th><th>@(L.IsArabic ? "الحالة" : "Status")</th></tr></thead>
                    <tbody>
                        @foreach (var item in _approvals.Take(12))
                        {
                            <tr><td>@item.Title</td><td>@item.SiteName</td><td>@item.Status</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </article>

        <article class="panel report-card">
            <header>
                <h2>@(L.IsArabic ? "تقرير الأتمتة" : "Automation report")</h2>
                <button class="btn compact" disabled="@(!_interactive || _loading)" @onclick="ExportAutomationAsync">CSV</button>
            </header>
            <div class="report-table-wrap">
                <table>
                    <thead><tr><th>@(L.IsArabic ? "المهمة" : "Job")</th><th>@(L.IsArabic ? "الموقع" : "Site")</th><th>@(L.IsArabic ? "الحالة" : "Status")</th></tr></thead>
                    <tbody>
                        @foreach (var job in _jobs.Take(12))
                        {
                            <tr><td>@job.Name</td><td>@job.SiteName</td><td>@job.LastStatus</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </article>

        <article class="panel report-card">
            <header>
                <h2>@(L.IsArabic ? "تقرير خطة المحتوى" : "Content planner report")</h2>
                <button class="btn compact" disabled="@(!_interactive || _loading)" @onclick="ExportPlannerAsync">CSV</button>
            </header>
            <div class="report-table-wrap">
                <table>
                    <thead><tr><th>@(L.IsArabic ? "العنوان" : "Title")</th><th>@(L.IsArabic ? "الموقع" : "Site")</th><th>@(L.IsArabic ? "الحالة" : "Status")</th></tr></thead>
                    <tbody>
                        @foreach (var item in _planner.Take(12))
                        {
                            <tr><td>@item.Title</td><td>@item.SiteName</td><td>@item.Status</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </article>
    </section>
</div>

@code {
    private List<Site> _sites = new List<Site>();
    private List<ApprovalItem> _approvals = new List<ApprovalItem>();
    private List<AutomationJob> _jobs = new List<AutomationJob>();
    private List<PlannerItem> _planner = new List<PlannerItem>();
    private bool _loading;
    private bool _interactive;
    private string _error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_interactive)
        {
            _interactive = true;
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    private async Task LoadAsync()
    {
        if (_loading) return;
        _loading = true;
        _error = string.Empty;
        try
        {
            var sitesTask = SiteService.GetSitesAsync();
            _approvals = ApprovalService.GetItems(null, 1000).ToList();
            _jobs = AutomationService.GetJobs().ToList();
            _planner = PlannerService.GetItems().ToList();
            _sites = await sitesTask;
        }
        catch (Exception ex)
        {
            _error = L.TranslateMessage(ex.Message);
            Notifications.Error(_error, L.IsArabic ? "فشل التقرير" : "Report failed", ex.ToString());
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ExportSitesAsync()
    {
        return DownloadAsync("sites-report.csv", Csv(
            new[] { "Name", "Url", "Status" },
            _sites.Select(x => new[] { x.Name, x.SiteUrl.ToString(), x.ConnectionStatus.ToString() })));
    }

    private Task ExportApprovalsAsync()
    {
        return DownloadAsync("approvals-report.csv", Csv(
            new[] { "Id", "Title", "Site", "Status" },
            _approvals.Select(x => new[] { x.Id.ToString(), x.Title, x.SiteName, x.Status.ToString() })));
    }

    private Task ExportAutomationAsync()
    {
        return DownloadAsync("automation-report.csv", Csv(
            new[] { "Id", "Name", "Site", "Type", "Status" },
            _jobs.Select(x => new[] { x.Id.ToString(), x.Name, x.SiteName, x.Type, x.LastStatus })));
    }

    private Task ExportPlannerAsync()
    {
        return DownloadAsync("content-planner-report.csv", Csv(
            new[] { "Id", "Title", "Site", "Status" },
            _planner.Select(x => new[] { x.Id.ToString(), x.Title, x.SiteName, x.Status.ToString() })));
    }

    private async Task DownloadAsync(string fileName, string csv)
    {
        await JS.InvokeVoidAsync("aiwmReports.downloadCsv", fileName, csv);
        Notifications.Success(L.IsArabic ? "تم تجهيز ملف CSV." : "CSV export created.");
    }

    private static string Csv(IEnumerable<string> headers, IEnumerable<IEnumerable<string>> rows)
    {
        var builder = new StringBuilder();
        builder.AppendLine(string.Join(",", headers.Select(Escape)));
        foreach (var row in rows)
        {
            builder.AppendLine(string.Join(",", row.Select(Escape)));
        }
        return "\uFEFF" + builder.ToString();
    }

    private static string Escape(string value)
    {
        var text = value ?? string.Empty;
        return "\"" + text.Replace("\"", "\"\"") + "\"";
    }
}