@page "/account/email-settings"
@rendermode InteractiveServer
@inject AIWordPressManager.Persistence.AppDbContext Db
@inject CurrentUserContext CurrentUser
@inject AIWordPressManager.Application.Abstractions.ISecretProtectionService SecretProtection
@inject AppLanguageService L
@inject AppNotificationService Notifications

<PageTitle>@(L.IsArabic ? "إعدادات بريد الحساب" : "Account Email Settings")</PageTitle>

<AppPage PageKey="account-email-settings" Class="settings-page" Width="standard">
    <AppToolbar Eyebrow="ACCOUNT EMAIL"
                Title="@(L.IsArabic ? "بريد الداشبورد والحساب" : "Dashboard & account email")"
                Subtitle="@(L.IsArabic ? "اضبط بريد الإرسال العام للحساب وحتى ثلاثة مستلمين لملخصات وتنبيهات الداشبورد. كلمات المرور تحفظ مشفرة ولا يتم عرضها بعد الحفظ." : "Configure the account-wide outbound mail profile and up to three dashboard recipients. Passwords are stored encrypted and are never displayed after saving.")">
        <Actions>
            <AppButton Href="/email/schedules" Icon="◷" Text="@(L.IsArabic ? "جدولة ملخص الداشبورد" : "Dashboard email schedules")" />
            <AppButton Href="/email/history" Icon="≡" Text="@(L.IsArabic ? "سجل الإرسال" : "Delivery history")" />
        </Actions>
    </AppToolbar>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <AppStateBanner Kind="error"
                        Title="@(L.IsArabic ? "تعذر تنفيذ آخر عملية" : "The last action could not be completed")"
                        Description="@_error" />
    }

    <AppSection Eyebrow="SMTP"
                Title="@(L.IsArabic ? "إعداد الإرسال العام" : "Account outbound mail profile")"
                Subtitle="@(L.IsArabic ? "المواقع التي تختار Use dashboard/account mail profile ستستخدم هذا الإعداد." : "Sites configured to use the dashboard/account mail profile inherit this configuration.")"
                HeadingLevel="3">
        <ChildContent>
            <div class="grid-2">
                <div><label>SMTP Host</label><input class="form-control" @bind="_profile.Host" maxlength="255" disabled="@_busy" /></div>
                <div><label>SMTP Port</label><input class="form-control" type="number" min="1" max="65535" @bind="_profile.Port" disabled="@_busy" /></div>
                <div><label>@(L.IsArabic ? "اسم المستخدم" : "Username")</label><input class="form-control" @bind="_profile.UserName" maxlength="320" disabled="@_busy" /></div>
                <div>
                    <label>@(L.IsArabic ? "كلمة المرور" : "Password")</label>
                    <input class="form-control" type="password" @bind="_profile.Password" maxlength="2048" disabled="@_busy" autocomplete="new-password" />
                    <small>@(_savedProfile.HasSavedPassword ? (L.IsArabic ? "يوجد سر محفوظ ومشفر. اترك الحقل فارغًا للاحتفاظ به." : "An encrypted password is saved. Leave this blank to keep it.") : (L.IsArabic ? "لا يوجد سر محفوظ." : "No password is currently stored."))</small>
                </div>
                <div><label>@(L.IsArabic ? "بريد المرسل" : "From address")</label><input class="form-control" type="email" @bind="_profile.FromAddress" maxlength="320" disabled="@_busy" /></div>
                <div><label>@(L.IsArabic ? "اسم المرسل" : "From name")</label><input class="form-control" @bind="_profile.FromName" maxlength="160" disabled="@_busy" /></div>
                <div><label>@(L.IsArabic ? "الرد إلى" : "Reply-to address")</label><input class="form-control" type="email" @bind="_profile.ReplyToAddress" maxlength="320" disabled="@_busy" /></div>
            </div>
            <label class="d-flex gap-2 align-items-center mt-2"><input type="checkbox" @bind="_profile.EnableSsl" disabled="@_busy" /> TLS / SSL</label>
            <label class="d-flex gap-2 align-items-center mt-2"><input type="checkbox" @bind="_profile.IsEnabled" disabled="@_busy" /> @(L.IsArabic ? "تفعيل الإرسال العام للحساب" : "Enable account outbound email")</label>
            <div class="app-action-cluster mt-3">
                <AppButton Variant="primary" Icon="✓" Text="@(L.IsArabic ? "حفظ إعداد البريد" : "Save mail profile")" Busy="@_busy" Disabled="@_busy" OnClick="SaveProfileClickedAsync" />
                @if (_savedProfile.HasSavedPassword)
                {
                    <AppButton Variant="danger" Icon="×" Text="@(L.IsArabic ? "مسح كلمة المرور المحفوظة" : "Clear saved password")" Disabled="@_busy" OnClick="ClearPasswordClickedAsync" />
                }
            </div>
            <SmtpDiagnosticsPanel GetProfileAsync="GetAccountTestProfileAsync" SuggestedRecipient="@SuggestedTestRecipient" />
        </ChildContent>
    </AppSection>

    <AppSection Eyebrow="RECIPIENTS"
                Title="@(L.IsArabic ? "مستلمو الداشبورد" : "Dashboard recipients")"
                Subtitle="@(L.IsArabic ? "يمكن إضافة حتى ثلاثة عناوين للحساب." : "Add up to three account-level recipients.")"
                HeadingLevel="3">
        <Header>
            <AppBadge Tone="@(_recipients.Count >= 3 ? "warning" : "info")" Text="@($"{_recipients.Count} / 3")" BidiMode="number" />
        </Header>
        <ChildContent>
            <div class="grid-2">
                <div><label>@(L.IsArabic ? "البريد الإلكتروني" : "Email address")</label><input class="form-control" type="email" @bind="_newEmail" maxlength="320" disabled="@(_busy || _recipients.Count >= 3)" /></div>
                <div><label>@(L.IsArabic ? "الاسم / الوصف" : "Display name / label")</label><input class="form-control" @bind="_newDisplayName" maxlength="120" disabled="@(_busy || _recipients.Count >= 3)" /></div>
            </div>
            <AppButton Class="mt-2" Variant="primary" Icon="＋" Text="@(L.IsArabic ? "إضافة البريد" : "Add email")" Disabled="@(_busy || _recipients.Count >= 3 || string.IsNullOrWhiteSpace(_newEmail))" OnClick="AddRecipientClickedAsync" />
        </ChildContent>
    </AppSection>

    <AppSection Eyebrow="DIRECTORY"
                Title="@(L.IsArabic ? "العناوين المحفوظة" : "Saved recipients")"
                Subtitle="@(L.IsArabic ? "راجع المستلمين وعدّل حالة التفعيل أو العنوان." : "Review recipients and edit address or enabled state.")"
                HeadingLevel="3">
        <ChildContent>
            @if (_loading)
            {
                <AppLoading Title="@(L.IsArabic ? "جاري تحميل المستلمين" : "Loading recipients")" />
            }
            else if (_recipients.Count == 0)
            {
                <AppEmptyState Title="@(L.IsArabic ? "لا توجد عناوين داشبورد" : "No dashboard recipients")"
                               Description="@(L.IsArabic ? "أضف أول مستلم باستخدام النموذج أعلاه." : "Add the first recipient using the form above.")"
                               Blocking="false" />
            }
            else
            {
                <div class="database-info-grid">
                    @foreach (var item in _recipients)
                    {
                        <AppCard Density="compact" Tone="@(item.IsEnabled ? "neutral" : "warning")">
                            <ChildContent>
                                @if (_editingId == item.Id)
                                {
                                    <div class="grid-2"><input class="form-control" type="email" @bind="_editEmail" maxlength="320" /><input class="form-control" @bind="_editDisplayName" maxlength="120" /></div>
                                    <label class="d-flex gap-2 align-items-center mt-2"><input type="checkbox" @bind="_editEnabled" /> @(L.IsArabic ? "مفعل" : "Enabled")</label>
                                    <div class="app-action-cluster mt-2"><AppButton Variant="primary" Text="@(L.IsArabic ? "حفظ" : "Save")" Disabled="@_busy" OnClick="SaveEditClickedAsync" /><AppButton Text="@(L.IsArabic ? "إلغاء" : "Cancel")" Disabled="@_busy" OnClick="CancelEditClicked" /></div>
                                }
                                else
                                {
                                    <strong>@item.EmailAddress</strong><p>@(string.IsNullOrWhiteSpace(item.DisplayName) ? "—" : item.DisplayName)</p>
                                    <AppBadge Tone="@(item.IsEnabled ? "success" : "warning")" Text="@(item.IsEnabled ? (L.IsArabic ? "مفعل" : "Enabled") : (L.IsArabic ? "متوقف" : "Disabled"))" />
                                    <div class="app-action-cluster mt-2"><AppButton Text="@(L.IsArabic ? "تعديل" : "Edit")" Disabled="@_busy" OnClick="_ => BeginEdit(item)" /><AppButton Variant="danger" Text="@(L.IsArabic ? "حذف" : "Delete")" Disabled="@_busy" OnClick="_ => DeleteRecipientAsync(item.Id)" /></div>
                                }
                            </ChildContent>
                        </AppCard>
                    }
                </div>
            }
        </ChildContent>
    </AppSection>
</AppPage>

@code {
    private AccountEmailSettingsService Service => new(Db, CurrentUser, SecretProtection);
    private IReadOnlyList<AccountEmailRecipientView> _recipients = [];
    private AccountMailProfileView _savedProfile = AccountMailProfileView.Default();
    private ProfileForm _profile = new();
    private bool _loading = true, _busy;
    private string? _error;
    private string _newEmail = string.Empty, _newDisplayName = string.Empty;
    private Guid? _editingId;
    private string _editEmail = string.Empty, _editDisplayName = string.Empty;
    private bool _editEnabled = true;
    private string SuggestedTestRecipient => _recipients.FirstOrDefault(x => x.IsEnabled)?.EmailAddress ?? _savedProfile.FromAddress;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        try
        {
            var state = await Service.GetAsync();
            _recipients = state.Recipients;
            _savedProfile = state.Profile;
            _profile = ProfileForm.From(_savedProfile);
        }
        catch (Exception ex) { _error = L.TranslateMessage(ex.Message); }
        finally { _loading = false; }
    }

    private Task<SiteMailDeliveryProfile> GetAccountTestProfileAsync() => Service.GetTestProfileAsync();
    private Task SaveProfileClickedAsync(MouseEventArgs _) => SaveProfileAsync();
    private Task ClearPasswordClickedAsync(MouseEventArgs _) => ClearPasswordAsync();
    private Task AddRecipientClickedAsync(MouseEventArgs _) => AddRecipientAsync();
    private Task SaveEditClickedAsync(MouseEventArgs _) => SaveEditAsync();
    private void CancelEditClicked(MouseEventArgs _) => CancelEdit();

    private async Task SaveProfileAsync()
    {
        if (_busy) return;
        _busy = true; _error = null;
        try
        {
            _savedProfile = await Service.SaveProfileAsync(new AccountMailProfileInput(_profile.Host, _profile.Port, _profile.UserName, _profile.Password, _profile.FromAddress, _profile.FromName, _profile.ReplyToAddress, _profile.EnableSsl, _profile.IsEnabled));
            _profile = ProfileForm.From(_savedProfile);
            Notifications.Success(L.IsArabic ? "تم حفظ إعداد بريد الحساب بصورة آمنة." : "Account mail profile saved securely.");
        }
        catch (Exception ex) { _error = L.TranslateMessage(ex.Message); Notifications.Error(_error); }
        finally { _busy = false; }
    }

    private async Task ClearPasswordAsync()
    {
        if (_busy) return;
        _busy = true; _error = null;
        try { await Service.ClearPasswordAsync(); await LoadAsync(); Notifications.Success(L.IsArabic ? "تم مسح كلمة المرور المشفرة." : "Saved SMTP password cleared."); }
        catch (Exception ex) { _error = L.TranslateMessage(ex.Message); Notifications.Error(_error); }
        finally { _busy = false; }
    }

    private async Task AddRecipientAsync()
    {
        if (_busy) return;
        _busy = true; _error = null;
        try { await Service.AddRecipientAsync(_newEmail, _newDisplayName); _newEmail = string.Empty; _newDisplayName = string.Empty; await LoadAsync(); Notifications.Success(L.IsArabic ? "تمت إضافة بريد الداشبورد." : "Dashboard recipient added."); }
        catch (Exception ex) { _error = L.TranslateMessage(ex.Message); Notifications.Error(_error); }
        finally { _busy = false; }
    }

    private void BeginEdit(AccountEmailRecipientView item) { _editingId = item.Id; _editEmail = item.EmailAddress; _editDisplayName = item.DisplayName ?? string.Empty; _editEnabled = item.IsEnabled; }
    private void CancelEdit() => _editingId = null;

    private async Task SaveEditAsync()
    {
        if (!_editingId.HasValue || _busy) return;
        _busy = true; _error = null;
        try { await Service.UpdateRecipientAsync(_editingId.Value, _editEmail, _editDisplayName, _editEnabled); _editingId = null; await LoadAsync(); Notifications.Success(L.IsArabic ? "تم تحديث بريد الداشبورد." : "Dashboard recipient updated."); }
        catch (Exception ex) { _error = L.TranslateMessage(ex.Message); Notifications.Error(_error); }
        finally { _busy = false; }
    }

    private async Task DeleteRecipientAsync(Guid id)
    {
        if (_busy) return;
        _busy = true; _error = null;
        try { await Service.DeleteRecipientAsync(id); if (_editingId == id) _editingId = null; await LoadAsync(); Notifications.Success(L.IsArabic ? "تم حذف بريد الداشبورد." : "Dashboard recipient deleted."); }
        catch (Exception ex) { _error = L.TranslateMessage(ex.Message); Notifications.Error(_error); }
        finally { _busy = false; }
    }

    private sealed class ProfileForm
    {
        public string Host { get; set; } = string.Empty;
        public int Port { get; set; } = 587;
        public string UserName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string FromAddress { get; set; } = string.Empty;
        public string FromName { get; set; } = string.Empty;
        public string ReplyToAddress { get; set; } = string.Empty;
        public bool EnableSsl { get; set; } = true;
        public bool IsEnabled { get; set; }
        public static ProfileForm From(AccountMailProfileView value) => new() { Host = value.Host, Port = value.Port, UserName = value.UserName, FromAddress = value.FromAddress, FromName = value.FromName, ReplyToAddress = value.ReplyToAddress, EnableSsl = value.EnableSsl, IsEnabled = value.IsEnabled };
    }
}