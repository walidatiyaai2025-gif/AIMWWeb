@page "/configuration-validation"
@page "/module/configuration"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = ApplicationPermissionCatalog.SettingsManage)]
@inject AppLanguageService L
@inject IConfiguration Configuration
@inject IWebHostEnvironment Environment
@inject AIWordPressManager.Application.Abstractions.IApplicationPathService Paths
@inject CurrentUserContext CurrentUser
@inject IJSRuntime JS

<PageTitle>@(L.IsArabic ? "التحقق من الإعدادات" : "Configuration Validation")</PageTitle>

<div class="settings-page">
    <section class="panel settings-hero">
        <div>
            <span class="workspace-kicker">CONFIGURATION</span>
            <h1>@(L.IsArabic ? "مركز التحقق من الإعدادات" : "Configuration Validation Center")</h1>
            <p>@(L.IsArabic ? "فحص مجموعة محددة من إعدادات التشغيل والتخزين والأمان، دون اعتبارها دليلاً على جاهزية النظام بالكامل." : "Check a bounded set of runtime, storage, and security settings without treating them as proof of whole-system readiness.")</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn" @onclick="CopyReportAsync" disabled="@(_report is null || _copying)">
                @(_copying
                    ? (L.IsArabic ? "جارٍ النسخ..." : "Copying...")
                    : !string.IsNullOrWhiteSpace(_copyError)
                        ? (L.IsArabic ? "إعادة محاولة النسخ" : "Retry copy")
                        : (L.IsArabic ? "نسخ التقرير" : "Copy report"))
            </button>
            <button class="btn primary" @onclick="RunValidation">
                ↻ @(!string.IsNullOrWhiteSpace(_error)
                    ? (L.IsArabic ? "إعادة محاولة الفحص" : "Retry validation")
                    : (L.IsArabic ? "إعادة الفحص" : "Run validation"))
            </button>
        </div>
    </section>

    @if (_copySucceeded)
    {
        <AppStateBanner Kind="success"
                        Title="@(L.IsArabic ? "تم نسخ تقرير التحقق" : "Validation report copied")"
                        Description="@(L.IsArabic ? "أكد المتصفح نجاح الكتابة إلى الحافظة." : "The browser confirmed that the sanitized report was written to the clipboard.")" />
    }
    else if (!string.IsNullOrWhiteSpace(_copyError))
    {
        <AppStateBanner Kind="error"
                        Title="@(L.IsArabic ? "تعذر نسخ تقرير التحقق" : "Validation report could not be copied")"
                        Description="@_copyError"
                        Busy="@_copying"
                        RetryText="@(L.IsArabic ? "إعادة محاولة النسخ" : "Retry copy")"
                        RetryingText="@(L.IsArabic ? "جارٍ إعادة المحاولة..." : "Retrying copy...")"
                        RetryAriaLabel="@(L.IsArabic ? "إعادة محاولة نسخ تقرير التحقق إلى الحافظة" : "Retry copying the validation report to the clipboard")"
                        RetryRequested="CopyReportAsync" />
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <AppCard>
            <AppEmptyState Icon="!"
                           Title="@(L.IsArabic ? "تعذر فحص الإعدادات" : "Configuration validation failed")"
                           Description="@_error" />
        </AppCard>
    }
    else if (_report is null)
    {
        <section class="panel empty-state"><p>@(L.IsArabic ? "جاري تجهيز الفحص..." : "Preparing validation...")</p></section>
    }
    else
    {
        <section class="settings-summary-grid">
            <article class="panel settings-summary-card"><span>✓</span><div><small>@(L.IsArabic ? "صحيح" : "Valid")</small><strong>@ValidCount</strong></div></article>
            <article class="panel settings-summary-card"><span>!</span><div><small>@(L.IsArabic ? "تحذيرات" : "Warnings")</small><strong>@_report.WarningCount</strong></div></article>
            <article class="panel settings-summary-card"><span>×</span><div><small>@(L.IsArabic ? "أخطاء حرجة" : "Critical errors")</small><strong>@_report.CriticalCount</strong></div></article>
            <article class="panel settings-summary-card"><span>◷</span><div><small>@(L.IsArabic ? "آخر فحص" : "Last checked")</small><strong>@_report.CheckedAtUtc.ToLocalTime().ToString("HH:mm:ss")</strong></div></article>
        </section>

        <section class="panel settings-section">
            <header>
                <div>
                    <span class="workspace-kicker">VALIDATION RESULT</span>
                    <h2>@ReadinessTitle</h2>
                    <p>@(L.IsArabic ? "هذه النتيجة تخص الفحوصات المدرجة أدناه فقط. راجع التحذيرات والأخطاء قبل الاعتماد أو النشر." : "This result applies only to the checks listed below. Review warnings and errors before approval or deployment.")</p>
                </div>
                <span class="settings-badge @ReadinessClass">@ReadinessBadge</span>
            </header>

            <div class="database-info-grid">
                @foreach (var item in _report.Items)
                {
                    <article class="panel" style="padding:1rem">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <small>@(L.IsArabic ? item.TitleAr : item.Title)</small>
                                <strong style="display:block;margin:.35rem 0;word-break:break-word">@DisplayValue(item)</strong>
                            </div>
                            <span class="settings-badge @StatusClass(item.Status)">@StatusText(item.Status)</span>
                        </div>
                        <p style="margin:.75rem 0 0">@DisplayMessage(item)</p>
                    </article>
                }
            </div>
        </section>
    }
</div>

@code {
    private static readonly HashSet<string> ManagedPathKeys = new(StringComparer.Ordinal)
    {
        "local-data", "logs", "backups"
    };

    private ConfigurationValidationReport? _report;
    private string? _error;
    private bool _copying;
    private bool _copySucceeded;
    private string? _copyError;
    private int ValidCount => _report?.Items.Count(x => x.Status == ValidationStatus.Valid) ?? 0;

    private string ReadinessTitle => _report is null
        ? string.Empty
        : _report.CriticalCount > 0
            ? (L.IsArabic ? "توجد أخطاء مانعة في فحوصات الإعدادات" : "Blocking errors found in the configuration checks")
            : _report.WarningCount > 0
                ? (L.IsArabic ? "لا توجد أخطاء مانعة؛ توجد تحذيرات للمراجعة" : "No blocking errors; warnings require review")
                : (L.IsArabic ? "لم تُكتشف أخطاء مانعة في فحوصات الإعدادات" : "No blocking errors detected in these configuration checks");

    private string ReadinessBadge => _report is null
        ? string.Empty
        : _report.CriticalCount > 0
            ? (L.IsArabic ? "إجراء مطلوب" : "ACTION REQUIRED")
            : _report.WarningCount > 0
                ? (L.IsArabic ? "توجد تحذيرات" : "WARNINGS PRESENT")
                : (L.IsArabic ? "لا توجد أخطاء مانعة" : "NO BLOCKERS");

    private string ReadinessClass => _report is null
        ? string.Empty
        : _report.CriticalCount > 0
            ? "danger"
            : _report.WarningCount > 0
                ? "warning"
                : "success";

    protected override void OnInitialized() => RunValidation();

    private void RunValidation()
    {
        _copySucceeded = false;
        _copyError = null;

        try
        {
            _error = null;
            _report = new ConfigurationValidationService(Configuration, Environment, Paths, CurrentUser).Validate();
        }
        catch (UnauthorizedAccessException)
        {
            _report = null;
            _error = L.IsArabic
                ? "ليست لديك صلاحية إدارة الإعدادات المطلوبة لتشغيل هذا الفحص."
                : "You do not have the Settings.Manage permission required to run this validation.";
        }
        catch (Exception)
        {
            _report = null;
            _error = L.IsArabic
                ? "تعذر إكمال فحص الإعدادات. لم يتم عرض تفاصيل الخادم الداخلية؛ يمكنك إعادة المحاولة."
                : "Configuration validation could not complete. Internal server details were withheld; you can retry.";
        }
    }

    private string DisplayValue(ConfigurationValidationItem item) => item.Key switch
    {
        "local-data" => L.IsArabic ? "تخزين بيانات التطبيق المُدار" : "Managed application-data storage",
        "logs" => L.IsArabic ? "تخزين السجلات المُدار" : "Managed log storage",
        "backups" => L.IsArabic ? "تخزين النسخ الاحتياطية المُدار" : "Managed backup storage",
        _ => item.Value
    };

    private string DisplayMessage(ConfigurationValidationItem item)
    {
        if (ManagedPathKeys.Contains(item.Key))
        {
            return item.Status == ValidationStatus.Error
                ? (L.IsArabic
                    ? "تعذر التحقق من قابلية الكتابة لهذا التخزين المُدار. تم حجب مسار الخادم وتفاصيل الاستثناء."
                    : "This managed storage target could not be verified as writable. Server paths and exception details were withheld.")
                : (L.IsArabic
                    ? "تم التحقق من توفر هذا التخزين المُدار وقابليته للكتابة."
                    : "This managed storage target was verified as available and writable.");
        }

        return L.IsArabic ? item.MessageAr : item.Message;
    }

    private string StatusClass(ValidationStatus status) => status switch
    {
        ValidationStatus.Valid => "success",
        ValidationStatus.Warning => "warning",
        ValidationStatus.Error => "danger",
        _ => string.Empty
    };

    private string StatusText(ValidationStatus status) => status switch
    {
        ValidationStatus.Valid => L.IsArabic ? "صحيح" : "Valid",
        ValidationStatus.Warning => L.IsArabic ? "تحذير" : "Warning",
        ValidationStatus.Error => L.IsArabic ? "خطأ" : "Error",
        _ => status.ToString()
    };

    private string BuildSanitizedCopyReport()
    {
        if (_report is null)
            return string.Empty;

        var lines = new List<string>
        {
            "AI WordPress Manager - Configuration Validation",
            $"Checked: {_report.CheckedAtUtc:O}",
            $"Critical: {_report.CriticalCount}",
            $"Warnings: {_report.WarningCount}",
            $"Result: {(_report.CriticalCount > 0 ? "Blocking errors found" : _report.WarningCount > 0 ? "No blockers; warnings require review" : "No blockers detected in these checks")}",
            string.Empty
        };
        lines.AddRange(_report.Items.Select(item =>
            $"[{item.Status}] {item.Title}: {DisplayValue(item)}{System.Environment.NewLine}{DisplayMessage(item)}"));
        return string.Join(System.Environment.NewLine, lines);
    }

    private async Task CopyReportAsync()
    {
        if (_report is null || _copying)
            return;

        _copying = true;
        _copySucceeded = false;
        _copyError = null;

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", BuildSanitizedCopyReport());
            _copySucceeded = true;
        }
        catch (Exception)
        {
            _copyError = L.IsArabic
                ? "لم يؤكد المتصفح نجاح الكتابة إلى الحافظة. لم يتم الإبلاغ عن نجاح النسخ؛ يمكنك إعادة المحاولة."
                : "The browser did not confirm a clipboard write. No copy success was reported; you can retry.";
        }
        finally
        {
            _copying = false;
        }
    }
}