@page "/settings/ai-prompts"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator")]
@using AIWordPressManager.Application.Abstractions.AI
@inject IAIPromptTemplateStore PromptStore
@inject CurrentUserContext CurrentUser
@inject AppLanguageService L
@inject IJSRuntime JS

<PageTitle>@(L.IsArabic ? "قوالب أوامر الذكاء الاصطناعي" : "AI Prompt Templates")</PageTitle>

<AppPage PageKey="ai-prompt-templates" Class="settings-page" Width="wide">
    <AppToolbar Eyebrow="PROMPT REGISTRY"
                Title="@(L.IsArabic ? "قوالب أوامر الذكاء الاصطناعي" : "AI Prompt Templates")"
                Subtitle="@(L.IsArabic ? "إدارة القوالب العربية والإنجليزية مع سجل إصدارات غير قابل لإعادة الكتابة واستعادة آمنة لأي إصدار سابق." : "Manage Arabic and English prompts with append-only revision history and safe restoration of any previous revision.")">
        <Meta>
            <AppBadge Tone="info" Text="@(L.IsArabic ? "للمسؤولين فقط" : "Administrators only")" />
            <AppBadge Tone="accent" Text="@($"{_templates.Count} {(L.IsArabic ? "قالب" : "templates")}")" BidiMode="number" />
        </Meta>
        <Actions>
            <AppButton Href="/settings" Icon="←" IconIntent="back" Text="@L["Settings"]" />
            <AppButton Variant="primary" Icon="＋" Text="@(L.IsArabic ? "قالب جديد" : "New template")" OnClick="NewTemplateClicked" />
        </Actions>
    </AppToolbar>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <AppStateBanner Kind="@(_isError ? "error" : "success")"
                        Title="@(_isError ? (L.IsArabic ? "تعذر تنفيذ العملية" : "Action failed") : (L.IsArabic ? "تم تنفيذ العملية" : "Action completed"))"
                        Description="@_message" />
    }

    <div class="settings-layout">
        <AppSection Class="settings-nav" Density="compact"
                    Eyebrow="LIBRARY"
                    Title="@(L.IsArabic ? "مكتبة القوالب" : "Template library")"
                    Subtitle="@(L.IsArabic ? "ابحث واختر قالبًا لتحريره." : "Search and select a template to edit.")"
                    HeadingLevel="3">
            <ChildContent>
                <AppSearchBox Value="@_search"
                              ValueChanged="SearchChanged"
                              Placeholder="@(L.IsArabic ? "بحث بالقالب..." : "Search templates...")"
                              AriaLabel="@(L.IsArabic ? "بحث في قوالب الذكاء الاصطناعي" : "Search AI prompt templates")" />
                <div class="settings-choice-list">
                    @foreach (var template in FilteredTemplates)
                    {
                        <button type="button" class="settings-choice @(_selectedKey == template.Key ? "active" : string.Empty)" @onclick="() => Select(template.Key)">
                            <strong>@DisplayTitle(template)</strong>
                            <small><AppBidiText Mode="technical">@template.Key</AppBidiText> · <AppBidiText Mode="version">r@template.Revision</AppBidiText> · @(template.Enabled ? (L.IsArabic ? "مفعل" : "Enabled") : (L.IsArabic ? "متوقف" : "Disabled"))</small>
                        </button>
                    }
                    @if (!FilteredTemplates.Any())
                    {
                        <AppEmptyState Title="@(L.IsArabic ? "لا توجد قوالب مطابقة" : "No matching templates")"
                                       Description="@(L.IsArabic ? "غيّر نص البحث أو أنشئ قالبًا جديدًا." : "Change the search text or create a new template.")"
                                       Blocking="false" />
                    }
                </div>
            </ChildContent>
        </AppSection>

        <div class="settings-content">
            <AppSection Eyebrow="EDITOR"
                        Title="@(_isNew ? (L.IsArabic ? "قالب جديد" : "New template") : DisplayTitle(_selected))"
                        Subtitle="@(L.IsArabic ? "مفتاح القالب ثابت بعد إنشائه حتى لا تنكسر الاستدعاءات الموجودة في النظام." : "The template key is immutable after creation so existing runtime references remain stable.")"
                        HeadingLevel="3">
                <Header>
                    @if (!_isNew && _selected is not null)
                    {
                        <AppBadge Tone="@(_selected.Enabled ? "success" : "warning")" BidiMode="version" Text="@($"r{_selected.Revision}")" />
                    }
                </Header>
                <ChildContent>
                    <div class="database-info-grid">
                        <label>
                            <small>@(L.IsArabic ? "مفتاح القالب" : "Template key")</small>
                            <input @bind="_editKey" disabled="@(!_isNew)" autocomplete="off" placeholder="content.rewrite" data-bidi="technical" />
                        </label>
                        <label>
                            <small>@(L.IsArabic ? "الحالة" : "Status")</small>
                            <select @bind="_editEnabled">
                                <option value="true">@(L.IsArabic ? "مفعل" : "Enabled")</option>
                                <option value="false">@(L.IsArabic ? "متوقف" : "Disabled")</option>
                            </select>
                        </label>
                    </div>

                    <div class="database-info-grid">
                        <label><small>@(L.IsArabic ? "العنوان بالإنجليزية" : "English title")</small><input @bind="_titleEn" maxlength="120" autocomplete="off" /></label>
                        <label><small>@(L.IsArabic ? "العنوان بالعربية" : "Arabic title")</small><input @bind="_titleAr" maxlength="120" dir="rtl" autocomplete="off" /></label>
                    </div>

                    <label class="ai-content-input"><span>@(L.IsArabic ? "الأمر بالإنجليزية" : "English prompt")</span><textarea @bind="_promptEn" rows="8" maxlength="20000" dir="ltr"></textarea></label>
                    <label class="ai-content-input"><span>@(L.IsArabic ? "الأمر بالعربية" : "Arabic prompt")</span><textarea @bind="_promptAr" rows="8" maxlength="20000" dir="rtl"></textarea></label>

                    <div class="settings-option-row">
                        <div><strong>@(L.IsArabic ? "حفظ إصدار جديد" : "Save new revision")</strong><small>@(L.IsArabic ? "إذا لم تتغير البيانات فلن يتم إنشاء إصدار مكرر." : "If the content did not change, a duplicate revision is not created.")</small></div>
                        <AppButton Variant="primary" Icon="✓" Busy="@_saving" Disabled="@_saving"
                                   Text="@(_saving ? (L.IsArabic ? "جارٍ الحفظ..." : "Saving...") : (L.IsArabic ? "حفظ" : "Save"))"
                                   OnClick="SaveClicked" />
                    </div>
                </ChildContent>
            </AppSection>

            @if (!_isNew && _selected is not null)
            {
                <AppSection Eyebrow="VERSION HISTORY"
                            Title="@(L.IsArabic ? "سجل الإصدارات" : "Revision history")"
                            Subtitle="@(L.IsArabic ? "الاستعادة لا تمسح التاريخ؛ تنشئ إصدارًا جديدًا من محتوى الإصدار المختار." : "Restoring never rewrites history; it creates a new revision from the selected historical content.")"
                            HeadingLevel="3">
                    <Header><AppBadge Tone="info" Text="@_history.Count.ToString()" BidiMode="number" /></Header>
                    <ChildContent>
                        @if (_history.Count == 0)
                        {
                            <AppEmptyState Title="@(L.IsArabic ? "لا يوجد سجل لهذا القالب" : "No revision history")"
                                           Description="@(L.IsArabic ? "سيظهر السجل بعد حفظ أول تعديل." : "History appears after the first saved change.")"
                                           Blocking="false" />
                        }
                        else
                        {
                            <div class="ai-history-list">
                                @foreach (var version in _history)
                                {
                                    <article>
                                        <div><strong><AppBidiText Mode="version" Text="@($"r{version.Revision}")" /> · @version.ChangeType</strong><small><AppBidiText Mode="date">@version.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</AppBidiText> · @version.CreatedBy</small></div>
                                        <p>@Preview(L.IsArabic ? version.PromptAr : version.PromptEn)</p>
                                        <div class="ai-history-actions"><AppButton Size="small" Icon="↺" Disabled="@(version.Revision == _selected.Revision)" Text="@(L.IsArabic ? "استعادة" : "Restore")" OnClick="_ => Restore(version.Revision)" /></div>
                                    </article>
                                }
                            </div>
                        }
                    </ChildContent>
                </AppSection>
            }
        </div>
    </div>
</AppPage>

@code {
    private readonly List<AIPromptTemplateDefinition> _templates = new();
    private readonly List<AIPromptTemplateVersion> _history = new();
    private string _search = string.Empty;
    private string _selectedKey = string.Empty;
    private string _editKey = string.Empty;
    private string _titleEn = string.Empty;
    private string _titleAr = string.Empty;
    private string _promptEn = string.Empty;
    private string _promptAr = string.Empty;
    private bool _editEnabled = true;
    private bool _isNew;
    private bool _saving;
    private bool _isError;
    private string _message = string.Empty;

    private AIPromptTemplateDefinition? _selected => _templates.FirstOrDefault(x => x.Key == _selectedKey);
    private IEnumerable<AIPromptTemplateDefinition> FilteredTemplates => _templates.Where(x =>
        string.IsNullOrWhiteSpace(_search) ||
        x.Key.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        x.TitleEn.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        x.TitleAr.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized()
    {
        CurrentUser.RequireAdministrator();
        Reload();
    }

    private void Reload(string? selectKey = null)
    {
        _templates.Clear();
        _templates.AddRange(PromptStore.GetDefinitions());
        var target = !string.IsNullOrWhiteSpace(selectKey) ? selectKey : _selectedKey;
        if (string.IsNullOrWhiteSpace(target) || !_templates.Any(x => x.Key == target)) target = _templates.FirstOrDefault()?.Key ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(target)) Select(target);
        else NewTemplate();
    }

    private void Select(string key)
    {
        var template = _templates.FirstOrDefault(x => x.Key == key);
        if (template is null) return;
        _selectedKey = template.Key;
        _isNew = false;
        _editKey = template.Key;
        _titleEn = template.TitleEn;
        _titleAr = template.TitleAr;
        _promptEn = template.PromptEn;
        _promptAr = template.PromptAr;
        _editEnabled = template.Enabled;
        _history.Clear();
        _history.AddRange(PromptStore.GetHistory(template.Key));
        _message = string.Empty;
    }

    private void NewTemplate()
    {
        _selectedKey = string.Empty;
        _isNew = true;
        _editKey = string.Empty;
        _titleEn = string.Empty;
        _titleAr = string.Empty;
        _promptEn = string.Empty;
        _promptAr = string.Empty;
        _editEnabled = true;
        _history.Clear();
        _message = string.Empty;
    }

    private Task SearchChanged(string value) { _search = value; return Task.CompletedTask; }
    private void NewTemplateClicked(MouseEventArgs _) => NewTemplate();
    private void SaveClicked(MouseEventArgs _) => Save();

    private void Save()
    {
        _saving = true;
        _message = string.Empty;
        _isError = false;
        try
        {
            var actor = AdministratorActor();
            var saved = PromptStore.Save(new AIPromptTemplateInput(_editKey, _titleEn, _titleAr, _promptEn, _promptAr, _editEnabled), actor);
            _message = L.IsArabic ? $"تم حفظ {saved.Key} كإصدار r{saved.Revision}." : $"Saved {saved.Key} as revision r{saved.Revision}.";
            ReloadPreservingMessage(saved.Key);
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = L.IsArabic ? $"تعذر حفظ القالب: {ex.Message}" : $"Could not save template: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task Restore(int revision)
    {
        if (_selected is null) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", L.IsArabic
            ? $"استعادة الإصدار r{revision} من {_selected.Key} كإصدار جديد؟"
            : $"Restore revision r{revision} of {_selected.Key} as a new revision?");
        if (!confirmed) return;

        try
        {
            var restored = PromptStore.Restore(_selected.Key, revision, AdministratorActor());
            _message = L.IsArabic ? $"تمت الاستعادة في الإصدار r{restored.Revision}." : $"Restored as revision r{restored.Revision}.";
            _isError = false;
            ReloadPreservingMessage(restored.Key);
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = L.IsArabic ? $"تعذرت الاستعادة: {ex.Message}" : $"Could not restore revision: {ex.Message}";
        }
    }

    private void ReloadPreservingMessage(string key)
    {
        var message = _message;
        var isError = _isError;
        Reload(key);
        _message = message;
        _isError = isError;
    }

    private string AdministratorActor()
    {
        var userId = CurrentUser.RequireAdministrator();
        return string.IsNullOrWhiteSpace(CurrentUser.UserName) ? userId.ToString() : CurrentUser.UserName;
    }

    private string DisplayTitle(AIPromptTemplateDefinition? template) => template is null
        ? (L.IsArabic ? "قالب" : "Template")
        : L.IsArabic ? template.TitleAr : template.TitleEn;

    private string Preview(string value)
    {
        var normalized = (value ?? string.Empty).Replace("\r", " ").Replace("\n", " ").Trim();
        return normalized.Length <= 220 ? normalized : normalized[..220] + "…";
    }
}