@page "/admin/sessions"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = AIWordPressManager.Web.Services.ApplicationPermissionCatalog.UsersManage)]
@implements IDisposable
@inject IServiceProvider Services
@inject AppLanguageService L

<PageTitle>@(L.IsArabic ? "إدارة الجلسات" : "Session Management")</PageTitle>

<div class="sessions-page" dir="@L.Direction">
    <AppToolbar Eyebrow="@(L.IsArabic ? "الأمان والجلسات" : "SECURITY & SESSIONS")"
                Title="@(L.IsArabic ? "إدارة الجلسات" : "Session management")"
                Subtitle="@(L.IsArabic ? "راجع الجلسات المسجلة على الخادم وألغِ الوصول فورًا عند الحاجة." : "Review server-tracked sessions and revoke access immediately when needed.")">
        <Actions>
            <AppButton Icon="↻" Text="@(L.IsArabic ? "تحديث" : "Refresh")" Busy="@_working" Disabled="@_working" OnClick="RefreshAsync" />
            <a class="app-button" href="/account/sessions">@(L.IsArabic ? "جلساتي" : "My sessions")</a>
        </Actions>
    </AppToolbar>

    <AppFormStatus Tone="@(_isError ? "error" : "success")"
                   Title="@(_isError ? (L.IsArabic ? "تعذر تنفيذ العملية" : "Action failed") : (L.IsArabic ? "تم تحديث الجلسات" : "Sessions updated"))"
                   Message="@_message" />

    <section class="app-stat-grid">
        <AppStatCard Icon="◎" Label="@(L.IsArabic ? "إجمالي السجلات" : "Session records")" Value="@_sessions.Count.ToString()" />
        <AppStatCard Icon="✓" Label="@(L.IsArabic ? "نشطة" : "Active")" Value="@_sessions.Count(x => x.IsActive).ToString()" Tone="success" />
        <AppStatCard Icon="⌁" Label="@(L.IsArabic ? "ملغاة" : "Revoked")" Value="@_sessions.Count(x => x.RevokedAtUtc.HasValue).ToString()" Tone="warning" />
        <AppStatCard Icon="◷" Label="@(L.IsArabic ? "منتهية" : "Expired")" Value="@_sessions.Count(x => !x.IsActive && !x.RevokedAtUtc.HasValue).ToString()" Tone="info" />
    </section>

    <AppCard>
        <div class="session-filters">
            <label>
                <span>@(L.IsArabic ? "بحث" : "Search")</span>
                <input @bind="_search" @bind:event="oninput" placeholder="@(L.IsArabic ? "المستخدم أو IP أو الدور..." : "User, IP, or role...")" />
            </label>
            <label class="session-toggle">
                <input type="checkbox" @bind="_activeOnly" @bind:after="ReloadAfterFilterAsync" />
                <span>@(L.IsArabic ? "النشطة فقط" : "Active only")</span>
            </label>
        </div>
    </AppCard>

    <AppCard>
        @if (_loading)
        {
            <AppLoading Title="@(L.IsArabic ? "تحميل الجلسات" : "Loading sessions")"
                        Message="@(L.IsArabic ? "جارٍ تحميل سجل الجلسات الآمنة." : "Loading the server-side session inventory.")" />
        }
        else if (!FilteredSessions.Any())
        {
            <p class="session-empty">@(L.IsArabic ? "لا توجد جلسات مطابقة." : "No matching sessions.")</p>
        }
        else
        {
            <div class="session-table-wrap">
                <table class="session-table">
                    <thead>
                    <tr>
                        <th>@(L.IsArabic ? "المستخدم" : "User")</th>
                        <th>@(L.IsArabic ? "الحالة" : "Status")</th>
                        <th>@(L.IsArabic ? "آخر نشاط" : "Last seen")</th>
                        <th>@(L.IsArabic ? "الانتهاء" : "Expires")</th>
                        <th>@(L.IsArabic ? "الجهاز / IP" : "Device / IP")</th>
                        <th>@(L.IsArabic ? "الإجراء" : "Action")</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var session in FilteredSessions)
                    {
                        <tr class="@(session.IsCurrent ? "current-session" : null)">
                            <td>
                                <strong>@session.UserName</strong>
                                <small>@session.Role · @ShortId(session.SessionId)</small>
                            </td>
                            <td>
                                <AppBadge Tone="@StatusTone(session)" Text="@StatusText(session)" />
                                @if (session.IsCurrent)
                                {
                                    <AppBadge Tone="info" Text="@(L.IsArabic ? "الجلسة الحالية" : "Current")" />
                                }
                                @if (session.RememberMe)
                                {
                                    <AppBadge Tone="neutral" Text="@(L.IsArabic ? "تذكرني" : "Remembered")" />
                                }
                            </td>
                            <td>@FormatDate(session.LastSeenAtUtc)</td>
                            <td>@FormatDate(session.ExpiresAtUtc)</td>
                            <td>
                                <span>@(string.IsNullOrWhiteSpace(session.IpAddress) ? "—" : session.IpAddress)</span>
                                <small title="@session.UserAgent">@DeviceText(session.UserAgent)</small>
                            </td>
                            <td>
                                @if (session.IsActive && !session.IsCurrent)
                                {
                                    <AppButton Size="small" Variant="danger" Text="@(L.IsArabic ? "إلغاء الجلسة" : "Revoke")"
                                               Disabled="@_working" OnClick="_ => RevokeAsync(session)" />
                                }
                                else if (session.IsCurrent)
                                {
                                    <span class="session-current-note">@(L.IsArabic ? "استخدم تسجيل الخروج" : "Use sign out")</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </AppCard>
</div>

@code {
    private ApplicationSessionAdministrationService _service = default!;
    private IReadOnlyList<ApplicationSessionView> _sessions = [];
    private string _search = string.Empty;
    private string? _message;
    private bool _activeOnly = true;
    private bool _loading = true;
    private bool _working;
    private bool _isError;

    private IEnumerable<ApplicationSessionView> FilteredSessions => _sessions.Where(x =>
        string.IsNullOrWhiteSpace(_search) ||
        x.UserName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        x.Role.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        x.IpAddress.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        x.SessionId.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized()
    {
        L.Changed += LanguageChanged;
        _service = Microsoft.Extensions.DependencyInjection.ActivatorUtilities.CreateInstance<ApplicationSessionAdministrationService>(Services);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _loading = false;
    }

    private Task RefreshAsync(MouseEventArgs _args) => LoadAsync();
    private Task ReloadAfterFilterAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _working = true;
            _sessions = await _service.ListAllAsync(_activeOnly);
            _isError = false;
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _working = false;
        }
    }

    private async Task RevokeAsync(ApplicationSessionView session)
    {
        try
        {
            _working = true;
            var result = await _service.RevokeAsync(session.SessionId);
            _isError = !result.IsSuccess;
            _message = result.IsSuccess
                ? (L.IsArabic ? $"تم إلغاء جلسة {session.UserName}." : $"Revoked session for {session.UserName}.")
                : result.Message;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _working = false;
        }
    }

    private string StatusText(ApplicationSessionView session) => session.IsActive
        ? (L.IsArabic ? "نشطة" : "Active")
        : session.RevokedAtUtc.HasValue
            ? (L.IsArabic ? "ملغاة" : "Revoked")
            : (L.IsArabic ? "منتهية" : "Expired");

    private static string StatusTone(ApplicationSessionView session) => session.IsActive ? "success" : session.RevokedAtUtc.HasValue ? "warning" : "neutral";
    private static string ShortId(string value) => value.Length <= 10 ? value : value[..10];
    private string FormatDate(DateTime value) => value.ToLocalTime().ToString(L.IsArabic ? "yyyy-MM-dd HH:mm" : "MMM d, yyyy HH:mm");

    private static string DeviceText(string userAgent)
    {
        if (string.IsNullOrWhiteSpace(userAgent)) return "—";
        if (userAgent.Contains("Edg/", StringComparison.OrdinalIgnoreCase)) return "Microsoft Edge";
        if (userAgent.Contains("Chrome/", StringComparison.OrdinalIgnoreCase)) return "Chrome";
        if (userAgent.Contains("Firefox/", StringComparison.OrdinalIgnoreCase)) return "Firefox";
        if (userAgent.Contains("Safari/", StringComparison.OrdinalIgnoreCase)) return "Safari";
        return userAgent.Length > 32 ? userAgent[..32] + "…" : userAgent;
    }

    private void LanguageChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= LanguageChanged;
}
