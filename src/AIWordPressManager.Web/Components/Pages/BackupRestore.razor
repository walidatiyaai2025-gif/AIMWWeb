@page "/backups"
@page "/module/backups"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator")]
@implements IDisposable
@using AIWordPressManager.Application.Abstractions
@inject AppLanguageService L
@inject AppNotificationService Notifications
@inject IJSRuntime JS
@inject ISecretRecoveryKeyService SecretRecovery

<PageTitle>@(L.IsArabic ? "النسخ الاحتياطي" : "Backup & Restore")</PageTitle>

<div class="backup-page">
    <section class="panel backup-hero">
        <div>
            <span class="workspace-kicker">DATA PROTECTION</span>
            <h1>@(L.IsArabic ? "مركز النسخ والاستعادة الآمنة" : "Backup & Restore Safety Center")</h1>
            <p>@(L.IsArabic ? "أنشئ نسخة موثقة لبيانات التطبيق وإعداداته، مع مفتاح استعادة مشفّر اختياري للأسرار المحمية." : "Create a verified archive of application data and configuration, with optional encrypted recovery material for protected secrets.")</p>
        </div>
        <button class="btn primary" disabled="@_working" @onclick="CreateAsync">＋ @(_working ? (L.IsArabic ? "جارٍ الإنشاء..." : "Creating...") : (L.IsArabic ? "إنشاء نسخة" : "Create backup"))</button>
    </section>

    <section class="backup-stats">
        <article class="panel"><small>@(L.IsArabic ? "إجمالي النسخ" : "Total backups")</small><strong>@_items.Count</strong></article>
        <article class="panel"><small>@(L.IsArabic ? "نسخ سليمة" : "Verified")</small><strong>@_items.Count(x => x.IsValid)</strong></article>
        <article class="panel"><small>@(L.IsArabic ? "إجمالي الحجم" : "Total size")</small><strong>@FormatBytes(_items.Sum(x => x.SizeBytes))</strong></article>
        <article class="panel"><small>@(L.IsArabic ? "سجل العمليات" : "Audit events")</small><strong>@_history.Count</strong></article>
    </section>

    <section class="panel backup-toolbar">
        <label>
            <span>@(L.IsArabic ? "ملاحظة النسخة" : "Backup note")</span>
            <input @bind="_note" disabled="@_working" placeholder="@(L.IsArabic ? "مثال: قبل تحديث النظام" : "Example: before system update")" />
        </label>
        <label>
            <span>@(L.IsArabic ? "سر الاستعادة" : "Recovery secret")</span>
            <input type="password" @bind="_recoverySecret" disabled="@_working" minlength="16" maxlength="1024" autocomplete="new-password" placeholder="@(L.IsArabic ? "16 حرفاً على الأقل" : "At least 16 characters")" />
        </label>
        <label>
            <span>@(L.IsArabic ? "تأكيد سر الاستعادة" : "Confirm recovery secret")</span>
            <input type="password" @bind="_recoverySecretConfirm" disabled="@_working" minlength="16" maxlength="1024" autocomplete="new-password" placeholder="@(L.IsArabic ? "أعد إدخال السر عند إنشاء نسخة" : "Re-enter when creating a backup")" />
        </label>
        <div>
            <button class="btn" disabled="@_working" @onclick="Reload">↻ @(L.IsArabic ? "تحديث" : "Refresh")</button>
            <button class="btn" disabled="@_working" @onclick="CopyPathAsync">@(L.IsArabic ? "نسخ المسار" : "Copy path")</button>
            <code>@_backups.BackupDirectory</code>
        </div>
    </section>

    <div class="settings-note">
        <span>🔐</span>
        <p>@(L.IsArabic ? "سر الاستعادة لا يُحفظ داخل النسخة أو سجل العمليات. احتفظ به خارج النظام. اترك الحقلين فارغين لإنشاء نسخة بدون إمكانية استعادة بيانات الاعتماد المشفرة. لفحص الجاهزية أدخل السر في حقل «سر الاستعادة» فقط." : "The recovery secret is never stored in the archive or audit trail. Keep it outside the system. Leave both fields empty to create a backup without encrypted-credential recovery. For preflight validation, enter the secret in the Recovery secret field only.")</p>
    </div>

    <section class="panel backup-list">
        <header><div><span class="workspace-kicker">ARCHIVES</span><h2>@(L.IsArabic ? "النسخ المتاحة" : "Available backups")</h2></div></header>
        @if (_items.Count == 0)
        {
            <div class="empty-state"><h3>@(L.IsArabic ? "لا توجد نسخ احتياطية" : "No backups yet")</h3><p>@(L.IsArabic ? "أنشئ أول نسخة من الزر بالأعلى." : "Create the first archive using the button above.")</p></div>
        }
        else
        {
            @foreach (var item in _items)
            {
                <article class="backup-row @(ReferenceEquals(_selected, item) ? "active" : string.Empty)">
                    <div class="backup-icon">▣</div>
                    <div class="backup-main">
                        <strong>@item.FileName</strong>
                        <small>@FormatDate(item.CreatedAtUtc) · @FormatBytes(item.SizeBytes) · @item.DatabaseCount @(L.IsArabic ? "قاعدة" : "databases")</small>
                        @if (!string.IsNullOrWhiteSpace(item.Note)){<small>@item.Note</small>}
                        <code>SHA-256 @item.Sha256[..Math.Min(20, item.Sha256.Length)]…</code>
                    </div>
                    <span class="badge @(item.IsValid ? "success" : "danger")">@(item.IsValid ? (L.IsArabic ? "سليمة" : "Verified") : (L.IsArabic ? "غير سليمة" : "Invalid"))</span>
                    <div class="backup-actions">
                        <button class="btn compact" disabled="@_working" @onclick="() => Inspect(item)">⌕ @(L.IsArabic ? "فحص" : "Inspect")</button>
                        <button class="btn compact" disabled="@_working" @onclick="() => PreflightAsync(item)">✓ @(L.IsArabic ? "جاهزية" : "Preflight")</button>
                        <button class="btn compact danger" disabled="@_working" @onclick="() => Delete(item)">× @(L.IsArabic ? "حذف" : "Delete")</button>
                    </div>
                </article>
            }
        }
    </section>

    @if (_inspection is not null)
    {
        <section class="panel backup-list">
            <header><div><span class="workspace-kicker">INSPECTION</span><h2>@(L.IsArabic ? "تفاصيل النسخة" : "Backup inspection")</h2></div><span class="badge @(_inspection.IsValid ? "success" : "danger")">@(_inspection.IsValid ? "VALID" : "INVALID")</span></header>
            <div class="database-info-grid">
                <div><small>@(L.IsArabic ? "إصدار الملف" : "Manifest version")</small><strong>@_inspection.ManifestVersion</strong></div>
                <div><small>@(L.IsArabic ? "الجهاز المصدر" : "Source machine")</small><strong>@(_inspection.MachineName ?? "—")</strong></div>
                <div><small>@(L.IsArabic ? "مزود قاعدة البيانات" : "Database provider")</small><strong>@(_inspection.DatabaseProvider ?? "—")</strong></div>
                <div><small>@(L.IsArabic ? "الحجم بعد الفك" : "Uncompressed size")</small><strong>@FormatBytes(_inspection.UncompressedBytes)</strong></div>
                <div><small>@(L.IsArabic ? "قواعد البيانات" : "Databases")</small><strong>@_inspection.DatabaseCount</strong></div>
                <div><small>@(L.IsArabic ? "الملفات المُدارة" : "Managed files")</small><strong>@_inspection.Files.Count</strong></div>
                <div><small>@(L.IsArabic ? "استعادة الأسرار" : "Secret recovery")</small><strong>@SecretRecoveryLabel(_inspection.SecretRecoveryMode, _inspection.WrappedSecretKeyEnvelope)</strong></div>
            </div>
            <div class="settings-note"><span>ⓘ</span><p>@_inspection.Message</p></div>
            @foreach (var file in _inspection.Files)
            {
                var displayPath = string.IsNullOrWhiteSpace(file.RelativePath) ? file.Name : file.RelativePath;
                <div class="backup-row"><div class="backup-icon">@KindIcon(file.Kind)</div><div class="backup-main"><strong>@displayPath</strong><small>@KindLabel(file.Kind) · @FormatBytes(file.SizeBytes)</small></div></div>
            }
        </section>
    }

    @if (_readiness is not null)
    {
        <section class="panel backup-list">
            <header><div><span class="workspace-kicker">RESTORE PREFLIGHT</span><h2>@(L.IsArabic ? "فحص جاهزية الاستعادة" : "Restore readiness")</h2></div><span class="badge @(_readiness.IsReady ? "success" : "danger")">@(_readiness.IsReady ? "READY" : "BLOCKED")</span></header>
            @foreach (var check in _readiness.Checks)
            {
                <article class="backup-row"><div class="backup-icon">@(check.Passed ? "✓" : "!")</div><div class="backup-main"><strong>@(L.IsArabic ? check.NameAr : check.Name)</strong><small>@check.Message</small></div><span class="badge @(check.Passed ? "success" : "danger")">@(check.Passed ? (L.IsArabic ? "اجتاز" : "Passed") : (L.IsArabic ? "موقوف" : "Blocked"))</span></article>
            }
            <div class="settings-note"><span>⚠</span><p>@(L.IsArabic ? "الاستعادة داخل التطبيق تظل محظورة. يجب إيقاف التطبيق وتنفيذ الاستعادة دون اتصال. وجود المفتاح المغلف لا يكفي وحده؛ فحص الجاهزية يتحقق أيضاً من سر الاستعادة قبل السماح باعتبار الأسرار قابلة للتعافي." : "In-process restore remains blocked. Stop the application and perform an offline restore. A wrapped key alone is not enough; preflight also validates the recovery secret before protected secrets are considered recoverable.")</p></div>
        </section>
    }

    <section class="panel backup-list">
        <header><div><span class="workspace-kicker">AUDIT TRAIL</span><h2>@(L.IsArabic ? "سجل العمليات" : "Backup audit trail")</h2></div></header>
        @if (_history.Count == 0)
        {
            <div class="empty-state"><p>@(L.IsArabic ? "لا توجد عمليات مسجلة." : "No recorded operations yet.")</p></div>
        }
        else
        {
            @foreach (var entry in _history.Take(20))
            {
                <article class="backup-row"><div class="backup-icon">@(entry.Succeeded ? "✓" : "!")</div><div class="backup-main"><strong>@entry.Action · @entry.FileName</strong><small>@FormatDate(entry.TimestampUtc) · @entry.Message</small></div><span class="badge @(entry.Succeeded ? "success" : "danger")">@(entry.Succeeded ? "OK" : "FAILED")</span></article>
            }
        }
    </section>
</div>

@code {
    private readonly BackupManagementService _backups = new();
    private List<BackupFileInfo> _items = [];
    private List<BackupAuditEntry> _history = [];
    private BackupFileInfo? _selected;
    private BackupInspectionResult? _inspection;
    private RestoreReadinessResult? _readiness;
    private string _note = string.Empty;
    private string _recoverySecret = string.Empty;
    private string _recoverySecretConfirm = string.Empty;
    private bool _working;
    private bool _disposed;

    protected override void OnInitialized()
    {
        L.Changed += Changed;
        Reload();
    }

    private void Reload()
    {
        if (_disposed) return;

        try
        {
            _items = _backups.GetBackups().ToList();
            _history = _backups.GetHistory().ToList();
        }
        catch (Exception ex)
        {
            ShowError(ex, L.IsArabic ? "فشل تحميل النسخ" : "Failed to load backups");
        }
    }

    private async Task CreateAsync()
    {
        if (_working || _disposed) return;

        try
        {
            _working = true;
            string? wrappedEnvelope = null;
            if (!string.IsNullOrWhiteSpace(_recoverySecret) || !string.IsNullOrWhiteSpace(_recoverySecretConfirm))
            {
                if (string.IsNullOrWhiteSpace(_recoverySecret) || string.IsNullOrWhiteSpace(_recoverySecretConfirm))
                    throw new InvalidOperationException(L.IsArabic ? "أدخل سر الاستعادة وأكده قبل إنشاء النسخة." : "Enter and confirm the recovery secret before creating the backup.");
                if (!string.Equals(_recoverySecret, _recoverySecretConfirm, StringComparison.Ordinal))
                    throw new InvalidOperationException(L.IsArabic ? "سر الاستعادة وتأكيده غير متطابقين." : "The recovery secret and confirmation do not match.");

                wrappedEnvelope = await SecretRecovery.ExportWrappedKeyAsync(_recoverySecret);
                if (!await SecretRecovery.ValidateWrappedKeyAsync(wrappedEnvelope, _recoverySecret))
                    throw new InvalidOperationException(L.IsArabic ? "تعذر التحقق من مفتاح الاستعادة المشفّر." : "The wrapped recovery key could not be verified.");
            }

            var item = _backups.CreateBackup(_note, wrappedEnvelope);
            if (_disposed) return;

            _note = string.Empty;
            Reload();
            _selected = _items.FirstOrDefault(x => x.FileName == item.FileName);
            Notifications.Success(
                wrappedEnvelope is null
                    ? (L.IsArabic ? $"تم إنشاء النسخة {item.FileName} بدون استعادة للأسرار المحمية." : $"Backup {item.FileName} was created without protected-secret recovery.")
                    : (L.IsArabic ? $"تم إنشاء النسخة {item.FileName} مع مفتاح استعادة مغلف." : $"Backup {item.FileName} was created with wrapped secret recovery."));
        }
        catch (Exception ex)
        {
            ShowError(ex, L.IsArabic ? "فشل إنشاء النسخة" : "Backup failed");
        }
        finally
        {
            ClearRecoverySecretFields();
            if (!_disposed) _working = false;
        }
    }

    private void Inspect(BackupFileInfo item)
    {
        RunOperation(() =>
        {
            _selected = item;
            _inspection = _backups.Inspect(item.FileName);
            _readiness = null;
            Reload();
        }, L.IsArabic ? "فشل فحص النسخة" : "Backup inspection failed");
    }

    private async Task PreflightAsync(BackupFileInfo item)
    {
        if (_working || _disposed) return;

        try
        {
            _working = true;
            _selected = item;
            _inspection = _backups.Inspect(item.FileName);

            var secretRecoveryValidated = false;
            if (_inspection.IsValid &&
                string.Equals(_inspection.SecretRecoveryMode, SecretRecoveryKeyEnvelopeFormat.WrappedKeyV1Mode, StringComparison.OrdinalIgnoreCase) &&
                !string.IsNullOrWhiteSpace(_inspection.WrappedSecretKeyEnvelope) &&
                !string.IsNullOrWhiteSpace(_recoverySecret))
            {
                secretRecoveryValidated = await SecretRecovery.ValidateWrappedKeyAsync(
                    _inspection.WrappedSecretKeyEnvelope,
                    _recoverySecret);
                if (!secretRecoveryValidated && !_disposed)
                {
                    Notifications.Error(
                        L.IsArabic ? "سر الاستعادة لا يطابق المفتاح المغلف في هذه النسخة." : "The recovery secret does not match the wrapped key in this backup.",
                        L.IsArabic ? "فشل التحقق من سر الاستعادة" : "Recovery secret validation failed");
                }
            }

            _readiness = _backups.CheckRestoreReadiness(item.FileName, secretRecoveryValidated);
            Reload();
        }
        catch (Exception ex)
        {
            ShowError(ex, L.IsArabic ? "فشل فحص الجاهزية" : "Preflight check failed");
        }
        finally
        {
            ClearRecoverySecretFields();
            if (!_disposed) _working = false;
        }
    }

    private void Delete(BackupFileInfo item)
    {
        RunOperation(() =>
        {
            _backups.Delete(item.FileName);
            if (_selected?.FileName == item.FileName)
            {
                _selected = null;
                _inspection = null;
                _readiness = null;
            }

            Reload();
            if (!_disposed)
                Notifications.Success(L.IsArabic ? "تم حذف النسخة." : "Backup deleted.");
        }, L.IsArabic ? "فشل الحذف" : "Delete failed");
    }

    private void RunOperation(Action action, string errorTitle)
    {
        if (_working || _disposed) return;

        try
        {
            _working = true;
            action();
        }
        catch (Exception ex)
        {
            ShowError(ex, errorTitle);
        }
        finally
        {
            if (!_disposed) _working = false;
        }
    }

    private async Task CopyPathAsync()
    {
        if (_working || _disposed) return;

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _backups.BackupDirectory);
            if (!_disposed)
                Notifications.Success(L.IsArabic ? "تم نسخ مسار النسخ الاحتياطية." : "Backup path copied.");
        }
        catch (Exception ex)
        {
            ShowError(ex, L.IsArabic ? "تعذر نسخ المسار" : "Could not copy the backup path");
        }
    }

    private void ShowError(Exception ex, string title)
    {
        if (_disposed) return;
        Notifications.Error(L.TranslateMessage(ex.Message), title, ex.ToString());
    }

    private void ClearRecoverySecretFields()
    {
        _recoverySecret = string.Empty;
        _recoverySecretConfirm = string.Empty;
    }

    private string FormatDate(DateTime value) => value.ToLocalTime().ToString(L.IsArabic ? "yyyy-MM-dd HH:mm" : "MMM d, yyyy HH:mm");
    private static string FormatBytes(long value) => value switch { >= 1073741824 => $"{value / 1073741824d:0.00} GB", >= 1048576 => $"{value / 1048576d:0.00} MB", >= 1024 => $"{value / 1024d:0.0} KB", _ => $"{value} B" };

    private static string KindIcon(string? kind)
    {
        if (!Enum.TryParse<BackupContentKind>(kind, true, out var parsed)) return "FS";
        return parsed switch
        {
            BackupContentKind.Database => "DB",
            BackupContentKind.DatabaseSidecar => "DB+",
            BackupContentKind.Configuration => "CFG",
            _ => "FS"
        };
    }

    private string KindLabel(string? kind)
    {
        if (!Enum.TryParse<BackupContentKind>(kind, true, out var parsed))
            parsed = BackupContentKind.ManagedFile;

        return parsed switch
        {
            BackupContentKind.Database => L.IsArabic ? "قاعدة بيانات" : "Database",
            BackupContentKind.DatabaseSidecar => L.IsArabic ? "ملف مساعد لقاعدة البيانات" : "Database sidecar",
            BackupContentKind.ManagedState => L.IsArabic ? "حالة تطبيق مُدارة" : "Managed application state",
            BackupContentKind.Configuration => L.IsArabic ? "إعدادات التطبيق" : "Application configuration",
            _ => L.IsArabic ? "ملف مُدار" : "Managed file"
        };
    }

    private string SecretRecoveryLabel(string? mode, string? wrappedEnvelope)
    {
        if (string.Equals(mode, SecretRecoveryKeyEnvelopeFormat.WrappedKeyV1Mode, StringComparison.OrdinalIgnoreCase) &&
            !string.IsNullOrWhiteSpace(wrappedEnvelope))
        {
            return L.IsArabic ? "مفتاح مغلف موجود — يحتاج تحقق السر" : "Wrapped key included — secret validation required";
        }

        if (string.Equals(mode, "wrapped-key-required", StringComparison.OrdinalIgnoreCase))
            return L.IsArabic ? "موقوف — لا يوجد مفتاح مغلف" : "Blocked — no wrapped key";

        return L.IsArabic ? "قديم أو غير معروف" : "Legacy or unknown";
    }

    private void Changed()
    {
        if (_disposed) return;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        ClearRecoverySecretFields();
        L.Changed -= Changed;
    }
}
