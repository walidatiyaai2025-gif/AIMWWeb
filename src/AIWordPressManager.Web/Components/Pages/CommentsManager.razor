@page "/sites/{SiteId:guid}/comments"
@rendermode InteractiveServer
@implements IDisposable
@inject SiteWebService SiteService
@inject WordPressCommentsWebService CommentsService
@inject CurrentUserContext CurrentUser
@inject AppLanguageService L

<PageTitle>@L["CommentsManager"]</PageTitle>

@if (_loading)
{
    <AppLoading Title="@L["LoadingComments"]"
                Message="@(L.IsArabic ? "يتم تحميل التعليقات وحالات المراجعة من WordPress." : "Loading comments and moderation states from WordPress.")" />
}
else if (_site is null)
{
    <AppCard>
        <AppEmptyState Icon="!" Title="@L["SiteNotFound"]">
            <Actions><AppButton Href="/sites" Text="@L["BackToSites"]" /></Actions>
        </AppEmptyState>
    </AppCard>
}
else
{
    <div class="comments-manager-workspace">
        <AppToolbar Eyebrow="@(L.IsArabic ? "إدارة التفاعل" : "ENGAGEMENT")"
                    Title="@L["CommentsManager"]"
                    Subtitle="@($"{_site.Name} — {L["CommentsIntro"]}")">
            <Actions>
                <AppButton Href="@($"/sites/{SiteId}/explorer")" Text="@L["BackToExplorer"]" />
                <AppButton Icon="↻" Text="@L["Refresh"]" Busy="@_working" Disabled="@_working" OnClick="RefreshClickedAsync" />
            </Actions>
        </AppToolbar>

        @if (!CanEditContent)
        {
            <div class="alert" role="status"><strong>@(L.IsArabic ? "وضع القراءة فقط: تحتاج صلاحية Content.Edit لاعتماد التعليقات أو تغيير حالتها أو الرد عليها أو حذفها." : "Read-only mode: Content.Edit permission is required to moderate, reply to, or delete comments.")</strong></div>
        }

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert @(_isError ? "error" : "success")"><strong>@_message</strong></div>
        }

        <section class="app-stat-grid">
            <AppStatCard Icon="☏" Label="@L["Comments"]" Value="@_result.Total.ToString()" Description="@L["CurrentFilter"]" />
            <AppStatCard Icon="✓" Label="@L["Approved"]" Value="@ApprovedCount.ToString()" Description="@(L.IsArabic ? "في الصفحة الحالية" : "On current page")" Tone="success" />
            <AppStatCard Icon="◷" Label="@L["PendingComment"]" Value="@PendingCount.ToString()" Description="@(L.IsArabic ? "تحتاج مراجعة" : "Needs moderation")" Tone="warning" />
            <AppStatCard Icon="#" Label="@L["CurrentPage"]" Value="@_page.ToString()" Description="@($"{L["OfPages"]} {_result.TotalPages}")" Tone="info" />
        </section>

        <AppSection Eyebrow="@(L.IsArabic ? "الفلاتر" : "FILTERS")"
                    Title="@(L.IsArabic ? "تصفية تعليقات WordPress" : "Filter WordPress comments")">
            <ChildContent>
                <div class="filter-row">
                    <input class="search-input" @bind="_search" @bind:event="oninput" placeholder="@L["SearchComments"]" />
                    <select @bind="_status">
                        <option value="all">@L["All"]</option>
                        <option value="approved">@L["Approved"]</option>
                        <option value="hold">@L["PendingComment"]</option>
                        <option value="spam">@L["Spam"]</option>
                        <option value="trash">@L["Trash"]</option>
                    </select>
                    <AppButton Variant="primary" Text="@L["Search"]" Disabled="@_working" OnClick="SearchClickedAsync" />
                    <AppButton Text="@L["Refresh"]" Disabled="@_working" OnClick="RefreshClickedAsync" />
                </div>
            </ChildContent>
        </AppSection>

        @if (!_result.Success)
        {
            <AppCard>
                <AppEmptyState Icon="!" Title="@L["CouldNotLoadComments"]" Description="@L.TranslateMessage(_result.Message)" />
            </AppCard>
        }
        else
        {
            <AppDataGrid TItem="WordPressCommentView"
                         Items="@_result.Items"
                         KeySelector="@(comment => comment.Id.ToString())"
                         SearchKeySelector="@CommentSearchKey"
                         SortKeySelector="@(comment => comment.AuthorName)"
                         CsvHeaders="@CsvHeaders"
                         CsvRowSelector="@CommentCsvRow"
                         CsvFileName="@CsvFileName"
                         PageSize="10"
                         Selectable="@CanEditContent"
                         EmptyTitle="@L["NoComments"]"
                         EmptyDescription="@L["NoCommentsHelp"]"
                         SearchPlaceholder="@L["SearchComments"]"
                         SearchAriaLabel="@L["SearchComments"]"
                         SortText="@(L.IsArabic ? "ترتيب بالكاتب" : "Sort by author")"
                         ExportText="@(L.IsArabic ? "تصدير CSV" : "Export CSV")"
                         SelectedText="@(L.IsArabic ? "محدد" : "selected")"
                         ShowingText="@(L.IsArabic ? "عرض" : "Showing")"
                         OfText="@(L.IsArabic ? "من" : "of")"
                         RowsPerPageText="@(L.IsArabic ? "صفوف" : "Rows")">
                <Toolbar>
                    <div>
                        <strong>@(L.IsArabic ? "تعليقات الصفحة الحالية" : "Current WordPress page")</strong>
                        <small>@($"{L["Page"]} {_page} {L["Of"]} {_result.TotalPages}")</small>
                    </div>
                    <AppBadge Tone="info" Text="@_result.Items.Count.ToString()" />
                </Toolbar>
                <Header>
                    <th>@L["User"]</th>
                    <th>@(L.IsArabic ? "التعليق" : "Comment")</th>
                    <th>@L["Status"]</th>
                    <th>@L["Registered"]</th>
                    <th>@L["Actions"]</th>
                </Header>
                <RowTemplate Context="comment">
                    <td>
                        <div class="user-row">
                            <div>
                                <strong>@AuthorName(comment)</strong>
                                <small>@comment.AuthorEmail</small>
                            </div>
                        </div>
                    </td>
                    <td>
                        <div class="comment-content">@((MarkupString)comment.Content)</div>
                        <small>@L["PostId"]: @comment.PostId · @L["CommentId"]: @comment.Id</small>
                        @if (!string.IsNullOrWhiteSpace(comment.Link))
                        {
                            <a href="@comment.Link" target="_blank" rel="noopener">@L["Open"] ↗</a>
                        }
                        @if (_replyingTo == comment.Id && CanEditContent)
                        {
                            <div class="reply-box">
                                <textarea rows="4" @bind="_replyText" placeholder="@L["WriteReply"]"></textarea>
                                <div class="actions">
                                    <AppButton Variant="primary" Text="@L["SendReply"]" Busy="@_working" Disabled="@_working" OnClick="args => SendReplyAsync(comment)" />
                                    <AppButton Text="@L["Cancel"]" Disabled="@_working" OnClick="CancelReplyClicked" />
                                </div>
                            </div>
                        }
                    </td>
                    <td><AppBadge Tone="@StatusTone(comment.Status)" Text="@TranslateStatus(comment.Status)" /></td>
                    <td>@FormatDate(comment.DateUtc)</td>
                    <td>
                        @if (CanEditContent)
                        {
                            <div class="table-actions comment-actions">
                                @if (comment.Status != "approved")
                                {
                                    <AppButton Size="small" Variant="primary" Text="@L["Approve"]" Disabled="@_working" OnClick="args => RunAsync(() => CommentsService.ApproveAsync(SiteId, comment.Id))" />
                                }
                                @if (comment.Status != "hold")
                                {
                                    <AppButton Size="small" Text="@L["Unapprove"]" Disabled="@_working" OnClick="args => RunAsync(() => CommentsService.HoldAsync(SiteId, comment.Id))" />
                                }
                                @if (comment.Status != "spam")
                                {
                                    <AppButton Size="small" Text="@L["MarkSpam"]" Disabled="@_working" OnClick="args => RunAsync(() => CommentsService.SpamAsync(SiteId, comment.Id))" />
                                }
                                @if (comment.Status != "trash")
                                {
                                    <AppButton Size="small" Variant="danger" Text="@L["MoveToTrash"]" Disabled="@_working" OnClick="args => RunAsync(() => CommentsService.TrashAsync(SiteId, comment.Id))" />
                                }
                                @if (comment.Status == "trash")
                                {
                                    <AppButton Size="small" Variant="danger" Text="@L["DeletePermanently"]" Disabled="@_working" OnClick="args => RunAsync(() => CommentsService.DeleteAsync(SiteId, comment.Id, true))" />
                                }
                                <AppButton Size="small" Text="@L["Reply"]" Disabled="@_working" OnClick="args => StartReplyClicked(comment)" />
                            </div>
                        }
                        else
                        {
                            <span class="block-muted">@(L.IsArabic ? "قراءة فقط" : "Read only")</span>
                        }
                    </td>
                </RowTemplate>
            </AppDataGrid>

            <AppSection Title="@(L.IsArabic ? "صفحات WordPress" : "WordPress pages")">
                <Actions>
                    <AppButton Icon="‹" Text="@L["Previous"]" Disabled="@(_page <= 1 || _working)" OnClick="PreviousPageClickedAsync" />
                    <AppBadge Tone="info" Text="@($"{L["Page"]} {_page} {L["Of"]} {_result.TotalPages}")" />
                    <AppButton Icon="›" Text="@L["Next"]" Disabled="@(_page >= _result.TotalPages || _working)" OnClick="NextPageClickedAsync" />
                </Actions>
            </AppSection>
        }
    </div>
}

@code {
    [Parameter] public Guid SiteId { get; set; }
    private AIWordPressManager.Domain.Entities.Site? _site;
    private CommentPageResult _result = new(true, string.Empty, Array.Empty<WordPressCommentView>(), 0, 1);
    private string _status = "all", _search = string.Empty, _replyText = string.Empty;
    private string? _message;
    private int _page = 1, _replyingTo;
    private bool _loading = true, _working, _isError;

    private bool CanEditContent => CurrentUser.HasPermission(ApplicationPermissionCatalog.ContentEdit);
    private int ApprovedCount => _result.Items.Count(x => x.Status == "approved");
    private int PendingCount => _result.Items.Count(x => x.Status == "hold");
    private IReadOnlyList<string> CsvHeaders => L.IsArabic
        ? new[] { "المعرّف", "الكاتب", "البريد الإلكتروني", "الحالة", "رقم المقال", "التاريخ", "المحتوى", "الرابط" }
        : new[] { "Id", "Author", "Email", "Status", "Post Id", "Date", "Content", "Link" };
    private string CsvFileName => $"wordpress-comments-{DateTime.Now:yyyyMMdd-HHmmss}.csv";

    protected override void OnInitialized() => L.Changed += Changed;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _site = await SiteService.GetSiteAsync(SiteId);
        if (_site is not null) await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        try
        {
            _working = true;
            _result = await CommentsService.GetAsync(SiteId, _status, _search, _page);
            _isError = !_result.Success;
            _message = _result.Success ? null : L.TranslateMessage(_result.Message);
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = L.TranslateMessage(ex.Message);
            _result = new(false, ex.Message, Array.Empty<WordPressCommentView>(), 0, 1);
        }
        finally { _working = false; }
    }

    private Task RefreshClickedAsync(MouseEventArgs _) => LoadAsync();
    private Task SearchClickedAsync(MouseEventArgs _) => ReloadFromFirstPageAsync();
    private Task PreviousPageClickedAsync(MouseEventArgs _) => PreviousPageAsync();
    private Task NextPageClickedAsync(MouseEventArgs _) => NextPageAsync();
    private Task CancelReplyClicked(MouseEventArgs _) { CancelReply(); return Task.CompletedTask; }
    private Task StartReplyClicked(WordPressCommentView comment) { CurrentUser.RequirePermission(ApplicationPermissionCatalog.ContentEdit); StartReply(comment); return Task.CompletedTask; }

    private async Task ReloadFromFirstPageAsync() { _page = 1; await LoadAsync(); }
    private async Task PreviousPageAsync() { if (_page > 1) { _page--; await LoadAsync(); } }
    private async Task NextPageAsync() { if (_page < _result.TotalPages) { _page++; await LoadAsync(); } }
    private void StartReply(WordPressCommentView comment) { _replyingTo = comment.Id; _replyText = string.Empty; }
    private void CancelReply() { _replyingTo = 0; _replyText = string.Empty; }

    private async Task SendReplyAsync(WordPressCommentView comment)
    {
        CurrentUser.RequirePermission(ApplicationPermissionCatalog.ContentEdit);
        if (string.IsNullOrWhiteSpace(_replyText)) { _isError = true; _message = L["ReplyRequired"]; return; }
        await RunAsync(() => CommentsService.ReplyAsync(SiteId, comment.PostId, comment.Id, _replyText));
        CancelReply();
    }

    private async Task RunAsync(Func<Task<CommentOperationResult>> operation)
    {
        try
        {
            CurrentUser.RequirePermission(ApplicationPermissionCatalog.ContentEdit);
            _working = true;
            var result = await operation();
            _isError = !result.Success;
            _message = L.TranslateMessage(result.Message);
            if (result.Success) await LoadAsync();
        }
        catch (Exception ex) { _isError = true; _message = L.TranslateMessage(ex.Message); }
        finally { _working = false; }
    }

    private string AuthorName(WordPressCommentView comment) => string.IsNullOrWhiteSpace(comment.AuthorName) ? L["Anonymous"] : comment.AuthorName;
    private string CommentSearchKey(WordPressCommentView comment) => $"{comment.Id} {comment.AuthorName} {comment.AuthorEmail} {comment.Status} {comment.PostId} {comment.Content}";
    private IReadOnlyList<string> CommentCsvRow(WordPressCommentView comment) => new[]
    {
        comment.Id.ToString(), AuthorName(comment), comment.AuthorEmail, TranslateStatus(comment.Status),
        comment.PostId.ToString(), FormatDate(comment.DateUtc), StripHtml(comment.Content), comment.Link ?? string.Empty
    };

    private string TranslateStatus(string status) => status switch
    {
        "approved" => L["Approved"], "hold" => L["PendingComment"], "spam" => L["Spam"], "trash" => L["Trash"], _ => status
    };

    private static string StatusTone(string status) => status switch
    {
        "approved" => "success", "hold" => "warning", "spam" or "trash" => "danger", _ => "neutral"
    };

    private string FormatDate(DateTime? value) => value is null ? "—" : value.Value.ToLocalTime().ToString(L.IsArabic ? "yyyy-MM-dd HH:mm" : "MMM d, yyyy HH:mm");
    private static string StripHtml(string value) => System.Text.RegularExpressions.Regex.Replace(value ?? string.Empty, "<.*?>", string.Empty);
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= Changed;
}