@page "/module/{Key}"
@rendermode InteractiveServer
@implements IDisposable
@inject SiteWebService SiteService
@inject AppLanguageService L

<PageTitle>@Title</PageTitle>

<div class="module-page module-@NormalizedKey" data-testid="module-workspace-fallback">
    <section class="module-hero panel">
        <div>
            <span class="workspace-kicker">@Section</span>
            <h1>@Icon @Title</h1>
            <p>@Description</p>
        </div>
    </section>

    @if (IsSeoGateway)
    {
        @if (_loading)
        {
            <section class="panel" style="padding:24px" data-testid="seo-audit-site-picker-loading" aria-busy="true">
                @(L.IsArabic ? "جارٍ تحميل مواقعك الحقيقية..." : "Loading your real sites...")
            </section>
        }
        else if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <section class="panel empty-state" style="padding:24px" data-testid="seo-audit-site-picker-error" role="alert">
                <h2>@(L.IsArabic ? "تعذر تحميل المواقع" : "Unable to load sites")</h2>
                <p>@_loadError</p>
                <button class="btn primary" @onclick="LoadSitesAsync">@(L.IsArabic ? "إعادة المحاولة" : "Retry")</button>
            </section>
        }
        else
        {
            <section class="panel" style="padding:24px" data-testid="seo-audit-site-picker">
                <header style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;margin-bottom:18px">
                    <div>
                        <span class="workspace-kicker">@(L.IsArabic ? "بيانات حقيقية فقط" : "REAL DATA ONLY")</span>
                        <h2 style="margin:8px 0">@(L.IsArabic ? "اختر موقعًا لفتح تدقيق SEO الحقيقي" : "Choose a site to open the real SEO audit")</h2>
                        <p style="margin:0;opacity:.74">@(L.IsArabic ? "لن تُعرض أي درجة أو مشكلة قبل تحليل بيانات الموقع الفعلية داخل مساحة SEO الخاصة به." : "No score or finding is shown until the site's real synchronized content is analyzed in its SEO workspace.")</p>
                    </div>
                    <button class="btn" @onclick="LoadSitesAsync" disabled="@_loading">↻ @(L.IsArabic ? "تحديث المواقع" : "Refresh sites")</button>
                </header>

                @if (_sites.Count == 0)
                {
                    <div class="empty-state" data-testid="seo-audit-no-sites">
                        <h3>@(L.IsArabic ? "لا توجد مواقع متاحة" : "No sites available")</h3>
                        <p>@(L.IsArabic ? "أضف موقع WordPress أو أكمل ربطه قبل تشغيل تدقيق SEO." : "Add or connect a WordPress site before running an SEO audit.")</p>
                        <a class="btn primary" href="/sites">@(L.IsArabic ? "إدارة المواقع" : "Manage sites")</a>
                    </div>
                }
                else
                {
                    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px">
                        @foreach (var site in _sites)
                        {
                            <article class="panel" style="padding:18px" data-testid="seo-audit-site-card">
                                <small style="opacity:.65">WordPress</small>
                                <h3 style="margin:8px 0 14px">@site.Name</h3>
                                <div style="display:flex;gap:8px;flex-wrap:wrap">
                                    <a class="btn primary" data-testid="seo-audit-site-link" href="@($"/sites/{site.Id}/seo")">
                                        @(L.IsArabic ? "فتح تدقيق SEO" : "Open SEO audit")
                                    </a>
                                    <a class="btn" href="@($"/sites/{site.Id}/explorer")">
                                        @(L.IsArabic ? "مستكشف المحتوى" : "Content explorer")
                                    </a>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        }
    }
    else if (TryGetCanonicalDestination(out var destination))
    {
        <section class="panel empty-state" style="padding:24px" data-testid="module-canonical-destination">
            <h2>@(L.IsArabic ? "هذه الوحدة لها مساحة تشغيل حقيقية" : "This module has a real workspace")</h2>
            <p>@(L.IsArabic ? "تم إلغاء الشاشة التجريبية. استخدم مساحة التشغيل الفعلية المرتبطة بالخدمات والبيانات الحقيقية." : "The prototype screen has been removed. Use the real workspace connected to actual services and data.")</p>
            <a class="btn primary" href="@destination">@(L.IsArabic ? "فتح مساحة التشغيل" : "Open real workspace")</a>
        </section>
    }
    else
    {
        <section class="panel empty-state" style="padding:24px" data-testid="module-unavailable">
            <h2>@(L.IsArabic ? "هذه الوظيفة غير متاحة بعد" : "This capability is not available yet")</h2>
            <p>@(L.IsArabic ? "تمت إزالة البيانات والأزرار التجريبية. لن يعرض AIMWWeb نتائج أو إجراءات وهمية إلى أن يتم توصيل هذه الوظيفة بخدمة حقيقية واختبارها من المتصفح." : "Mock data and inert controls have been removed. AIMWWeb will not present fake results or actions until this capability is connected to a real service and browser-verified.")</p>
            <a class="btn" href="/">@(L.IsArabic ? "العودة للرئيسية" : "Back to home")</a>
        </section>
    }
</div>

@code {
    [Parameter] public string Key { get; set; } = "overview";

    private IReadOnlyList<AIWordPressManager.Domain.Entities.Site> _sites = [];
    private bool _loading;
    private string? _loadError;

    private string NormalizedKey => (Key ?? string.Empty).Trim().ToLowerInvariant();
    private bool IsSeoGateway => NormalizedKey is "seo-audit" or "seo-suggestions";

    private string Title => NormalizedKey switch
    {
        "seo-audit" => L.IsArabic ? "تدقيق SEO" : "SEO Audit",
        "seo-suggestions" => L.IsArabic ? "اقتراحات SEO" : "SEO Suggestions",
        "approvals" => L.IsArabic ? "قائمة الموافقات" : "Approval Queue",
        "ai-providers" => L.IsArabic ? "مزودو الذكاء الاصطناعي" : "AI Providers",
        "prompts" => L.IsArabic ? "قوالب الأوامر" : "Prompt Templates",
        _ => L.IsArabic ? "مساحة الوحدة" : "Module workspace"
    };

    private string Section => NormalizedKey switch
    {
        "seo-audit" or "seo-suggestions" => "SEO",
        "approvals" => L.IsArabic ? "سير العمل" : "Workflow",
        "ai-providers" or "prompts" => L.IsArabic ? "الذكاء الاصطناعي" : "AI",
        _ => L.IsArabic ? "النظام" : "System"
    };

    private string Icon => NormalizedKey switch
    {
        "seo-audit" => "◈",
        "seo-suggestions" => "✦",
        "approvals" => "✓",
        "ai-providers" => "✦",
        "prompts" => "⌘",
        _ => "◇"
    };

    private string Description => NormalizedKey switch
    {
        "seo-audit" => L.IsArabic ? "اختر موقعًا للوصول إلى التحليل الفعلي ونتائج التدقيق المحفوظة." : "Choose a site to access real analysis and persisted audit results.",
        "seo-suggestions" => L.IsArabic ? "اقتراحات التحسين تُستمد من نتائج SEO الفعلية لكل موقع، وليس من بيانات ثابتة." : "Improvement suggestions come from each site's real SEO results, never static sample data.",
        _ => L.IsArabic ? "يتم توجيه الوظائف المكتملة إلى مساحات التشغيل الحقيقية فقط." : "Completed capabilities are routed only to real operational workspaces."
    };

    protected override void OnInitialized() => L.Changed += OnLanguageChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (IsSeoGateway)
        {
            await LoadSitesAsync();
        }
        else
        {
            _sites = [];
            _loadError = null;
            _loading = false;
        }
    }

    private async Task LoadSitesAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _sites = await SiteService.GetSitesAsync();
        }
        catch
        {
            _sites = [];
            _loadError = L.IsArabic
                ? "حدث خطأ أثناء تحميل المواقع المملوكة لهذا الحساب. حاول مرة أخرى أو راجع الاتصال والصلاحيات."
                : "An error occurred while loading sites owned by this account. Retry or review connectivity and permissions.";
        }
        finally
        {
            _loading = false;
        }
    }

    private bool TryGetCanonicalDestination(out string destination)
    {
        destination = NormalizedKey switch
        {
            "approvals" => "/approvals",
            "ai-providers" => "/settings/ai-providers",
            "prompts" => "/settings/ai-prompts",
            _ => string.Empty
        };

        return destination.Length > 0;
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= OnLanguageChanged;
}
