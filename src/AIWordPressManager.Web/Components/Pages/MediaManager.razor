@page "/sites/{SiteId:guid}/media"
@rendermode InteractiveServer
@implements IDisposable
@inject SiteWebService SiteService
@inject WordPressSyncWebService SyncService
@inject WordPressMediaWebService MediaService
@inject CurrentUserContext CurrentUser
@inject IServiceProvider Services
@inject AppLanguageService L

<PageTitle>@L["MediaManager"]</PageTitle>

@if (_loading)
{
    <AppLoading Title="@L["LoadingMedia"]" Message="@(L.IsArabic ? "جارٍ تحميل مكتبة الوسائط المحلية." : "Loading the local media library.")" />
}
else if (_site is null)
{
    <AppEmptyState Icon="!" Title="@L["SiteNotFound"]" Description="@(L.IsArabic ? "تعذر العثور على الموقع المحدد." : "The selected site could not be found.")">
        <Actions><AppButton Href="/sites" Text="@L["BackToSites"]" /></Actions>
    </AppEmptyState>
}
else
{
    <div class="media-manager-workspace">
        <AppToolbar Eyebrow="@(L.IsArabic ? "مكتبة ووردبريس" : "WORDPRESS LIBRARY")"
                    Title="@L["MediaManager"]"
                    Subtitle="@($"{_site.Name} — {L["MediaManagerIntro"]}")">
            <Actions>
                <AppButton Icon="↻" Text="@L["Refresh"]" Busy="@_busy" Disabled="@_busy" OnClick="RefreshClickedAsync" />
                <AppButton Href="/module/media" Text="@(L.IsArabic ? "كل الوسائط" : "Global media")" />
                <AppButton Href="@($"/sites/{SiteId}/explorer")" Text="@L["BackToExplorer"]" />
            </Actions>
        </AppToolbar>

        @if (!CanEditContent)
        {
            <div class="alert" role="status"><strong>@(L.IsArabic ? "وضع القراءة فقط: تحتاج صلاحية Content.Edit لرفع الوسائط أو تعديل بياناتها أو حذفها." : "Read-only mode: Content.Edit permission is required to upload, optimize, or delete media.")</strong></div>
        }

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert @(_isError ? "error" : "success")"><strong>@_message</strong></div>
        }

        <section class="app-stat-grid">
            <AppStatCard Icon="▣" Label="@L["MediaLibrary"]" Value="@MediaItems.Count.ToString()" Description="@L["MediaCount"]" Tone="accent" />
            <AppStatCard Icon="▧" Label="@(L.IsArabic ? "الصور" : "Images")" Value="@ImageCount.ToString()" Description="@(L.IsArabic ? "عناصر صور" : "Image items")" Tone="success" />
            <AppStatCard Icon="≡" Label="@(L.IsArabic ? "الملفات" : "Files")" Value="@FileCount.ToString()" Description="@(L.IsArabic ? "مستندات وملفات أخرى" : "Documents and other files")" Tone="info" />
            <AppStatCard Icon="◷" Label="@(L.IsArabic ? "آخر تعديل" : "Last modified")" Value="@LatestModified" Description="@(L.IsArabic ? "بيانات المزامنة المحلية" : "Local synchronization data")" Tone="warning" ValueClass="summary-date" />
        </section>

        @if (CanEditContent)
        {
            <AppSection Eyebrow="@(L.IsArabic ? "رفع عدة ملفات" : "BATCH UPLOAD")"
                        Title="@(L.IsArabic ? "رفع وسائط متعددة" : "Upload multiple media files")"
                        Subtitle="@(L.IsArabic ? $"اختر حتى {WordPressMediaBatchUploadService.MaxBatchFiles} ملفًا. يتم التحقق من كل ملف قبل إرساله، ويمكن ضبط البيانات الوصفية لكل ملف بشكل مستقل." : $"Select up to {WordPressMediaBatchUploadService.MaxBatchFiles} files. Every file is validated before upload and has independent metadata.")">
                <ChildContent>
                    <div class="form-grid">
                        <label style="grid-column:1/-1">
                            <span>@L["ChooseFile"]</span>
                            <InputFile OnChange="OnFilesSelected" multiple accept=".jpg,.jpeg,.png,.gif,.webp,.avif,.pdf,.doc,.docx,.xls,.xlsx,.zip" />
                        </label>
                    </div>

                    @if (_uploadDrafts.Count > 0)
                    {
                        <div style="display:grid;gap:12px;margin-top:14px">
                            @foreach (var draft in _uploadDrafts)
                            {
                                <article @key="draft.Id" class="panel" style="padding:14px">
                                    <div style="display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap">
                                        <div>
                                            <strong>@draft.File.Name</strong>
                                            <small class="block-muted">@FormatSize(draft.File.Size) — @draft.File.ContentType</small>
                                        </div>
                                        <AppBadge Tone="@(draft.Validation.IsValid ? "success" : "danger")" Text="@(draft.Validation.IsValid ? (L.IsArabic ? "صالح" : "Valid") : (L.IsArabic ? "مرفوض" : "Rejected"))" />
                                    </div>
                                    @if (!draft.Validation.IsValid)
                                    {
                                        <small style="display:block;color:var(--danger,#dc2626);margin-top:8px">@L.TranslateMessage(draft.Validation.Message)</small>
                                    }
                                    else
                                    {
                                        <div class="form-grid" style="margin-top:12px">
                                            <label><span>@L["Title"]</span><InputText @bind-Value="draft.Title" disabled="@_busy" /></label>
                                            <label><span>@L["AltText"]</span><InputText @bind-Value="draft.AltText" disabled="@_busy" /></label>
                                            <label style="grid-column:1/-1"><span>@L["Caption"]</span><InputText @bind-Value="draft.Caption" disabled="@_busy" /></label>
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    }

                    @if (_batchProgress is not null)
                    {
                        <div class="panel" style="padding:12px;margin-top:14px" role="status">
                            <div style="display:flex;justify-content:space-between;gap:10px"><strong>@(L.IsArabic ? "تقدم الدفعة" : "Batch progress")</strong><span>@_batchProgress.Completed / @_batchProgress.Total (@_batchProgress.Percent%)</span></div>
                            <progress value="@_batchProgress.Completed" max="@_batchProgress.Total" style="width:100%;margin-top:8px"></progress>
                            <small class="block-muted">@_batchProgress.Item.OriginalFileName — @TranslateBatchState(_batchProgress.Item.State)</small>
                        </div>
                    }

                    @if (_lastBatchResult is not null)
                    {
                        <div class="panel" style="padding:12px;margin-top:14px">
                            <strong>@(L.IsArabic ? "نتيجة آخر دفعة" : "Last batch result")</strong>
                            <p style="margin:6px 0 10px">@_lastBatchResult.Message</p>
                            <div style="display:grid;gap:6px">
                                @foreach (var item in _lastBatchResult.Items)
                                {
                                    <small><strong>@item.OriginalFileName</strong> — @TranslateBatchState(item.State)@(!string.IsNullOrWhiteSpace(item.Message) ? $": {L.TranslateMessage(item.Message)}" : string.Empty)</small>
                                }
                            </div>
                        </div>
                    }

                    <div class="actions" style="margin-top:14px">
                        <AppButton Variant="primary" Icon="⇧"
                                   Text="@UploadButtonText"
                                   Busy="@_busy"
                                   Disabled="@(_busy || ValidUploadCount == 0)"
                                   OnClick="UploadBatchClickedAsync" />
                        @if (_uploadDrafts.Count > 0)
                        {
                            <AppButton Text="@L["Cancel"]" Disabled="@_busy" OnClick="ClearUploadSelectionClicked" />
                        }
                    </div>
                </ChildContent>
            </AppSection>
        }

        @if (_editing is not null && CanEditContent)
        {
            <AppSection Eyebrow="@(L.IsArabic ? "تحسين الوسائط" : "MEDIA OPTIMIZATION")"
                        Title="@(L.IsArabic ? $"تحسين #{_editing.MediaId}" : $"Optimize media #{_editing.MediaId}")"
                        Subtitle="@(L.IsArabic ? "حسّن العنوان وAlt Text والوصف والرابط المختصر بدون إعادة ضغط الملف الأصلي." : "Improve title, alt text, description, caption, and slug without recompressing the original binary.")">
                <ChildContent>
                    <div style="display:grid;grid-template-columns:minmax(180px,280px) minmax(0,1fr);gap:20px;align-items:start">
                        <div>
                            <div class="media-preview" style="min-height:180px">
                                @if (IsEditingImage)
                                {
                                    <img src="@_editing.SourceUrl" alt="@_editAltText" loading="lazy" />
                                }
                                else
                                {
                                    <span>@L["File"]</span>
                                }
                            </div>
                            <div style="display:grid;gap:7px;margin-top:12px;font-size:.86rem;opacity:.78">
                                <span>@_editing.MimeType</span>
                                @if (_editing.Width.HasValue && _editing.Height.HasValue)
                                {
                                    <span>@_editing.Width × @_editing.Height px</span>
                                }
                                @if (_editing.FileSize.HasValue)
                                {
                                    <span>@FormatSize(_editing.FileSize.Value)</span>
                                }
                                <span>@(L.IsArabic ? "جودة البيانات الوصفية" : "Metadata quality"): <strong>@OptimizationScore/100</strong></span>
                            </div>
                        </div>

                        <div>
                            <div class="form-grid">
                                <label><span>@L["Title"]</span><InputText @bind-Value="_editTitle" /></label>
                                <label><span>@(L.IsArabic ? "الرابط المختصر" : "Slug")</span><InputText @bind-Value="_editSlug" dir="ltr" /></label>
                                <label style="grid-column:1/-1"><span>@L["AltText"]</span><InputText @bind-Value="_editAltText" /></label>
                                <label style="grid-column:1/-1"><span>@L["Caption"]</span><InputTextArea @bind-Value="_editCaption" /></label>
                                <label style="grid-column:1/-1"><span>@(L.IsArabic ? "الوصف" : "Description")</span><InputTextArea @bind-Value="_editDescription" /></label>
                            </div>

                            @if (IsEditingImage)
                            {
                                <div class="panel" style="padding:14px;margin-top:14px">
                                    <strong>@(L.IsArabic ? "اقتراح Alt Text بالذكاء الاصطناعي" : "AI alt-text suggestion")</strong>
                                    <p style="margin:6px 0 10px;opacity:.72;font-size:.88rem">@(L.IsArabic ? "اكتب سياق الصورة أو الغرض منها، ثم راجع الاقتراح قبل الحفظ." : "Describe the image context or purpose, then review the suggestion before saving.")</p>
                                    <InputTextArea @bind-Value="_aiContext" placeholder="@(L.IsArabic ? "مثال: صورة رئيسية لمقال عن تحسين سرعة WordPress" : "Example: Hero image for an article about WordPress performance")" />
                                    <div class="actions" style="margin-top:10px">
                                        <AppButton Icon="✦" Text="@(L.IsArabic ? "اقتراح Alt Text" : "Suggest alt text")" Busy="@_aiBusy" Disabled="@(_busy || _aiBusy || string.IsNullOrWhiteSpace(_aiContext))" OnClick="SuggestAltClickedAsync" />
                                    </div>
                                </div>
                            }

                            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px;margin-top:14px">
                                @OptimizationCheck(!string.IsNullOrWhiteSpace(_editTitle), L.IsArabic ? "عنوان واضح" : "Clear title")
                                @OptimizationCheck(!string.IsNullOrWhiteSpace(_editSlug), L.IsArabic ? "رابط مختصر" : "Slug")
                                @OptimizationCheck(!IsEditingImage || !string.IsNullOrWhiteSpace(_editAltText), L.IsArabic ? "Alt Text للصورة" : "Image alt text")
                                @OptimizationCheck(!string.IsNullOrWhiteSpace(_editDescription), L.IsArabic ? "وصف" : "Description")
                            </div>

                            <div class="actions" style="margin-top:16px">
                                <AppButton Variant="primary" Icon="✓" Text="@(L.IsArabic ? "حفظ التحسينات" : "Save optimization")" Busy="@_busy" Disabled="@(_busy || string.IsNullOrWhiteSpace(_editTitle))" OnClick="SaveOptimizationClickedAsync" />
                                <AppButton Text="@L["Cancel"]" Disabled="@_busy" OnClick="CancelOptimizationClickedAsync" />
                                <AppButton Href="@_editing.SourceUrl" Text="@L["OpenFile"]" Size="small" />
                            </div>
                        </div>
                    </div>
                </ChildContent>
            </AppSection>
        }

        <AppDataGrid TItem="MediaExplorerItem"
                     Items="@MediaItems"
                     KeySelector="@(item => item.WordPressId.ToString())"
                     SearchKeySelector="@(item => $"{DisplayTitle(item.Title)} {item.MimeType} {item.MediaType} {item.SourceUrl}")"
                     SortKeySelector="@(item => DisplayTitle(item.Title))"
                     CsvHeaders="@CsvHeaders"
                     CsvRowSelector="@(item => new[] { item.WordPressId.ToString(), DisplayTitle(item.Title), item.MediaType, item.MimeType, item.SourceUrl, FormatDate(item.ModifiedAtUtc) })"
                     CsvFileName="@CsvFileName"
                     PageSize="10"
                     Selectable="@CanEditContent"
                     Loading="@_busy"
                     LoadingTitle="@(L.IsArabic ? "جارٍ تحديث الوسائط" : "Updating media")"
                     EmptyTitle="@L["NoMedia"]"
                     EmptyDescription="@L["NoMediaHelp"]"
                     SearchPlaceholder="@L["SearchMedia"]"
                     SearchAriaLabel="@L["SearchMedia"]"
                     SortText="@(L.IsArabic ? "ترتيب بالعنوان" : "Sort by title")"
                     ExportText="@(L.IsArabic ? "تصدير CSV" : "Export CSV")"
                     RowsPerPageText="@(L.IsArabic ? "صفوف" : "Rows")"
                     SelectedText="@(L.IsArabic ? "محدد" : "selected")"
                     ShowingText="@(L.IsArabic ? "عرض" : "Showing")"
                     OfText="@(L.IsArabic ? "من" : "of")">
            <Toolbar>
                <div>
                    <strong>@L["MediaLibrary"]</strong>
                    <small class="block-muted">@string.Format(L["MediaCount"], MediaItems.Count)</small>
                </div>
                <AppBadge Tone="info" Text="@MediaItems.Count.ToString()" />
            </Toolbar>
            <Header>
                <th>@(L.IsArabic ? "المعاينة" : "Preview")</th>
                <th>@L["Title"]</th>
                <th>@(L.IsArabic ? "النوع" : "Type")</th>
                <th>@(L.IsArabic ? "آخر تعديل" : "Modified")</th>
                <th>@L["Actions"]</th>
            </Header>
            <RowTemplate Context="item">
                <td>
                    <div class="media-preview media-preview--compact">
                        @if (item.MediaType == "image")
                        {
                            <img src="@item.SourceUrl" alt="@DisplayTitle(item.Title)" loading="lazy" />
                        }
                        else
                        {
                            <span>@L["File"]</span>
                        }
                    </div>
                </td>
                <td><strong>@DisplayTitle(item.Title)</strong><small class="block-muted">#@item.WordPressId</small></td>
                <td><AppBadge Tone="@(item.MediaType == "image" ? "success" : "info")" Text="@item.MimeType" /></td>
                <td>@FormatDate(item.ModifiedAtUtc)</td>
                <td>
                    <div class="table-actions">
                        @if (CanEditContent)
                        {
                            <AppButton Variant="primary" Icon="✦" Text="@(L.IsArabic ? "تحسين" : "Optimize")" Size="small" Disabled="@_busy" OnClick="args => OpenOptimizationAsync(item)" />
                        }
                        <AppButton Href="@item.SourceUrl" Text="@L["OpenFile"]" Size="small" />
                        @if (CanEditContent)
                        {
                            <AppButton Variant="danger" Icon="⌫" Text="@L["Delete"]" Size="small" Disabled="@_busy" OnClick="args => RequestDeleteAsync(item.WordPressId, item.Title)" />
                        }
                    </div>
                </td>
            </RowTemplate>
        </AppDataGrid>
    </div>

    @if (CanEditContent)
    {
        <AppConfirmDialog @bind-Open="_deleteConfirmOpen"
                          Title="@(L.IsArabic ? "حذف الوسيط نهائيًا؟" : "Permanently delete media?")"
                          Message="@(L.IsArabic ? $"سيتم حذف «{DisplayTitle(_pendingDeleteTitle)}» من WordPress نهائيًا." : $"“{DisplayTitle(_pendingDeleteTitle)}” will be permanently deleted from WordPress.")"
                          Details="@(L.IsArabic ? "هذه العملية تستخدم force=true ولا يمكن استعادتها من سلة مهملات WordPress. قد تتأثر الصفحات التي تستخدم هذا الملف." : "This operation uses force=true and cannot be restored from the WordPress trash. Pages that reference this file may be affected.")"
                          ConfirmText="@(L.IsArabic ? "حذف نهائي" : "Delete permanently")"
                          CancelText="@L["Cancel"]"
                          Busy="@_busy"
                          OnConfirm="ConfirmDeleteAsync" />
    }
}

@code {
    [Parameter] public Guid SiteId { get; set; }
    private AIWordPressManager.Domain.Entities.Site? _site;
    private ContentExplorerView? _data;
    private readonly List<MediaUploadDraft> _uploadDrafts = [];
    private MediaBatchUploadProgress? _batchProgress;
    private MediaBatchUploadResult? _lastBatchResult;
    private WordPressMediaBatchUploadService? _batchUploadService;
    private string? _message;
    private bool _loading = true, _busy, _aiBusy, _isError;

    private MediaEditableDetails? _editing;
    private string _editTitle = string.Empty, _editSlug = string.Empty, _editAltText = string.Empty, _editCaption = string.Empty, _editDescription = string.Empty, _aiContext = string.Empty;
    private bool _deleteConfirmOpen;
    private int _pendingDeleteId;
    private string _pendingDeleteTitle = string.Empty;

    private WordPressMediaBatchUploadService BatchUploadService =>
        _batchUploadService ??= Microsoft.Extensions.DependencyInjection.ActivatorUtilities.CreateInstance<WordPressMediaBatchUploadService>(Services);
    private bool CanEditContent => CurrentUser.HasPermission(ApplicationPermissionCatalog.ContentEdit);
    private IReadOnlyList<MediaExplorerItem> MediaItems => (_data?.Media ?? Array.Empty<MediaExplorerItem>()).ToList();
    private int ImageCount => MediaItems.Count(x => x.MediaType == "image");
    private int FileCount => MediaItems.Count - ImageCount;
    private int ValidUploadCount => _uploadDrafts.Count(x => x.Validation.IsValid);
    private string UploadButtonText => _busy
        ? L["Uploading"]
        : L.IsArabic
            ? $"رفع {ValidUploadCount} ملف صالح"
            : $"Upload {ValidUploadCount} valid file(s)";
    private string LatestModified => MediaItems.Where(x => x.ModifiedAtUtc.HasValue).OrderByDescending(x => x.ModifiedAtUtc).Select(x => FormatDate(x.ModifiedAtUtc)).FirstOrDefault() ?? L["Unknown"];
    private IReadOnlyList<string> CsvHeaders => L.IsArabic
        ? new[] { "المعرف", "العنوان", "نوع الوسائط", "نوع MIME", "الرابط", "آخر تعديل" }
        : new[] { "Id", "Title", "Media type", "MIME type", "URL", "Modified" };
    private string CsvFileName => $"media-{SiteId:N}-{DateTime.Now:yyyyMMdd-HHmmss}.csv";
    private bool IsEditingImage => _editing is not null && (_editing.MediaType.Equals("image", StringComparison.OrdinalIgnoreCase) || _editing.MimeType.StartsWith("image/", StringComparison.OrdinalIgnoreCase));
    private int OptimizationScore => _editing is null ? 0
        : (!string.IsNullOrWhiteSpace(_editTitle) ? 25 : 0)
        + (!string.IsNullOrWhiteSpace(_editSlug) ? 15 : 0)
        + (!IsEditingImage || !string.IsNullOrWhiteSpace(_editAltText) ? 35 : 0)
        + (!string.IsNullOrWhiteSpace(_editCaption) ? 10 : 0)
        + (!string.IsNullOrWhiteSpace(_editDescription) ? 15 : 0);

    protected override void OnInitialized() => L.Changed += Changed;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _site = await SiteService.GetSiteAsync(SiteId);
        if (_site is not null) _data = await SyncService.GetExplorerAsync(SiteId);
        _loading = false;
    }

    private void OnFilesSelected(InputFileChangeEventArgs args)
    {
        if (!CanEditContent || _busy) return;
        try
        {
            var files = args.GetMultipleFiles(WordPressMediaBatchUploadService.MaxBatchFiles);
            _uploadDrafts.Clear();
            foreach (var file in files)
            {
                var validation = MediaUploadPolicy.Validate(file.Name, file.Size, file.ContentType);
                _uploadDrafts.Add(new MediaUploadDraft(
                    file,
                    Path.GetFileNameWithoutExtension(file.Name),
                    string.Empty,
                    string.Empty,
                    validation));
            }

            _lastBatchResult = null;
            _batchProgress = null;
            _isError = _uploadDrafts.Count > 0 && ValidUploadCount == 0;
            _message = _isError
                ? (L.IsArabic ? "كل الملفات المحددة مرفوضة بواسطة سياسة الرفع." : "Every selected file was rejected by the upload policy.")
                : null;
        }
        catch (InvalidOperationException ex)
        {
            _uploadDrafts.Clear();
            _isError = true;
            _message = L.IsArabic
                ? $"اختر بحد أقصى {WordPressMediaBatchUploadService.MaxBatchFiles} ملفًا في الدفعة الواحدة."
                : $"Select at most {WordPressMediaBatchUploadService.MaxBatchFiles} files per batch.";
            _batchProgress = null;
            _lastBatchResult = null;
            _ = ex;
        }
    }

    private Task UploadBatchClickedAsync(MouseEventArgs _) => UploadBatchAsync();
    private Task ClearUploadSelectionClicked(MouseEventArgs _)
    {
        if (!_busy) _uploadDrafts.Clear();
        _batchProgress = null;
        return Task.CompletedTask;
    }
    private Task RefreshClickedAsync(MouseEventArgs _) => RefreshAsync();
    private Task SaveOptimizationClickedAsync(MouseEventArgs _) => SaveOptimizationAsync();
    private Task SuggestAltClickedAsync(MouseEventArgs _) => SuggestAltAsync();
    private Task CancelOptimizationClickedAsync(MouseEventArgs _) { ClearOptimization(); return Task.CompletedTask; }

    private async Task UploadBatchAsync()
    {
        if (_uploadDrafts.Count == 0 || ValidUploadCount == 0) return;
        try
        {
            CurrentUser.RequirePermission(ApplicationPermissionCatalog.ContentEdit);
            _busy = true;
            _isError = false;
            _message = null;
            _batchProgress = null;
            _lastBatchResult = null;

            var items = _uploadDrafts
                .Select(x => new MediaBatchUploadItem(x.File, x.Title, x.AltText, x.Caption))
                .ToArray();
            var result = await BatchUploadService.UploadAsync(
                SiteId,
                items,
                progress => InvokeAsync(() =>
                {
                    _batchProgress = progress;
                    StateHasChanged();
                }));

            _lastBatchResult = result;
            _isError = result.Succeeded == 0;
            _message = result.Message;
            if (result.Succeeded > 0)
                await RefreshLocalAsync();

            _uploadDrafts.Clear();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = L.TranslateMessage(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenOptimizationAsync(MediaExplorerItem item)
    {
        try
        {
            CurrentUser.RequirePermission(ApplicationPermissionCatalog.ContentEdit);
            _busy = true; _isError = false; _message = null;
            var result = await MediaService.GetDetailsAsync(SiteId, item.WordPressId);
            if (!result.IsSuccess || result.Details is null)
            {
                _isError = true; _message = L.TranslateMessage(result.Message); return;
            }

            _editing = result.Details;
            _editTitle = result.Details.Title;
            _editSlug = result.Details.Slug;
            _editAltText = result.Details.AltText;
            _editCaption = PlainText(result.Details.Caption);
            _editDescription = PlainText(result.Details.Description);
            _aiContext = string.Join(". ", new[] { _editTitle, _editCaption, _editDescription }.Where(x => !string.IsNullOrWhiteSpace(x)));
        }
        catch (Exception ex) { _isError = true; _message = L.TranslateMessage(ex.Message); }
        finally { _busy = false; }
    }

    private async Task SaveOptimizationAsync()
    {
        if (_editing is null) return;
        try
        {
            CurrentUser.RequirePermission(ApplicationPermissionCatalog.ContentEdit);
            _busy = true; _isError = false; _message = null;
            var request = new MediaMetadataUpdate(
                _editTitle, _editAltText, _editCaption, _editDescription, _editSlug,
                _editing.ModifiedGmt);
            var result = await MediaService.UpdateMetadataAsync(SiteId, _editing.MediaId, request);
            _isError = !result.IsSuccess;
            _message = L.TranslateMessage(result.Message);
            if (result.IsSuccess)
            {
                await RefreshLocalAsync();
                ClearOptimization();
            }
        }
        catch (Exception ex) { _isError = true; _message = L.TranslateMessage(ex.Message); }
        finally { _busy = false; }
    }

    private async Task SuggestAltAsync()
    {
        if (_editing is null || !IsEditingImage || string.IsNullOrWhiteSpace(_aiContext)) return;
        try
        {
            CurrentUser.RequirePermission(ApplicationPermissionCatalog.ContentEdit);
            _aiBusy = true; _isError = false; _message = null;
            _editAltText = await MediaService.SuggestAltTextAsync(
                SiteId,
                _editing.MediaId,
                _aiContext,
                L.IsArabic ? "ar" : "en",
                null);
            _message = L.IsArabic ? "تم إنشاء اقتراح Alt Text. راجعه ثم احفظ التحسينات." : "Alt-text suggestion generated. Review it, then save the optimization.";
        }
        catch (Exception ex) { _isError = true; _message = L.TranslateMessage(ex.Message); }
        finally { _aiBusy = false; }
    }

    private Task RequestDeleteAsync(int mediaId, string title)
    {
        CurrentUser.RequirePermission(ApplicationPermissionCatalog.ContentEdit);
        _pendingDeleteId = mediaId;
        _pendingDeleteTitle = title;
        _deleteConfirmOpen = true;
        return Task.CompletedTask;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_pendingDeleteId <= 0) { _deleteConfirmOpen = false; return; }
        try
        {
            CurrentUser.RequirePermission(ApplicationPermissionCatalog.ContentEdit);
            _busy = true; _isError = false; _message = null;
            var deletedId = _pendingDeleteId;
            var result = await MediaService.DeleteAsync(SiteId, deletedId);
            _isError = !result.IsSuccess;
            _message = L.TranslateMessage(result.Message);
            if (result.IsSuccess)
            {
                if (_editing?.MediaId == deletedId) ClearOptimization();
                await RefreshLocalAsync();
                _deleteConfirmOpen = false;
                _pendingDeleteId = 0;
                _pendingDeleteTitle = string.Empty;
            }
        }
        catch (Exception ex) { _isError = true; _message = L.TranslateMessage(ex.Message); }
        finally { _busy = false; }
    }

    private async Task RefreshAsync()
    {
        try
        {
            _busy = true;
            var result = await SyncService.SynchronizeAsync(SiteId);
            _isError = !result.IsSuccess;
            _message = L.TranslateMessage(result.Message);
            _data = await SyncService.GetExplorerAsync(SiteId);
        }
        catch (Exception ex) { _isError = true; _message = L.TranslateMessage(ex.Message); }
        finally { _busy = false; }
    }

    private async Task RefreshLocalAsync()
    {
        await SyncService.SynchronizeAsync(SiteId);
        _data = await SyncService.GetExplorerAsync(SiteId);
    }

    private void ClearOptimization()
    {
        _editing = null;
        _editTitle = _editSlug = _editAltText = _editCaption = _editDescription = _aiContext = string.Empty;
    }

    private RenderFragment OptimizationCheck(bool ok, string text) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", ok ? "badge success" : "badge warning");
        builder.AddContent(2, $"{(ok ? "✓" : "!")} {text}");
        builder.CloseElement();
    };

    private string TranslateBatchState(MediaBatchUploadState state) => L.IsArabic
        ? state switch
        {
            MediaBatchUploadState.Succeeded => "نجح",
            MediaBatchUploadState.Failed => "فشل",
            MediaBatchUploadState.Rejected => "مرفوض",
            _ => state.ToString()
        }
        : state switch
        {
            MediaBatchUploadState.Succeeded => "Succeeded",
            MediaBatchUploadState.Failed => "Failed",
            MediaBatchUploadState.Rejected => "Rejected",
            _ => state.ToString()
        };

    private string DisplayTitle(string value) => string.IsNullOrWhiteSpace(value) ? L["UntitledMedia"] : value;
    private string FormatDate(DateTimeOffset? value) => value.HasValue ? value.Value.ToLocalTime().ToString(L.IsArabic ? "dd/MM/yyyy HH:mm" : "MMM d, yyyy HH:mm") : L["Unknown"];
    private static string FormatSize(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.##} MB" : $"{bytes / 1024d:0.##} KB";
    private static string PlainText(string value) => System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(value ?? string.Empty, "<[^>]+>", string.Empty)).Trim();
    private void Changed() => InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= Changed;

    private sealed class MediaUploadDraft(
        IBrowserFile file,
        string title,
        string altText,
        string caption,
        MediaUploadValidation validation)
    {
        public Guid Id { get; } = Guid.NewGuid();
        public IBrowserFile File { get; } = file;
        public string Title { get; set; } = title;
        public string AltText { get; set; } = altText;
        public string Caption { get; set; } = caption;
        public MediaUploadValidation Validation { get; } = validation;
    }
