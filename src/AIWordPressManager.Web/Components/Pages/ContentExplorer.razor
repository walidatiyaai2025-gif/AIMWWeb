@page "/sites/{Id:guid}/explorer"
@rendermode InteractiveServer
@implements IDisposable
@inject SiteWebService SiteService
@inject WordPressSyncWebService SyncService
@inject IWordPressPostEditorService EditorService
@inject AppLanguageService L
<PageTitle>@L["WordPressExplorer"]</PageTitle>

@if (_loading)
{
    <div class="explorer-loading"><div class="explorer-skeleton hero"></div><div class="explorer-skeleton-grid">@for (var i = 0; i < 4; i++) { <div class="explorer-skeleton"></div> }</div></div>
}
else if (_site is null)
{
    <div class="empty-state"><h1>@L["SiteNotFound"]</h1><a class="btn" href="/sites">@L["BackToSites"]</a></div>
}
else
{
    <div class="content-explorer-page">
        <section class="explorer-hero panel"><div><span class="workspace-kicker">@(L.IsArabic ? "مركز إدارة المحتوى" : "CONTENT OPERATIONS")</span><h1>@L["WordPressExplorer"]</h1><p><strong>@_site.Name</strong> · @L["ExplorerIntro"]</p></div><div class="explorer-hero-actions"><a class="btn" href="@($"/sites/{Id}")">← @L["SiteDetailsButton"]</a><button class="btn primary" @onclick="SynchronizeAsync" disabled="@(_syncing || _bulkRunning)">@(_syncing ? L["Syncing"] : $"↻ {L["SyncNow"]}")</button></div></section>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert @(_isError ? "error" : "success")"><strong>@_message</strong></div>
        }

        <section class="explorer-summary-grid">
            <article class="panel explorer-summary-card"><span>▤</span><div><small>@L["Posts"]</small><strong>@(_data?.Totals.Posts ?? 0)</strong><p>@(L.IsArabic ? "مقال محفوظ محليًا" : "Locally cached posts")</p></div></article>
            <article class="panel explorer-summary-card"><span>▧</span><div><small>@L["Pages"]</small><strong>@(_data?.Totals.Pages ?? 0)</strong><p>@(L.IsArabic ? "صفحة ثابتة" : "Static pages")</p></div></article>
            <article class="panel explorer-summary-card"><span>#</span><div><small>@L["CategoriesTags"]</small><strong>@((_data?.Totals.Categories ?? 0) + (_data?.Totals.Tags ?? 0))</strong><p>@(_data?.Totals.Categories ?? 0) @L["Category"] · @(_data?.Totals.Tags ?? 0) @L["Tag"]</p></div></article>
            <article class="panel explorer-summary-card"><span>▣</span><div><small>@L["Media"]</small><strong>@(_data?.Totals.Media ?? 0)</strong><p>@L["LastSync"]: @FormatDate(_data?.LastSynchronizedAtUtc)</p></div></article>
        </section>

        <section class="explorer-nav panel">
            <button class="explorer-tab @Active("content")" @onclick="SetContentTab">▤ @L["Content"]</button>
            <button class="explorer-tab @Active("categories")" @onclick="SetCategoriesTab"># @L["Categories"]</button>
            <button class="explorer-tab @Active("tags")" @onclick="SetTagsTab">⌗ @L["Tags"]</button>
            <button class="explorer-tab @Active("media")" @onclick="SetMediaTab">▣ @L["Media"]</button>
            <span class="explorer-nav-spacer"></span>
            <a class="explorer-shortcut" href="@($"/sites/{Id}/taxonomy")">@(L.IsArabic ? "إدارة التصنيفات" : "Manage taxonomy")</a>
            <a class="explorer-shortcut" href="@($"/sites/{Id}/seo")">SEO</a>
        </section>

        @if (_tab == "content")
        {
            <section class="explorer-toolbar panel"><div class="explorer-search"><span>⌕</span><InputText @bind-Value="_query" @bind-Value:event="oninput" placeholder="@L["SearchPlaceholder"]" /></div><select @bind="_type"><option value="all">@L["All"]</option><option value="post">@L["Posts"]</option><option value="page">@L["Pages"]</option></select><select @bind="_status"><option value="all">@(L.IsArabic ? "كل الحالات" : "All statuses")</option><option value="publish">@(L.IsArabic ? "منشور" : "Published")</option><option value="draft">@(L.IsArabic ? "مسودة" : "Draft")</option><option value="pending">@(L.IsArabic ? "قيد المراجعة" : "Pending")</option><option value="future">@(L.IsArabic ? "مجدول" : "Scheduled")</option></select><button class="btn" @onclick="ApplyFiltersAsync">@L["Search"]</button></section>
            @if (_selected.Count > 0)
            {
                <section class="bulk-action-bar panel">
                    <strong>@(L.IsArabic ? $"تم تحديد {_selected.Count} عنصر" : $"{_selected.Count} items selected")</strong>
                    <button class="btn" disabled="@_bulkRunning" @onclick="BulkPendingAsync">@(_bulkRunning ? (L.IsArabic ? "جارٍ التنفيذ..." : "Working...") : (L.IsArabic ? "إرسال للمراجعة" : "Send for review"))</button>
                    <button class="btn primary" disabled="@_bulkRunning" @onclick="BulkPublishAsync">@(L.IsArabic ? "نشر" : "Publish")</button>
                    <button class="btn" disabled="@_bulkRunning" @onclick="BulkDraftAsync">@(L.IsArabic ? "تحويل لمسودة" : "Move to draft")</button>
                    <button class="icon-button" disabled="@_bulkRunning" @onclick="ClearSelection">×</button>
                </section>
            }
        }

        @if (_data is null || (_data.Content.Count == 0 && _data.Categories.Count == 0 && _data.Tags.Count == 0 && _data.Media.Count == 0))
        {
            <div class="panel empty-state"><h3>@L["NoLocalData"]</h3><p>@L["SyncPrompt"]</p><button class="btn primary" @onclick="SynchronizeAsync">@L["SyncNow"]</button></div>
        }
        else if (_tab == "content")
        {
            <section class="panel explorer-table-panel"><div class="explorer-table-head"><span><input type="checkbox" checked="@AllPageSelected" @onchange="TogglePageSelection" /></span><span>@L["Title"]</span><span>@L["Type"]</span><span>@L["Status"]</span><span>@L["LastModified"]</span><span>@L["Actions"]</span></div>
                @foreach (var item in PagedContent)
                {
                    var key = ContentKey(item);
                    <article class="explorer-table-row @(_selected.Contains(key) ? "selected" : "")"><span><input type="checkbox" checked="@_selected.Contains(key)" @onchange="e => ToggleItem(key, e)" /></span><div class="content-title-cell"><strong>@PlainText(item.Title)</strong><small>/@item.Slug</small></div><span class="content-type-pill">@(item.ContentType == "post" ? L["Post"] : L["Page"])</span><span class="badge @(item.Status == "publish" ? "success" : item.Status == "draft" ? "warning" : "")">@TranslateStatus(item.Status)</span><time>@FormatDate(item.ModifiedAtUtc)</time><div class="table-actions"><a class="btn compact primary" href="@($"/sites/{Id}/content/{item.ContentType}/{item.WordPressId}/edit")">@L["Edit"]</a>@if (!string.IsNullOrWhiteSpace(item.Link)) { <a class="btn compact" href="@item.Link" target="_blank">↗</a> }</div></article>
                }
                <footer class="explorer-pagination"><span>@(L.IsArabic ? $"صفحة {_page} من {TotalPages}" : $"Page {_page} of {TotalPages}")</span><div><button class="btn compact" disabled="@(_page <= 1)" @onclick="PreviousPage">@(L.IsArabic ? "السابق" : "Previous")</button><button class="btn compact" disabled="@(_page >= TotalPages)" @onclick="NextPage">@(L.IsArabic ? "التالي" : "Next")</button></div></footer></section>
        }
        else if (_tab is "categories" or "tags")
        {
            var terms = _tab == "categories" ? _data.Categories : _data.Tags;
            <section class="taxonomy-card-grid">@foreach (var item in terms) { <article class="panel taxonomy-card"><span class="taxonomy-icon">#</span><div><h3>@item.Name</h3><code>@item.Slug</code></div><strong>@item.Count</strong><small>@L["PostCount"]</small></article> }</section>
        }
        else
        {
            <section class="explorer-media-grid">@foreach (var item in _data.Media) { <article class="panel explorer-media-card"><div class="explorer-media-preview">@if (item.MediaType == "image") { <img src="@item.SourceUrl" alt="@PlainText(item.Title)" loading="lazy" /> } else { <span>FILE</span> }</div><div class="explorer-media-info"><strong>@PlainText(item.Title)</strong><small>@item.MimeType</small><a class="btn compact" href="@item.SourceUrl" target="_blank">@L["OpenFile"] ↗</a></div></article> }</section>
        }
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private AIWordPressManager.Domain.Entities.Site? _site;
    private ContentExplorerView? _data;
    private bool _loading = true, _syncing, _bulkRunning, _isError;
    private string _tab = "content", _type = "all", _status = "all", _query = "";
    private string? _message;
    private readonly HashSet<string> _selected = [];
    private int _page = 1;
    private const int PageSize = 10;

    private IEnumerable<ContentExplorerItem> FilteredContent => (_data?.Content ?? Array.Empty<ContentExplorerItem>()).Where(x => _status == "all" || x.Status == _status);
    private IEnumerable<ContentExplorerItem> PagedContent => FilteredContent.Skip((_page - 1) * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredContent.Count() / (double)PageSize));
    private bool AllPageSelected => PagedContent.Any() && PagedContent.All(x => _selected.Contains(ContentKey(x)));

    protected override void OnInitialized() => L.Changed += Changed;
    protected override async Task OnParametersSetAsync() { _loading = true; _site = await SiteService.GetSiteAsync(Id); await ReloadDataAsync(); _loading = false; }

    private async Task SynchronizeAsync()
    {
        try { _syncing = true; _isError = false; var result = await SyncService.SynchronizeAsync(Id); _message = L.TranslateMessage(result.Message); await ReloadDataAsync(); }
        catch (Exception ex) { _isError = true; _message = L.TranslateMessage(ex.Message); }
        finally { _syncing = false; }
    }

    private async Task ExecuteBulkStatusAsync(string status)
    {
        if (_data is null || _selected.Count == 0) return;
        try
        {
            _bulkRunning = true; _isError = false; _message = null;
            var targets = _data.Content.Where(x => _selected.Contains(ContentKey(x))).ToList();
            var succeeded = 0;
            var failed = new List<string>();

            foreach (var item in targets)
            {
                var current = await EditorService.GetAsync(Id, item.ContentType, item.WordPressId);
                if (current.IsFailure)
                {
                    failed.Add($"{PlainText(item.Title)}: {current.Error.Message}");
                    continue;
                }

                var value = current.Value;
                var request = new WordPressContentUpdateRequest(
                    value.ContentType, value.Id, value.Title, value.Slug, status, value.Content, value.Excerpt,
                    value.DateGmt, value.FeaturedMediaId, value.CategoryIds, value.TagIds, value.Template,
                    value.CommentStatus, value.PingStatus, value.Format, value.Sticky);
                var result = await EditorService.UpdateAsync(Id, request);
                if (result.IsSuccess) succeeded++;
                else failed.Add($"{PlainText(item.Title)}: {result.Error.Message}");
            }

            await SyncService.SynchronizeAsync(Id);
            await ReloadDataAsync();
            _isError = failed.Count > 0;
            _message = L.IsArabic
                ? $"تم تحديث {succeeded} عنصر بنجاح" + (failed.Count > 0 ? $"، وفشل {failed.Count}: {string.Join(" | ", failed.Take(3))}" : ".")
                : $"Updated {succeeded} item(s) successfully" + (failed.Count > 0 ? $"; {failed.Count} failed: {string.Join(" | ", failed.Take(3))}" : ".");
        }
        catch (Exception ex) { _isError = true; _message = L.TranslateMessage(ex.Message); }
        finally { _bulkRunning = false; }
    }

    private Task BulkPendingAsync() => ExecuteBulkStatusAsync("pending");
    private Task BulkPublishAsync() => ExecuteBulkStatusAsync("publish");
    private Task BulkDraftAsync() => ExecuteBulkStatusAsync("draft");
    private async Task ReloadDataAsync() { _data = await SyncService.GetExplorerAsync(Id, _query, _type); _page = 1; _selected.Clear(); }
    private async Task ApplyFiltersAsync() => await ReloadDataAsync();
    private void SetTab(string tab) { _tab = tab; _selected.Clear(); }
    private void SetContentTab() => SetTab("content");
    private void SetCategoriesTab() => SetTab("categories");
    private void SetTagsTab() => SetTab("tags");
    private void SetMediaTab() => SetTab("media");
    private string Active(string tab) => _tab == tab ? "active" : "";
    private void PreviousPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < TotalPages) _page++; }
    private void ClearSelection() => _selected.Clear();
    private static string ContentKey(ContentExplorerItem item) => $"{item.ContentType}:{item.WordPressId}";
    private void ToggleItem(string key, ChangeEventArgs e) { if (e.Value is bool selected && selected) _selected.Add(key); else _selected.Remove(key); }
    private void TogglePageSelection(ChangeEventArgs e) { var selected = e.Value is bool value && value; foreach (var item in PagedContent) { var key = ContentKey(item); if (selected) _selected.Add(key); else _selected.Remove(key); } }
    private string FormatDate(DateTime? value) => value is null ? "—" : value.Value.ToLocalTime().ToString(L.IsArabic ? "yyyy-MM-dd HH:mm" : "MMM d, yyyy HH:mm");
    private string TranslateStatus(string status) => L.IsArabic ? status switch { "publish" => "منشور", "draft" => "مسودة", "pending" => "قيد المراجعة", "private" => "خاص", "future" => "مجدول", _ => status } : status switch { "publish" => "Published", "draft" => "Draft", "pending" => "Pending Review", "private" => "Private", "future" => "Scheduled", _ => status };
    private static string PlainText(string value) => System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(value ?? "", "<.*?>", ""));
    private void Changed() => InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= Changed;
}
