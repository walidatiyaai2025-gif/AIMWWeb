@page "/ai-center"
@rendermode InteractiveServer
@implements IDisposable
@using System.Text.Json
@using AIWordPressManager.Application.AI
@using AIWordPressManager.Application.Abstractions.AI
@using AIWordPressManager.Domain.Entities
@inject IAIOrchestrator Orchestrator
@inject IAIPromptRegistry PromptRegistry
@inject IAIUsageLog UsageLog
@inject SiteWebService SiteService
@inject ApprovalWorkflowService ApprovalService
@inject CurrentUserContext CurrentUser
@inject AppLanguageService L
@inject AppNotificationService Notifications
@inject IJSRuntime JS

<PageTitle>@(L.IsArabic ? "مركز الذكاء الاصطناعي" : "AI Center")</PageTitle>

<AppPage PageKey="ai-center" Class="ai-center-page" Width="fluid">
    <AppToolbar Class="ai-center-hero"
                Eyebrow="AI WORKSPACE"
                Title="@(L.IsArabic ? "مركز الذكاء الاصطناعي" : "AI Center")"
                Subtitle="@(L.IsArabic ? "ولّد اقتراحات منظمة مع مقارنة قبل وبعد، سبب التغيير، درجة الثقة والحقول المتأثرة، ثم أرسلها إلى الموافقات." : "Generate structured suggestions with before/after evidence, rationale, confidence, affected fields, and approval governance.")">
        <Actions>
            <AppButton Href="/module/ai-usage" Icon="◫" Text="@(L.IsArabic ? "الاستخدام والتكلفة" : "Usage & cost")" />
            <AppButton Href="/approvals" Icon="✓" Text="@(L.IsArabic ? "قائمة الموافقات" : "Approval queue")" />
            <AppButton Icon="↻" Text="@(L.IsArabic ? "تحديث البيانات" : "Refresh data")" OnClick="LoadMetadataClickedAsync" />
            <AppButton Icon="＋" Text="@(L.IsArabic ? "جلسة جديدة" : "New session")" OnClick="ClearClicked" />
        </Actions>
    </AppToolbar>

    <section class="app-stat-grid" aria-label="@(L.IsArabic ? "ملخص مركز الذكاء الاصطناعي" : "AI Center summary")">
        <AppStatCard Icon="⌘" Label="@(L.IsArabic ? "القوالب المتاحة" : "Available prompts")" Value="@_prompts.Count.ToString()" Description="@(L.IsArabic ? "من سجل القوالب" : "from prompt registry")" Tone="accent" ValueBidiMode="number" />
        <AppStatCard Icon="◫" Label="@(L.IsArabic ? "طلبات الاستخدام الأخيرة" : "Recent usage records")" Value="@_usageCount.ToString()" Description="@(L.IsArabic ? "آخر 100 سجل خاص بحسابك" : "latest 100 records for your account")" Tone="info" ValueBidiMode="number" />
        <AppStatCard Icon="↺" Label="@(L.IsArabic ? "نتائج الجلسة" : "Session results")" Value="@_history.Count.ToString()" Description="@(L.IsArabic ? "متاحة للاستعادة" : "available for reuse")" Tone="success" ValueBidiMode="number" />
        <AppStatCard Icon="✓" Label="@(L.IsArabic ? "حالة الموافقة" : "Approval state")" Value="@ApprovalStateText" Description="@(_lastApprovalId?.ToString("N")[..8] ?? "—")" Tone="@ApprovalTone" />
    </section>

    <section class="ai-center-layout" aria-label="@(L.IsArabic ? "مساحة إنشاء ومراجعة الاقتراح" : "Suggestion creation and review workspace")">
        <aside class="panel ai-prompt-library">
            <header><div><span class="workspace-kicker">PROMPTS</span><h3>@(L.IsArabic ? "مكتبة القوالب" : "Prompt library")</h3></div></header>
            <input class="search-input" @bind="_promptSearch" @bind:event="oninput" placeholder="@(L.IsArabic ? "ابحث في القوالب..." : "Search prompts...")" aria-label="@(L.IsArabic ? "بحث في مكتبة القوالب" : "Search prompt library")" />
            <div class="ai-prompt-list">
                @foreach (var prompt in FilteredPrompts)
                {
                    <button type="button" class="@(_promptKey == prompt.Key ? "active" : string.Empty)" @onclick="() => SelectPrompt(prompt)">
                        <strong>@prompt.Title</strong><small><AppBidiText Mode="technical">@prompt.Key</AppBidiText></small>
                    </button>
                }
                @if (!FilteredPrompts.Any())
                {
                    <AppEmptyState Title="@(L.IsArabic ? "لا توجد قوالب مطابقة" : "No matching prompts")"
                                   Description="@(L.IsArabic ? "غيّر نص البحث لعرض قوالب أخرى." : "Change the search text to view other prompts.")"
                                   Blocking="false" />
                }
            </div>
        </aside>

        <section class="panel ai-composer" aria-labelledby="ai-composer-title">
            <header><div><span class="workspace-kicker">COMPOSER</span><h3 id="ai-composer-title">@(L.IsArabic ? "إنشاء اقتراح" : "Create suggestion")</h3></div><AppBadge Tone="@(_working ? "warning" : "info")" Text="@(_working ? (L.IsArabic ? "يعمل" : "Working") : (L.IsArabic ? "خامل" : "Idle"))" /></header>
            <div class="ai-options-grid">
                <label><span>@(L.IsArabic ? "مفتاح القالب" : "Prompt key")</span><input @bind="_promptKey" placeholder="content.rewrite" data-bidi="technical" /></label>
                <label><span>@(L.IsArabic ? "النموذج الاختياري" : "Optional model")</span><input @bind="_model" placeholder="Default provider model" data-bidi="technical" /></label>
                <label><span>Temperature: @_temperature.ToString("0.0")</span><input type="range" min="0" max="1" step="0.1" @bind="_temperature" /></label>
                <label><span>@(L.IsArabic ? "الحد الأقصى للرموز" : "Max output tokens")</span><input type="number" min="100" max="8000" @bind="_maxTokens" /></label>
                <label class="wide"><span>@(L.IsArabic ? "الموقع" : "Site")</span>
                    <select @bind="_selectedSiteId">
                        <option value="">@(L.IsArabic ? "بدون موقع محدد" : "No specific site")</option>
                        @foreach (var site in _sites)
                        {
                            <option value="@site.Id">@site.Name</option>
                        }
                    </select>
                </label>
            </div>
            <label class="ai-content-input"><span>@(L.IsArabic ? "القيمة الأصلية / المحتوى الحالي" : "Original value / current content")</span><textarea @bind="_content" rows="14" placeholder="@(L.IsArabic ? "ألصق القيمة الحالية التي تريد تحسينها..." : "Paste the current value you want the AI to improve...")"></textarea></label>
            <div class="ai-composer-footer">
                <span><AppBidiText Mode="number">@ContentLength</AppBidiText> @(L.IsArabic ? "حرف" : "characters")</span>
                <AppButton Variant="primary" Icon="✦" Busy="@_working" Disabled="@(_working || string.IsNullOrWhiteSpace(_content))" Text="@(_working ? (L.IsArabic ? "جارٍ إنشاء الاقتراح..." : "Generating suggestion...") : (L.IsArabic ? "إنشاء اقتراح" : "Generate suggestion"))" OnClick="GenerateClickedAsync" />
            </div>
        </section>

        <aside class="panel ai-output-panel" aria-labelledby="ai-output-title">
            <header>
                <div><span class="workspace-kicker">SUGGESTION</span><h3 id="ai-output-title">@(L.IsArabic ? "القيمة المقترحة" : "Proposed value")</h3></div>
                @if (!string.IsNullOrWhiteSpace(_output))
                {
                    <AppButton Size="small" Icon="⧉" Text="@(L.IsArabic ? "نسخ" : "Copy")" OnClick="CopyOutputClickedAsync" />
                }
            </header>
            @if (_working)
            {
                <AppLoading Title="@(L.IsArabic ? "جارٍ إنشاء الاقتراح" : "Generating suggestion")" Message="@(L.IsArabic ? "يتولى المزود إنشاء اقتراح منظم وقابل للمراجعة..." : "The provider is building a structured, reviewable suggestion...")" />
            }
            else if (!string.IsNullOrWhiteSpace(_error))
            {
                <AppStatePanel Kind="error" Title="@(L.IsArabic ? "فشل إنشاء الاقتراح" : "Suggestion generation failed")" Description="@_error" />
            }
            else if (_suggestion is null)
            {
                <AppEmptyState Icon="✦" Title="@(L.IsArabic ? "الاقتراح سيظهر هنا" : "Your suggestion will appear here")" Description="@(L.IsArabic ? "اختر قالبًا، أدخل القيمة الأصلية، ثم أنشئ الاقتراح." : "Choose a prompt, enter the original value, and generate a suggestion.")" Blocking="false" />
            }
            else
            {
                <article class="ai-generated-output">@_suggestion.After</article>
                <div class="ai-result-meta"><span><AppBidiText Mode="number">@_suggestion.After.Length</AppBidiText> @(L.IsArabic ? "حرف" : "characters")</span><span><AppBidiText Mode="time">@(_lastElapsed is null ? "—" : $"{_lastElapsed.Value.TotalSeconds:0.0}s")</AppBidiText></span></div>

                <section class="ai-suggestion-evidence">
                    <div class="ai-suggestion-summary">
                        <div><span class="workspace-kicker">RATIONALE</span><h4>@(L.IsArabic ? "سبب الاقتراح" : "Why this change")</h4><p>@_suggestion.Explanation</p></div>
                        <div class="ai-confidence-card"><small>@(L.IsArabic ? "درجة الثقة" : "Confidence")</small><strong>@_suggestion.Confidence.ToString("P0")</strong><span>@ConfidenceText(_suggestion.Confidence)</span></div>
                    </div>
                    <div class="ai-affected-fields"><small>@(L.IsArabic ? "الحقول المتأثرة" : "Affected fields")</small><div>@foreach (var field in _suggestion.AffectedFields) { <AppBadge Tone="info" Text="@field" /> }</div></div>
                </section>

                <section class="ai-approval-box">
                    <div class="ai-approval-heading"><div><span class="workspace-kicker">GOVERNANCE</span><h4>@(L.IsArabic ? "إرسال للموافقة" : "Submit for approval")</h4></div><AppButton Size="small" Icon="↻" Disabled="@(!_lastApprovalId.HasValue)" Text="@(L.IsArabic ? "تحديث الحالة" : "Refresh state")" OnClick="RefreshApprovalStatusClicked" /></div>
                    <div class="ai-approval-grid">
                        <label><span>@(L.IsArabic ? "درجة الخطورة" : "Risk level")</span><select @bind="_riskLevel">@foreach (var risk in Enum.GetValues<ApprovalRiskLevel>()) { <option value="@risk">@RiskText(risk)</option> }</select></label>
                        <label><span>@(L.IsArabic ? "نوع العملية" : "Operation type")</span><input @bind="_operationType" data-bidi="technical" /></label>
                        <label class="wide"><span>@(L.IsArabic ? "عنوان طلب الموافقة" : "Approval title")</span><input @bind="_approvalTitle" /></label>
                    </div>
                    <div class="ai-compare-grid"><div><small>@(L.IsArabic ? "قبل" : "Before")</small><pre>@_suggestion.Before</pre></div><div><small>@(L.IsArabic ? "بعد" : "After")</small><pre>@_suggestion.After</pre></div></div>
                    <AppButton Class="full" Variant="primary" Icon="✓" Busy="@_submittingApproval" Disabled="@_submittingApproval" Text="@(_submittingApproval ? (L.IsArabic ? "جارٍ الإرسال..." : "Submitting...") : (L.IsArabic ? "إرسال إلى قائمة الموافقات" : "Submit to approval queue"))" OnClick="SubmitForApprovalClickedAsync" />
                    @if (_lastApprovalId.HasValue)
                    {
                        <div class="ai-approval-status"><AppBadge Tone="@ApprovalTone" Text="@ApprovalStateText" /><AppButton Href="/approvals" Size="small" Icon="↗" Text="@(L.IsArabic ? "فتح قائمة الموافقات" : "Open approval queue")" /></div>
                    }
                </section>
            }
        </aside>
    </section>

    <AppSection Class="ai-session-history" Eyebrow="SESSION HISTORY" Title="@(L.IsArabic ? "اقتراحات الجلسة" : "Session suggestions")" HeadingLevel="3">
        <Header><AppButton Size="small" Variant="ghost" Disabled="@(_history.Count == 0)" Text="@(L.IsArabic ? "مسح السجل" : "Clear history")" OnClick="ClearHistoryClicked" /></Header>
        <ChildContent>
            @if (_history.Count == 0)
            {
                <AppEmptyState Title="@(L.IsArabic ? "لا توجد اقتراحات في هذه الجلسة" : "No session suggestions yet")" Description="@(L.IsArabic ? "ستظهر الاقتراحات هنا بعد أول عملية إنشاء." : "Suggestions appear here after the first generation.")" Blocking="false" />
            }
            else
            {
                <div class="ai-history-list">
                    @foreach (var item in _history)
                    {
                        <article><div><strong>@item.Title</strong><small><AppBidiText Mode="technical">@item.PromptKey</AppBidiText> · <AppBidiText Mode="date">@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</AppBidiText> · <AppBidiText Mode="time">@item.Elapsed.TotalSeconds.ToString("0.0")s</AppBidiText> · @item.Suggestion.Confidence.ToString("P0")</small></div><p>@Preview(item.Suggestion.After)</p><div class="ai-history-actions"><AppButton Size="small" Text="@(L.IsArabic ? "استعادة" : "Restore")" OnClick="_ => RestoreHistory(item)" /><AppButton Size="small" Text="@(L.IsArabic ? "نسخ" : "Copy")" OnClick="_ => CopyHistoryAsync(item)" /></div></article>
                    }
                </div>
            }
        </ChildContent>
    </AppSection>
</AppPage>

@code {
    private readonly List<PromptOption> _prompts = new();
    private readonly List<SessionResult> _history = new();
    private List<Site> _sites = new();
    private string _content = string.Empty, _promptKey = string.Empty, _model = string.Empty, _output = string.Empty, _error = string.Empty, _promptSearch = string.Empty;
    private string _selectedSiteId = string.Empty, _approvalTitle = string.Empty, _operationType = "AI.ContentUpdate", _approvalActor = string.Empty;
    private ApprovalRiskLevel _riskLevel = ApprovalRiskLevel.High;
    private ApprovalStatus? _lastApprovalStatus;
    private AISuggestion? _suggestion;
    private double _temperature = .2;
    private int _maxTokens = 1500, _usageCount;
    private bool _working, _submittingApproval;
    private TimeSpan? _lastElapsed;
    private Guid? _lastApprovalId;
    private Guid _ownerUserId;
    private int ContentLength => _content?.Length ?? 0;
    private IEnumerable<PromptOption> FilteredPrompts => _prompts.Where(x => string.IsNullOrWhiteSpace(_promptSearch) || x.Key.Contains(_promptSearch, StringComparison.OrdinalIgnoreCase) || x.Title.Contains(_promptSearch, StringComparison.OrdinalIgnoreCase));
    private string ApprovalStateText => _lastApprovalStatus?.ToString() ?? (L.IsArabic ? "لم يُرسل" : "Not submitted");
    private string ApprovalBadgeClass => _lastApprovalStatus switch { ApprovalStatus.Approved or ApprovalStatus.Executed => "success", ApprovalStatus.Rejected or ApprovalStatus.Cancelled => "error", _ => "warning" };
    private string ApprovalTone => _lastApprovalStatus switch { ApprovalStatus.Approved or ApprovalStatus.Executed => "success", ApprovalStatus.Rejected or ApprovalStatus.Cancelled => "danger", _ => "warning" };

    protected override void OnInitialized()
    {
        L.Changed += Changed;
        _ownerUserId = CurrentUser.UserId;
        _approvalActor = string.IsNullOrWhiteSpace(CurrentUser.UserName) ? _ownerUserId.ToString() : CurrentUser.UserName;
    }

    protected override async Task OnInitializedAsync() => await LoadMetadataAsync();
    private Task LoadMetadataClickedAsync(MouseEventArgs _) => LoadMetadataAsync();
    private void ClearClicked(MouseEventArgs _) => Clear();
    private Task GenerateClickedAsync(MouseEventArgs _) => GenerateAsync();
    private Task CopyOutputClickedAsync(MouseEventArgs _) => CopyOutputAsync();
    private Task SubmitForApprovalClickedAsync(MouseEventArgs _) => SubmitForApprovalAsync();
    private void RefreshApprovalStatusClicked(MouseEventArgs _) => RefreshApprovalStatus();
    private void ClearHistoryClicked(MouseEventArgs _) => ClearHistory();

    private async Task LoadMetadataAsync()
    {
        _prompts.Clear();
        try
        {
            foreach (var key in PromptRegistry.GetAll(L.Culture).Keys.OrderBy(x => x, StringComparer.OrdinalIgnoreCase))
                _prompts.Add(new PromptOption(key, PromptTitle(key)));

            _usageCount = UsageLog.GetRecent(100, null, _ownerUserId.ToString("D")).Count;
            _sites = await SiteService.GetSitesAsync();
            RefreshApprovalStatus();
        }
        catch (Exception ex) { _error = L.TranslateMessage(ex.Message); }
    }

    private void SelectPrompt(PromptOption prompt) { _promptKey = prompt.Key; _approvalTitle = prompt.Title; }

    private async Task GenerateAsync()
    {
        _working = true; _error = string.Empty; _output = string.Empty; _suggestion = null; _lastApprovalId = null; _lastApprovalStatus = null; var started = DateTime.UtcNow;
        try
        {
            string? baseInstruction = null;
            if (!string.IsNullOrWhiteSpace(_promptKey))
            {
                if (!PromptRegistry.TryGet(_promptKey, L.Culture, out var resolvedPrompt))
                    throw new InvalidOperationException(L.IsArabic ? "قالب الأمر غير موجود أو تم تعطيله." : "Prompt template was not found or is disabled.");
                baseInstruction = resolvedPrompt;
            }

            var instruction = AISuggestionContract.BuildSystemPrompt(baseInstruction, L.Culture);
            var result = await Orchestrator.ExecuteAsync(new AIRequest(_content, instruction, string.IsNullOrWhiteSpace(_model) ? null : _model, _temperature, _maxTokens, SelectedSiteGuid(), _ownerUserId.ToString("D"), string.IsNullOrWhiteSpace(_promptKey) ? "ai.suggestion" : $"ai.suggestion:{_promptKey}"));
            _lastElapsed = DateTime.UtcNow - started;
            if (!result.IsSuccess)
            {
                _error = L.TranslateMessage(result.Error ?? (L.IsArabic ? "فشل طلب الذكاء الاصطناعي." : "AI generation failed."));
                Notifications.Error(_error, L.IsArabic ? "فشل الذكاء الاصطناعي" : "AI generation failed");
                return;
            }

            if (!AISuggestionContract.TryParse(_content, result.Content ?? string.Empty, out var suggestion, out var parseError) || suggestion is null)
                throw new InvalidOperationException((L.IsArabic ? "أعاد مزود الذكاء الاصطناعي اقتراحًا غير صالح للمراجعة: " : "AI provider returned an unreviewable suggestion: ") + parseError);

            _suggestion = suggestion;
            _output = suggestion.After;
            if (string.IsNullOrWhiteSpace(_approvalTitle)) _approvalTitle = string.IsNullOrWhiteSpace(_promptKey) ? (L.IsArabic ? "اقتراح محتوى بالذكاء الاصطناعي" : "AI content proposal") : _promptKey;
            _history.Insert(0, new SessionResult(Guid.NewGuid(), _approvalTitle, string.IsNullOrWhiteSpace(_promptKey) ? "custom" : _promptKey, suggestion, DateTime.UtcNow, _lastElapsed ?? TimeSpan.Zero, _selectedSiteId));
            if (_history.Count > 10) _history.RemoveAt(_history.Count - 1);
            Notifications.Success(L.IsArabic ? "اكتمل إنشاء الاقتراح المنظم." : "Structured AI suggestion generated.");
            await LoadMetadataAsync();
        }
        catch (Exception ex) { _error = L.TranslateMessage(ex.Message); Notifications.Error(_error, L.IsArabic ? "فشل الذكاء الاصطناعي" : "AI generation failed", ex.ToString()); }
        finally { _working = false; }
    }

    private Task SubmitForApprovalAsync()
    {
        if (_suggestion is null) return Task.CompletedTask;
        try
        {
            _submittingApproval = true;
            var siteId = SelectedSiteGuid();
            var site = siteId.HasValue ? _sites.FirstOrDefault(x => x.Id == siteId.Value) : null;
            var item = ApprovalService.Submit(
                _ownerUserId,
                new ApprovalSubmission(
                    siteId,
                    site?.Name,
                    string.IsNullOrWhiteSpace(_operationType) ? "AI.ContentUpdate" : _operationType.Trim(),
                    string.IsNullOrWhiteSpace(_approvalTitle) ? "AI content proposal" : _approvalTitle.Trim(),
                    new { Content = _suggestion.Before, PromptKey = _promptKey, Model = _model, AffectedFields = _suggestion.AffectedFields },
                    new { Content = _suggestion.After, _suggestion.Explanation, _suggestion.Confidence, AffectedFields = _suggestion.AffectedFields, PromptKey = _promptKey, Model = _model },
                    _approvalActor,
                    _riskLevel,
                    Guid.NewGuid().ToString("N"),
                    null),
                _approvalActor);
            _lastApprovalId = item.Id;
            _lastApprovalStatus = item.Status;
            Notifications.Success(L.IsArabic ? "تم إرسال الاقتراح المنظم إلى قائمة الموافقات." : "Structured proposal submitted to the approval queue.");
        }
        catch (Exception ex) { Notifications.Error(L.TranslateMessage(ex.Message), L.IsArabic ? "فشل إرسال الموافقة" : "Approval submission failed", ex.ToString()); }
        finally { _submittingApproval = false; }
        return Task.CompletedTask;
    }

    private void RefreshApprovalStatus()
    {
        if (!_lastApprovalId.HasValue) return;
        _lastApprovalStatus = ApprovalService.GetById(_ownerUserId, _lastApprovalId.Value)?.Status;
    }

    private void RestoreHistory(SessionResult item)
    {
        _suggestion = item.Suggestion; _content = item.Suggestion.Before; _output = item.Suggestion.After; _promptKey = item.PromptKey == "custom" ? string.Empty : item.PromptKey; _approvalTitle = item.Title; _selectedSiteId = item.SiteId; _lastElapsed = item.Elapsed; _error = string.Empty; _lastApprovalId = null; _lastApprovalStatus = null;
    }

    private async Task CopyHistoryAsync(SessionResult item) { await JS.InvokeVoidAsync("navigator.clipboard.writeText", item.Suggestion.After); Notifications.Success(L.IsArabic ? "تم نسخ الاقتراح." : "Suggestion copied."); }
    private async Task CopyOutputAsync() { await JS.InvokeVoidAsync("navigator.clipboard.writeText", _output); Notifications.Success(L.IsArabic ? "تم نسخ الاقتراح." : "Suggestion copied."); }
    private void ClearHistory() => _history.Clear();
    private void Clear() { _content = _output = _error = _promptKey = string.Empty; _suggestion = null; _lastElapsed = null; _lastApprovalId = null; _lastApprovalStatus = null; }
    private Guid? SelectedSiteGuid() => Guid.TryParse(_selectedSiteId, out var id) ? id : null;
    private string RiskText(ApprovalRiskLevel risk) => L.IsArabic ? risk switch { ApprovalRiskLevel.Low => "منخفض", ApprovalRiskLevel.Medium => "متوسط", ApprovalRiskLevel.High => "مرتفع", ApprovalRiskLevel.Critical => "حرج", _ => risk.ToString() } : risk.ToString();
    private string ConfidenceText(double confidence) => L.IsArabic
        ? confidence >= .85 ? "مرتفعة" : confidence >= .65 ? "متوسطة" : "منخفضة"
        : confidence >= .85 ? "High" : confidence >= .65 ? "Medium" : "Low";
    private void Changed() => InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= Changed;
    private static string Preview(string value) => value.Length <= 180 ? value : value[..180] + "…";
    private static string PromptTitle(string key)
    {
        var words = key.Replace('.', ' ').Replace('-', ' ').Replace('_', ' ')
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return words.Length == 0 ? key : string.Join(' ', words.Select(x => char.ToUpperInvariant(x[0]) + x[1..]));
    }

    private sealed record PromptOption(string Key, string Title);
    private sealed record SessionResult(Guid Id, string Title, string PromptKey, AISuggestion Suggestion, DateTime CreatedAt, TimeSpan Elapsed, string SiteId);
}