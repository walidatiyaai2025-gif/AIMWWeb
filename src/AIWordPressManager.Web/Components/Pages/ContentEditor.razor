@page "/sites/{SiteId:guid}/content/{ContentType}/{WordPressId:int}/edit"
@rendermode InteractiveServer
@implements IDisposable
@inject IWordPressPostEditorService EditorService
@inject WordPressSyncWebService SyncService
@inject SiteWebService SiteService
@inject ApprovalWorkflowService ApprovalService
@inject CurrentUserContext CurrentUser
@inject AppLanguageService L

<PageTitle>@L["EditContent"]</PageTitle>

@if (_loading)
{
    <div class="editor-loading"><div class="editor-skeleton hero"></div><div class="editor-skeleton-grid"><div></div><div></div></div></div>
}
else if (_site is null || _model is null)
{
    <div class="empty-state"><h1>@L["ContentNotFound"]</h1><a class="btn" href="@ExplorerUrl">@L["BackToExplorer"]</a></div>
}
else
{
    <div class="content-editor-page">
        <header class="editor-command-bar panel">
            <div class="editor-breadcrumbs"><a href="/sites">@L["Sites"]</a><span>/</span><a href="@($"/sites/{SiteId}")">@_site.Name</a><span>/</span><a href="@ExplorerUrl">@L["Content"]</a><span>/</span><strong>@(_model.ContentType == "post" ? L["Post"] : L["Page"]) #@_model.Id</strong></div>
            <div class="editor-command-actions">
                <a class="btn" href="@ExplorerUrl">← @L["BackToExplorer"]</a>
                @if (!string.IsNullOrWhiteSpace(_model.Link)) { <a class="btn" href="@_model.Link" target="_blank">@L["ViewOnWordPress"] ↗</a> }
                <button type="button" class="btn" disabled="@(_saving || _submittingApproval)" @onclick="SubmitForApprovalAsync">@(_submittingApproval ? (L.IsArabic ? "جارٍ الإرسال..." : "Submitting...") : (L.IsArabic ? "إرسال للموافقة" : "Send for approval"))</button>
                <button type="button" class="btn primary" disabled="@(_saving || _submittingApproval)" @onclick="SaveAsync">@(_saving ? L["Saving"] : L["SaveToWordPress"])</button>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert @(_isError ? "error" : "success")"><strong>@_message</strong></div>
        }

        <EditForm Model="_model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="editor-workspace-grid">
                <main class="editor-canvas">
                    <section class="panel editor-title-card">
                        <span class="workspace-kicker">@(L.IsArabic ? "تحرير المحتوى" : "CONTENT EDITOR")</span>
                        <InputText class="editor-title-input" @bind-Value="_model.Title" placeholder="@(L.IsArabic ? "اكتب عنوانًا واضحًا وجذابًا" : "Write a clear, compelling title")" />
                        <div class="editor-slug-row"><span>@_site.SiteUrl.TrimEnd('/')/</span><InputText @bind-Value="_model.Slug" dir="ltr" /><button type="button" class="btn compact" @onclick="GenerateSlug">@(L.IsArabic ? "توليد" : "Generate")</button></div>
                    </section>

                    <section class="panel editor-content-card">
                        <div class="editor-card-head"><div><h2>@L["ContentHtml"]</h2><p>@(L.IsArabic ? "حرر محتوى WordPress بصيغة HTML مع معاينة مباشرة للنص." : "Edit WordPress HTML with a live text preview.")</p></div><div class="editor-view-toggle"><button type="button" class="@ViewClass("edit")" @onclick="ShowEdit">@(L.IsArabic ? "تحرير" : "Edit")</button><button type="button" class="@ViewClass("preview")" @onclick="ShowPreview">@(L.IsArabic ? "معاينة" : "Preview")</button></div></div>
                        @if (_viewMode == "edit") { <InputTextArea class="content-editor-pro" @bind-Value="_model.Content" dir="ltr" /> }
                        else { <article class="content-preview">@((MarkupString)_model.Content)</article> }
                    </section>

                    <section class="panel editor-excerpt-card">
                        <div class="editor-card-head"><div><h2>@L["Excerpt"]</h2><p>@(L.IsArabic ? "ملخص قصير يظهر في الأرشيف ونتائج البحث." : "A concise summary for archives and search results.")</p></div><span class="editor-counter">@ExcerptLength / 300</span></div>
                        <InputTextArea class="excerpt-editor-pro" @bind-Value="_model.Excerpt" maxlength="300" />
                    </section>

                    <section class="panel editor-seo-card">
                        <div class="editor-card-head"><div><h2>SEO</h2><p>@(L.IsArabic ? "معاينة مبدئية للعنوان والوصف والرابط." : "Preliminary title, description, and URL preview.")</p></div><span class="seo-score-chip @SeoClass">@SeoScore/100</span></div>
                        <div class="search-preview-card"><small>@_site.SiteUrl</small><strong>@PlainText(_model.Title)</strong><p>@PlainText(_model.Excerpt)</p><code>@_site.SiteUrl.TrimEnd('/')/@_model.Slug</code></div>
                        <div class="seo-check-grid"><span class="@CheckClass(TitleLength is >= 30 and <= 65)">@(L.IsArabic ? "طول العنوان" : "Title length") <b>@TitleLength</b></span><span class="@CheckClass(ExcerptLength is >= 80 and <= 160)">@(L.IsArabic ? "طول الوصف" : "Description length") <b>@ExcerptLength</b></span><span class="@CheckClass(!string.IsNullOrWhiteSpace(_model.Slug))">Slug</span><span class="@CheckClass(_model.FeaturedMediaId > 0)">@(L.IsArabic ? "صورة بارزة" : "Featured image")</span></div>
                    </section>
                </main>

                <aside class="editor-inspector">
                    <section class="panel inspector-card publish-card">
                        <div class="inspector-head"><h3>@L["Publishing"]</h3><span class="badge @StatusBadgeClass">@TranslateStatus(_model.Status)</span></div>
                        <div class="form-stack">
                            <label><span>@L["Status"]</span><InputSelect @bind-Value="_model.Status"><option value="draft">@L["Draft"]</option><option value="pending">@L["PendingReview"]</option><option value="publish">@L["Published"]</option><option value="future">@L["Scheduled"]</option><option value="private">@L["Private"]</option></InputSelect></label>
                            <label><span>@L["PublishDateUtc"]</span><InputDate Type="InputDateType.DateTimeLocal" @bind-Value="_model.DateLocal" /></label>
                            <label><span>@L["CommentStatus"]</span><InputSelect @bind-Value="_model.CommentStatus"><option value="open">@L["OpenStatus"]</option><option value="closed">@L["ClosedStatus"]</option></InputSelect></label>
                            <label><span>@L["PingStatus"]</span><InputSelect @bind-Value="_model.PingStatus"><option value="open">@L["OpenStatus"]</option><option value="closed">@L["ClosedStatus"]</option></InputSelect></label>
                            @if (_model.ContentType == "post") { <label class="check-row"><InputCheckbox @bind-Value="_model.Sticky" /> <span>@L["StickyPost"]</span></label> }
                        </div>
                        <button class="btn primary full" type="submit" disabled="@(_saving || _submittingApproval)">@(_saving ? L["Saving"] : L["SaveToWordPress"])</button>
                        <button class="btn full" type="button" disabled="@(_saving || _submittingApproval)" @onclick="SubmitForApprovalAsync">@(L.IsArabic ? "حفظ كمقترح للموافقة" : "Submit change for approval")</button>
                        <small>@(L.IsArabic ? "التنفيذ بعد الموافقة يتحقق من نسخة WordPress مرة أخرى ولن يكتب فوق تعديل أحدث." : "Approved execution rechecks the WordPress version and will not overwrite a newer remote edit.")</small>
                    </section>

                    <section class="panel inspector-card">
                        <div class="inspector-head"><h3>@L["FeaturedImage"]</h3><a class="btn compact" href="@($"/sites/{SiteId}/media")">@L["ManageMedia"]</a></div>
                        @if (_model.FeaturedMediaId > 0)
                        {
                            var selected = _media.FirstOrDefault(x => x.WordPressId == _model.FeaturedMediaId);
                            <div class="featured-preview">@if (selected is not null && selected.MediaType == "image") { <img src="@selected.SourceUrl" alt="@selected.Title" /> }<div><strong>#@_model.FeaturedMediaId</strong><button type="button" class="btn compact" @onclick="ClearFeatured">@L["RemoveSelection"]</button></div></div>
                        }
                        <input class="search-input" placeholder="@L["SearchMedia"]" @bind="_mediaSearch" @bind:event="oninput" />
                        <div class="media-picker-pro">@foreach (var media in FilteredMedia.Take(8)) { <button type="button" class="@(media.WordPressId == _model.FeaturedMediaId ? "selected" : string.Empty)" @onclick="() => SelectFeatured(media.WordPressId)" title="@media.Title">@if (media.MediaType == "image") { <img src="@media.SourceUrl" alt="@media.Title" loading="lazy" /> } else { <span>FILE</span> }<small>#@media.WordPressId</small></button> }</div>
                    </section>

                    <section class="panel inspector-card">
                        <h3>@L["ContentSettings"]</h3>
                        <div class="form-stack">
                            <label><span>@L["FeaturedMediaId"]</span><InputNumber @bind-Value="_model.FeaturedMediaId" /></label>
                            <label><span>@L["Template"]</span><InputText @bind-Value="_model.Template" dir="ltr" /></label>
                            @if (_model.ContentType == "post")
                            {
                                <label><span>@L["CategoriesIds"]</span><InputText @bind-Value="_model.CategoryIdsText" dir="ltr" /><small>@L["CommaSeparatedIds"]</small></label>
                                <label><span>@L["TagsIds"]</span><InputText @bind-Value="_model.TagIdsText" dir="ltr" /><small>@L["CommaSeparatedIds"]</small></label>
                                <label><span>@L["Format"]</span><InputText @bind-Value="_model.Format" dir="ltr" /></label>
                            }
                        </div>
                    </section>
                </aside>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public Guid SiteId { get; set; }
    [Parameter] public string ContentType { get; set; } = "post";
    [Parameter] public int WordPressId { get; set; }

    private AIWordPressManager.Domain.Entities.Site? _site;
    private EditorModel? _model;
    private WordPressContentUpdateRequest? _baselineRequest;
    private bool _loading = true, _saving, _submittingApproval, _isError;
    private string _viewMode = "edit";
    private string? _message;
    private IReadOnlyList<MediaExplorerItem> _media = Array.Empty<MediaExplorerItem>();
    private string _mediaSearch = string.Empty;
    private string ExplorerUrl => $"/sites/{SiteId}/explorer";
    private int TitleLength => PlainText(_model?.Title ?? string.Empty).Length;
    private int ExcerptLength => PlainText(_model?.Excerpt ?? string.Empty).Length;
    private int SeoScore => (_model is null ? 0 : 20 + (TitleLength is >= 30 and <= 65 ? 25 : 0) + (ExcerptLength is >= 80 and <= 160 ? 25 : 0) + (!string.IsNullOrWhiteSpace(_model.Slug) ? 15 : 0) + (_model.FeaturedMediaId > 0 ? 15 : 0));
    private string SeoClass => SeoScore >= 80 ? "good" : SeoScore >= 50 ? "medium" : "poor";
    private string StatusBadgeClass => _model?.Status == "publish" ? "success" : _model?.Status == "draft" ? "warning" : string.Empty;

    protected override void OnInitialized() => L.Changed += Changed;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _site = await SiteService.GetSiteAsync(SiteId);
        var result = await EditorService.GetAsync(SiteId, ContentType, WordPressId);
        if (result.IsSuccess)
        {
            _model = EditorModel.From(result.Value);
            _baselineRequest = _model.ToRequest(result.Value.ModifiedGmt);
            var explorer = await SyncService.GetExplorerAsync(SiteId);
            _media = explorer.Media;
        }
        else
        {
            _isError = true;
            _message = L.TranslateMessage(result.Error.Message);
        }
        _loading = false;
    }

    private async Task SaveAsync()
    {
        if (_model is null) return;
        try
        {
            _saving = true; _isError = false; _message = null;
            var expected = _baselineRequest?.ExpectedModifiedGmt;
            var result = await EditorService.UpdateAsync(SiteId, _model.ToRequest(expected));
            if (result.IsFailure) { _isError = true; _message = L.TranslateMessage(result.Error.Message); return; }
            _message = L.TranslateMessage(result.Value.Message);
            _model.Link = result.Value.Link;
            _baselineRequest = _model.ToRequest(result.Value.ModifiedGmt);
            await SyncService.SynchronizeAsync(SiteId);
        }
        catch (Exception ex) { _isError = true; _message = L.TranslateMessage(ex.Message); }
        finally { _saving = false; }
    }

    private Task SubmitForApprovalAsync()
    {
        if (_model is null || _site is null || _baselineRequest is null) return Task.CompletedTask;
        try
        {
            _submittingApproval = true; _isError = false; _message = null;
            var ownerUserId = CurrentUser.RequireUserId();
            var after = _model.ToRequest(_baselineRequest.ExpectedModifiedGmt);
            var approval = ApprovalService.Submit(
                ownerUserId,
                new ApprovalSubmission(
                    SiteId,
                    _site.Name,
                    ApprovedChangePolicy.WordPressContentUpdateOperation,
                    $"Update {_model.ContentType} #{_model.Id} — {PlainText(_model.Title)}",
                    _baselineRequest,
                    after,
                    null,
                    ApprovalRiskLevel.Medium,
                    null,
                    null),
                CurrentUser.UserName);
            _message = L.IsArabic
                ? $"تم إرسال التعديل للموافقة. رقم الطلب: {approval.Id.ToString()[..8]}"
                : $"Change submitted for approval. Request: {approval.Id.ToString()[..8]}";
        }
        catch (Exception ex) { _isError = true; _message = L.TranslateMessage(ex.Message); }
        finally { _submittingApproval = false; }
        return Task.CompletedTask;
    }

    private IEnumerable<MediaExplorerItem> FilteredMedia => _media.Where(x => x.MediaType == "image" && (string.IsNullOrWhiteSpace(_mediaSearch) || x.Title.Contains(_mediaSearch, StringComparison.OrdinalIgnoreCase) || x.MimeType.Contains(_mediaSearch, StringComparison.OrdinalIgnoreCase)));
    private void SelectFeatured(int id) { if (_model is not null) _model.FeaturedMediaId = id; }
    private void ClearFeatured() { if (_model is not null) _model.FeaturedMediaId = 0; }
    private void ShowEdit() => _viewMode = "edit";
    private void ShowPreview() => _viewMode = "preview";
    private string ViewClass(string mode) => _viewMode == mode ? "active" : string.Empty;
    private string CheckClass(bool ok) => ok ? "seo-check good" : "seo-check warning";
    private void GenerateSlug() { if (_model is null) return; var plain = PlainText(_model.Title).Trim().ToLowerInvariant(); _model.Slug = System.Text.RegularExpressions.Regex.Replace(plain, @"[^\p{L}\p{N}]+", "-").Trim('-'); }
    private string TranslateStatus(string status) => L.IsArabic ? status switch { "publish" => "منشور", "draft" => "مسودة", "pending" => "قيد المراجعة", "future" => "مجدول", "private" => "خاص", _ => status } : status switch { "publish" => "Published", "draft" => "Draft", "pending" => "Pending", "future" => "Scheduled", "private" => "Private", _ => status };
    private static string PlainText(string value) => System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(value ?? string.Empty, "<.*?>", string.Empty));
    private void Changed() => InvokeAsync(StateHasChanged);
    public void Dispose() => L.Changed -= Changed;

    private sealed class EditorModel
    {
        public string ContentType { get; set; } = "post";
        public int Id { get; set; }
        [Required] public string Title { get; set; } = string.Empty;
        public string Slug { get; set; } = string.Empty;
        public string Status { get; set; } = "draft";
        public string Content { get; set; } = string.Empty;
        public string Excerpt { get; set; } = string.Empty;
        public string Link { get; set; } = string.Empty;
        public DateTime? DateLocal { get; set; }
        public int FeaturedMediaId { get; set; }
        public string CategoryIdsText { get; set; } = string.Empty;
        public string TagIdsText { get; set; } = string.Empty;
        public string Template { get; set; } = string.Empty;
        public string CommentStatus { get; set; } = "open";
        public string PingStatus { get; set; } = "open";
        public string Format { get; set; } = "standard";
        public bool Sticky { get; set; }

        public static EditorModel From(WordPressEditableContent value) => new()
        {
            ContentType = value.ContentType, Id = value.Id, Title = value.Title, Slug = value.Slug, Status = value.Status,
            Content = value.Content, Excerpt = value.Excerpt, Link = value.Link, DateLocal = value.DateGmt?.ToLocalTime().DateTime,
            FeaturedMediaId = value.FeaturedMediaId, CategoryIdsText = string.Join(",", value.CategoryIds), TagIdsText = string.Join(",", value.TagIds),
            Template = value.Template, CommentStatus = value.CommentStatus, PingStatus = value.PingStatus, Format = value.Format, Sticky = value.Sticky
        };

        public WordPressContentUpdateRequest ToRequest(DateTimeOffset? expectedModifiedGmt = null) => new(
            ContentType, Id, Title, Slug, Status, Content, Excerpt,
            DateLocal.HasValue ? new DateTimeOffset(DateTime.SpecifyKind(DateLocal.Value, DateTimeKind.Local)).ToUniversalTime() : null,
            FeaturedMediaId, ParseIds(CategoryIdsText), ParseIds(TagIdsText), Template, CommentStatus, PingStatus, Format, Sticky,
            expectedModifiedGmt, false);

        private static IReadOnlyList<int> ParseIds(string? value) => (value ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(x => int.TryParse(x, out var id) ? id : 0)
            .Where(x => x > 0).Distinct().ToArray();
    }
}
