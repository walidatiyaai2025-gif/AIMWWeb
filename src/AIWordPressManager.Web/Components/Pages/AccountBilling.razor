@page "/account/billing"
@rendermode InteractiveServer
@using System.Globalization
@using AIWordPressManager.Application.Abstractions.Billing
@using AIWordPressManager.Domain.Entities
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@inject AppLanguageService L
@inject NavigationManager Navigation

<PageTitle>@(L.IsArabic ? "الاشتراك والفوترة" : "Subscription & Billing")</PageTitle>

<AppPage PageKey="account-billing" Class="billing-page" Width="wide" AriaLabel="@(L.IsArabic ? "مساحة الاشتراك والفوترة" : "Subscription and billing workspace")">
    <AppToolbar
        Eyebrow="@(L.IsArabic ? "الحساب" : "ACCOUNT")"
        Title="@(L.IsArabic ? "الاشتراك والفوترة" : "Subscription & Billing")"
        Subtitle="@(L.IsArabic ? "راجع الخطة والحالة واطلب تغييرات الاشتراك من الخادم مع بقاء PayPal ومصالحة المزود هي سلطة التغيير الفعلية." : "Review your plan and request subscription changes server-side while PayPal and provider reconciliation remain authoritative for actual changes.")">
        <Actions>
            <AppButton Href="/account/profile" Icon="←" IconIntent="back" Text="@(L.IsArabic ? "حسابي" : "My Account")" />
            <AppButton Href="/account/email-settings" Icon="✉" Text="@(L.IsArabic ? "إعدادات البريد" : "Email settings")" Variant="secondary" />
        </Actions>
    </AppToolbar>

    @if (IsCheckoutReturned)
    {
        <div class="billing-notice billing-notice--info" role="status">
            <strong>@(L.IsArabic ? "تم الرجوع من PayPal." : "Returned from PayPal.")</strong>
            <span>@(L.IsArabic ? "هذه العودة للتنقل فقط. لن تتغير حالة الاشتراك أو الخطة إلا بعد مصالحة بيانات PayPal الموثوقة." : "This browser return is navigation-only. Subscription state or plan changes only after authoritative PayPal reconciliation.")</span>
        </div>
    }
    else if (IsCheckoutCancelled)
    {
        <div class="billing-notice billing-notice--neutral" role="status">
            <strong>@(L.IsArabic ? "تم إلغاء مسار PayPal." : "PayPal flow was cancelled.")</strong>
            <span>@(L.IsArabic ? "لم يتم اعتبار العملية ناجحة ولم تتغير حالة الاشتراك من عودة المتصفح." : "The operation was not treated as successful and no subscription state was changed from the browser return.")</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_operationMessage))
    {
        <div class="billing-notice billing-notice--info" role="status">
            <strong>@(L.IsArabic ? "تم قبول الطلب." : "Request accepted.")</strong>
            <span>@_operationMessage</span>
        </div>
    }

    @if (_loading)
    {
        <AppLoading Title="@(L.IsArabic ? "جارٍ تحميل بيانات الاشتراك" : "Loading subscription data")" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <AppCard Tone="danger">
            <ChildContent>
                <AppEmptyState Icon="!" Title="@(L.IsArabic ? "تعذر تنفيذ عملية الفوترة" : "Billing operation could not be completed")" Description="@_error" />
            </ChildContent>
        </AppCard>
    }
    else if (_workspace is not null)
    {
        @if (_workspace.Subscription is null)
        {
            <AppCard>
                <ChildContent>
                    <AppEmptyState
                        Icon="◇"
                        Title="@(L.IsArabic ? "لا يوجد اشتراك حالي" : "No current subscription")"
                        Description="@(L.IsArabic ? "لا توجد حالة اشتراك مرتبطة بهذا الحساب حاليًا." : "There is currently no subscription state linked to this account.")" />
                </ChildContent>
            </AppCard>
        }
        else
        {
            var subscription = _workspace.Subscription;
            var currentPlan = _workspace.CurrentPlan;

            <section class="app-stat-grid" aria-label="@(L.IsArabic ? "ملخص الاشتراك" : "Subscription summary")">
                <AppStatCard Icon="◇" Label="@(L.IsArabic ? "الخطة الحالية" : "Current plan")" Value="@(currentPlan is null ? "—" : LocalizedPlanName(currentPlan))" Description="@(currentPlan is null ? (L.IsArabic ? "الخطة غير متاحة في الكتالوج" : "Plan unavailable in catalog") : FormatPrice(currentPlan))" Tone="accent" />
                <AppStatCard Icon="●" Label="@(L.IsArabic ? "الحالة" : "Status")" Value="@StatusLabel(subscription.Status)" Description="@StatusDescription(subscription)" Tone="@StatusTone(subscription.Status)" />
                <AppStatCard Icon="◷" Label="@(L.IsArabic ? "التاريخ التالي" : "Next relevant date")" Value="@FormatDate(NextRelevantDate(subscription))" Description="@NextRelevantDateLabel(subscription)" Tone="info" />
                <AppStatCard Icon="↗" Label="@(L.IsArabic ? "ربط المزود" : "Provider binding")" Value="@ProviderLabel(_workspace.Checkout)" Description="@ProviderReferenceLabel(_workspace.Checkout)" Tone="neutral" />
            </section>

            <div class="billing-two-column">
                <AppCard Eyebrow="@(L.IsArabic ? "الخطة" : "PLAN")" Title="@(currentPlan is null ? (L.IsArabic ? "الخطة الحالية غير متاحة" : "Current plan unavailable") : LocalizedPlanName(currentPlan))" Subtitle="@(currentPlan is null ? (L.IsArabic ? "تعذر مطابقة الخطة الحالية بكتالوج الخطط." : "The current subscription could not be matched to the plan catalog.") : LocalizedPlanDescription(currentPlan))" HeadingLevel="3">
                    <ChildContent>
                        @if (currentPlan is not null)
                        {
                            <div class="billing-plan-summary">
                                <div><span>@(L.IsArabic ? "السعر" : "Price")</span><strong dir="ltr">@FormatPrice(currentPlan)</strong></div>
                                <div><span>@(L.IsArabic ? "دورة الفوترة" : "Billing interval")</span><strong>@BillingIntervalLabel(currentPlan.BillingInterval)</strong></div>
                                <div><span>@(L.IsArabic ? "فترة السماح" : "Grace policy")</span><strong>@FormatDays(currentPlan.GracePeriodDays)</strong></div>
                            </div>
                        }

                        @if (subscription.CancelAtPeriodEnd)
                        {
                            <div class="billing-notice billing-notice--warning" role="status">
                                <strong>@(L.IsArabic ? "يوجد إلغاء مجدول محليًا لنهاية الفترة." : "A local period-end cancellation flag is present.")</strong>
                                <span>@(L.IsArabic ? "لا يتم تحويل هذا العلم إلى ادعاء عن PayPal. حالة المزود الموثوقة ستظل هي المرجع." : "This flag is not treated as a PayPal cancellation claim. Authoritative provider state remains the source of truth.")</span>
                            </div>
                        }

                        @if (subscription.Status == AccountSubscriptionStatus.Grace && subscription.GraceUntilUtc.HasValue)
                        {
                            <div class="billing-notice billing-notice--warning" role="status">
                                <strong>@(L.IsArabic ? "الحساب داخل فترة سماح." : "The account is in a grace period.")</strong>
                                <span>@($"{(L.IsArabic ? "تنتهي في" : "Ends")}: {FormatDate(subscription.GraceUntilUtc)}")</span>
                            </div>
                        }

                        <div class="billing-action-row">
                            <AppButton Icon="↗" Text="@(L.IsArabic ? "متابعة الدفع عبر PayPal" : "Continue with PayPal")" Busy="@_startingCheckout" Disabled="@(_busy || !_workspace.Checkout.CanStart)" AriaLabel="@(L.IsArabic ? "إنشاء جلسة اشتراك PayPal على الخادم" : "Create a server-side PayPal subscription checkout")" OnClick="StartCheckoutAsync" />
                            <span class="billing-action-help">@CheckoutHelp(_workspace.Checkout)</span>
                        </div>

                        @if (_workspace.Mutations.IsPayPalBound)
                        {
                            <div class="billing-action-row">
                                @if (_workspace.Mutations.CanReactivate)
                                {
                                    <AppButton Icon="↻" Text="@(L.IsArabic ? "طلب إعادة التفعيل" : "Request reactivation")" Busy="@_lifecycleBusy" Disabled="@_busy" OnClick="ReactivateAsync" />
                                }
                                @if (_workspace.Mutations.CanCancelPermanently)
                                {
                                    <AppButton Icon="×" Variant="danger" Text="@(L.IsArabic ? "إلغاء PayPal نهائيًا" : "Permanently cancel PayPal")" Busy="@_lifecycleBusy" Disabled="@_busy" OnClick="CancelPermanentlyAsync" />
                                }
                                <span class="billing-action-help">@(L.IsArabic ? "الإلغاء عبر PayPal نهائي وليس مسار إعادة تفعيل. إعادة التفعيل متاحة فقط عندما تكون حالة المزود معلقة." : "PayPal cancellation is permanent, not a reversible pause. Reactivation is available only for a suspended provider subscription.")</span>
                            </div>
                        }
                    </ChildContent>
                </AppCard>

                <AppCard Eyebrow="@(L.IsArabic ? "دورة الحياة" : "LIFECYCLE")" Title="@(L.IsArabic ? "تواريخ الاشتراك" : "Subscription dates")" Subtitle="@(L.IsArabic ? "تواريخ محفوظة من سلطة الاشتراك الداخلية ومصالحة المزود." : "Dates stored by the internal subscription authority and provider reconciliation.")" HeadingLevel="3">
                    <ChildContent>
                        <dl class="billing-definition-list">
                            <div><dt>@(L.IsArabic ? "بداية التجربة" : "Trial starts")</dt><dd>@FormatDate(subscription.TrialStartedAtUtc)</dd></div>
                            <div><dt>@(L.IsArabic ? "نهاية التجربة" : "Trial ends")</dt><dd>@FormatDate(subscription.TrialEndsAtUtc)</dd></div>
                            <div><dt>@(L.IsArabic ? "بداية الفترة الحالية" : "Current period starts")</dt><dd>@FormatDate(subscription.CurrentPeriodStartUtc)</dd></div>
                            <div><dt>@(L.IsArabic ? "نهاية الفترة الحالية" : "Current period ends")</dt><dd>@FormatDate(subscription.CurrentPeriodEndsAtUtc)</dd></div>
                            <div><dt>@(L.IsArabic ? "آخر دليل من المزود" : "Last provider evidence")</dt><dd>@FormatDate(subscription.LastProviderEventAtUtc)</dd></div>
                        </dl>
                    </ChildContent>
                </AppCard>
            </div>

            <AppCard Eyebrow="@(L.IsArabic ? "الاستحقاقات" : "ENTITLEMENTS")" Title="@(L.IsArabic ? "الحدود والقدرات المكوّنة" : "Configured limits & capabilities")" Subtitle="@(L.IsArabic ? "هذه القيم هي إعدادات الخطة المخزنة وتطبقها الخدمات على الخادم." : "These are stored plan settings enforced by server-side services.")" HeadingLevel="3">
                <ChildContent>
                    @if (_workspace.Entitlements.Count == 0)
                    {
                        <AppEmptyState Icon="—" Title="@(L.IsArabic ? "لا توجد استحقاقات مكوّنة" : "No entitlements configured")" Description="@(L.IsArabic ? "لم يتم العثور على قيم استحقاق لهذه الخطة." : "No entitlement values were found for this plan.")" />
                    }
                    else
                    {
                        <div class="billing-entitlement-grid" aria-label="@(L.IsArabic ? "استحقاقات الخطة" : "Plan entitlements")">
                            @foreach (var entitlement in _workspace.Entitlements)
                            {
                                <article class="billing-entitlement"><span>@EntitlementLabel(entitlement.Key)</span><strong>@EntitlementValue(entitlement)</strong><small dir="ltr">@entitlement.Key</small></article>
                            }
                        </div>
                    }
                </ChildContent>
            </AppCard>
        }

        <AppCard Eyebrow="@(L.IsArabic ? "الكتالوج" : "CATALOG")" Title="@(L.IsArabic ? "الخطط المتاحة" : "Available plans")" Subtitle="@(L.IsArabic ? "تغيير الخطة يرسل طلب revise إلى PayPal؛ الخطة المحلية لا تتغير حتى تؤكد المصالحة plan_id الموثوق." : "Plan changes send a PayPal revision request; the local plan does not change until reconciliation confirms the authoritative provider plan ID.")" HeadingLevel="3">
            <ChildContent>
                @if (_workspace.AvailablePlans.Count == 0)
                {
                    <AppEmptyState Icon="◇" Title="@(L.IsArabic ? "لا توجد خطط مفعلة" : "No enabled plans")" Description="@(L.IsArabic ? "لم يتم تكوين خطط متاحة للحساب بعد." : "No plans are currently configured as available.")" />
                }
                else
                {
                    <div class="billing-plan-grid" aria-label="@(L.IsArabic ? "كتالوج الخطط المتاحة" : "Available plan catalog")">
                        @foreach (var plan in _workspace.AvailablePlans)
                        {
                            var isCurrent = _workspace.Subscription?.PlanId == plan.Id;
                            var canChange = !isCurrent && _workspace.Mutations.CanChangePlan && !string.IsNullOrWhiteSpace(plan.GatewayPlanId);
                            <article class="billing-plan-card @(isCurrent ? "billing-plan-card--current" : string.Empty)">
                                <div class="billing-plan-card__heading">
                                    <div><strong>@LocalizedPlanName(plan)</strong><span>@LocalizedPlanDescription(plan)</span></div>
                                    <AppBadge Tone="@(isCurrent ? "success" : "neutral")" Text="@(isCurrent ? (L.IsArabic ? "الحالية" : "Current") : (L.IsArabic ? "متاحة" : "Available"))" />
                                </div>
                                <div class="billing-plan-card__price" dir="ltr">@FormatPrice(plan)</div>
                                <small>@BillingIntervalLabel(plan.BillingInterval) · @($"{(L.IsArabic ? "سماح" : "Grace")}: {FormatDays(plan.GracePeriodDays)}")</small>
                                @if (canChange)
                                {
                                    <div class="billing-action-row">
                                        <AppButton Text="@(L.IsArabic ? "طلب تغيير لهذه الخطة" : "Request change to this plan")" Busy="@(_changingPlanId == plan.Id)" Disabled="@_busy" OnClick="_ => ChangePlanAsync(plan)" />
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
            </ChildContent>
        </AppCard>

        @if (_workspace.Subscription is not null)
        {
            var history = _workspace.History ?? Array.Empty<AccountBillingHistoryItem>();
            <AppCard Eyebrow="@(L.IsArabic ? "سجل الفوترة" : "BILLING HISTORY")" Title="@(L.IsArabic ? "سجل الفوترة والإشعارات" : "Billing & notification history")" Subtitle="@(L.IsArabic ? "يعرض فقط تغييرات الاشتراك والخطة الملتزمة بعد المصالحة، مع حالة إشعار البريد المرتبط بها. الرجوع من المتصفح أو قبول أمر PayPal ليس حدث نجاح هنا." : "Shows only committed subscription and plan changes after reconciliation, together with correlated email delivery state. Browser returns and accepted PayPal commands are not success events here.")" HeadingLevel="3">
                <ChildContent>
                    @if (history.Count == 0)
                    {
                        <AppEmptyState Icon="◷" Title="@(L.IsArabic ? "لا توجد أحداث فوترة موثقة" : "No authoritative billing events")" Description="@(L.IsArabic ? "سيظهر السجل عندما يلتزم انتقال حالة أو تغيير خطة بواسطة سلطة الاشتراك أو مصالحة المزود." : "History appears after a status transition or plan change is committed by subscription authority or provider reconciliation.")" />
                    }
                    else
                    {
                        <div class="billing-history" role="list" aria-label="@(L.IsArabic ? "سجل الفوترة الموثق" : "Authoritative billing history")">
                            @foreach (var item in history)
                            {
                                <article class="billing-history__item" role="listitem">
                                    <div class="billing-history__states">
                                        @if (item.Kind == AccountBillingHistoryKind.StatusTransition && item.FromStatus.HasValue && item.ToStatus.HasValue)
                                        {
                                            <AppBadge Tone="neutral" Text="@StatusLabel(item.FromStatus.Value)" />
                                            <span aria-hidden="true">→</span>
                                            <AppBadge Tone="@StatusTone(item.ToStatus.Value)" Text="@StatusLabel(item.ToStatus.Value)" />
                                        }
                                        else
                                        {
                                            <AppBadge Tone="info" Text="@(L.IsArabic ? "تغيير خطة" : "Plan change")" />
                                            <span>@HistoryPlanName(item, true)</span>
                                            <span aria-hidden="true">→</span>
                                            <strong>@HistoryPlanName(item, false)</strong>
                                            @if (item.Amount.HasValue && !string.IsNullOrWhiteSpace(item.Currency))
                                            {
                                                <AppBadge Tone="neutral" Text="@HistoryAmount(item)" />
                                            }
                                        }
                                        <AppBadge Tone="@NotificationTone(item.NotificationState)" Text="@NotificationLabel(item.NotificationState)" />
                                    </div>
                                    <div class="billing-history__meta">
                                        <strong>@SourceLabel(item.Source)</strong>
                                        <time datetime="@item.OccurredAtUtc.ToString("O", CultureInfo.InvariantCulture)">@FormatDate(item.OccurredAtUtc)</time>
                                    </div>
                                    <p>@item.Reason</p>
                                    @if (item.ProviderEvidenceAtUtc.HasValue)
                                    {
                                        <small>@($"{(L.IsArabic ? "دليل المزود" : "Provider evidence")}: {FormatDate(item.ProviderEvidenceAtUtc)}")</small>
                                    }
                                    <small>@NotificationDescription(item)</small>
                                </article>
                            }
                        </div>
                    }
                </ChildContent>
            </AppCard>
        }
    }
</AppPage>

@code {
    [SupplyParameterFromQuery(Name = "checkout")]
    public string? CheckoutResult { get; set; }

    private AccountBillingService Billing => ActivatorUtilities.CreateInstance<AccountBillingService>(Services);
    private AccountBillingWorkspaceView? _workspace;
    private bool _loading = true;
    private bool _startingCheckout;
    private bool _lifecycleBusy;
    private Guid? _changingPlanId;
    private string? _error;
    private string? _operationMessage;
    private bool _busy => _startingCheckout || _lifecycleBusy || _changingPlanId.HasValue;

    private bool IsCheckoutReturned => string.Equals(CheckoutResult, "returned", StringComparison.OrdinalIgnoreCase);
    private bool IsCheckoutCancelled => string.Equals(CheckoutResult, "cancelled", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try { _workspace = await Billing.GetAsync(); }
        catch
        {
            _workspace = null;
            _error = L.IsArabic ? "تعذر تحميل بيانات الاشتراك بأمان. أعد المحاولة أو راجع حالة النظام." : "Subscription data could not be loaded safely. Try again or review system health.";
        }
        finally { _loading = false; }
    }

    private async Task StartCheckoutAsync(MouseEventArgs _)
    {
        if (_workspace?.Checkout.CanStart != true || _busy) return;
        _startingCheckout = true;
        _error = null;
        _operationMessage = null;
        try
        {
            var returnUri = Navigation.ToAbsoluteUri("/account/billing?checkout=returned");
            var cancelUri = Navigation.ToAbsoluteUri("/account/billing?checkout=cancelled");
            var session = await Billing.CreatePayPalCheckoutAsync(returnUri, cancelUri);
            Navigation.NavigateTo(session.CheckoutUri.ToString(), forceLoad: true);
        }
        catch
        {
            _error = L.IsArabic ? "تعذر بدء جلسة PayPal. لم يتم تسجيل نجاح دفع ولم تتغير حالة الاشتراك." : "PayPal checkout could not be started. No payment success was recorded and subscription state was not changed.";
        }
        finally { _startingCheckout = false; }
    }

    private async Task ChangePlanAsync(SubscriptionPlanItem plan)
    {
        if (_busy) return;
        _changingPlanId = plan.Id;
        _error = null;
        _operationMessage = null;
        try
        {
            var result = await Billing.ChangePlanAsync(plan.Id);
            if (result.RequiresUserApproval && result.ApprovalUri is not null)
            {
                Navigation.NavigateTo(result.ApprovalUri.ToString(), forceLoad: true);
                return;
            }
            _operationMessage = L.IsArabic ? "قبل PayPal طلب تغيير الخطة. ستظل الخطة الحالية كما هي حتى تؤكد المصالحة الخطة الجديدة من PayPal." : "PayPal accepted the plan-change request. The current plan remains unchanged until reconciliation confirms the new PayPal plan.";
            await LoadAsync();
        }
        catch (Exception ex) { _error = L.TranslateMessage(ex.Message); }
        finally { _changingPlanId = null; }
    }

    private async Task CancelPermanentlyAsync(MouseEventArgs _)
    {
        if (_busy) return;
        _lifecycleBusy = true;
        _error = null;
        _operationMessage = null;
        try
        {
            await Billing.CancelPermanentlyAsync();
            _operationMessage = L.IsArabic ? "قبل PayPal طلب الإلغاء النهائي. ستظل الحالة المحلية كما هي حتى تؤكد المصالحة الإلغاء من المزود." : "PayPal accepted the permanent cancellation request. Local state remains unchanged until provider reconciliation confirms cancellation.";
            await LoadAsync();
        }
        catch (Exception ex) { _error = L.TranslateMessage(ex.Message); }
        finally { _lifecycleBusy = false; }
    }

    private async Task ReactivateAsync(MouseEventArgs _)
    {
        if (_busy) return;
        _lifecycleBusy = true;
        _error = null;
        _operationMessage = null;
        try
        {
            await Billing.ReactivateAsync();
            _operationMessage = L.IsArabic ? "قبل PayPal طلب إعادة التفعيل. ستظل الحالة المحلية معلقة حتى تؤكد المصالحة التفعيل من المزود." : "PayPal accepted the reactivation request. Local state remains suspended until provider reconciliation confirms activation.";
            await LoadAsync();
        }
        catch (Exception ex) { _error = L.TranslateMessage(ex.Message); }
        finally { _lifecycleBusy = false; }
    }

    private string LocalizedPlanName(SubscriptionPlanItem plan) => L.IsArabic ? plan.NameAr : plan.NameEn;
    private string LocalizedPlanDescription(SubscriptionPlanItem plan) => L.IsArabic ? plan.DescriptionAr : plan.DescriptionEn;
    private string FormatPrice(SubscriptionPlanItem plan) => $"{plan.Price.ToString("0.00", CultureInfo.InvariantCulture)} {plan.Currency}";
    private string BillingIntervalLabel(string interval) => interval == SubscriptionPlan.YearlyInterval ? (L.IsArabic ? "سنوي" : "Yearly") : (L.IsArabic ? "شهري" : "Monthly");
    private string FormatDays(int days) => L.IsArabic ? $"{days} يوم" : $"{days} day{(days == 1 ? string.Empty : "s")}";
    private string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToLocalTime().ToString(L.IsArabic ? "dd/MM/yyyy HH:mm" : "yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) : "—";

    private DateTime? NextRelevantDate(AccountSubscriptionItem subscription) => subscription.Status == AccountSubscriptionStatus.Grace ? subscription.GraceUntilUtc ?? subscription.CurrentPeriodEndsAtUtc : subscription.Status == AccountSubscriptionStatus.Trialing ? subscription.TrialEndsAtUtc ?? subscription.CurrentPeriodEndsAtUtc : subscription.CurrentPeriodEndsAtUtc ?? subscription.TrialEndsAtUtc;
    private string NextRelevantDateLabel(AccountSubscriptionItem subscription) => subscription.Status switch { AccountSubscriptionStatus.Trialing => L.IsArabic ? "نهاية التجربة أو الفترة" : "Trial or period end", AccountSubscriptionStatus.Grace => L.IsArabic ? "نهاية فترة السماح" : "Grace period end", _ when subscription.CancelAtPeriodEnd => L.IsArabic ? "موعد الإلغاء المجدول" : "Scheduled cancellation boundary", _ => L.IsArabic ? "نهاية الفترة الحالية" : "Current period end" };
    private string StatusLabel(AccountSubscriptionStatus status) => status switch { AccountSubscriptionStatus.Trialing => L.IsArabic ? "تجريبي" : "Trialing", AccountSubscriptionStatus.Active => L.IsArabic ? "نشط" : "Active", AccountSubscriptionStatus.PastDue => L.IsArabic ? "متأخر الدفع" : "Past due", AccountSubscriptionStatus.Grace => L.IsArabic ? "فترة سماح" : "Grace", AccountSubscriptionStatus.Suspended => L.IsArabic ? "معلق" : "Suspended", AccountSubscriptionStatus.Cancelled => L.IsArabic ? "ملغي" : "Cancelled", AccountSubscriptionStatus.Expired => L.IsArabic ? "منتهي" : "Expired", _ => status.ToString() };
    private string StatusTone(AccountSubscriptionStatus status) => status switch { AccountSubscriptionStatus.Active => "success", AccountSubscriptionStatus.Trialing => "info", AccountSubscriptionStatus.PastDue or AccountSubscriptionStatus.Grace => "warning", AccountSubscriptionStatus.Suspended or AccountSubscriptionStatus.Cancelled or AccountSubscriptionStatus.Expired => "danger", _ => "neutral" };
    private string StatusDescription(AccountSubscriptionItem subscription) => subscription.Status switch { AccountSubscriptionStatus.Active => L.IsArabic ? "الحالة الداخلية مفعلة" : "Internal subscription authority is active", AccountSubscriptionStatus.Trialing => L.IsArabic ? "الاشتراك في فترة تجريبية" : "Subscription is in trial", AccountSubscriptionStatus.PastDue => L.IsArabic ? "المصالحة تشير إلى دفع متأخر" : "Reconciliation indicates a payment problem", AccountSubscriptionStatus.Grace => L.IsArabic ? "الوصول داخل سياسة السماح" : "Access is within grace policy", _ => L.IsArabic ? "راجع سجل الاشتراك لمزيد من التفاصيل" : "Review subscription audit for details" };
    private string ProviderLabel(AccountBillingCheckoutAvailability checkout) => checkout.HasProviderBinding ? string.IsNullOrWhiteSpace(checkout.ProviderKey) ? (L.IsArabic ? "مزود خارجي" : "External provider") : checkout.ProviderKey : L.IsArabic ? "غير مربوط" : "Not bound";
    private string ProviderReferenceLabel(AccountBillingCheckoutAvailability checkout) => string.IsNullOrWhiteSpace(checkout.ProviderReferenceDisplay) ? (L.IsArabic ? "لا يوجد مرجع مزود مخزن" : "No stored provider reference") : $"{(L.IsArabic ? "مرجع" : "Reference")}: {checkout.ProviderReferenceDisplay}";

    private string CheckoutHelp(AccountBillingCheckoutAvailability checkout) => checkout.BlockReason switch
    {
        AccountBillingCheckoutBlockReason.None => L.IsArabic ? "سيتم إنشاء جلسة على الخادم؛ عودة المتصفح ليست دليل دفع." : "A server-side session will be created; the browser return is not payment evidence.",
        AccountBillingCheckoutBlockReason.NoSubscription => L.IsArabic ? "لا يوجد اشتراك حالي لبدء checkout." : "There is no current subscription to check out.",
        AccountBillingCheckoutBlockReason.SubscriptionExpired => L.IsArabic ? "الاشتراك المنتهي لا يعاد استخدام سجله لبدء checkout جديد." : "An expired subscription record is not reused for a new checkout.",
        AccountBillingCheckoutBlockReason.CurrentPlanUnavailable => L.IsArabic ? "الخطة الحالية غير متاحة أو غير مفعلة." : "The current plan is unavailable or disabled.",
        AccountBillingCheckoutBlockReason.ProviderPlanNotConfigured => L.IsArabic ? "الخطة غير مربوطة بخطة PayPal على الخادم." : "The plan has no server-side PayPal mapping.",
        AccountBillingCheckoutBlockReason.ProviderAlreadyBound => L.IsArabic ? "الاشتراك مربوط بالفعل بمرجع مزود خارجي؛ استخدم تغيير الخطة بدل checkout جديد." : "The subscription is already bound to an external provider; use the plan-change flow instead of a new checkout.",
        _ => L.IsArabic ? "checkout غير متاح." : "Checkout is unavailable."
    };

    private string EntitlementLabel(string key) => key switch { EntitlementDefinitionCatalog.SitesMax => L.IsArabic ? "الحد الأقصى للمواقع" : "Maximum sites", EntitlementDefinitionCatalog.EmailSiteRecipientsMax => L.IsArabic ? "مستلمو بريد الموقع" : "Site email recipients", EntitlementDefinitionCatalog.EmailSchedulesMax => L.IsArabic ? "جداول البريد" : "Email schedules", EntitlementDefinitionCatalog.EmailDashboardDigest => L.IsArabic ? "ملخص الداشبورد بالبريد" : "Dashboard email digest", EntitlementDefinitionCatalog.AutomationSchedulesMax => L.IsArabic ? "جداول الأتمتة" : "Automation schedules", EntitlementDefinitionCatalog.AiEnabled => L.IsArabic ? "الذكاء الاصطناعي" : "AI capability", EntitlementDefinitionCatalog.AiMonthlyRequestsMax => L.IsArabic ? "طلبات AI الشهرية" : "Monthly AI requests", EntitlementDefinitionCatalog.BackupRetentionDays => L.IsArabic ? "احتفاظ النسخ الاحتياطي" : "Backup retention", EntitlementDefinitionCatalog.PremiumSeo => L.IsArabic ? "SEO المميز" : "Premium SEO", _ => key };
    private string EntitlementValue(PlanEntitlementItem item) { if (item.ValueType == EntitlementValueType.Boolean && bool.TryParse(item.CanonicalValue, out var enabled)) return enabled ? (L.IsArabic ? "مفعّل" : "Enabled") : (L.IsArabic ? "غير مفعّل" : "Disabled"); if (item.Key == EntitlementDefinitionCatalog.BackupRetentionDays && long.TryParse(item.CanonicalValue, NumberStyles.Integer, CultureInfo.InvariantCulture, out var days)) return L.IsArabic ? $"{days} يوم" : $"{days} days"; return item.CanonicalValue; }
    private string SourceLabel(SubscriptionTransitionSource source) => source switch { SubscriptionTransitionSource.Provider => L.IsArabic ? "المزود" : "Provider", SubscriptionTransitionSource.Administration => L.IsArabic ? "الإدارة" : "Administration", _ => L.IsArabic ? "النظام" : "System" };

    private string HistoryPlanName(AccountBillingHistoryItem item, bool from)
    {
        var name = L.IsArabic
            ? (from ? item.FromPlanNameAr : item.ToPlanNameAr)
            : (from ? item.FromPlanNameEn : item.ToPlanNameEn);
        return string.IsNullOrWhiteSpace(name) ? (L.IsArabic ? "خطة غير متاحة" : "Unavailable plan") : name;
    }

    private string HistoryAmount(AccountBillingHistoryItem item) =>
        item.Amount.HasValue && !string.IsNullOrWhiteSpace(item.Currency)
            ? $"{item.Amount.Value.ToString("0.00", CultureInfo.InvariantCulture)} {item.Currency}"
            : "—";

    private string NotificationLabel(AccountBillingNotificationState state) => state switch
    {
        AccountBillingNotificationState.NotConfigured => L.IsArabic ? "لا يوجد مستلم بريد" : "No email recipient",
        AccountBillingNotificationState.NotQueued => L.IsArabic ? "بانتظار الترحيل" : "Awaiting relay",
        AccountBillingNotificationState.Queued => L.IsArabic ? "البريد في الطابور" : "Email queued",
        AccountBillingNotificationState.Sending => L.IsArabic ? "جارٍ الإرسال" : "Sending",
        AccountBillingNotificationState.Sent => L.IsArabic ? "تم إرسال البريد" : "Email sent",
        AccountBillingNotificationState.Retrying => L.IsArabic ? "إعادة محاولة" : "Retrying",
        AccountBillingNotificationState.Failed => L.IsArabic ? "فشل البريد" : "Email failed",
        AccountBillingNotificationState.Cancelled => L.IsArabic ? "ألغي البريد" : "Email cancelled",
        _ => L.IsArabic ? "غير معروف" : "Unknown"
    };

    private static string NotificationTone(AccountBillingNotificationState state) => state switch
    {
        AccountBillingNotificationState.Sent => "success",
        AccountBillingNotificationState.Queued or AccountBillingNotificationState.Sending => "info",
        AccountBillingNotificationState.Retrying or AccountBillingNotificationState.NotQueued => "warning",
        AccountBillingNotificationState.Failed or AccountBillingNotificationState.Cancelled => "danger",
        _ => "neutral"
    };

    private string NotificationDescription(AccountBillingHistoryItem item) => item.NotificationState switch
    {
        AccountBillingNotificationState.NotConfigured => L.IsArabic ? "لم يكن هناك مستلم بريد فوترة مفعّل لهذا الحساب عند قراءة السجل." : "No enabled billing email recipient is currently configured for this account.",
        AccountBillingNotificationState.NotQueued => L.IsArabic ? "الحدث موثق، لكن لم يتم العثور على رسالة outbox مرتبطة به حتى الآن." : "The event is committed, but no correlated outbox message exists yet.",
        AccountBillingNotificationState.Sent => $"{(L.IsArabic ? "أرسل في" : "Sent")}: {FormatDate(item.NotificationSentAtUtc)}",
        AccountBillingNotificationState.Retrying => $"{(L.IsArabic ? "المحاولة" : "Attempt")} {item.NotificationAttemptCount}/{item.NotificationMaxAttempts} · {(L.IsArabic ? "المحاولة التالية" : "Next retry")}: {FormatDate(item.NotificationNextAttemptAtUtc)}",
        AccountBillingNotificationState.Queued or AccountBillingNotificationState.Sending => $"{(L.IsArabic ? "المحاولة" : "Attempt")} {item.NotificationAttemptCount}/{item.NotificationMaxAttempts}",
        AccountBillingNotificationState.Failed => $"{(L.IsArabic ? "توقفت بعد" : "Stopped after")} {item.NotificationAttemptCount}/{item.NotificationMaxAttempts} {(L.IsArabic ? "محاولات" : "attempts")}",
        AccountBillingNotificationState.Cancelled => L.IsArabic ? "تم إلغاء رسالة الإشعار المرتبطة بهذا الحدث." : "The notification message correlated with this event was cancelled.",
        _ => string.Empty
    };
}
