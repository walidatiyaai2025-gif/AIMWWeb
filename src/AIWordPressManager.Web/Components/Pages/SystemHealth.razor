@page "/system-health"
@rendermode InteractiveServer
@inject SystemHealthWebService HealthService
@inject AppLanguageService L
@inject IJSRuntime JS

<PageTitle>@(L.IsArabic ? "صحة النظام" : "System Health")</PageTitle>

<AppPage PageKey="system-health" Class="system-health-page" Width="wide">
    <AppToolbar Eyebrow="@(L.IsArabic ? "التشخيص المباشر" : "LIVE DIAGNOSTICS")"
                Title="@(L.IsArabic ? "صحة النظام والتشخيص" : "System Health & Diagnostics")"
                Subtitle="@(L.IsArabic ? "فحص التطبيق والتخزين المُدار وقاعدة البيانات والمواقع التابعة لحسابك من مصادر النظام الحقيقية." : "Real application, managed storage, configured database, and account-owned WordPress diagnostics.")">
        <Actions>
            @if (snapshot is not null)
            {
                <AppBadge Tone="@(snapshot.IsHealthy ? "success" : "danger")" Icon="●"
                          Text="@(snapshot.IsHealthy ? (L.IsArabic ? "النظام سليم" : "System healthy") : (L.IsArabic ? "يحتاج مراجعة" : "Attention required"))" />
                <button type="button" class="btn" disabled="@isLoading" @onclick="CopySummaryAsync">
                    @(L.IsArabic ? "نسخ الملخص" : "Copy summary")
                </button>
            }
            <AppButton Variant="primary" Icon="↻" Busy="@isLoading" Disabled="@isLoading"
                       Text="@(isLoading ? (L.IsArabic ? "جارٍ الفحص..." : "Checking...") : (L.IsArabic ? "إعادة الفحص" : "Run checks"))"
                       OnClick="RefreshClickedAsync" />
        </Actions>
    </AppToolbar>

    @if (!string.IsNullOrWhiteSpace(actionMessage))
    {
        <div class="panel" role="status" style="padding:12px 16px;margin-bottom:16px">@actionMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert danger" role="alert" style="margin-bottom:16px">@errorMessage</div>
    }

    @if (snapshot is null && string.IsNullOrWhiteSpace(errorMessage))
    {
        <AppLoading Title="@(L.IsArabic ? "جارٍ فحص صحة النظام" : "Checking system health")"
                    Message="@(L.IsArabic ? "يتم فحص التطبيق والتخزين المُدار وقاعدة البيانات والمواقع التابعة لحسابك." : "Checking the application, managed storage, configured database, and account-owned WordPress sites.")" />
    }
    else if (snapshot is not null)
    {
        <section class="app-stat-grid" aria-label="@(L.IsArabic ? "ملخص صحة النظام" : "System health summary")">
            <AppStatCard Icon="♥" Label="@(L.IsArabic ? "الحالة العامة" : "Overall status")"
                         Value="@(snapshot.IsHealthy ? (L.IsArabic ? "سليم" : "Healthy") : (L.IsArabic ? "تحذير" : "Warning"))"
                         Description="@($"{HealthyCount} / {snapshot.Checks.Count}")" Tone="@(snapshot.IsHealthy ? "success" : "danger")" />
            <AppStatCard Icon="✓" Label="@(L.IsArabic ? "الفحوصات السليمة" : "Healthy checks")"
                         Value="@(HealthyCount.ToString())" Description="@(L.IsArabic ? "تعمل بصورة طبيعية" : "Operating normally")" Tone="success" />
            <AppStatCard Icon="!" Label="@(L.IsArabic ? "تحتاج مراجعة" : "Needs attention")"
                         Value="@(FailedCount.ToString())" Description="@(L.IsArabic ? "فحوصات غير سليمة" : "Unhealthy checks")"
                         Tone="@(FailedCount == 0 ? "success" : "danger")" />
            <AppStatCard Icon="◷" Label="@(L.IsArabic ? "آخر فحص" : "Last checked")"
                         Value="@FormatDate(snapshot.CheckedAtUtc)" Description="@($"v{snapshot.Version}")" Tone="info" ValueClass="health-date" />
        </section>

        <section class="system-health-layout" aria-label="@(L.IsArabic ? "تفاصيل صحة النظام" : "System health details")">
            <div class="system-health-main">
                <AppDataGrid TItem="SystemHealthCheck"
                             Items="@snapshot.Checks"
                             KeySelector="@(check => check.Key)"
                             SearchKeySelector="@HealthSearchText"
                             SortKeySelector="@CheckTitle"
                             CsvHeaders="@CsvHeaders"
                             CsvRowSelector="@HealthCsvRow"
                             CsvFileName="@CsvFileName"
                             PageSize="10"
                             Selectable="true"
                             SearchPlaceholder="@(L.IsArabic ? "ابحث في المكوّن أو الحالة أو الهدف أو التفاصيل..." : "Search component, status, target, or details...")"
                             SearchAriaLabel="@(L.IsArabic ? "بحث نتائج صحة النظام" : "Search system health results")"
                             SortText="@(L.IsArabic ? "ترتيب" : "Sort")"
                             ExportText="@(L.IsArabic ? "تصدير CSV" : "Export CSV")"
                             RowsPerPageText="@(L.IsArabic ? "صفوف" : "Rows")"
                             EmptyTitle="@(L.IsArabic ? "لا توجد نتائج مطابقة" : "No matching checks")"
                             EmptyDescription="@(L.IsArabic ? "غيّر كلمات البحث أو أعد تشغيل الفحص." : "Change the search text or run the checks again.")"
                             SelectedText="@(L.IsArabic ? "محدد" : "selected")"
                             ShowingText="@(L.IsArabic ? "عرض" : "Showing")"
                             OfText="@(L.IsArabic ? "من" : "of")">
                    <Toolbar>
                        <div class="health-grid-title">
                            <strong>@(L.IsArabic ? "حالة مكونات النظام" : "System component status")</strong>
                            <small>@(L.IsArabic ? "يمكن البحث والترتيب والتصدير من نفس الجدول" : "Search, sort, select, and export from one grid")</small>
                        </div>
                        <AppBadge Tone="info" Text="@(snapshot.Checks.Count.ToString())" />
                    </Toolbar>
                    <Header>
                        <th>@(L.IsArabic ? "المكوّن" : "Component")</th>
                        <th>@(L.IsArabic ? "الحالة" : "Status")</th>
                        <th>@(L.IsArabic ? "الهدف" : "Target")</th>
                        <th>@(L.IsArabic ? "التفاصيل" : "Details")</th>
                    </Header>
                    <RowTemplate Context="check">
                        <td><strong>@CheckTitle(check)</strong></td>
                        <td><AppBadge Tone="@(check.IsHealthy ? "success" : "danger")" Text="@CheckStatus(check)" /></td>
                        <td><code>@check.Target</code></td>
                        <td>@check.Details</td>
                    </RowTemplate>
                </AppDataGrid>
            </div>

            <aside class="system-health-side">
                <AppDetailsPanel Icon="@(snapshot.IsHealthy ? "✓" : "!")"
                                 Eyebrow="@(L.IsArabic ? "الصحة العامة" : "OVERALL HEALTH")"
                                 Title="@(snapshot.IsHealthy ? (L.IsArabic ? "المنصة تعمل بصورة جيدة" : "Platform is healthy") : (L.IsArabic ? "توجد عناصر تحتاج مراجعة" : "Some checks need attention"))"
                                 Description="@(snapshot.IsHealthy ? (L.IsArabic ? "جميع الفحوصات الأساسية اجتازت الاختبار بنجاح." : "All essential diagnostics passed successfully.") : (L.IsArabic ? "راجع الصفوف غير السليمة لتحديد سبب المشكلة." : "Review unhealthy rows to identify the issue."))"
                                 Tone="@(snapshot.IsHealthy ? "success" : "warning")">
                    <ChildContent>
                        <AppProgressBar Value="@HealthPercent" Tone="@(snapshot.IsHealthy ? "success" : "warning")"
                                        Label="@(L.IsArabic ? "مؤشر الصحة" : "Health score")" />
                    </ChildContent>
                </AppDetailsPanel>

                <AppSection Title="@(L.IsArabic ? "معلومات الفحص" : "Diagnostic information")" HeadingLevel="3">
                    <ChildContent>
                        <dl class="health-info-list">
                            <div><dt>@(L.IsArabic ? "الإصدار" : "Version")</dt><dd>@snapshot.Version</dd></div>
                            <div><dt>@(L.IsArabic ? "إجمالي الفحوصات" : "Total checks")</dt><dd>@snapshot.Checks.Count</dd></div>
                            <div><dt>@(L.IsArabic ? "الناجحة" : "Healthy")</dt><dd>@HealthyCount</dd></div>
                            <div><dt>@(L.IsArabic ? "غير السليمة" : "Unhealthy")</dt><dd>@FailedCount</dd></div>
                            <div><dt>@(L.IsArabic ? "وقت الفحص" : "Checked at")</dt><dd>@FormatDate(snapshot.CheckedAtUtc)</dd></div>
                        </dl>
                    </ChildContent>
                </AppSection>

                <AppDetailsPanel Icon="≡" Eyebrow="@(L.IsArabic ? "الإجراءات" : "ACTIONS")"
                                 Title="@(L.IsArabic ? "ماذا أفعل عند ظهور خطأ؟" : "What to do when a check fails")"
                                 Description="@(L.IsArabic ? "أعد الفحص أولًا، ثم راجع الهدف والتفاصيل وافتح السجلات عند الحاجة." : "Run checks again, review the target and details, then open Logs when needed.")">
                    <Actions><AppButton Href="/module/logs" Text="@(L.IsArabic ? "فتح السجلات" : "Open logs")" /></Actions>
                </AppDetailsPanel>
            </aside>
        </section>
    }
</AppPage>

@code {
    private SystemHealthSnapshot? snapshot;
    private bool isLoading;
    private string? actionMessage;
    private string? errorMessage;
    private int HealthyCount => snapshot?.Checks.Count(x => x.IsHealthy) ?? 0;
    private int FailedCount => snapshot?.Checks.Count(x => !x.IsHealthy) ?? 0;
    private int HealthPercent => snapshot is null || snapshot.Checks.Count == 0 ? 0 : (int)Math.Round(HealthyCount * 100d / snapshot.Checks.Count);
    private IReadOnlyList<string> CsvHeaders => L.IsArabic
        ? new[] { "المكوّن", "الحالة", "الهدف", "التفاصيل", "وقت الفحص", "الإصدار" }
        : new[] { "Component", "Status", "Target", "Details", "Checked At", "Version" };
    private string CsvFileName => $"system-health-{DateTime.Now:yyyyMMdd-HHmmss}.csv";

    protected override Task OnInitializedAsync() => RefreshAsync();
    private Task RefreshClickedAsync(MouseEventArgs _) => RefreshAsync();

    private async Task RefreshAsync()
    {
        if (isLoading) return;
        isLoading = true;
        actionMessage = null;
        errorMessage = null;
        try
        {
            snapshot = await HealthService.CheckAsync();
        }
        catch (UnauthorizedAccessException)
        {
            snapshot = null;
            errorMessage = L.IsArabic ? "ليست لديك صلاحية عرض تشخيص صحة النظام." : "You do not have permission to view system-health diagnostics.";
        }
        catch (Exception ex)
        {
            snapshot = null;
            errorMessage = L.IsArabic
                ? $"تعذر إكمال فحص صحة النظام ({ex.GetType().Name}). لم يتم عرض نتيجة نجاح قديمة أو وهمية."
                : $"System-health checks could not complete ({ex.GetType().Name}). No stale or synthetic success result is being shown.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CopySummaryAsync()
    {
        if (snapshot is null || isLoading) return;
        actionMessage = null;
        errorMessage = null;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", BuildCopySummary());
            actionMessage = L.IsArabic ? "تم نسخ ملخص صحة النظام." : "System-health summary copied.";
        }
        catch (Exception ex)
        {
            errorMessage = L.IsArabic
                ? $"تعذر نسخ الملخص ({ex.GetType().Name})."
                : $"The system-health summary could not be copied ({ex.GetType().Name}).";
        }
    }

    private string BuildCopySummary()
    {
        if (snapshot is null) return string.Empty;
        var lines = new List<string>
        {
            "AI WordPress Manager - System Health Summary",
            "Overall: " + (snapshot.IsHealthy ? "Healthy" : "Attention required"),
            "Checked at: " + snapshot.CheckedAtUtc.ToString("O"),
            "Version: " + snapshot.Version
        };
        lines.AddRange(snapshot.Checks.Select(check =>
            $"{CheckTitle(check)} | {CheckStatus(check)} | {check.Target} | {check.Details}"));
        return string.Join(Environment.NewLine, lines);
    }

    private string CheckTitle(SystemHealthCheck check) => check.Key switch
    {
        "application" => L.IsArabic ? "التطبيق وبيئة التشغيل" : "Application runtime",
        "storage" => L.IsArabic ? "التخزين المُدار" : "Managed storage",
        "database" => L.IsArabic ? $"قاعدة بيانات {check.Target}" : $"{check.Target} database",
        "sqlite" => L.IsArabic ? "قاعدة بيانات SQLite" : "SQLite database",
        "logs" => L.IsArabic ? "تخزين السجلات المُدار" : "Managed log storage",
        _ => check.Key
    };

    private string CheckStatus(SystemHealthCheck check) => check.IsHealthy
        ? (L.IsArabic ? "سليم" : "Healthy")
        : (L.IsArabic ? "فشل" : "Failed");

    private string HealthSearchText(SystemHealthCheck check) => string.Join(' ',
        check.Key,
        CheckTitle(check),
        CheckStatus(check),
        check.Target,
        check.Details);

    private IReadOnlyList<string> HealthCsvRow(SystemHealthCheck check) => new[]
    {
        CheckTitle(check),
        CheckStatus(check),
        check.Target,
        check.Details,
        snapshot is null ? string.Empty : FormatDate(snapshot.CheckedAtUtc),
        snapshot?.Version ?? string.Empty
    };

    private string FormatDate(DateTimeOffset value) => value.ToLocalTime().ToString(L.IsArabic ? "yyyy-MM-dd HH:mm:ss" : "MMM d, yyyy HH:mm:ss");
}
