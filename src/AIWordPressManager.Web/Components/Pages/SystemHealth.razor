@page "/system-health"
@rendermode InteractiveServer
@inject SystemHealthWebService HealthService
@inject AppLanguageService L

<PageTitle>@(L.IsArabic ? "صحة النظام" : "System Health")</PageTitle>

<div class="system-health-page">
    <AppToolbar Eyebrow="@(L.IsArabic ? "التشخيص المباشر" : "LIVE DIAGNOSTICS")"
                Title="@(L.IsArabic ? "صحة النظام والتشخيص" : "System Health & Diagnostics")"
                Subtitle="@(L.IsArabic ? "فحص التطبيق والتخزين المحلي وقاعدة SQLite والسجلات من مصدر النظام الحقيقي." : "Real application, local storage, SQLite, and logging diagnostics.")">
        <Actions>
            @if (snapshot is not null)
            {
                <AppBadge Tone="@(snapshot.IsHealthy ? "success" : "danger")"
                          Icon="●"
                          Text="@(snapshot.IsHealthy ? (L.IsArabic ? "النظام سليم" : "System healthy") : (L.IsArabic ? "يحتاج مراجعة" : "Attention required"))" />
            }
            <AppButton Variant="primary"
                       Icon="↻"
                       Busy="@isLoading"
                       Disabled="@isLoading"
                       Text="@(isLoading ? (L.IsArabic ? "جارٍ الفحص..." : "Checking...") : (L.IsArabic ? "إعادة الفحص" : "Run checks"))"
                       OnClick="RefreshClickedAsync" />
        </Actions>
    </AppToolbar>

    @if (snapshot is null)
    {
        <AppLoading Title="@(L.IsArabic ? "جارٍ فحص صحة النظام" : "Checking system health")"
                    Message="@(L.IsArabic ? "يتم فحص التطبيق والتخزين وSQLite والسجلات." : "Checking the application, storage, SQLite, and logs.")" />
    }
    else
    {
        <section class="app-stat-grid">
            <AppStatCard Icon="♥"
                         Label="@(L.IsArabic ? "الحالة العامة" : "Overall status")"
                         Value="@(snapshot.IsHealthy ? (L.IsArabic ? "سليم" : "Healthy") : (L.IsArabic ? "تحذير" : "Warning"))"
                         Description="@($"{HealthyCount} / {snapshot.Checks.Count}")"
                         Tone="@(snapshot.IsHealthy ? "success" : "danger")" />
            <AppStatCard Icon="✓"
                         Label="@(L.IsArabic ? "الفحوصات السليمة" : "Healthy checks")"
                         Value="@HealthyCount.ToString()"
                         Description="@(L.IsArabic ? "تعمل بصورة طبيعية" : "Operating normally")"
                         Tone="success" />
            <AppStatCard Icon="!"
                         Label="@(L.IsArabic ? "تحتاج مراجعة" : "Needs attention")"
                         Value="@FailedCount.ToString()"
                         Description="@(L.IsArabic ? "فحوصات غير سليمة" : "Unhealthy checks")"
                         Tone="@(FailedCount == 0 ? "success" : "danger")" />
            <AppStatCard Icon="◷"
                         Label="@(L.IsArabic ? "آخر فحص" : "Last checked")"
                         Value="@FormatDate(snapshot.CheckedAtUtc)"
                         Description="@($"v{snapshot.Version}")"
                         Tone="info"
                         ValueClass="health-date" />
        </section>

        <section class="system-health-layout">
            <div class="system-health-main">
                <AppSection Eyebrow="@(L.IsArabic ? "المكونات" : "COMPONENTS")"
                            Title="@(L.IsArabic ? "حالة مكونات النظام" : "System component status")"
                            Subtitle="@(L.IsArabic ? "كل بطاقة تمثل فحصًا فعليًا منفذًا بواسطة خدمة صحة النظام." : "Each card represents a real check executed by the system health service.")"
                            BodyClass="health-check-grid">
                    <ChildContent>
                        @foreach (var check in snapshot.Checks)
                        {
                            <AppDetailsPanel Icon="@CheckIcon(check.Key)"
                                             Eyebrow="@check.Target"
                                             Title="@CheckTitle(check.Key)"
                                             Description="@check.Details"
                                             Tone="@(check.IsHealthy ? "success" : "danger")">
                                <ChildContent>
                                    <div class="health-component-status">
                                        <AppBadge Tone="@(check.IsHealthy ? "success" : "danger")"
                                                  Text="@(check.IsHealthy ? (L.IsArabic ? "سليم" : "Healthy") : (L.IsArabic ? "فشل" : "Failed"))" />
                                        <AppProgressBar Value="@(check.IsHealthy ? 100 : 35)"
                                                        Tone="@(check.IsHealthy ? "success" : "danger")"
                                                        Label="@(L.IsArabic ? "نتيجة الفحص" : "Check result")" />
                                    </div>
                                </ChildContent>
                            </AppDetailsPanel>
                        }
                    </ChildContent>
                </AppSection>
            </div>

            <aside class="system-health-side">
                <AppDetailsPanel Icon="@(snapshot.IsHealthy ? "✓" : "!")"
                                 Eyebrow="@(L.IsArabic ? "الصحة العامة" : "OVERALL HEALTH")"
                                 Title="@(snapshot.IsHealthy ? (L.IsArabic ? "المنصة تعمل بصورة جيدة" : "Platform is healthy") : (L.IsArabic ? "توجد عناصر تحتاج مراجعة" : "Some checks need attention"))"
                                 Description="@(snapshot.IsHealthy ? (L.IsArabic ? "جميع الفحوصات الأساسية اجتازت الاختبار بنجاح." : "All essential diagnostics passed successfully.") : (L.IsArabic ? "راجع البطاقات الحمراء لتحديد سبب المشكلة." : "Review the red diagnostics cards to identify the issue."))"
                                 Tone="@(snapshot.IsHealthy ? "success" : "warning")">
                    <ChildContent>
                        <AppProgressBar Value="@HealthPercent"
                                        Tone="@(snapshot.IsHealthy ? "success" : "warning")"
                                        Label="@(L.IsArabic ? "مؤشر الصحة" : "Health score")" />
                    </ChildContent>
                </AppDetailsPanel>

                <AppSection Title="@(L.IsArabic ? "معلومات الفحص" : "Diagnostic information")">
                    <ChildContent>
                        <dl class="health-info-list">
                            <div><dt>@(L.IsArabic ? "الإصدار" : "Version")</dt><dd>@snapshot.Version</dd></div>
                            <div><dt>@(L.IsArabic ? "إجمالي الفحوصات" : "Total checks")</dt><dd>@snapshot.Checks.Count</dd></div>
                            <div><dt>@(L.IsArabic ? "الناجحة" : "Healthy")</dt><dd>@HealthyCount</dd></div>
                            <div><dt>@(L.IsArabic ? "غير السليمة" : "Unhealthy")</dt><dd>@FailedCount</dd></div>
                            <div><dt>@(L.IsArabic ? "وقت الفحص" : "Checked at")</dt><dd>@FormatDate(snapshot.CheckedAtUtc)</dd></div>
                        </dl>
                    </ChildContent>
                </AppSection>

                <AppDetailsPanel Icon="≡"
                                 Eyebrow="@(L.IsArabic ? "الإجراءات" : "ACTIONS")"
                                 Title="@(L.IsArabic ? "ماذا أفعل عند ظهور خطأ؟" : "What to do when a check fails")"
                                 Description="@(L.IsArabic ? "أعد الفحص أولًا، ثم راجع مسار العنصر وتفاصيله. استخدم صفحة السجلات للحصول على معلومات إضافية." : "Run the checks again, review the target and details, then open Logs for deeper diagnostics.")">
                    <Actions>
                        <AppButton Href="/module/logs" Text="@(L.IsArabic ? "فتح السجلات" : "Open logs")" />
                    </Actions>
                </AppDetailsPanel>
            </aside>
        </section>
    }
</div>

@code {
    private SystemHealthSnapshot? snapshot;
    private bool isLoading;
    private int HealthyCount => snapshot?.Checks.Count(x => x.IsHealthy) ?? 0;
    private int FailedCount => snapshot?.Checks.Count(x => !x.IsHealthy) ?? 0;
    private int HealthPercent => snapshot is null || snapshot.Checks.Count == 0 ? 0 : (int)Math.Round(HealthyCount * 100d / snapshot.Checks.Count);

    protected override Task OnInitializedAsync() => RefreshAsync();
    private Task RefreshClickedAsync(MouseEventArgs _) => RefreshAsync();

    private async Task RefreshAsync()
    {
        isLoading = true;
        try { snapshot = await HealthService.CheckAsync(); }
        finally { isLoading = false; }
    }

    private string CheckTitle(string key) => key switch
    {
        "application" => L.IsArabic ? "التطبيق وبيئة التشغيل" : "Application runtime",
        "storage" => L.IsArabic ? "التخزين المحلي" : "Local storage",
        "sqlite" => L.IsArabic ? "قاعدة بيانات SQLite" : "SQLite database",
        "logs" => L.IsArabic ? "مجلد السجلات" : "Logs directory",
        _ => key
    };

    private static string CheckIcon(string key) => key switch
    {
        "application" => "◆",
        "storage" => "▣",
        "sqlite" => "DB",
        "logs" => "≡",
        _ => "●"
    };

    private string FormatDate(DateTimeOffset value) => value.ToLocalTime().ToString(L.IsArabic ? "yyyy-MM-dd HH:mm:ss" : "MMM d, yyyy HH:mm:ss");
    private string FormatDate(DateTime value) => value.ToLocalTime().ToString(L.IsArabic ? "yyyy-MM-dd HH:mm:ss" : "MMM d, yyyy HH:mm:ss");
}
